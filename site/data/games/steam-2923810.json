투가 어우러진 판타지 늑대인간 게임입니다. 비화사절단은 잠식된 땅에 잠입해 감염 확산을 막으라는 명을 받습니다. 이곳에는 흉포한 괴물과 치명적인 함정이 도사리지만, 가장 큰 위협은 내부에 있습니다 — 명계 사도 몇몇이 정체를 숨긴 채 배신을 노립니다. 혈월이 다가오면 수호자와 배신자의 수 싸움이 시작됩니다. 배수의 진을 칠 것인가, 이미 예정된 함정으로 달아날 것인가? 진실과 운명은 검과 마법 속에서 당신을 기다립니다.","publishers":[{"name":"TMXN Games"}],"developers":[{"name":"TMXN Games"}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_quarter"},"trailers":{"highlights":[{"trailer_name":"preview","trailer_url_format":"steam/apps/${FILENAME}?t=1784195193","trailer_category":2,"microtrailer":[{"filename":"2923810/150056975/57aaef4694fe629c2c7c3790084e433db545dbf8/1784192597/microtrailer.webm","type":"video/webm"},{"filename":"2923810/150056975/57aaef4694fe629c2c7c3790084e433db545dbf8/1784192597/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"2923810/150056975/57aaef4694fe629c2c7c3790084e433db545dbf8/1784192597/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"2923810/150056975/57aaef4694fe629c2c7c3790084e433db545dbf8/1784192597/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"2923810/150056975/57aaef4694fe629c2c7c3790084e433db545dbf8/1784192597/hls_264_master.m3u8","encoding":"hls_h264"}],"screenshot_medium":"257375934/0a95c33a0567ec10e449807a2f716f309accd393/movie_600x337.jpg","screenshot_full":"257375934/0a95c33a0567ec10e449807a2f716f309accd393/movie_full.jpg","trailer_base_id":885222,"all_ages":true},{"trailer_name":"show","trailer_url_format":"steam/apps/${FILENAME}?t=1788511182","trailer_category":1,"microtrailer":[{"filename":"2923810/1606400759/3926d387d70d2e9b3017212944a7433c547918a6/1788509345/microtrailer.webm","type":"video/webm"},{"filename":"2923810/1606400759/3926d387d70d2e9b3017212944a7433c547918a6/1788509345/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"2923810/1606400759/3926d387d70d2e9b3017212944a7433c547918a6/1788509345/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"2923810/1606400759/3926d387d70d2e9b3017212944a7433c547918a6/