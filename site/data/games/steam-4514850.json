_community_announcements/1833334318565857","verified_at":"2026-10-20T14:48:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4514850-1831432155564842","game_id":"steam-4514850","kind":"announcement","title":"WELCOME TO TIAMAT CITY","summary":"Hello! It's my honor to greet the first hub members. Currently we're applying to fests and planning to conduct the first playtest in late May. Stay tuned!","occurred_at":null,"published_at":"2026-04-29T11:40:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1831432155564842","verified_at":"2026-10-20T14:48:48Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4514850":{"last_attempt_at":"2026-10-26T02:51:48Z","status":"ok","all_sources_checked_at":"2026-10-26T02:51:47Z","error_codes":[]}},"news_last_attempt_at":{"steam-4514850":"2026-10-26T02:51:48Z"},"notices":[],"news_sources":{"4514850":{"last_attempt_at":"2026-10-26T02:51:47Z","last_success_at":"2026-10-26T02:51:47Z","status":"ok","error_codes":[]},"4690840":{"last_attempt_at":"2026-10-26T02:51:48Z","last_success_at":"2026-10-26T02:51:48Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4514850","app_id":4514850,"app_scope":"base","observed_at":"2026-10-26T06:14:39Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"cfbbc0d0c93f6080345751f39d0c981ae318f6f14d016d1df8d403f96751ee3d","response_sha256":null,"source_fields":{"basic_info":{"short_description":"You are an elite Law enforcer, deployed into a dystopian city torn apart by gangs.\r\nRide your bike, react to threats and hunt down gang bosses before the city collapses.","publishers":[{"name":"Swarmoclock"}],"developers":[{"name":"Swa