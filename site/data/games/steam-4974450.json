 surrounded.","occurred_at":null,"published_at":"2026-08-04T19:31:30Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839676055898290","verified_at":"2026-10-20T19:54:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4974450-1839676055896324","game_id":"steam-4974450","kind":"announcement","title":"Apocalipsis Survivor now speaks 12 languages","summary":"Apocalipsis Survivor now speaks 12 languagesThe game went from 2 languages to 12: English, Spanish, Brazilian Portuguese, French, German, Italian, Polish, Turkish, Russian, Simplified Chinese, Japanese and Korean.Everything is translated: menus, all 16 weapons and their evolutions, the 10 characters, the 25 achievements, the full codex, and the story that unfolds between worlds.What else changed· Text now scales itself down when it does not fit. German and Russian produce far longer words than E","occurred_at":null,"published_at":"2026-08-04T02:11:55Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839676055896324","verified_at":"2026-10-20T19:54:21Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4974450":{"last_attempt_at":"2026-10-26T05:53:51Z","status":"ok","all_sources_checked_at":"2026-10-26T05:53:50Z","error_codes":[]}},"news_last_attempt_at":{"steam-4974450":"2026-10-26T05:53:51Z"},"notices":[],"news_sources":{"4974450":{"last_attempt_at":"2026-10-26T05:53:50Z","last_success_at":"2026-10-26T05:53:50Z","status":"ok","error_codes":[]},"5032620":{"last_attempt_at":"2026-10-26T05:53:51Z","last_success_at":"2026-10-26T05:53:51Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4974450","app_id":4974450,"app_scope":"base","observed_at":"2026-10-26T06:15:12Z","source_url":"https://api.steampowered.com/IStoreBrowseSer