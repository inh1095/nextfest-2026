ind":"announcement","title":"Demo of Magua: Twenty Sorrows is released!","summary":"Go ahed and try out the demo. The most important thing: Please give me some feedback, the point of this demo is so I can gather some feedback and improve on the game, if you can write down anything that you dislike or you think is working incorrectly - just write here in the comments, in the discord - wherever you can! But for now.... Enjoy the game!","occurred_at":null,"published_at":"2026-10-03T06:26:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656388476","verified_at":"2026-10-20T21:42:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5089680-1843481262705527","game_id":"steam-5089680","kind":"update","title":"Update! Magua is now available in 9 languages!","summary":"Steam's statistics showed me which countries the players interested in Magua come from, so I translated the game for you. Now you can play in your own language!I hope Magua lives up to your expectations and that you enjoy playing it in your native language. When I was a kid, I didn't speak any other languages, and games were sometimes hard to understand. That's why I want my game to be available in many languages!","occurred_at":null,"published_at":"2026-09-15T19:50:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262705527","verified_at":"2026-10-20T21:42:06Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5089680":{"last_attempt_at":"2026-10-26T08:02:28Z","status":"ok","all_sources_checked_at":"2026-10-26T08:02:28Z","error_codes":[]}},"news_last_attempt_at":{"steam-5089680":"2026-10-26T08:02:28Z"},"notices":[],"news_sources":{"5089680":{"last_attempt_at":"2026-10-26T08:02:28Z","last_success_at":"2026-10-26T08:02:28Z","status":"ok","erro