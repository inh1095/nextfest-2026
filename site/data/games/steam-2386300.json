/v1/","context":{"app_id":2386300,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-2386300","metric":"demo_ccu","observed_at":"2026-10-26T07:32:02Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5356390","error_code":null}],"events":[{"id":"steam-steam-2386300-1847286114035815","game_id":"steam-2386300","kind":"update","title":"Moongrave – Hotfix 0.1.4.b","summary":"Important: saves and scores have been reset. The game went through a deep balance change. To start on solid ground, all saves and all leaderboards have been reset. To thank you for already playing, players who had a save receive a 10,000 lunarite bonus. A message will explain it when you launch the game. Balance Monster damage is much lower: wave 1: 1.8 => 1.0; wave 10: 5.3 => 2.1; wave 30: 9.6 => 3.2. Mini-boss Sacreel (wave 10) is much easier: 60% less health, 50% less damage and 50% fewer ene","occurred_at":null,"published_at":"2026-10-23T10:18:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114035815","verified_at":"2026-10-23T11:24:26Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2386300-1847286114031729","game_id":"steam-2386300","kind":"update","title":"Moongrave – Hotfix 0.1.4.a","summary":"Interface Turrets: a shrinking circle draws attention to the turret button until you place one, and its tooltip explains how (hold left click, drag onto the map). The Arsenal is flagged with a notification on the Builder until you open it, even on an existing save. More compact turret tooltip and Arsenal cards: stats in a table, shorter description, text no longer overflows the frame. Arsenal cards now take half the width. Bug fixes Defeating Incarnate now properly sends your score to the Steam ","occurred_at":null,"published_at":"2026-10-22T08:27:52Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114031729","verified_at":"2026-10-22T08:38:20Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2386300-1847286114029793","game_id":"steam-2386300","kind":"update","title":"Moongrave – Update 0.1.4","summary":"Gameplay Builder's Arsenal: buy turrets, store them in your slots and drag them onto the battlefield during a run (12 gold). They shoot the nearest enemy for 30 s. Turrets can be upgraded over 6 levels: damage, range, duration, charges and up to 3 projectiles per shot. Right click: hold to recast the spell every 0.5 s. Mini-boss Sacreel: new attacks. It backs off to summon Noctheris that orbit and protect it, shielded. It now has its own health bar and the boss music; the wave is blocked until i","occurred_at":null,"published_at":"2026-10-21T17:36:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114029793","verified_at":"2026-10-21T21:41:18Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2386300-1846651706682861","game_id":"steam-2386300","kind":"update","title":"UPDATE 0.1.3","summary":"Version 0.1.3 Gameplay Added \"Incarnate\", the boss of the first game zone. Right-click now fires a projectile at the targeted location, costing 10% mana. New in-run \"Stats\" panel (button on the left, like the quest log): it shows the final value of every stat. A green value means a bonus is active; hover over it to see the base value and a breakdown of each bonus. New in-run \"Combat\" panel (damage meter): damage dealt, healing, mana and damage taken, with one bar per source (attack, right-click,","occurred_at":null,"published_at":"2026-10-16T19:14:00Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706682861","verified_at":"2026-10-20T10:02:56Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-2386300":{"last_attempt_at":"2026-10-26T00:17:32Z","status":"ok","all_sources_checked_at":"2026-10-26T00:17:31Z","error_codes":[]}},"news_last_attempt_at":{"steam-2386300":"2026-10-26T00:17:32Z"},"notices":[],"news_sources":{"2386300":{"last_attempt_at":"2026-10-26T00:17:31Z","last_success_at":"2026-10-26T00:17:31Z","status":"ok","error_codes":[]},"5356390":{"last_attempt_at":"2026-10-26T00:17:32Z","last_success_at":"2026-10-26T00:17:32Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-2386300","app_id":2386300,"app_scope":"base","observed_at":"2026-10-26T06:14:08Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"23b6b69f0ababbc78f2e45bb876a8788d8f83cbb9e4ad68871acec43c76ed2a6","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Defend a mysterious lunar crystal against relentless hordes in this roguelite tower defense. Build powerful defenses, cast devastating spells, gather resources, and rebuild humanity's underground city between runs.\r\n","publishers":[{"name":"CoLore studio"}],"developers":[{"name":"Mendez Guillaume"},{"name":"Silvestre Jonathan"}],"franchises":[{"name":"CoLore studio"}]},"release":{"is_coming_soon":true,"custom_release_date_message":"출시 예정","coming_soon_display":"text_comingsoon","is_early_access":true},"trailers":{"highlights":[{"trailer_name":"Trailer gameplay","trailer_url_format":"steam/apps/${FILENAME}?t=1791045831","trailer_category":1,"microtrailer":[{"filename":"2386300/1446022789/34433b36ebc14cb6f4bb286c50f40