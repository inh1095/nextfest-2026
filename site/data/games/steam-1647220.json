ems/v1/","context":{"app_id":1647220,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-1647220","metric":"demo_ccu","observed_at":"2026-10-26T07:31:09Z","value":5,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5057550","error_code":null}],"events":[{"id":"steam-steam-1647220-1847286114028521","game_id":"steam-1647220","kind":"announcement","title":"《隐藏真探》新品节Demo直播","summary":"","occurred_at":null,"published_at":"2026-10-21T11:32:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114028521","verified_at":"2026-10-21T16:06:20Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1647220-1846651706693608","game_id":"steam-1647220","kind":"announcement","title":"我們定檔啦！12月2日全球同步上線","summary":"Hello, Detectives — thank you for waiting.First, let me say this sincerely: thank you for still being here.Today, we can finally share something we've been holding onto:The full version of Once, in Times of Chaos will launch globally on December 2, 2026.We've made a brand-new PV, and with Steam Next Fest underway, today felt like the right day to release it.The story takes place in Republican-era Shanghai. You become the amnesiac agent codenamed \"Hu Yang,\" drawn into a chessboard of competing fo","occurred_at":null,"published_at":"2026-10-20T03:58:50Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706693608","verified_at":"2026-10-20T10:01:12Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1647220-1846651706690158","game_id":"steam-1647220","kind":"update","title":"Once, in Times of Chaos Demo Update! Coming to Steam Next Fest!","summary":"Hello, Detectives!Since the demo launched on August 20, we've received so many playthroughs, positive reviews, and pieces of feedback. We've read every suggestion and every discussion carefully. Thank you for taking the time to play, and for sharing your thoughts with us. We'll keep working hard to live up to your expectations. So this time, we've prepared something new for you too —Once, in Times of Chaos Demo — Updated Again: This update adds roughly 20–30 minutes of new content, along with ga","occurred_at":null,"published_at":"2026-10-19T13:12:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706690158","verified_at":"2026-10-20T10:01:12Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1647220-1842212951304971","game_id":"steam-1647220","kind":"announcement","title":"Once, in Times of Chaos – Demo FAQ","summary":"Greetings, Agents!Thank you all for playing, sharing your thoughts, and supporting us. We'll keep working hard to live up to your expectations.Since the demo launched, we've received a ton of feedback and questions. Our team has been reading and logging every single comment and suggestion. Today, we'd like to address some of the most common questions we've seen.Q1: When will the full version of Once, in Times of Chaos be released?A1: We don't have a final release date just yet, but both the post","occurred_at":null,"published_at":"2026-08-29T05:00:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951304971","verified_at":"2026-10-20T10:01:12Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1647220-1841579228672691","game_id":"steam-1647220","kind":"announcement","title":"好久不见！《隐藏真探》试玩版现已上线，期待大家的体验和反馈！","summary":"各位真探，好久不见！先统一回复一下这五年来大家问得最多的问题—— “《隐藏真探》还活着吗？” 活着。 不仅活着，还带着Demo回来交作业了，试玩版已于8月20日正式上线，不知道大家这几天是否有下载体验？ 五年时间，说不长吧，确实够大家从“什么时候上线”问到“你们是不是失踪了”；说长吧，好在我们一直没停，你们也一直没走。 剧本改过，玩法磨过，内容推倒重来过，甚至连“到底什么时候能见面”都被催了不知道多少遍。 但我们真的想再多打磨一次，给各位带来更好的体验！接下来，我们将全身心的投入到正式版最后的攻坚开发中。 破晓之前，请各位再耐心等待～ Demo上线期间，我们给各位真探准备了二创福利活动，你的脑洞有多大，我们就敢看多大！活动具体规则请见：https://docs.qq.com/doc/DV1ZEQmhoeXJtbEdT 期待看到你的投稿！当然，试玩过程中各位如果遇到任何问题，或者有任何想吐槽、想建议、想催我们改的地方，也请尽管开麦，我们每一条都会认真阅读，并在正式版中做出优化！试玩意见收集表：https://docs.qq.com/sheet/DV21oR3hQdVdxWVNZ?tab=","occurred_at":null,"published_at":"2026-08-23T04:23:35Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228672691","verified_at":"2026-10-20T10:01:12Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-1647220":{"last_attempt_at":"2026-10-25T23:59:00Z","status":"ok","all_sources_checked_at":"2026-10-25T23:59:00Z","error_codes":[]}},"news_last_attempt_at":{"steam-1647220":"2026-10-25T23:59:00Z"},"notices":[],"news_sources":{"1647220":{"last_attempt_at":"2026-10-25T23:59:00Z","last_success_at":"2026-10-25T23:59:00Z","status":"ok","error_codes":[]},"5057550":{"last_attempt_at":"2026-10-25T23:59:00Z","last_success_at":"2026-10-25T23:59:00Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-1647220","app_id":1647220,"app_scope":"base","observed_at":"2026-10-26T06:14:06Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"0d6fb420219d0d3b24809cd3f6e249cfa9674cb15fb55df4b7ffe9c679d3671c","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Once, in Times of Chaos is a live-action FMV espionage game set in Republican-era China. You will take on the role of an operative codenamed “Oak” and live through an extraordinary tale of intrigue in 1920s China. "