_at":null,"published_at":"2026-09-22T15:30:07Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010504566","verified_at":"2026-10-20T18:05:15Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4876820-1839041357038599","game_id":"steam-4876820","kind":"announcement","title":"The commissary needs test subjects (playtest signups are open)","summary":"The commissary is understaffed. That's where you come in. I'm a solo dev, and Joint Venture has hit the stage where it needs to be played by people who aren't me, ideally before I talk myself into calling it finished. So I'm opening early playtest access and looking for a first crew willing to break it. New here? Joint Venture is a prison-commissary sim. You run the shop from behind the window: fill inmate orders, manage your stock, and turn a profit, all under the cameras, patrols, and pat-down","occurred_at":null,"published_at":"2026-07-28T15:18:19Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839041357038599","verified_at":"2026-10-20T18:05:15Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4876820":{"last_attempt_at":"2026-10-26T14:53:48Z","status":"ok","all_sources_checked_at":"2026-10-26T14:53:47Z","error_codes":[]}},"news_last_attempt_at":{"steam-4876820":"2026-10-26T14:53:48Z"},"notices":[],"news_sources":{"4876820":{"last_attempt_at":"2026-10-26T14:53:47Z","last_success_at":"2026-10-26T14:53:47Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:53:47Z"},"4962900":{"last_attempt_at":"2026-10-26T14:53:48Z","last_success_at":"2026-10-26T14:53:48Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:53:48Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4876820","app_id":4876820,"app_scope":"base",