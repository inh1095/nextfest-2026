Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4949360,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-4949360","metric":"review_count","observed_at":"2026-10-26T14:45:16Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4949360,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-4949360","metric":"review_positive_percent","observed_at":"2026-10-26T14:45:16Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4949360,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4949360","metric":"demo_ccu","observed_at":"2026-10-26T15:33:13Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5275400","error_code":null}],"events":[{"id":"steam-steam-4949360-1846651706690898","game_id":"steam-4949360","kind":"announcement","title":"Undying Soul Demo Updated for Steam Next Fest","summary":"Explore the new prologue, take on reworked boss battles, discover the new Treasure Room and its Mimic enemies, and experiment with the new Relic system. The update also brings a new hat-like enemy, breakable objects, visual improvements, and an enhanced inventory. Run progress is now saved more consistently.Try the updated demo and let me know what you think. If you enjoy the demo, adding it to your wishlist really helps.","occurred_at":null,"published_at":"2026-10-19T15:55:52Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706690898","verified_at":"2026-10-20T19:12:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4949360-1846018067936600","game_id":"steam-4949360","kind":"announcement","title":"Boss & Miniboss Improvements","summary":"Boss & Miniboss ImprovementsReworked the movesets of all minibosses and bosses to make their attacks more varied and less predictable.Added a new attack to both the Berserker and Paladin minibosses.Replaced the main boss's healing ability with a new attack. Bug FixesFixed an issue that allowed the same item to be purchased from both the Shop and Chest.Fixed an issue with the percentage (%) symbol in certain languages.Fixed the missing Move Down icon for controllers in the tutorial. Thank you for","occurred_at":null,"published_at":"2026-10-10T16:02:14Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067936600","verified_at":"2026-10-20T19:12:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4949360-1846018067929129","game_id":"steam-4949360","kind":"announcement","title":"Prologue, Gameplay Improvements & Fixes","summary":"Story & TutorialAdded the Prologue section.Updated the Tutorial.Added new story dialogue.Gameplay ImprovementsRemoved invulnerability during skill usage.While the Berserker's Spin (Q) is active, the character can now jump and pass through one-way platforms.Improved enemy exclamation marks and red indicators to make them easier to read and react to.Item FixesFixed issues with Berserker's Heart.Fixed issues with Soul Pendant.Fixed issues with Berserker's Axe.Fixed issues with Serrated Edge.Skill F","occurred_at":null,"published_at":"2026-10-08T10:23:19Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067929129","verified_at":"2026-10-20T19:12:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4949360-1845383656389232","game_id":"steam-4949360","kind":"announcement","title":"Controller Support","summary":"Controller SupportAdded full controller support for gameplay.Added controller navigation for menus and UI.Controller bindings have been added for the game's main actions and interactions.The Controls menu now displays the appropriate controller inputs.Thank you for playing the demo and for all the feedback so far.","occurred_at":null,"published_at":"2026-10-03T14:01:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656389232","verified_at":"2026-10-20T19:12:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4949360-1845383656376607","game_id":"steam-4949360","kind":"announcement","title":"Visual and UI Improvements","summary":"Visual ImprovementsRemoved the AI-generated character portraits from the game. Character visuals shown next to skills now use their in-game artwork.Updated skill icons and other UI elements with redesigned visuals.Map ImprovementsAdded an information section next to the map.The map now clearly shows what each room icon represents, making it easier to understand the different room types.Gameplay FeedbackAdded a ready effect to skills when their cooldowns are complete.Added the same ready feedback","occurred_at":null,"published_at":"2026-09-30T07:37:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656376607","verified_at":"2026-10-20T19:12:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4949360-1844751498231946","game_id":"steam-4949360","kind":"announcement","title":"Fixes and Improvements","summary":"Inventory ImprovementsImproved the inventory screen with a new Stats section.Character stats can now be viewed directly from the inventory.Items can now be sold directly from the inventory.Items found throughout the game, such as items obtained from chests, can now be sold as well.UI & Interaction ImprovementsImproved interaction prompts to make interactions clearer.Added clearer instructions to the teleport screen.Bug FixesFixed several collision issues.LocalizationImproved and corrected locali","occurred_at":null,"published_at":"2026-09-28T16:10:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498231946","verified_at":"2026-10-20T19:12:19Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4949360":{"last_attempt_at":"2026-10-26T15:37:30Z","status":"ok","all_sources_checked_at":"2026-10-26T15:37:29Z","error_codes":[]}},"news_last_attempt_at":{"steam-4949360":"2026-10-26T15:37:30Z"},"notices":[],"news_sources":{"4949360":{"last_attempt_at":"2026-10-26T15:37:29Z","last_success_at":"2026-10-26T15:37:29Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T15:37:29Z"},"5275400":{"last_attempt_at":"2026-10-26T15:37:30Z","last_success_at":"2026-10-26T15:37:30Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T15:37:30Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4949360","app_id":4949360,"app_scope":"base","observed_at":"2026-10-26T06:15:10Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,