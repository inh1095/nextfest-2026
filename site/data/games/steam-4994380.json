et/news/externalpost/steam_community_announcements/1846018067926500","verified_at":"2026-10-20T20:16:31Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4994380-1842846814438738","game_id":"steam-4994380","kind":"announcement","title":"Hi Everyone! 👋 Welcome to Tidy Town!","summary":"Hi Everybody!Welcome to everyone new, and also to those who have been following us since Tidy Town's earliest days of development. It's great to have you in this cozy corner of Steam.In case you haven't already - please check out our announcement trailer featuring our star Percy the cat!We are working hard to make this game extremely satisfying to play. When we started prototyping the idea was to take that sticky merge mechanic that is loved in so many 2D games and see if we could make it just a","occurred_at":null,"published_at":"2026-09-01T22:52:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814438738","verified_at":"2026-10-20T20:16:31Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4994380":{"last_attempt_at":"2026-10-26T06:36:12Z","status":"ok","all_sources_checked_at":"2026-10-26T06:36:11Z","error_codes":[]}},"news_last_attempt_at":{"steam-4994380":"2026-10-26T06:36:12Z"},"notices":[],"news_sources":{"4994380":{"last_attempt_at":"2026-10-26T06:36:11Z","last_success_at":"2026-10-26T06:36:11Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T06:36:11Z"},"5292200":{"last_attempt_at":"2026-10-26T06:36:12Z","last_success_at":"2026-10-26T06:36:12Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T06:36:12Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4994380","app_id":4994380,"app_scope":"base","observed_at":"2026-10-26T06:15:15Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","lang