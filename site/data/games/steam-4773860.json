d interpolation frames for smoother animations.5. Difficulty & Pacing: Adjusted the overall difficulty and slowed down the game'","occurred_at":null,"published_at":"2026-06-24T13:28:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1836506165545926","verified_at":"2026-10-20T17:03:26Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4773860":{"last_attempt_at":"2026-10-26T04:04:16Z","status":"ok","all_sources_checked_at":"2026-10-26T04:04:16Z","error_codes":[]}},"news_last_attempt_at":{"steam-4773860":"2026-10-26T04:04:16Z"},"notices":[],"news_sources":{"4773860":{"last_attempt_at":"2026-10-26T04:04:16Z","last_success_at":"2026-10-26T04:04:16Z","status":"ok","error_codes":[]},"4773870":{"last_attempt_at":"2026-10-26T04:04:16Z","last_success_at":"2026-10-26T04:04:16Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4773860","app_id":4773860,"app_scope":"base","observed_at":"2026-10-26T06:14:57Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"cbcedae6c1b687d19e14281c7d418cfaa9313539496dc870a986084f44aab0b3","response_sha256":null,"source_fields":{"basic_info":{"short_description":"A 2D anime-style action game. Dive into the unconscious mind world to hunt negative emotion monsters!","publishers":[{"name":"KazaRimne"}],"developers":[{"name":"KazaRimne"}]},"release":{"steam_release_date":1838098800,"is_coming_soon":true,"coming_soon_display":"date_quarter"},"trailers":{"highlights":[{"trailer_name":"In-game footage","trailer_url_format":"steam/apps/${FILENAME}?t=1792512366","trailer_category":1,"microtrailer":[{"filename":"4773860/1844064923/8c72da7020701656369a16c6e71ed815312b6809/1792512125/microtrailer.webm","type":"video/w