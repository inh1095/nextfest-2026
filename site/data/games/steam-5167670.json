olk reach new he","occurred_at":null,"published_at":"2026-09-12T14:01:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262697523","verified_at":"2026-10-20T23:52:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5167670-1842212951310722","game_id":"steam-5167670","kind":"announcement","title":"The cove is open: Starlight Cove is now on Steam","summary":"🎣 Starlight Cove is now on Steam!Make some lemonade, grab your fishing rod, and get ready for a summer you probably won’t forget.🌴 Catch weird fish across colorful locations.🎣 Upgrade your skills and gear to catch even MORE fish.🏘️ Rebuild and customize Starlight Cove back to its former glory.🐠 Fill the local aquarium with your rarest discoveries.❤️ Meet the townsfolk and uncover a heartfelt story about you and your grandfather.🦈 And maybe settle an old family score with the evil shark that stol","occurred_at":null,"published_at":"2026-08-31T16:08:44Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951310722","verified_at":"2026-10-20T23:52:54Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5167670":{"last_attempt_at":"2026-10-26T09:07:26Z","status":"ok","all_sources_checked_at":"2026-10-26T09:07:25Z","error_codes":[]}},"news_last_attempt_at":{"steam-5167670":"2026-10-26T09:07:26Z"},"notices":[],"news_sources":{"5167670":{"last_attempt_at":"2026-10-26T09:07:25Z","last_success_at":"2026-10-26T09:07:25Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:07:25Z"},"5252280":{"last_attempt_at":"2026-10-26T09:07:26Z","last_success_at":"2026-10-26T09:07:26Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:07:26Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5167670","app_id":5167670,"app_s