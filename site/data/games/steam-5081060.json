ggestions","occurred_at":null,"published_at":"2026-10-19T17:00:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691297","verified_at":"2026-10-20T21:40:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5081060-1846018067926228","game_id":"steam-5081060","kind":"announcement","title":"Release Date Announced!","summary":"Hello everyone! I'm happy to announce that Just Up: 2D Platformer will be released on November 11, 2026! The free demo is already available on Steam, so you can try the game before the full release. Thank you so much for your support and for following the development of the game. I'm really excited to finally share the full game with you! See you on November 11!","occurred_at":null,"published_at":"2026-10-07T14:00:20Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067926228","verified_at":"2026-10-20T21:40:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5081060-1845383656389014","game_id":"steam-5081060","kind":"announcement","title":"A New Name for the Game","summary":"Hello everyone! I have an important update about the game. The game was previously titled \"Only Up: 2D Platformer\", but I recently received a trademark complaint regarding that name. Following the complaint, the game has been renamed to \"Just Up: 2D Platformer\". The demo has also been renamed to \"Just Up: 2D Platformer Demo\". The game itself remains the same, and all existing progress, achievements, leaderboards, and other game features remain part of the project. I have also updated the game's ","occurred_at":null,"published_at":"2026-10-03T12:00:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656389014","verified_at":"2026-10-20T21:40:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5081060-1844115010489711","game_id":"steam-5081060","kind":"announcement","title":"Demo is Now Available!","summary":"Only Up: 2D Platformer Demo is now available on Steam! Now you can enjoy a small part of the full game. The demo offers around 10 minutes of gameplay, Steam Leaderboards, Steam Achievements, and more! If you encounter any bugs or have any suggestions, I'd love to hear from you. Have fun climbing!","occurred_at":null,"published_at":"2026-09-16T17:11:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010489711","verified_at":"2026-10-20T21:40:41Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5081060":{"last_attempt_at":"2026-10-26T08:01:02Z","status":"ok","all_sources_checked_at":"2026-10-26T08:01:02Z","error_codes":[]}},"news_last_attempt_at":{"steam-5081060":"2026-10-26T08:01:02Z"},"notices":[],"news_sources":{"5081060":{"last_attempt_at":"2026-10-26T08:01:02Z","last_success_at":"2026-10-26T08:01:02Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:01:02Z"},"5225400":{"last_attempt_at":"2026-10-26T08:01:02Z","last_success_at":"2026-10-26T08:01:02Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:01:02Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5081060","app_id":5081060,"app_scope":"base","observed_at":"2026-10-26T06:15:24Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"7454c6f84553bafa3e3d4bbe3a057eadb3ae40073743a8ad5572a19c96d97101","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Just Up: 2D Platformer is a vertical platformer where the goal is