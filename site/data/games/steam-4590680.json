/v1/","context":{"app_id":4590680,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4590680-1846651706693060","game_id":"steam-4590680","kind":"announcement","title":"Darkest Path is in Steam Next Fest!","summary":"Steam Next Fest has begun, and Darkest Path is part of it.We haven't posted here in a while because most of our time has gone into polishing the demo and getting it as close as possible to how we want the full game to feel. This isn't just a small prototype anymore. The demo includes the core combat systems, enemies, abilities, path choices, altars, NPC encounters and the boss of the first chapter.Over the last few weeks we've also been watching people play the demo for the first time. Seeing wh","occurred_at":null,"published_at":"2026-10-19T23:21:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706693060","verified_at":"2026-10-20T15:12:22Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4590680-1836506165560815","game_id":"steam-4590680","kind":"announcement","title":"Darkest Path passed 1000 wishlists!","summary":"Darkest Path has passed 1000 wishlists on Steam.For some games this may not sound like a huge number, but for us it already means a lot. Every wishlist, every comment, every small reaction makes the work feel a little less invisible.So thank you.Right now, most of our time is going into the demo. We do not want it to feel like a separate showcase build or a rough sample made only for Steam. We want it to feel like the real beginning of Darkest Path.That means the section you play in the demo sho","occurred_at":null,"published_at":"2026-06-29T19:04:44Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1836506165560815","verified_at":"2026-10-20T15:12:22Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4590680-1833334318578020","game_id":"steam-4590680","kind":"announcement","title":"The Darkest Path Playtest is Now Closed","summary":"It has been exactly one week, and we are officially closing the doors on this early playtest.First off, I want to say a massive thank you to everyone who played and took the time to leave feedback. To be completely honest, we never expected this much attention. We opened this build just to do a very small, quiet run to see if the core gameplay loop was actually fun. The overwhelming interest caught us off guard, which is exactly why the build felt so rough around the edges.We are incredibly happ","occurred_at":null,"published_at":"2026-05-25T20:41:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318578020","verified_at":"2026-10-20T15:12:22Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4590680-1830797770230874","game_id":"steam-4590680","kind":"announcement","title":"We just hit a major milestone: 100 Organic Wishlists! 🎉","summary":"It may seem like a small number, but for us, it's incredibly meaningful. We haven't launched any official marketing yet, so every single one of you found Darkest Path through your own curiosity. Thank you for joining us on this descent so early in the journey!To make things even better, we recently celebrated our lead artist’s birthday. His mother surprised him with this amazing, blood-dripping Darkest Path cake!Seeing our dark, gritty world turned into a handmade gift was a truly special moment","occurred_at":null,"published_at":"2026-04-22T14:40:33Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1830797770230874","verified_at":"2026-10-20T15:12:22Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4590680":{"last_attempt_at":"2026-10-26T02:56:05Z","status":"ok","all_sources_checked_at":"2026-10-26T02:56:05Z","error_codes":[]}},"news_last_attempt_at":{"steam-4590680":"2026-10-26T02:56:05Z"},"notices":[],"news_sources":{"4590680":{"last_attempt_at":"2026-10-26T02:56:05Z","last_success_at":"2026-10-26T02:56:05Z","status":"ok","error_codes":[]},"5378050":{"last_attempt_at":"2026-10-26T02:56:05Z","last_success_at":"2026-10-26T02:56:05Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4590680","app_id":4590680,"app_scope":"base","observed_at":"2026-10-26T06:14:42Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"224d09983f10ee96e4a06d6c02b61b42149688e4d12e73a9d665d9d5117ada7c","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Darkest Path is a 2.5D roguelike FPS that merges a modern-retro aesthetic with cosmic horror. Navigate through shifting nightmare realms, master diverse character classes, and survive the brutal corruption of a decaying world.","publishers":[{"name":"MegaKil Studios"}],"developers":[{"name":"MegaKil Studios"}]},"release":{"is_coming_soon":true,"custom_release_date_message":"발표 예정","coming_soon_display":"text_tba"},"trailers":{"highlights":[{"trailer_name":"Darkest Path Official Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1791474456","trailer_category":1,"microtrailer":[{"filename":"4590680/1466797585/1276eeb62063b35b0d504c9547cb0d37d0f77a05/1791471663/microtrailer.webm","type":"video/webm"},{"filename":"4590680/1466797585/1276eeb62063b35b0d504c9547cb0d37d0f77a05/1791471663/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_pa