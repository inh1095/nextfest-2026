RMANCE BUILDING DEMOLITIONBlowing whole shell off a building could sink the framerate for a couple of seconds while the debris settled worst right in the middle of a firefight.The cause, every flying chunk was doing expensive collision math against the buildings' detailed collision meshes, and slow frames made physics work even harder to catch up.Debris now collides with the terrain only. Demolishing a building holds full frame rate even under fire measured at a rock steady frame time where","occurred_at":null,"published_at":"2026-08-11T15:00:19Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840310314354354","verified_at":"2026-10-20T21:01:46Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5041990":{"last_attempt_at":"2026-10-25T22:16:11Z","status":"ok","all_sources_checked_at":"2026-10-25T22:16:10Z","error_codes":[]}},"news_last_attempt_at":{"steam-5041990":"2026-10-25T22:16:11Z"},"notices":[],"news_sources":{"5041990":{"last_attempt_at":"2026-10-25T22:16:10Z","last_success_at":"2026-10-25T22:16:10Z","status":"ok","error_codes":[]},"5127470":{"last_attempt_at":"2026-10-25T22:16:11Z","last_success_at":"2026-10-25T22:16:11Z","status":"ok","error_codes":[]}}}
