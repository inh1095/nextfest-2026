ror_code":"no_reviews"},{"game_id":"steam-5146010","metric":"demo_ccu","observed_at":"2026-10-26T06:33:04Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5251830","error_code":null}],"events":[{"id":"steam-steam-5146010-1847286114031440","game_id":"steam-5146010","kind":"announcement","title":"One material short? Watch what your opponents discard","summary":"Two materials in hand. One more to go. You head out to explore, and come back with something you weren't looking for. If you play card games, that probably sounds familiar. In Fliprium, it's worth watching your opponents' discards too. A material they don't need might finish your craft. Their turn gives you a reason to keep watching the table. Of course, the missing card may not show up. Then there's a decision to make: keep working towards that artifact, or look again at what your current hand ","occurred_at":null,"published_at":"2026-10-22T06:48:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114031440","verified_at":"2026-10-22T07:55:40Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5146010-1846651706676941","game_id":"steam-5146010","kind":"announcement","title":"42, No Coding Background: The Story Behind Fliprium","summary":"Can you make the card game in your head at 42? The creator of Fliprium is a 42-year-old industrial sales representative and a card-game enthusiast. With no coding background or game-industry experience, he spent a month developing Fliprium with AI assistance. The free demo is now playable on Steam. {STEAM_CLAN_IMAGE}/46544072/4e9f9b037f2dca6389155b7ceadbcff69ede4443.png Actual gameplay: forging an artifact after gathering materials. From mahjong and Yezi Xi to a fantasy tabletop Inspired by trad","occurred_at":null,"published_at":"2026-10-15T09:25:22Z","time_precision":"minute","sourc