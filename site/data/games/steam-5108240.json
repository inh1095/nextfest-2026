ror_code":"no_reviews"},{"game_id":"steam-5108240","metric":"demo_ccu","observed_at":"2026-10-26T06:24:10Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5132690","error_code":null}],"events":[{"id":"steam-steam-5108240-1846651706692425","game_id":"steam-5108240","kind":"announcement","title":"Rogue's Dark Descent — Steam Next Fest Gameplay","summary":"Current gameplay features. I mainly use the keyboard for movement, etc. I use the auto-move option when I have already explored a given area.If you are interested in the ongoing saga that is my development log you can go to the following URL. I did not start this until well into development and so far am just posting older baselines.https://www.patreon.com/c/KnighthawqYou are also more then welcome to provide any feedback, suggestions, idle banter, etc. :) https://docs.google.com/forms/d/e/1FAIp","occurred_at":null,"published_at":"2026-10-19T19:24:21Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706692425","verified_at":"2026-10-20T22:26:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5108240-1846018067927442","game_id":"steam-5108240","kind":"update","title":"Rogue’s Dark Descent Demo Update — v3.10.0","summary":"A large update is now live for the Rogue’s Dark Descent demo, focused on combat, monster behavior, persistence, usability, and overall stability. This update includes a lot of behind-the-scenes work, but the goal is straightforward: make the demo feel smoother, clearer, more tactical, and more reliable ahead of the upcoming press preview and Steam Next Fest. If you run into anything unusual, please use the new Report a Bug button from the title screen or demo-completion window.I am sorry if anyo","occurred_at":null,"published_at":"2026-10-07T20:00:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067927442","verified_at":"2026-10-20T22:26:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5108240-1843481262703516","game_id":"steam-5108240","kind":"update","title":"Rogue’s Dark Descent Demo Update — v3.8.0","summary":"This update includes a collection of gameplay, interface, accessibility, and performance improvements made since the previous demo build.HighlightsAdded Bear Traps, including hidden trap discovery and interaction. This has NOTHING to do with the fact that, despite all my efforts, I only managed to survive until morning once :|Improved monster glyph visibility — monster glyphs now use clearer backgrounds and improved contrast, making creatures easier to identify across different terrain and envir","occurred_at":null,"published_at":"2026-09-15T03:53:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262703516","verified_at":"2026-10-20T22:26:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5108240-1842846814454658","game_id":"steam-5108240","kind":"update","title":"Rogue’s Dark Descent Demo Update — v3.7.0","summary":"A new update for the Rogue’s Dark Descent Demo is now available!This update includes a mix of new features, quality-of-life improvements, world polish, and updates to the beginning of a new run.Highlights include:Added configurable, persistent key bindingsAdded Auto-AttackOmens can now be combined, allowing multiple Omens to shape the same runAdded a new opening narrative and battlefield aftermathThe game window can now be freely resized and scaledUpdated the Hearthcoil quest and related interac","occurred_at":null,"published_at":"2026-09-08T04:16:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814454658","verified_at":"2026-10-20T22:26:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5108240-1842846814441133","game_id":"steam-5108240","kind":"update","title":"Rogue’s Dark Descent Demo Update — v3.5.0","summary":"A new update is now available for the Rogue’s Dark Descent demo, with a mix of gameplay, presentation, and behind-the-scenes improvements.Highlights include:Improved environmental detail around blacksmith work areas, homestead crops, apothecary workspaces, and scholar residences.Companion, spell-learning, and UI improvements.Improved new-run monster placement to give players some initial breathing room. Hostile creatures will no longer be generated immediately around the player's starting positi","occurred_at":null,"published_at":"2026-09-02T17:29:44Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814441133","verified_at":"2026-10-20T22:26:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5108240-1842212951310747","game_id":"steam-5108240","kind":"announcement","title":"The Rogue's Dark Descent Demo is Live!","summary":"The Rogue's Dark Descent Demo is Live!After a lot of work, testing, tweaking, breaking things, fixing those things, and occasionally breaking completely different things while fixing them, the demo for Rogue's Dark Descent is finally live.Thank you to everyone who takes the time to give it a try. This is a solo-developed game and getting it to the point where I can finally put it into other people's hands is both exciting and a little terrifying.The demo is also exactly that — a demo. I've done ","occurred_at":null,"published_at":"2026-08-31T16:18:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951310747","verified_at":"2026-10-20T22:26:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5108240-1841579228670486","game_id":"steam-5108240","kind":"announcement","title":"Demo Progress & Next Fest","summary":"A few development milestones for Rogue's Dark Descent ...I have submitted the demo to Steam for review, and Rogue's Dark Descent is officially registered for October's Steam Next Fest.With the major features of the demo in place, my current focus is on playtesting and polish — improving performance and stability, cleaning up UI and interactions, and making sure the opening experience is clear for players stepping into the game for the first time.There are still plenty of little things on my list","occurred_at":null,"published_at":"2026-08-22T00:53:04Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228670486","verified_at":"2026-10-20T22:26:30Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5108240":{"last_attempt_at":"2026-10-25T22:55:24Z","status":"ok","all_sources_checked_at":"2026-10-25T22:55:24Z","error_codes":[]}},"news_last_attempt_at":{"steam-5108240":"2026-10-25T22:55:24Z"},"notices":[],"news_sources":{"5108240":{"last_attempt_at":"2026-10-25T22:55:24Z","last_success_at":"2026-10-25T22:55:24Z","status":"ok","error_codes":[]},"5132690":{"last_attempt_at":"2026-10-25T22:55:24Z","last_success_at":"2026-10-25T22:55:24Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5108240","app_id":5108240,"app_scope":"base","observed_at":"2026-10-26T06:15:30Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"4c581841e81f1dfced7dedb3c0715d026190381986524bca6de37c35ef406e62","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Rogue’s Dark Descent is a traditional roguelike about exploring a dangerous, procedurally generated wilderness and the forgotten places beneath it. Fight, explore, meet survivors, uncover lost history, find powerful artifacts, and see how long your story lasts.\r\n","publishers":[{"name":"Knighthawq"}],"developers":[{"name":"Knighthawq"}]},"release":{"is_coming_soon":true,"custom_release_date_message":"출시 예정","coming_soon_display":"text_comingsoon"},"trailers":{"highlights":[{"trailer_name":"Rogue’s Dark Descent Trailer 1","trailer_url_format":"steam/apps/${FILENAME}?t=1787151369","trailer_category":1,"microtrailer":[{"filename":"5108240/2023573087/f4696d930d97949f6eb1d0caa6526a27eeee2181/1786999293/microtrailer.webm","type":"video/webm"},{"filename":"5108240/2023573087/f4696d930d97949f6eb1d0caa6526a27eeee2181/1786999293/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"5108240/2023573087/f4696d930d97949f6eb1d0caa6526a27eeee2181/1786999293/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"5108240/2023573087/f4696d930d97949f6eb1d0caa6526a27eeee2181/1786999293/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"5108240/2023573087/f4696d930d97949f6eb1d0caa6526a27eeee2181/1786999293/hls_264_master.m3u8","encoding":"hls_h264"}],"screenshot_medium":"257401738/fde866a1b21ac67f766c44c8d9b1f162551e0fc8/movie_600x337.jpg","screenshot_full":"257401738/fde866a1b21ac67f766c44c8d9b1f162551e0fc8/movie_full.jpg","trailer_base_id":1290991,"all_ages":true},{"trailer_name":"Rogue’s Dark Descent Trailer 2","trailer_url_format":"steam/apps/${FILENAME}?t=1787151370","trailer_category":2,"microtrailer":[{"filename":"5108240/1655316845/2f42522125accd0db18acaac8ae8a473ba86146e/1787004213/microtrailer.webm","type":"video/webm"},{"filename":"5108240/1655316845/2f42522125accd0db18acaac8ae8a473ba86146e/1787004213/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"5108240/1655316845/2f42522125accd0db18acaac8ae8a473ba86146e/1787004213/dash_av1.mpd","encodin