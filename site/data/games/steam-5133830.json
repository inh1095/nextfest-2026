ror_code":"no_reviews"},{"game_id":"steam-5133830","metric":"demo_ccu","observed_at":"2026-10-26T06:30:21Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5315140","error_code":null}],"events":[{"id":"steam-steam-5133830-1847286114033531","game_id":"steam-5133830","kind":"announcement","title":"The voice in Dario's head","summary":"In UNDERSKIN you are never alone. There's a voice in Dario's head, and it talks to you the whole time.It greets you when a run starts: \"Tonight again, huh?\"It's there when you die: \"See? I told you.\"It comments on the bosses, on the shop, on every step down. When Dario's Psyche drops, it gets worse.THOSE ARE REAL VOICESThe voice is not generated. In Italian it's mine: almost two hundred lines, recorded one by one with a microphone I bought for this. In English it's Frank P, the same friend who d","occurred_at":null,"published_at":"2026-10-22T17:00:48Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114033531","verified_at":"2026-10-22T18:30:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5133830-1846651706691390","game_id":"steam-5133830","kind":"announcement","title":"The demo is out: UNDERSKIN is in Steam Next Fest","summary":"Dario works in a warehouse. Tonight his mind gives in, and you go down with it.The UNDERSKIN demo is live, and we're part of Steam Next Fest from October 19 to 26.WHAT'S IN THE DEMOThe whole first floor: the warehouse, from the locker room to the freight elevatorPerri, the Deputy Supervisor, and the floor boss: Sartori, the Shift SupervisorThe voice that follows you for the whole run, fully voiced in English and ItalianPills as currency, weapon fusions, and a mind that gets worse the deeper you ","occurred_at":null,"published_at":"2026-10-19T17:00:50Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691390","verified_at":"2026-10-20T23:09:26Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5133830-1846651706684425","game_id":"steam-5133830","kind":"announcement","title":"Behind the locker: the new menu and the new capsule","summary":"Every run of UNDERSKIN now starts the same way: you open Dario's medicine cabinet.A MENU WITHOUT WORDSThe new main menu has no buttons. Everything is an object on Dario's shelves:the pill bottle with his name on it starts a new runthe punch card holds your statsthe black notebook is the Codexthe folded leaflet shows the controlsthe switch on the side opens the optionsclosing the door quits the gameAnd on the inside of the door there's a mirror. Dario is looking back at you.The menu was drawn by ","occurred_at":null,"published_at":"2026-10-17T12:01:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706684425","verified_at":"2026-10-20T23:09:26Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5133830":{"last_attempt_at":"2026-10-26T08:44:43Z","status":"ok","all_sources_checked_at":"2026-10-26T08:44:43Z","error_codes":[]}},"news_last_attempt_at":{"steam-5133830":"2026-10-26T08:44:43Z"},"notices":[],"news_sources":{"5133830":{"last_attempt_at":"2026-10-26T08:44:43Z","last_success_at":"2026-10-26T08:44:43Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:44:43Z"},"5315140":{"last_attempt_at":"2026-10-26T08:44:43Z","last_success_at":"2026-10-26T08:44:43Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:44:43Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5133830","app_id":5133830,"app_scope":"base","observed_at":"2026-10-26T06:15:34Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","con