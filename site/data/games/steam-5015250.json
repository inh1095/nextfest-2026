/v1/","context":{"app_id":5015250,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-5015250-1847286114037229","game_id":"steam-5015250","kind":"announcement","title":"Try the Hearts Extreme demo this weekend","summary":"Steam Next Fest is underway. If you haven't tried Hearts Extreme yet, the free demo is available this weekend. It includes the Base Deck and Magic Deck. If you've only played the Base Deck, try switching to the Magic Deck to see how its special cards change the game. Both decks include levels 1–10 in 4-player mode. For the full game, we're also working on in-game events with different challenges every two weeks and cosmetic rewards for completing them. We'll share the details when they're ready.","occurred_at":null,"published_at":"2026-10-23T17:01:00Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114037229","verified_at":"2026-10-23T20:55:00Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5015250-1846651706691436","game_id":"steam-5015250","kind":"announcement","title":"Hearts Extreme is in Steam Next Fest","summary":"Hearts Extreme is taking part in Steam Next Fest. It's a single-player card puzzle where everyone's hand is visible. Each level gives you a goal to work toward with the cards on the table. You don't need to know Hearts to start; the game introduces the rules as you play. The demo includes levels 1–10 of both the Base Deck and Magic Deck in 4-player mode. It's available on Windows and macOS. If something doesn't work or a rule is unclear, please let us know in the Steam discussions or through the","occurred_at":null,"published_at":"2026-10-19T17:00:55Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691436","verified_at":"2026-10-20T20:19:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5015250-1845383656392618","game_id":"steam-5015250","kind":"announcement","title":"Warm 'Cozy Day' Visual Redesign & Revamped Beginner Tutorial","summary":"Hello, Hearts Extreme community!With Steam Next Fest around the corner and our official launch on November 4th, we are thrilled to share the major improvements and updates we’ve developed over the past quarter.1. Complete Visual Redesign: Welcome to 'Cozy Day'• From Dark Neon to Warm Cozy: We’ve reimagined the entire visual aesthetic from a cold digital theme to \"Cozy Day\"—bringing the heartwarming, tactile feel of playing cards at a sunny wooden table. • Handcrafted Details: Experience 10 uniqu","occurred_at":null,"published_at":"2026-10-05T05:46:36Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656392618","verified_at":"2026-10-20T20:19:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5015250-1841579228664375","game_id":"steam-5015250","kind":"announcement","title":"Playtest access has gone out — check your Steam library","summary":"If you requested access to the Hearts Extreme Playtest, you have it now. Look for Hearts Extreme Playtest in your Steam library and hit install — it's about 112 MB.This is the full game, not a cut-down demo. All 10 decks, all 250 stages, the 4/5/6-player modes, and the Daily Challenge are open from the start. Your Daily Challenge runs count on the real global leaderboard.Two things worth knowing: playtest progress is saved separately from the full game, and Steam achievements don't unlock in thi","occurred_at":null,"published_at":"2026-08-20T04:58:51Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228664375","verified_at":"2026-10-20T20:19:16Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5015250":{"last_attempt_at":"2026-10-25T22:11:57Z","status":"ok","all_sources_checked_at":"2026-10-25T22:11:56Z","error_codes":[]}},"news_last_attempt_at":{"steam-5015250":"2026-10-25T22:11:57Z"},"notices":[],"news_sources":{"5015250":{"last_attempt_at":"2026-10-25T22:11:56Z","last_success_at":"2026-10-25T22:11:56Z","status":"ok","error_codes":[]},"5034530":{"last_attempt_at":"2026-10-25T22:11:57Z","last_success_at":"2026-10-25T22:11:57Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5015250","app_id":5015250,"app_scope":"base","observed_at":"2026-10-26T06:15:17Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"4f11c107583ee3ba14bdd9ee25d519fdf2ed3dd268a3df983faee8d6a211b718","response_sha256":null,"source_fields":{"basic_info":{"short_description":"고전 카드게임 하츠를 혼자 푸는 퍼즐로 다시 만들었습니다.\r\n레벨마다 달라지는 다양한 목표를 달성해 보세요.\r\n서로 다른 카드들로 구성되는 덱 10종을 4·5·6인 게임으로 플레이할 수 있습니다.\r\n또, 랭크 게임으로 전 세계 플레이어들과 경쟁할 수 있습니다.","publishers":[{"name":"Hwantastic Games","creator_clan_account_id":46245505}],"developers":[{"name":"Hwantastic Games","creator_clan_account_id":46245505}]},"release":{"steam_release_date":1793750400,"is_coming_soon":true,"coming_soon_display":"date_full"},"trailers":{"highlights":[{"trailer_name":"Hearts Extreme Teaser","trailer_url_format":"steam/apps/${FILENAME}?t=1788531512","trailer_category":0,"microtrailer":[{"filename":"5015250/1326695820/020b14ca5bc16023e2729e639013081c91281e23/1788524254/microtrailer.webm","type":"video/webm"},{"filename":"5015250/1326695820/020b14ca5bc16023e2729e639013081c91281e23/1788524254/microtrailer.mp4","type":"video/mp4"}],"adaptive_traile