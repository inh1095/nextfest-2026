/v1/","context":{"app_id":3404030,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-3404030","metric":"demo_ccu","observed_at":"2026-10-26T07:54:13Z","value":2,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4943040","error_code":null}],"events":[{"id":"steam-steam-3404030-1846651706689350","game_id":"steam-3404030","kind":"announcement","title":"Clogwork is participating in Steam Next Fest!","summary":"Steam Next FestLet's just hope that more people see this game and test the demo. Like always, more feedback is always welcomed.Controller supportController support has been improved. If you use controller please give me feedback here.Workshop (full game)Clogwork's full version now can handle custom figures made by players, and custom puzzles for the campaign. If you're thinking of good ideas that would be fun in the campaign, just make it and other people will play them.","occurred_at":null,"published_at":"2026-10-19T09:01:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706689350","verified_at":"2026-10-20T11:08:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3404030-1844115010498274","game_id":"steam-3404030","kind":"update","title":"Major update: Campaign mode and others","summary":"Clogwork just had a big update.Your voices have been heard, and the main thing players complained about was that the tutorial was terrible. People felt overwhelmed by all the choices at the start of the game and the tutorial didn't really do a good job at explaining it. So Clogwork now has a campaign mode. Some of the levels are just a way to show new machines for the player, or new uses for them. And then some others will be challenges. Most of the challenges will, however, be reserved for the ","occurred_at":null,"published_at":"2026-09-20T03:15:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010498274","verified_at":"2026-10-20T11:08:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3404030-1842846814444838","game_id":"steam-3404030","kind":"announcement","title":"Languages, Fixes, and Quality of Life","summary":"Game updateNewAll 17 supported languages from the steam page are now supported in-game.Steam Input API. Much better controller support.What is blocking this piece? feature on hovering over stuck pieces (toggle-able in settings).ImprovementsStick Navigation. Please leave feedback in the discussion thread. Particularly if you use a Steam Deck.Logic view rendering improvements.F4 - Forces visualisation is now more clear (it also shows you the belts below)Cable data visualisation on smaller screens.","occurred_at":null,"published_at":"2026-09-03T23:17:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814444838","verified_at":"2026-10-20T11:08:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3404030-1842212951314422","game_id":"steam-3404030","kind":"announcement","title":"Free CLOGWORK Demo is out now.","summary":"The demo is finally out. Go download it, build your factory, and if you enjoyed the demo, please add the full game to your wishlist. Adding it to your wishlist will notify you when the release is out or about other events. There is no time limit in this demo, and your objective is to build and deliver 3 target figures.A simple bar to get you started.A little chair.A house (this one will take you longer).Feedback Please drop your demo feedback in this community post. As a solo developer, I don't ","occurred_at":null,"published_at":"2026-09-01T18:32:54Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951314422","verified_at":"2026-10-20T11:08:38Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3404030":{"last_attempt_at":"2026-10-26T00:40:01Z","status":"ok","all_sources_checked_at":"2026-10-26T00:40:00Z","error_codes":[]}},"news_last_attempt_at":{"steam-3404030":"2026-10-26T00:40:01Z"},"notices":[],"news_sources":{"3404030":{"last_attempt_at":"2026-10-26T00:40:00Z","last_success_at":"2026-10-26T00:40:00Z","status":"ok","error_codes":[]},"4943040":{"last_attempt_at":"2026-10-26T00:40:01Z","last_success_at":"2026-10-26T00:40:01Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3404030","app_id":3404030,"app_scope":"base","observed_at":"2026-10-26T06:14:17Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"aee9a8ad578be58d35de47b308459671121b02ae0332e1b10cfa813be7023a44","response_sha256":null,"source_fields":{"basic_info":{"short_description":"CLOGWORK는 공장 자동화 게임입니다. 조각을 자르고 붙이고 회전시켜 필요한 도형을 만드세요. 컨베이어와 논리 회로를 구축하고, 막힘을 방지하며 완성된 도형을 코어로 보내세요. 2D로 건설하다가 언제든 3D로 전환할 수 있습니다.","publishers":[{"name":"Odd Sprout Games","creator_clan_account_id":46258277}],"developers":[{"name":"Odd Sprout Games","creator_clan_account_id":46258277}]},"release":{"steam_release_date":1794333600,"is_coming_soon":true,"coming_soon_display":"date_full"},"trailers":{"highlights":[{"trailer_name":"Clogwork Gameplay Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1792946750","trailer_category":1,"microtrailer":[{"filename":"3404030/1223957164/52a076a092cf62343dfda410af4b12b85914edcb/1792944673/microtrailer.webm","type":"video/webm"}