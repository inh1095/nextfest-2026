minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656388081","verified_at":"2026-10-20T21:40:43Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5081510-1842846814441975","game_id":"steam-5081510","kind":"announcement","title":"v0.504 Release!","summary":"Paint The World — v0.504Catch-up notes covering everything since v0.499. NewAim Lock (middle-click) - paint with a perfectly still camera. Move the mouse to slide a reticle around the screen instead of turning the view. Ideal if first-person movement makes you queasy. Steam Deck touch painting (experimental) - touch the screen to paint right where you point, and look around with the stick. Join our Discord - a link right on the title screen. Come share what you've painted and ideas for the game!","occurred_at":null,"published_at":"2026-09-03T02:12:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814441975","verified_at":"2026-10-20T21:40:43Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5081510":{"last_attempt_at":"2026-10-26T08:01:04Z","status":"ok","all_sources_checked_at":"2026-10-26T08:01:04Z","error_codes":[]}},"news_last_attempt_at":{"steam-5081510":"2026-10-26T08:01:04Z"},"notices":[],"news_sources":{"5081510":{"last_attempt_at":"2026-10-26T08:01:04Z","last_success_at":"2026-10-26T08:01:04Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:01:04Z"},"5110080":{"last_attempt_at":"2026-10-26T08:01:04Z","last_success_at":"2026-10-26T08:01:04Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:01:04Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5081510","app_id":5081510,"app_scope":"base","observed_at":"2026-10-26T06:15:24Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/"