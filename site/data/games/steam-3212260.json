rce_only"},{"id":"steam-steam-3212260-1794102528098649","game_id":"steam-3212260","kind":"announcement","title":"Something stirs on this island...","summary":"Hey everyone! Just a quick update to show what I’ve been working on. I realized that I should post something here from time to time, so people know that the game is actively being worked on!:) I have to be careful though, as not to spoil anything:) Not much to say—just some sights from the world. Make of them what you will;) 🏔️ An ominous mountain {STEAM_CLAN_IMAGE}/45204671/1755b63336d29cb4651597903549f98d0b88dcd1.png 🔥 The fire crackles, but no one is here {STEAM_CLAN_IMAGE}/45204671/1b6c9c801","occurred_at":null,"published_at":"2025-03-14T06:52:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1794102528098649","verified_at":"2026-10-20T10:47:17Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3212260":{"last_attempt_at":"2026-10-26T00:23:37Z","status":"ok","all_sources_checked_at":"2026-10-26T00:23:36Z","error_codes":[]}},"news_last_attempt_at":{"steam-3212260":"2026-10-26T00:23:37Z"},"notices":[],"news_sources":{"3212260":{"last_attempt_at":"2026-10-26T00:23:36Z","last_success_at":"2026-10-26T00:23:36Z","status":"ok","error_codes":[]},"3435410":{"last_attempt_at":"2026-10-26T00:23:37Z","last_success_at":"2026-10-26T00:23:37Z","status":"ok","error_codes":[]}}}
