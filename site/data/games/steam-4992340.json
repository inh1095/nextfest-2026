 by this relation","occurred_at":null,"published_at":"2026-08-17T11:14:12Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840944183785778","verified_at":"2026-10-20T19:56:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4992340-1840944183775380","game_id":"steam-4992340","kind":"announcement","title":"Steam page is now out!","summary":"Yay! Stack Factory steam page is up and running.Just a heads up, it took a few weeks to get the steam page sorted so the demo is a lil outdated, but the guts of it is all there. Some things to note: Tutorial: Tutorial is a bit of a pain point. It's something that I will rework once i have all of the game loops etc. established. But in saying that, it should be good enough to give you the general idea of how things work. Next update: The next update (another demo update) will have: A better wave ","occurred_at":null,"published_at":"2026-08-13T01:11:22Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840944183775380","verified_at":"2026-10-20T19:56:51Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4992340":{"last_attempt_at":"2026-10-26T05:56:21Z","status":"ok","all_sources_checked_at":"2026-10-26T05:56:20Z","error_codes":[]}},"news_last_attempt_at":{"steam-4992340":"2026-10-26T05:56:21Z"},"notices":[],"news_sources":{"4992340":{"last_attempt_at":"2026-10-26T05:56:20Z","last_success_at":"2026-10-26T05:56:20Z","status":"ok","error_codes":[]},"5039870":{"last_attempt_at":"2026-10-26T05:56:21Z","last_success_at":"2026-10-26T05:56:21Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4992340","app_id":4992340,"app_scope":"base","observed_at":"2026-10-26T06:15:15Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/