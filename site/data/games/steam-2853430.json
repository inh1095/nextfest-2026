a.akamaihd.net/news/externalpost/steam_community_announcements/1830797770234330","verified_at":"2026-10-20T10:24:46Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2853430-1829528821305273","game_id":"steam-2853430","kind":"announcement","title":"Meet Naya Coldbrook!","summary":"{STEAM_CLAN_IMAGE}/44972966/cf032ce849eb382e66fc300c7f28db8e9df95f48.png Naya Coldbrook's skill, talent, and determination have earned her the praise of Headmaster Ambrose himself. 🔮 Ancient incantations, obscure alchemy, rare manuscripts... she knows it all. A good study partner, if you can keep up with her!","occurred_at":null,"published_at":"2026-04-08T22:01:00Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1829528821305273","verified_at":"2026-10-20T10:24:46Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2853430-1827626365769082","game_id":"steam-2853430","kind":"announcement","title":"Take a peek inside the Death School!","summary":"{STEAM_CLAN_IMAGE}/44972966/34b27a4fb6f3ada72195c5db50215dd8caa9aff8.jpg Think you can survive a lesson in the Death School? 💀 Wizard101 players can’t attend one of Professor Malistaire Drake’s lectures in the Death School. But YOU can. Caution: his pop quizzes are evil...","occurred_at":null,"published_at":"2026-03-25T21:30:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1827626365769082","verified_at":"2026-10-20T10:24:46Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2853430-1826992588591106","game_id":"steam-2853430","kind":"announcement","title":"Meet Dalia Falmea!","summary":"{STEAM_CLAN_IMAGE}/44972966/b5617f41b0c3efc4d31791cf6ad5b5701683fe86.png She'll be the Professor of Fire Magic at the Ravenwood School of Magical Arts... someday. 🔥 Right now, Dalia Falmea'