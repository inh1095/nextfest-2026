":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833968530885031","verified_at":"2026-10-20T13:21:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4261080-1833334318565591","game_id":"steam-4261080","kind":"announcement","title":"Playtest Now Live — Welcome to Try the Game!","summary":"Hello everyone, I’m Chubby Meow, the developer of Expedition of the Guild.Thank you all so much for your continued support and interest in Expedition of the Guild! Today, I’m excited to announce that the Steam store page for Expedition of the Guild is officially live! At the same time, the Playtest is now available, and everyone is welcome to jump in and try it out! This playtest includes 3 dungeons, with the max character level capped at 6.Whether you’ve been following the game for a long time ","occurred_at":null,"published_at":"2026-05-20T07:35:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318565591","verified_at":"2026-10-20T13:21:30Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4261080":{"last_attempt_at":"2026-10-26T01:50:51Z","status":"ok","all_sources_checked_at":"2026-10-26T01:50:51Z","error_codes":[]}},"news_last_attempt_at":{"steam-4261080":"2026-10-26T01:50:51Z"},"notices":[],"news_sources":{"4261080":{"last_attempt_at":"2026-10-26T01:50:51Z","last_success_at":"2026-10-26T01:50:51Z","status":"ok","error_codes":[]},"4817140":{"last_attempt_at":"2026-10-26T01:50:51Z","last_success_at":"2026-10-26T01:50:51Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4261080","app_id":4261080,"app_scope":"base","observed_at":"2026-10-26T06:14:31Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"s