_only"},{"id":"steam-steam-4481330-1838407329253584","game_id":"steam-4481330","kind":"announcement","title":"Frankenmine Demo is on the way!","summary":"Hi everyone! I'm excited to share that the Frankenmine Demo is almost ready and will be arriving on Steam in the coming days!Over the past weeks, I've been polishing the game, improving core mechanics, fixing bugs, and making sure the first experience is as enjoyable as possible. I can't wait for you to step into the graveyard, start digging and begin assembling your very own creature. I'd Love Your FeedbackOnce the demo is live, I'd love to hear what you think. Your feedback will help me improv","occurred_at":null,"published_at":"2026-07-15T08:32:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1838407329253584","verified_at":"2026-10-20T14:28:07Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4481330":{"last_attempt_at":"2026-10-26T12:31:20Z","status":"ok","all_sources_checked_at":"2026-10-26T12:31:20Z","error_codes":[]}},"news_last_attempt_at":{"steam-4481330":"2026-10-26T12:31:20Z"},"notices":[],"news_sources":{"4481330":{"last_attempt_at":"2026-10-26T12:31:20Z","last_success_at":"2026-10-26T12:31:20Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T12:31:20Z"},"4973850":{"last_attempt_at":"2026-10-26T12:31:20Z","last_success_at":"2026-10-26T12:31:20Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T12:31:20Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4481330","app_id":4481330,"app_scope":"base","observed_at":"2026-10-26T06:14:37Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"e5f3c8dd64d5394656d7593dcdaf738258b39448a33aa606992d480382837aeb","r