/v1/","context":{"app_id":4874380,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4874380-1846651706694823","game_id":"steam-4874380","kind":"announcement","title":"Idle Camp Tale at Steam Next Fest — Try the Free Demo!","summary":"Hi everyone! Steam Next Fest is here, and the free demo of Idle Camp Tale is available to play. The demo includes the complete first chapter. Recruit heroes, choose their skills and equipment, and take on stages to find loot and strengthen your party through forging. Your heroes fight automatically while the game is running, so you can return to sort your gear, adjust your lineup, and take on the next challenge. Based on feedback from earlier players, we've made improvements to parts of the game","occurred_at":null,"published_at":"2026-10-20T11:15:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706694823","verified_at":"2026-10-20T18:05:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4874380-1844751498218292","game_id":"steam-4874380","kind":"announcement","title":"Dev Log #2: Climb the 100-Floor Babel Tower","summary":"Hi everyone, The free demo covers Chapter 1. Today I want to talk about something that unlocks after you finish all five main chapters in the full game: the Babel Tower. The tower has 100 floors, and every floor is a boss fight. On regular floors, you'll face 3–4 randomly selected bosses from the same chapter. Every tenth floor is a milestone battle against one giant boss. As you climb, enemies get stronger, and the gear and crafting materials you earn get better too. {STEAM_CLAN_IMAGE}/46178721","occurred_at":null,"published_at":"2026-09-23T12:30:31Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498218292","verified_at":"2026-10-20T18:05:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4874380-1842212951303340","game_id":"steam-4874380","kind":"announcement","title":"Free Demo Available Now: The Complete First Chapter, in 9 Languages","summary":"Adventurers passing by the camp,The free demo of Idle Camp Tale is now available to download — come sit by the fire. The demo includes the complete first chapter:🏕️ Build your camp Upgrade buildings, unlock features, and watch your outpost take shape.⚔️ Recruit heroes and gear them up Experiment with skills, equipment, and forging — even Chapter 1 gives you plenty of affixes to build around.⏳ Experience online idle progression Leave the game running while you do other things; your heroes fight a","occurred_at":null,"published_at":"2026-08-28T14:05:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951303340","verified_at":"2026-10-20T18:05:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4874380-1838407329256896","game_id":"steam-4874380","kind":"announcement","title":"Dev Log #1: Camp & Conquer Enters Full Polish & Optimization, 9 Languages Ready","summary":"Adventurers passing by the camp,This is the first dev log for Camp & Conquer — an idle RPG where you build your camp, recruit heroes, forge gear, and then leave the game running on the side while you get on with whatever you're doing: your heroes fight and push forward on their own, and by the time you come back to the screen, the loot and battle reports are waiting for you.Status report:🔧 Full polish & optimization phase Right now the work is about exactly one thing: making the game smoother an","occurred_at":null,"published_at":"2026-07-16T14:49:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1838407329256896","verified_at":"2026-10-20T18:05:06Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4874380":{"last_attempt_at":"2026-10-26T04:48:58Z","status":"ok","all_sources_checked_at":"2026-10-26T04:48:57Z","error_codes":[]}},"news_last_attempt_at":{"steam-4874380":"2026-10-26T04:48:58Z"},"notices":[],"news_sources":{"4874380":{"last_attempt_at":"2026-10-26T04:48:57Z","last_success_at":"2026-10-26T04:48:57Z","status":"ok","error_codes":[]},"4877360":{"last_attempt_at":"2026-10-26T04:48:58Z","last_success_at":"2026-10-26T04:48:58Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4874380","app_id":4874380,"app_scope":"base","observed_at":"2026-10-26T06:15:04Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"26d9d2155f69082f2125f60023fa9e81e74f7b90c45caab7f89c8dd2dbc37dbb","response_sha256":null,"source_fields":{"basic_info":{"short_description":"판타지 방치형 RPG. 캠프를 경영하고 영웅을 모아 자동 전투에 맡기세요. 매 전투마다 장비와 재료를 파밍하고 강화·인챈트·접사 커스터마이즈로 나만의 강력한 장비를 벼려내며 변경을 한 스테이지씩 정복하세요!","publishers":[{"name":"Maple Leaf","creator_clan_account_id":46601524}],"developers":[{"name":"Maple Leaf","creator_clan_account_id":46601524}]},"release":{"steam_release_date":1794227400,"is_coming_soon":true,"coming_soon_display":"date_full"},"trailers":{"highlights":[{"trailer_name":"Idle Camp Tale","trailer_url_format":"steam/apps/${FILENAME}?t=1785181301","trailer_category":1,"microtrailer":[{"filename":"4874380/1454951882/3e5ae98a0210e3931bcfb0e565c30a6178204463/1785181165/microtrailer.webm","type":"video/webm"},{"filename":"4874380/1454951882/3e5ae98a0210e3931bcfb0e565c30a6178204463/1785181165/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[