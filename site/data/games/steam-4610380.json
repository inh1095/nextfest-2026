/v1/","context":{"app_id":4610380,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4610380-1846651706686976","game_id":"steam-4610380","kind":"update","title":"Feather Rogue Demo 0.3.1: Big Update Before Next Fest","summary":"Our biggest demo update so far, shaped by your feedback and our own playtests. This post covers everything since 0.2.1. Thanks for playing! Highlights Choose Relaxed or Veteran before each run. Relaxed is easier and great for your first runs. See what every enemy is planning, where it can hit you and which tiles are safe. Hold Alt (L3 on gamepad) to see the danger zones across the whole arena. Card upgrades now change how a card plays. Each card gains a new rule at 2 stars and another at 3 stars","occurred_at":null,"published_at":"2026-10-18T13:31:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706686976","verified_at":"2026-10-20T15:13:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4610380-1846018067945085","game_id":"steam-4610380","kind":"update","title":"Feather Rogue Demo: Major Update Is Live!","summary":"The demo you played is gone. This one hits harder.Since Demo v1 launched, we've been listening to every comment, every bug report and every \"wait, that combo did WHAT?\" moment. Then we went back to work.Today, the Feather Rogue demo receives its biggest update yet. This isn't a patch. It's a major overhaul that touches almost every part of the game, from how the world looks to how every fight feels.If you tried the demo before, now is the perfect time to jump back in. If you haven't, there's nev","occurred_at":null,"published_at":"2026-10-13T19:04:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067945085","verified_at":"2026-10-20T15:13:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4610380-1834602721185587","game_id":"steam-4610380","kind":"announcement","title":"Demo v1 is Live — and This Is Just the Beginning","summary":"The first playable demo of Feather Rogue is out now!Build a deck of elemental cards, stack conditions on a tactical grid, and trigger chain reactions that cascade across the whole board in a single turn. No reflexes just you, the grid, and the perfect sequence waiting to be found.This is Demo v1, an early slice of the full game. I'm actively building and more demo updates are on the way: new cards, more elemental reactions, balance passes, and quality of life improvements based on your feedback.","occurred_at":null,"published_at":"2026-06-03T18:11:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1834602721185587","verified_at":"2026-10-20T15:13:41Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4610380":{"last_attempt_at":"2026-10-26T03:15:06Z","status":"ok","all_sources_checked_at":"2026-10-26T03:15:05Z","error_codes":[]}},"news_last_attempt_at":{"steam-4610380":"2026-10-26T03:15:06Z"},"notices":[],"news_sources":{"4610380":{"last_attempt_at":"2026-10-26T03:15:05Z","last_success_at":"2026-10-26T03:15:05Z","status":"ok","error_codes":[]},"4672500":{"last_attempt_at":"2026-10-26T03:15:06Z","last_success_at":"2026-10-26T03:15:06Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4610380","app_id":4610380,"app_scope":"base","observed_at":"2026-10-26T06:14:42Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"st