ms/v1/","context":{"app_id":4529770,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4529770-1846651706682793","game_id":"steam-4529770","kind":"announcement","title":"One More Flight Demo Is LIVE!","summary":"The One More Flight demo is LIVE!Play now for free and let us know what you think. Your feedback helps our two-person team improve the game!Enjoyed the demo? Wishlist the full game to support us!","occurred_at":null,"published_at":"2026-10-16T18:51:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706682793","verified_at":"2026-10-20T14:49:34Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4529770-1846651706679132","game_id":"steam-4529770","kind":"announcement","title":"One More Flight Demo Lands Tomorrow!","summary":"The One More Flight demo goes live tomorrow, October 16!Step aboard a flight trapped in a time loop, where psychological horror meets dark comedy. Talk to the passengers, solve puzzles, and discover how your choices can change the fate of everyone aboard.Each death teaches you something. Can you break the loop?We're also joining Steam Next Fest, October 19–26! You can try the demo early tomorrow and keep exploring throughout the festival.We're a two-person indie team, and we're excited to finall","occurred_at":null,"published_at":"2026-10-15T19:54:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706679132","verified_at":"2026-10-20T14:49:34Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4529770-1845383656383100","game_id":"steam-4529770","kind":"announcement","title":"1,000 Wishlists! Thank You for Joining Us Onboard","summary":"One More Flight has reached 1,000 wishlists!We're a two-person indie team, and seeing this many people interested in our strange, terrifying flight means so much to us.To everyone who wishlisted the game, shared our trailer, told a friend, or sent us a kind message: thank you. You've helped more people discover One More Flight and given us a huge boost as we prepare the demo.A special thank you to Next Indie and Indie Games Hub for sharing our trailer and helping it reach so many new passengers!","occurred_at":null,"published_at":"2026-10-01T17:18:20Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656383100","verified_at":"2026-10-20T14:49:34Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4529770-1844751498218813","game_id":"steam-4529770","kind":"announcement","title":"Help Translate One More Flight!","summary":"We’re looking for community volunteers to help translate One More Flight into Spanish, Korean, Japanese, and Portuguese! We’ve already found someone to help with Russian—thank you!There’s very little text to translate. We’ll send over the final English text by October 1, leaving about 15 days before the demo launches on October 16.If you’d like to help, email us at nyrointeractive@gmail.com or leave a comment below and we can talk through the details. ❤️","occurred_at":null,"published_at":"2026-09-23T15:35:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498218813","verified_at":"2026-10-20T14:49:34Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4529770":{"last_attempt_at":"2026-10-26T02:52:34Z","status":"ok","all_sources_checked_at":"2026-10-26T02:52:33Z","error_codes":[]}},"news_last_attempt_at":{"steam-4529770":"2026-10-26T02:52:34Z"},"noti