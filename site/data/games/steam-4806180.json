ems/v1/","context":{"app_id":4806180,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4806180","metric":"demo_ccu","observed_at":"2026-10-26T09:49:30Z","value":3,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5197870","error_code":null}],"events":[{"id":"steam-steam-4806180-1844751498222064","game_id":"steam-4806180","kind":"announcement","title":"Imperium is now available in Simplified Chinese, Japanese and Russian","summary":"Hey everyone, Imperium now supports Simplified Chinese, Japanese and Russian, and so does the free demo. It's the whole game, not just the menus: the interface, the tutorial, the Codex, species lore and every tech, building and ship component description. Star names and AI ship names are translated too. Chinese and Japanese come with their own fonts, so the text renders properly on Windows, Mac and Linux. Choosing your languageImperium picks up your system language on first launch. To change it,","occurred_at":null,"published_at":"2026-09-24T16:21:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498222064","verified_at":"2026-10-20T17:25:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4806180-1844115010495980","game_id":"steam-4806180","kind":"announcement","title":"The Imperium demo is live!","summary":"The free demo is up on Steam right now, ahead of Next Fest.What's in it: a small galaxy, 3 AI opponents to out-build or out-fight, and three playable species (Veylilith, Throk, Zyyth Azr) to start your empire with. It's capped at year 1500 so you can see a full early-to-mid game arc without a Q4 launch spoiling itself.The full game underneath is 21 playable species, ships built component-by-component across 5 hull classes, a 68-tech web, and diplomacy that runs as a real economy - embassies, esp","occurred_at":null,"published_at":"2026-09-18T20:28:13Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010495980","verified_at":"2026-10-20T17:25:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4806180-1840944183774006","game_id":"steam-4806180","kind":"announcement","title":"Announcement Trailer & See You at Steam Next Fest in October","summary":"Imperium is a single-player 4X space strategy game: colonize alien worlds, design your fleets component by component, research exotic technologies, and outmaneuver rival empires through diplomacy or war. Every game generates a new galaxy - and a new empire to call your own.🎬 Watch the trailer on the store page above, or on YouTube.🚀 What's next:October 19–26 - Steam Next Fest: free playable demo, and I'll be around all week for feedback and questionsFull release - coming shortly after the fest. ","occurred_at":null,"published_at":"2026-08-12T13:34:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840944183774006","verified_at":"2026-10-20T17:25:36Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4806180":{"last_attempt_at":"2026-10-26T04:25:29Z","status":"ok","all_sources_checked_at":"2026-10-26T04:25:29Z","error_codes":[]}},"news_last_attempt_at":{"steam-4806180":"2026-10-26T04:25:29Z"},"notices":[],"news_sources":{"4806180":{"last_attempt_at":"2026-10-26T04:25:29Z","last_success_at":"2026-10-26T04:25:29Z","status":"ok","error_codes":[]},"5197870":{"last_attempt_at":"2026-10-26T04:25:29Z","last_success_at":"2026-10-26T04:25:29Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-48