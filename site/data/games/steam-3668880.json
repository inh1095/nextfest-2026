"value":2,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4347450","error_code":null}],"events":[{"id":"steam-steam-3668880-1839041357025887","game_id":"steam-3668880","kind":"announcement","title":"CONTAMINANT DEMO IS LIVE","summary":"REALITY HAS A GLITCH. YOU ARE THE PATCH. CONTAMINANT demo is now live on Steam — and it's not just a slice of gameplay. It's a standalone prologue designed to throw you headfirst into the rotting heart of Dal and let you taste the tension of a world held together by rust and radio waves. We want to hear from you — the survivors, the theorists, the ones who dig through every note and dare to open every locked door. Drop your thoughts, bug reports, and wildest theories here: 📋 Feedback form: https","occurred_at":null,"published_at":"2026-07-23T06:50:18Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839041357025887","verified_at":"2026-10-20T11:31:26Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3668880-1806698490846839","game_id":"steam-3668880","kind":"announcement","title":"Looking for CONTAMINANT Playtesters!","summary":"Looking for Test Subjects!CONTAMINANT is entering its next phase - and you're invited to witness it firsthand.We're launching a closed playtest soon to let players like you descend into the unknown and help us refine the horror that lurks below. The build will be Free-to-Play and will only require you to sign up via a Google Form and to join our Discord for the playtester role.Want to be part of the playtest? Follow the steps below!Sign up for the CONTAMINANT Playtest using the Google Form below","occurred_at":null,"published_at":"2025-08-05T14:53:00Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1806698490846839","verified_at":"2026-10-20T11:31:26Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3668880-1806064758652170","game_id":"steam-3668880","kind":"announcement","title":"Transmission 0.02 - Behind The Horror: Motion Capture in CONTAMINANT","summary":"Motion Capture in focus.In CONTAMINANT, motion capture is important to creating immersive horror, using authentic character movement as a key storytelling tool.This devlog offers a deeper dive into how mocap shapes the game’s eerie atmosphere and emotional, physical storytelling.The Value - Motion Capture in CONTAMINANTThe player's emotion relies on the characters' movements and reactions, and how convincing they're for them. Translating real human performances into the game makes it more possib","occurred_at":null,"published_at":"2025-07-25T19:41:02Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1806064758652170","verified_at":"2026-10-20T11:31:26Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3668880-1800991756415591","game_id":"steam-3668880","kind":"announcement","title":"Transmission 0.01 - Welcome to CONTAMINANT","summary":"{STEAM_CLAN_IMAGE}/45640073/e4cebae1972deb39c39c380b77906f41df8bdfc4.png Welcome to CONTAMINANT. It begins here. This is the first of many “transmissions” from the team behind CONTAMINANT, our surreal, story-driven horror adventure that dares to unravel the seams of reality. If you've seen our early stuff, you already know we’re not aiming for your usual haunted house. We're crafting a descent into madness, memory, and the unknown. In this devlog, we’ll reveal our creative visions, the inner wor","occurred_at":null,"published_at":"2025-06-01T18:28:26Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1800991756415591","verified_at":"2026-10-20T11:31:26Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3668880-1800991756353271","game_id":"steam-3668880","kind":"announcement","title":"Watch the New Teaser Trailer Tomorrow!","summary":"{STEAM_CLAN_IMAGE}/45640073/d9f941dcf42d4294f0f877ec21c16b86c8d12ac1.png CONTAMINANT’s New Trailer will have its World Premiere at the Horror Game Awards 2025’s Summer Showcase! Celebrate this monumental event with us! May 31st, 2025 Saturday @ 11:00 AM PDT / 2 PM EDT / 7 PM BST Stay tuned for more updates! Be notified about any updates on Steam by adding CONTAMINANT to your wishlist! FOLLOW CONTAMINANT You don’t have to enter the decaying world of CONTAMINANT alone. Become part of a community h","occurred_at":null,"published_at":"2025-05-30T19:06:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1800991756353271","verified_at":"2026-10-20T11:31:26Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3668880":{"last_attempt_at":"2026-10-26T10:41:06Z","status":"ok","all_sources_checked_at":"2026-10-26T10:41:05Z","error_codes":[]}},"news_last_attempt_at":{"steam-3668880":"2026-10-26T10:41:06Z"},"notices":[],"news_sources":{"3668880":{"last_attempt_at":"2026-10-26T10:41:05Z","last_success_at":"2026-10-26T10:41:05Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T10:41:05Z"},"4347450":{"last_attempt_at":"2026-10-26T10:41:06Z","last_success_at":"2026-10-26T10:41:06Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T10:41:06Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3668880","app_id":3668880,"app_scope":"base","observed_at":"2026-10-26T06:14:19Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"a8af218e43e99d7b5d52af6ec272502174fbc55307c85