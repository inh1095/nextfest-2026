rl":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114030473","verified_at":"2026-10-22T02:43:09Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5176020-1846651706695898","game_id":"steam-5176020","kind":"update","title":"Demo update: Windows title screen fixed","summary":"If the Veil of Time demo opened on a black title screen for you on Windows, sorry about that. It's fixed.Steam updates the demo automatically, so just relaunch it and you'll land on the menu.Thanks for giving it a try.","occurred_at":null,"published_at":"2026-10-20T16:10:14Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706695898","verified_at":"2026-10-20T23:54:23Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5176020-1846651706693064","game_id":"steam-5176020","kind":"announcement","title":"Veil of Time demo, live during Next Fest","summary":"We are streaming the Veil of Time demo on this page during Steam Next Fest: the clock tower fight, a tavern brawl and the forest battles, with parries and timed strikes. The demo is free, so you can play it right now. Full game Nov 19.","occurred_at":null,"published_at":"2026-10-19T23:22:54Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706693064","verified_at":"2026-10-20T23:54:23Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5176020-1846651706692122","game_id":"steam-5176020","kind":"announcement","title":"The Veil of Time demo is out now for Steam Next Fest","summary":"The Veil of Time demo is live on Steam for Next Fest. Raine is summoned to Castra Castle, where his uncle Gale hands him the family sword and a knight's writ. From there the quest board opens up, and the demo's main job is the bounty on the Wild Fernigus.Combat starts out on the map. When a hunter winds up a strike, swing into the flash and you parry it. If the swing connects, the fight goes turn-based, and there you time your strikes on the ring for a PERFECT hit.There are four difficulty level","occurred_at":null,"published_at":"2026-10-19T18:20:38Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706692122","verified_at":"2026-10-20T23:54:23Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5176020":{"last_attempt_at":"2026-10-26T09:08:55Z","status":"ok","all_sources_checked_at":"2026-10-26T09:08:55Z","error_codes":[]}},"news_last_attempt_at":{"steam-5176020":"2026-10-26T09:08:55Z"},"notices":[],"news_sources":{"5176020":{"last_attempt_at":"2026-10-26T09:08:55Z","last_success_at":"2026-10-26T09:08:55Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:08:55Z"},"5402400":{"last_attempt_at":"2026-10-26T09:08:55Z","last_success_at":"2026-10-26T09:08:55Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:08:55Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5176020","app_id":5176020,"app_scope":"base","observed_at":"2026-10-26T06:15:39Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"ed874ef8fa5cd6742aa664cdbb410d1978fa04d4e77f2b4a461bb32d8c4806a2","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Raine's brother is missing, and his uncle has handed him the family sword. Fight in real time on the field, where a perfect parry drops the world to pencil, or let foes close in for turn-based battles with timed strikes. A JRPG with hand-painted maps, a 32-track score and optional voices.","publishers":[{"name":"Quorum","cr