y're easier to read and nicer to press. Paper panels. The top bar and windows like Foraging, the RAX and the end of year report now have a vintage paper feel.A meadow under the hive. The flat yellow background is gone. There's a nice subtle te","occurred_at":null,"published_at":"2026-10-23T16:01:13Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114036998","verified_at":"2026-10-23T19:47:23Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4864810":{"last_attempt_at":"2026-10-26T14:52:43Z","status":"ok","all_sources_checked_at":"2026-10-26T14:52:42Z","error_codes":[]}},"news_last_attempt_at":{"steam-4864810":"2026-10-26T14:52:43Z"},"notices":[],"news_sources":{"4864810":{"last_attempt_at":"2026-10-26T14:52:42Z","last_success_at":"2026-10-26T14:52:42Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:52:42Z"},"4970170":{"last_attempt_at":"2026-10-26T14:52:43Z","last_success_at":"2026-10-26T14:52:43Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:52:43Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4864810","app_id":4864810,"app_scope":"base","observed_at":"2026-10-26T06:15:03Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"fde3e55df42281e7d35e82a3a9ec699d6e4280f169f86cbbc10105ef6b502246","response_sha256":null,"source_fields":{"basic_info":{"short_description":"로그라이크 콜로니 시뮬레이션에서 벌집을 짓고 살아남으세요. 일벌을 부화시키고 꽃꿀을 채집해, 지독하게 현실적인 시장에서 꿀을 최고가에 파세요. 벌집의 기후를 관리하고 말벌의 습격을 막아 내지 못하면 군락은 무너집니다. 벌집을 정복하고 당신만의 꿀 제국을 세우세요.\r\n","publishers":[{"name":"Studio42"}],"developers":[{"name":"Studio42"}]},"release":{"steam_release_date":1794222000,"is_coming_soon":true,"coming_soon_display":"date_full"},"trailers":{"h