시뮬레이션입니다. 수유, 수면, 기저귀 교체, 놀이를 자동화하고 센서와 분기 게이트를 활용해 수많은 아기의 일상을 효율적으로 관리하세요. 월령이 높아지면 필요한 돌봄도 달라지고, 어제까지 안정적으로 돌아가던 라인에도 개조가 필요해집니다. 그리고 점차 드러나는 아기 한 명 한 명의 서로 다른 반응. 효율을 유지하면서 그 차이에 어디까지 대응할 수 있을까요? 아기들의 ‘첫 1년’을 맡아 돌보는, 조금은 기묘한 근미래의 육아 시설을 운영하세요.","publishers":[{"name":"Dayveil Games"}],"developers":[{"name":"岡部　正孝 (Okabe Masataka)"}]},"release":{"steam_release_date":1803801600,"is_coming_soon":true,"coming_soon_display":"date_month"},"trailers":{"highlights":[{"trailer_name":"Official Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1790654243","trailer_category":3,"microtrailer":[{"filename":"5187610/895337972/ef5b37de517b2b7017e66afb55f23b8856fbd85b/1790649767/microtrailer.webm","type":"video/webm"},{"filename":"5187610/895337972/ef5b37de517b2b7017e66afb55f23b8856fbd85b/1790649767/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"5187610/895337972/ef5b37de517b2b7017e66afb55f23b8856fbd85b/1790649767/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"5187610/895337972/ef5b37de517b2b7017e66afb55f23b8856fbd85b/1790649767/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"5187610/895337972/ef5b37de517b2b7017e66afb55f23b8856fbd85b/1790649767/hls_264_master.m3u8","encoding":"hls_h264"}],"screenshot_medium":"257422398/c2d1379ce116e91ea14bf39431c8b0cab19b0cd7/movie_600x337.jpg","screenshot_full":"257422398/c2d1379ce116e91ea14bf39431c8b0cab19b0cd7/movie_full.jpg","trailer_base_id":1324462,"all_ages":true}]}},"field_present":{"basic_info":true,"release":true,"trailers":true},"field_status":{"basic_info":"ok","release":"ok","trailers":"ok"},"field_errors":{},"developers":["岡部　正孝 (Okabe Masataka)"],"publishers":["Dayveil Games"],"release":{"steam_release_date":1803801600,"is_coming_soon":true,"coming_soon_display":"date_month"},"trailers":{"highlights":[{"trailer_name":"Official Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1790654243","trailer_category":3,"microtrailer":[{"filename":"5187610/895337972/ef5b37de517b2b7017e66afb55f23b885