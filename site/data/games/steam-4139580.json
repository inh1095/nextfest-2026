er goes against orders ","occurred_at":null,"published_at":"2026-09-15T03:30:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262703487","verified_at":"2026-10-20T12:57:25Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4139580-1842846814443818","game_id":"steam-4139580","kind":"announcement","title":"Introducing CygamesEdge","summary":"CygamesEdge is a new brand under Cygames dedicated to empowering small and mid-sized teams filled with innovative ideas and the drive to bring groundbreaking experiences to players everywhere. Under the tagline \"Stay on the edge,\" CygamesEdge draws on the game development expertise Cygames has cultivated over the years, channeling it into innovative titles built on strong core mechanics and state-of-the-art technology. The brand's debut title, Where the Seeds Fall, will launch on November 5, 202","occurred_at":null,"published_at":"2026-09-03T15:55:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814443818","verified_at":"2026-10-20T12:57:25Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4139580":{"last_attempt_at":"2026-10-26T01:46:41Z","status":"ok","all_sources_checked_at":"2026-10-26T01:46:41Z","error_codes":[]}},"news_last_attempt_at":{"steam-4139580":"2026-10-26T01:46:41Z"},"notices":[],"news_sources":{"4139580":{"last_attempt_at":"2026-10-26T01:46:41Z","last_success_at":"2026-10-26T01:46:41Z","status":"ok","error_codes":[]},"5024030":{"last_attempt_at":"2026-10-26T01:46:41Z","last_success_at":"2026-10-26T01:46:41Z","status":"ok","error_codes":[]}}}
