o is in its polishing stage at the moment being tested and tweaked - all is going well so far! It will keep its October 16th 2026 release date. Soon enough it will have its own page, separate from the main page, so players can leave ","occurred_at":null,"published_at":"2026-08-30T15:33:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951307796","verified_at":"2026-10-20T20:17:02Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4997610":{"last_attempt_at":"2026-10-25T22:09:42Z","status":"ok","all_sources_checked_at":"2026-10-25T22:09:41Z","error_codes":[]}},"news_last_attempt_at":{"steam-4997610":"2026-10-25T22:09:42Z"},"notices":[],"news_sources":{"4997610":{"last_attempt_at":"2026-10-25T22:09:41Z","last_success_at":"2026-10-25T22:09:41Z","status":"ok","error_codes":[]},"4997900":{"last_attempt_at":"2026-10-25T22:09:42Z","last_success_at":"2026-10-25T22:09:42Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4997610","app_id":4997610,"app_scope":"base","observed_at":"2026-10-26T06:15:15Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"4dae0f4f5f37871ef676a6401ba93cd8d1a0b778ca7fa23e7560bfe834529b7d","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Embark as Blaise Vaelthorne, the 35th Duke of Caerwyn and Warden of the White City, on a harrowing journey to reclaim the Phoenix Throne from the daemon host. Endure betrayal, suffering, and impossible odds as you fight to restore your dukedom’s destiny. By Right. By Blood.","publishers":[{"name":"SaltieSaltieProductions"}],"developers":[{"name":"SaltieSaltieProductions"}]},"release":{"is_coming_soon":true,"custom_release_date_message":"발표 예정",