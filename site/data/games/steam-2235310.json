"value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5280390","error_code":null}],"events":[{"id":"steam-steam-2235310-1846651706692435","game_id":"steam-2235310","kind":"announcement","title":"PatchWorld Demo is LIVE for Steam Next Fest!","summary":"The amazing creative universe that is PatchWorld is now available on Steam as a free demo! The demo will feature a lot (but not all) of PatchWorld’s core systems, like building unique machines and creating amazing music. Features such as cross-platform interaction and multiple world-building will be available in the full Steam edition, coming later in 2026. Check out the Steam Demo: Happy Patching!","occurred_at":null,"published_at":"2026-10-19T19:26:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706692435","verified_at":"2026-10-20T10:02:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2235310-1846651706691901","game_id":"steam-2235310","kind":"announcement","title":"PatchWorld LIVE at Steam Next Fest","summary":"PatchWorld is LIVE during Steam Next Fest! Join us throughout the festival for live creator sessions, performances, workshops, world tours and community jams inside PatchWorld. We’ll be exploring everything from playing music and instrument building to patching, physics, logic, world creation and just experiences live shows and creation from the community! Check our calendar for the next events!https://portal.patchxr.io/calendar Expect sessions including:• Live music and audiovisual performances","occurred_at":null,"published_at":"2026-10-19T17:46:02Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691901","verified_at":"2026-10-20T10:02:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2235310-1835236783566781","game_id":"steam-2235310","kind":"announcement","title":"Community Spotlight: Leo, PatchWorld’s Skeleton Inventor","summary":"Meet Leonardo Björk, one of those PatchWorld creators who, despite showing up as a skeleton, makes the whole platform feel alive.If you have watched our YouTube channel or spent time in PatchWorld on standalone VR, you may have already seen him: the quiet skeleton avatar building something strange, funny, playful, and interactive somewhere in the corner.Leo builds toys, vehicles, musical machines, games, rideable trains, remote-controlled UFOs, catapults, interactive bombs, hose guns, spear guns","occurred_at":null,"published_at":"2026-06-13T22:26:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1835236783566781","verified_at":"2026-10-20T10:02:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2235310-1832700592798946","game_id":"steam-2235310","kind":"announcement","title":"PatchWorld is Coming to Steam Early Access","summary":"PatchWorld is coming to Steam Early Access, bringing our multiplayer music-making universe to PC VR and desktop. This is an important new chapter for us. Over the past years, we have been building PatchWorld on standalone VR headsets with a small but incredibly creative community of patchers. What started as a single-player VR music app has grown into a living creative ecosystem: a place where people make music together, build instruments, create audiovisual worlds, perform live, teach, learn, a","occurred_at":null,"published_at":"2026-05-18T16:12:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1832700592798946","verified_at":"2026-10-20T10:02:16Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-2235310":{"last_attempt_at":"2026-10-26T09:52:48Z","status":"ok","all_sources_checked_at":"2026-10-26T09:52:48Z","error_codes":[]}},"news_last_attempt_at":{"steam-2235310":"2026-10-26T09:52:48Z"},"notices":[],"news_sources":{"2235310":{"last_attempt_at":"2026-10-26T09:52:48Z","last_success_at":"2026-10-26T09:52:48Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:52:48Z"},"5280390":{"last_attempt_at":"2026-10-26T09:52:48Z","last_success_at":"2026-10-26T09:52:48Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:52:48Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-2235310","app_id":2235310,"app_scope":"base","observed_at":"2026-10-26T06:14:08Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"3b9080766c359b62bf3bc572810d0ef2b6042b54f8750fe81fbb465aa2d854a1","response_sha256":null,"source_fields":{"basic_info":{"short_description":"음악, 예술, 창의성이 살아 숨 쉬는 ‘패치월드(PatchWorld)’에서 상상력을 마음껏 펼쳐보세요. 논리, 물리학, 직관적인 빌딩 블록을 활용해 수많은 세계를 창조하고, 공유하며, 탐험해 보세요. 혼자서든 친구들과 함께든, 여러분의 아이디어를 현실로 구현하거나 커뮤니티의 아이디어를 재창조해 보세요.","publishers":[{"name":"PatchXR"}],"developers":[{"name":"PatchXR"}]},"release":{"steam_release_date":1798704000,"release_from_early_access_date":1798790400,"release_from_early_access_style":4,"is_coming_soon":true,"coming_soon_display":"date_year","is_early_access":true},"trailers":{"highlights":[{"trailer_name":"PatchWorld trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1792092085","trailer_category":1,"microtrailer":[{"filename":"2235310/676950024/0ab88a84359c8f5e376a43e50daa9eb79efbee02/1778074953/microtrailer.webm","type":"video/webm"},{"filename":"2235310/676950024/0ab88a84359c8f5e376a43e50daa9eb79efbee02/1778074953/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"2235310/676950024/0ab88a84359c8f5e376a43e50daa9eb79efbee02/1778074953/dash_av1