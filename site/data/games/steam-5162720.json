ror_code":"no_reviews"},{"game_id":"steam-5162720","metric":"demo_ccu","observed_at":"2026-10-26T07:08:13Z","value":1,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5297020","error_code":null},{"game_id":"steam-5162720","metric":"price_final","observed_at":"2026-10-26T10:31:33Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5162720,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-5162720","metric":"review_count","observed_at":"2026-10-26T10:31:33Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5162720,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-5162720","metric":"review_positive_percent","observed_at":"2026-10-26T10:31:33Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5162720,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-5162720-1846651706679628","game_id":"steam-5162720","kind":"update","title":"Update: fly down to your planets, no more freeze","summary":"Entering a planet surface used to stop the game for a moment, longer on slower computers and hard drives, and on some PCs Windows even closed it. Now the camera zooms into the planet, comes down through the clouds onto the surface, and everything loads in the background meanwhile. If the game stopped on you there, give it another try. The surface builds up in front of you: terrain, grass and trees, buildings and tanks, roads, cars, and finally the residents. PgUp/PgDn: the camera rises into the ","occurred_at":null,"published_at":"2026-10-15T23:58:13Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706679628","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5162720-1846651706678896","game_id":"steam-5162720","kind":"update","title":"Update: selection rings, fleet renaming and tester fixes","summary":"The rainbow selection is gone: your selected units now get the same swirling ring in your colour as your planets. Enemy units always show it, in red. This works in the galaxy, in space battles and on planet surfaces, where the ring also shows through buildings. Fleets can be renamed: click the fleet's name on the fleet info panel. The arrows beside the name step through your other fleets, and the camera glides over. A renamed fleet's name also shows above the ship. A fleet heading into another f","occurred_at":null,"published_at":"2026-10-15T18:20:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706678896","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5162720-1846651706674092","game_id":"steam-5162720","kind":"update","title":"Small update: Mucus keeps you on track","summary":"If you do something else during the tutorial (open another panel, close the current one, or leave the planet surface), Mucus asks you to go back. If you still haven't after 30 seconds, he takes you back to where you were and repeats what you missed. The game speed label is now shown in both languages, and it blinks while Mucus talks about the game speed. The surface tutorial now uses the same word as the resource bar (\"joy\"). Small fixes: the planet info panel text and a smaller font on the top ","occurred_at":null,"published_at":"2026-10-14T12:03:48Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706674092","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5162720-1846651706672597","game_id":"steam-5162720","kind":"update","title":"Small update: ship designer and tutorial","summary":"Based on your feedback, we improved the ship designer and the tutorial: The ship designer now answers every action on the panel: it tells you when saving, refitting or deleting worked. If something can't be done, it tells you why (not enough credits, design in use, built-in design, category full and so on). After saving, refitting or deleting, the ship model returns to its place and the design list updates at once: a new design shows up right away, a deleted one is gone. The big ship picture in ","occurred_at":null,"published_at":"2026-10-13T22:34:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706672597","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5162720-1846018067944172","game_id":"steam-5162720","kind":"update","title":"Small update: player colours restored","summary":"Player colours are back to their previous shades. Yesterday's update changed them, which made blue fleets glow purple and some text outlines too dark. Brown, which replaced red as a player colour, has its lighter shade back.","occurred_at":null,"published_at":"2026-10-13T14:13:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067944172","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5162720-1846018067942142","game_id":"steam-5162720","kind":"update","title":"Demo update: a tutorial that plays like a story","summary":"The NABERON demo just got its biggest update since launch. I rebuilt the tutorial from the ground up: instead of walking you from menu to menu, it now teaches you while things happen. A tutorial that plays like a story A new opening: your fleet arrives from the edge of the galaxy, the radar slowly comes to life, and you land on your home world. A distress call and a meteor arrive at the same time: split your fleet and deal with both. A real pirate scout circles your new colony until your tanks l","occurred_at":null,"published_at":"2026-10-12T19:47:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067942142","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5162720-1846018067936044","game_id":"steam-5162720","kind":"announcement","title":"Quick fix and an apology","summary":"After yesterday's update I accidentally left a panel switched on, so it was sitting open on the screen when the game started. That was my mistake, sorry about it. With this update the game checks every menu and panel on each scene change and closes anything that should not be open. This cannot happen again. Thank you for your patience, and if you find anything else, let me know on the forum.","occurred_at":null,"published_at":"2026-10-10T11:25:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067936044","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5162720-1846018067934765","game_id":"steam-5162720","kind":"update","title":"Demo update – October 9","summary":"Tonight's update is about the interface, based on your feedback. The research and blueprint panels have a new layout: cost on the left, the model in the middle, description on the right, your choice at the bottom. Every text now sits on a dark board, so it stays readable whatever is behind it. Build panel texts got a translucent board, and they clear as soon as the pointer leaves a building. Quick save on the planet surface too: F5, or the save icon in the top bar. Notification text is now as la","occurred_at":null,"published_at":"2026-10-09T21:49:12Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067934765","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5162720-1846018067928521","game_id":"steam-5162720","kind":"announcement","title":"The NABERON free demo is out now","summary":"The free NABERON demo is live on Steam. Build a galactic empire and fight your battles alone or with a friend. NABERON is a real-time space 4X: you command the space battles yourself, then land your tanks and fight for the planet on the ground. What is in the demo: A small galaxy with the Terran Dominion, on any of the four difficulty levels A narrated tutorial that walks you through colonies, research, ship design and your first battles Online play with a friend: side by side or against each ot","occurred_at":null,"published_at":"2026-10-08T06:41:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067928521","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5162720-1845383656397402","game_id":"steam-5162720","kind":"announcement","title":"The colony surface comes alive","summary":"The planet surface is no longer an empty meadow. Every colony now grows into a small town around its buildings. Roads around every building: asphalt, sidewalk and a yellow dashed centre line, painted right onto the terrain. Demolish a building and the grass grows back. Street lamps, benches, trash cans, fire hydrants and electric boxes along the streets. Cars: two parked and two driving around every building, with right-hand traffic. Now and then one pulls into a free spot and another drives off","occurred_at":null,"published_at":"2026-10-06T19:13:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656397402","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5162720-1845383656393150","game_id":"steam-5162720","kind":"announcement","title":"Free demo arrives on October 8","summary":"The NABERON demo will be free to play on Steam from October 8. In the demo you play the opening of a real-time space 4X: explore the galaxy, colonize planets, design your own ships and tanks, win the battle in orbit, then land and take the planet in a ground battle. A narrator guides you through the first steps. The demo will also be part of Steam Next Fest, October 19–26. Wishlist and follow NABERON to see it in your Steam news when the demo is out.","occurred_at":null,"published_at":"2026-10-05T10:56:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656393150","verified_at":"2026-10-20T23:32:57Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5162720":{"last_attempt_at":"2026-10-26T09:06:42Z","status":"ok","all_sources_checked_at":"2026-10-26T09:06:42Z","error_codes":[]}},"news_last_attempt_at":{"steam-516