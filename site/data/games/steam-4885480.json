 move, an","occurred_at":null,"published_at":"2026-10-25T19:05:02Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114042751","verified_at":"2026-10-25T21:26:14Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4885480-1846018067930223","game_id":"steam-4885480","kind":"announcement","title":"Ruler of Empires Official Demo is Now Live!","summary":"We are thrilled to announce that the official demo for Ruler of Empires is now officially live on Steam!Get ready to test your strategic skills before the full release. Dive into the deep mechanics, tech trees, and tactical warfare.What’s Playable in the Demo?Campaign Mode (Germany): Take command of Germany in a dedicated narrative campaign. Make critical decisions, manage war logistics, and shape the outcome of the frontlines.Conquest Mode (15+ Playable Nations): Jump into open warfare with ove","occurred_at":null,"published_at":"2026-10-08T15:43:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067930223","verified_at":"2026-10-20T18:25:57Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4885480":{"last_attempt_at":"2026-10-26T14:54:54Z","status":"ok","all_sources_checked_at":"2026-10-26T14:54:53Z","error_codes":[]}},"news_last_attempt_at":{"steam-4885480":"2026-10-26T14:54:54Z"},"notices":[],"news_sources":{"4885480":{"last_attempt_at":"2026-10-26T14:54:53Z","last_success_at":"2026-10-26T14:54:53Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:54:53Z"},"5350110":{"last_attempt_at":"2026-10-26T14:54:54Z","last_success_at":"2026-10-26T14:54:54Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:54:54Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4885480","app_id":4885480,"app_scope":"base"