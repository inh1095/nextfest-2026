ind":"announcement","title":"The WizKitty demo is live for Steam Next Fest","summary":"The free demo is out now for Steam Next Fest. WizKitty is a roguelike deckbuilder where your cards don't attack. They craft. Every card adds, removes, rerolls or upgrades modifiers on a single weapon, and that weapon has to be strong enough to beat each enemy on the way up the tower. What's in the demo: Two characters: The Smith, and The Blizzard, who can freeze a mod so rerolls skip it The first seven floors of the tower, bosses included Two crafting puzzles, if you want something without the R","occurred_at":null,"published_at":"2026-10-19T17:00:52Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691410","verified_at":"2026-10-20T17:02:09Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4756250":{"last_attempt_at":"2026-10-26T14:06:49Z","status":"ok","all_sources_checked_at":"2026-10-26T14:06:48Z","error_codes":[]}},"news_last_attempt_at":{"steam-4756250":"2026-10-26T14:06:49Z"},"notices":[],"news_sources":{"4756250":{"last_attempt_at":"2026-10-26T14:06:48Z","last_success_at":"2026-10-26T14:06:48Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:06:48Z"},"4784100":{"last_attempt_at":"2026-10-26T14:06:49Z","last_success_at":"2026-10-26T14:06:49Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:06:49Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4756250","app_id":4756250,"app_scope":"base","observed_at":"2026-10-26T06:14:55Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"feb54d91208e7eab9354971aa7869d1c7cd47de5735dc77f234454b61053fcb7","response_sha256":null,"source_fields":{"basic_info":{"short_descript