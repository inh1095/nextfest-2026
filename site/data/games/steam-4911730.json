net/news/externalpost/steam_community_announcements/1846018067936650","verified_at":"2026-10-20T18:48:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4911730-1844751498224221","game_id":"steam-4911730","kind":"announcement","title":"THE JUBAKU DEMO IS LIVE.","summary":"THE JUBAKU DEMO IS NOW LIVE!After months of development, the JUBAKU Demo is finally available to play!Step into the Tanaka Residence, a mysterious house in Japan, 1991, and investigate the strange events surrounding it.📷 Document paranormal activity 📼 Discover hidden recordings 📰 Uncover the truth behind the residence 🕯️ Make choices that shape your experience 👁️ And try to make it out aliveThis demo is your first chance to experience JUBAKU for yourself, and we'd genuinely love to know what you","occurred_at":null,"published_at":"2026-09-25T11:29:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498224221","verified_at":"2026-10-20T18:48:06Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4911730":{"last_attempt_at":"2026-10-26T05:11:08Z","status":"ok","all_sources_checked_at":"2026-10-26T05:11:08Z","error_codes":[]}},"news_last_attempt_at":{"steam-4911730":"2026-10-26T05:11:08Z"},"notices":[],"news_sources":{"4911730":{"last_attempt_at":"2026-10-26T05:11:08Z","last_success_at":"2026-10-26T05:11:08Z","status":"ok","error_codes":[]},"4958510":{"last_attempt_at":"2026-10-26T05:11:08Z","last_success_at":"2026-10-26T05:11:08Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4911730","app_id":4911730,"app_scope":"base","observed_at":"2026-10-26T06:15:06Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"fac