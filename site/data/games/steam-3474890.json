/v1/","context":{"app_id":3474890,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-3474890","metric":"demo_ccu","observed_at":"2026-10-26T07:54:40Z","value":2,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5295650","error_code":null}],"events":[{"id":"steam-steam-3474890-1846651706675798","game_id":"steam-3474890","kind":"announcement","title":"The demo is out. Please ask me things.","summary":"Hey everyone,we made it. We actually managed to finish a demo in time for Steam Next Fest. It was tight right up to the end, and I’m really glad it’s out.So nobody goes in with the wrong expectations: almost nothing in this demo is final. It’s meant to give you a general feel for how SuperCitycon looks and plays, and that’s about it. For example, there’s no economy in the game yet. You can build and explore, but it isn’t a “real” city builder yet, with systems that feed into each other and goals","occurred_at":null,"published_at":"2026-10-14T22:47:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706675798","verified_at":"2026-10-20T11:09:29Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3474890-1842846814455135","game_id":"steam-3474890","kind":"announcement","title":"Why Is It Called SuperCitycon?","summary":"Back in 2017, when my gamedev journey started, the game didn't really have a name. The project was simply called City, and for more than two and a half years, that was all it was called. No clever working title, no grand plan for the final name, just City. In fact, the original project folder is still called City to this day.The name Citycon came much later, almost by accident. At some point during development, I was building what is now called the Citycon Building, the city's construction yard.","occurred_at":null,"published_at":"2026-09-08T09:36:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814455135","verified_at":"2026-10-20T11:09:29Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3474890":{"last_attempt_at":"2026-10-26T00:40:53Z","status":"ok","all_sources_checked_at":"2026-10-26T00:40:53Z","error_codes":[]}},"news_last_attempt_at":{"steam-3474890":"2026-10-26T00:40:53Z"},"notices":[],"news_sources":{"3474890":{"last_attempt_at":"2026-10-26T00:40:53Z","last_success_at":"2026-10-26T00:40:53Z","status":"ok","error_codes":[]},"5295650":{"last_attempt_at":"2026-10-26T00:40:53Z","last_success_at":"2026-10-26T00:40:53Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3474890","app_id":3474890,"app_scope":"base","observed_at":"2026-10-26T06:14:18Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"1d2a02870f680741ba020204d001bf91e4c86cf9b7118626eb161998ac9fcef8","response_sha256":null,"source_fields":{"basic_info":{"short_description":"레트로 감성의 도시 건설 게임. 창의적인 샌드박스에서 도로와 철도, 도시의 구역들을 만들어 보세요. 내장 복셀 에디터 SCC Studio로 건물과 차량 등을 꾸미고 Steam 창작마당에서 작품을 공유하세요.","publishers":[{"name":"Sunapie Games"}],"developers":[{"name":"Sunapie Games"}],"franchises":[{"name":"SuperCitycon"}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_quarter","is_early_access":true},"trailers":{"highlights":[{"trailer_name":"SuperCitycon - Gameplay Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1791680446","trailer_category":1,"microtrailer":[{"filename":"3474890/1951555731/f91186805f