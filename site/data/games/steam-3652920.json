/v1/","context":{"app_id":3652920,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-3652920","metric":"demo_ccu","observed_at":"2026-10-26T07:55:55Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4592210","error_code":null}],"events":[{"id":"steam-steam-3652920-1847286114039153","game_id":"steam-3652920","kind":"announcement","title":"NETHERWAKE SCREAM V","summary":"We’re excited to announce that Netherwake will be taking part in Steam Scream V from October 26 to November 2!As Netherwake is a story-driven horror game, we wanted to give you a taste of the experience without revealing too much. The demo starts at the very beginning of the game and lasts around 12–15 minutes, offering a glimpse of the atmosphere, mystery, and horrors that await.We hope you enjoy the demo. If it leaves you wanting more, please consider adding Netherwake to your Steam wishlist a","occurred_at":null,"published_at":"2026-10-24T08:52:30Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114039153","verified_at":"2026-10-24T10:11:18Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3652920-1842212951301325","game_id":"steam-3652920","kind":"announcement","title":"Netherwake Demo Version 2.0 Is Out Now - Meet the Voice of Henry","summary":"Netherwake Demo Version 2.0 Is Available NowWe are excited to announce that a major new version of the Netherwake demo is now available on Steam.Version 2.0 introduces numerous improvements across the entire experience but the biggest and most important addition is the voice behind our main character.Fletcher Woolley Is the Voice of Henry We are incredibly happy to welcome Fletcher Woolley as the voice of Henry, the main character of Netherwake.Fletcher’s performance gives Henry a distinct perso","occurred_at":null,"published_at":"2026-08-27T21:09:19Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951301325","verified_at":"2026-10-20T11:31:14Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3652920-1828894815560530","game_id":"steam-3652920","kind":"announcement","title":"The Netherwake release date has been set!","summary":"After a long time of blood and sweat, we are finally ready to announce the release date of our new horror game Netherwake Chapter One. As we near the end of our work on Netherwake, we feel both ready and confident that we will be able to be completely finished by the date of November 13th, yes friday the 13th :)It has been a while since we released our first game The Mare of Jonah, and we know that we have learned an incredible amount since then. As time has passed, we have become both older and","occurred_at":null,"published_at":"2026-04-03T14:46:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1828894815560530","verified_at":"2026-10-20T11:31:14Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3652920-1828894815560416","game_id":"steam-3652920","kind":"announcement","title":"Netherwake is participating in Steamfest!","summary":"We are pleased to announce that Netherwake will be participating in this year's Steamfest 19. oct - 26. oct. Since Netherwake is a story-driven horror game, we have been wondering how we can best showcase our game, while not giving too much away. We have therefore decided that the demo will start from the beginning of the game, and will last for about 15 minutes. With this, we hope that you as a player can be left with a more or less accurate impression of what the Netherwake experience is reall","occurred_at":null,"published_at":"2026-04-03T14:03:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1828894815560416","verified_at":"2026-10-20T11:31:14Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3652920":{"last_attempt_at":"2026-10-26T00:43:34Z","status":"ok","all_sources_checked_at":"2026-10-26T00:43:34Z","error_codes":[]}},"news_last_attempt_at":{"steam-3652920":"2026-10-26T00:43:34Z"},"notices":[],"news_sources":{"3652920":{"last_attempt_at":"2026-10-26T00:43:34Z","last_success_at":"2026-10-26T00:43:34Z","status":"ok","error_codes":[]},"4592210":{"last_attempt_at":"2026-10-26T00:43:34Z","last_success_at":"2026-10-26T00:43:34Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3652920","app_id":3652920,"app_scope":"base","observed_at":"2026-10-26T06:14:19Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"b4ef4e3232d53119d32df5c81d0e37e1b2dbe22c976073004cf3a8b2d0d90d46","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Netherwake is a story-driven first-person psychological horror game. Explore a town consumed by unnatural fog and a facility beneath the mountain. Hide from deadly anomalies, solve environmental puzzles, and uncover what happened before they find you.","publishers":[{"name":"NALYCAN","creator_clan_account_id":45226691}],"developers":[{"name":"NALYCAN","creator_clan_account_id":45226691}]},"release":{"steam_release_date":1794556560,"is_coming_soon":true,"coming_soon_display":"date_full"},"trailers":{"highlights":[{"trailer_name":"GAMEPLAY TRAILER 1","trailer_url_format":"steam/apps/${FILENAME}?t=1776903366","trailer_category"