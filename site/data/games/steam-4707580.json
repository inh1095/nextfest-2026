"value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4953770","error_code":null},{"game_id":"steam-4707580","metric":"price_final","observed_at":"2026-10-26T14:45:09Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4707580,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-4707580","metric":"review_count","observed_at":"2026-10-26T14:45:09Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4707580,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-4707580","metric":"review_positive_percent","observed_at":"2026-10-26T14:45:09Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4707580,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4707580-1840944183779320","game_id":"steam-4707580","kind":"announcement","title":"【Developement Thread 8】Supplies & Logistics","summary":"Units in the game will gradually consume supplies, morale, and readiness while moving and engaging in sustained combat. A shortage of supplies will not only limit a unit’s ability to continue operating, but will also directly reduce its actual combat effectiveness. To maintain an offensive, players will need to establish a stable logistics network.Friendly cities form the backbone of the supply system. Cities transport food, ammunition, weapons, and other equipment to the front through transport","occurred_at":null,"published_at":"2026-08-14T11:15:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840944183779320","verified_at":"2026-10-20T16:19:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4707580-1840310314344318","game_id":"steam-4707580","kind":"announcement","title":"【Developement Thread 7】Lines of Transportation","summary":"Transportation lines are one of the most important elements in the game, serving as the links that connect cities with one another and with the front lines.Unlike most strategy games and wargames, we aim to represent historical transportation networks through a more concrete and hands-on system. You can precisely manage the traffic on each transportation line, as well as the flow of individual goods along those routes, allowing resources to move between different cities. Weapons, food, and ammun","occurred_at":null,"published_at":"2026-08-07T09:34:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840310314344318","verified_at":"2026-10-20T16:19:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4707580-1839676055887611","game_id":"steam-4707580","kind":"announcement","title":"【Developement Thread 6】Resolving a Battle","summary":"Welcome to Development Thread 6!In this entry, we will discuss how battles are resolved.When the player orders one or more units to attack, an engagement begins. Combat is generally divided into two phases: the approach phase and the assault phase.During the approach phase, the attackers advance toward the defenders’ positions while both sides exchange fire. During the assault phase, close-combat calculations determine whether the defenders hold their ground, retreat, or are destroyed.The outcom","occurred_at":null,"published_at":"2026-07-31T09:30:19Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839676055887611","verified_at":"2026-10-20T16:19:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4707580-1839041357029124","game_id":"steam-4707580","kind":"announcement","title":"【Developement Thread 5】Maneuver","summary":"Each combat unit performs two types of actions during a turn: movement and combat. Both consume Movement Points (MP).Every unit has a limited amount of Movement Points each turn. A unit's available MP is determined by its weight, current condition, and the amount of mobility equipment it possesses, such as horses and trucks. Movement Points are gradually consumed as the unit moves across the map. You can always check a unit's remaining MP in its information panel.Marching also reduces a unit's c","occurred_at":null,"published_at":"2026-07-24T10:20:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839041357029124","verified_at":"2026-10-20T16:19:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4707580-1838407329258980","game_id":"steam-4707580","kind":"announcement","title":"【Developement Thread 4】Stockpile & Production Chains","summary":"Welcome to Development Log 4!The game places strong emphasis on the concept of “production chains,” as they realistically reflect how a nation’s economic and wartime industrial foundations shape the eventual course of a war.In a city’s inventory panel, you can view the stockpiles of all products, their current trends, and the ways in which they are produced.Generally speaking, products further downstream in the production chain require more complex combinations of materials. Artillery production","occurred_at":null,"published_at":"2026-07-17T09:46:41Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1838407329258980","verified_at":"2026-10-20T16:19:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4707580-1837955055356358","game_id":"steam-4707580","kind":"announcement","title":"【Developement Thread 3】Buildings","summary":"Welcome to Development Log 2.Buildings are the production units within a city. They are responsible for producing usable goods, either to equip your army or to support your economic system.City buildings are divided into four categories: Resources, Production, Military, and Administration.Resource buildings are the most basic type of production. They require no input and only produce resources. Resource buildings have an upper limit, which you may need to increase through exploration and land de","occurred_at":null,"published_at":"2026-07-10T10:11:32Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1837955055356358","verified_at":"2026-10-20T16:19:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4707580-1833334318572253","game_id":"steam-4707580","kind":"announcement","title":"【Developement Thread 1】Units","summary":"Operators are the basic combat units in the game. Depending on the faction, a non-command operator will usually represent either a division or a regiment.When you select a unit, you can view the following information in its panel: its NATO unit symbol, including unit type and formation size; attack value; defense value; status bar; manpower; movement points; morale; experience; and supply value.These values will be affected by different factors, causing them to rise or fall over time. “Status” i","occurred_at":null,"published_at":"2026-05-22T16:18:30Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318572253","verified_at":"2026-10-20T16:19:19Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4707580":{"last_attempt_at":"2026-10-26T13:39:19Z","status":"ok","all_sources_checked_at":"2026-10-26T13:39:19Z","error_codes":[]}},"news_last_attempt_at":{"steam-4707580":"2026-10-26T13:39:19Z"},"notices":[],"news_sources":{"4707580":{"last_attempt_at":"2026-10-26T13:39:19Z","last_success_at":"2026-10-26T13:39:19Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T13:39:19Z"},"4953770":{"last_attempt_at":"2026-10-26T13:39:19Z","last_success_at":"2026-10-26T13:39:19Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T13:39:19Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4707580","app_id":4707580,"app_scope":"base","observed_at":"2026-10-26T06:14:48Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"d99d819d9eddb0af64487da64962f01797b2d2fc092a7f1c6d2ed0f9c843b73e","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Take command of any faction in the East Asian theater of World War II (1937–1945). Govern your nation’s military, economy, and transportation through realistic simulation systems, and direct your forces via a structured chain of command across a 7 km-scale map to conduct operations.","publishers":[{"name":"Bufo Studio"}],"developers":[{"name":"Bufo Studio"}]},"release":{"steam_release_date":1806476400,"is_coming_soon":true,"coming_soon_display":"date_quarter"},"trailers":null},"field_present":{"basic_info":true,"release":true,"trailers":false},"field_stat