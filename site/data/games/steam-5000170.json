wseService/GetItems/v1/","context":{"app_id":5000170,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-5000170-1846651706691449","game_id":"steam-5000170","kind":"announcement","title":"BORE joins Steam Next Fest - Play the free demo","summary":"PLAY THE FREE BORE DEMO BORE is taking part in Steam Next Fest from October 19 to October 26. The free demo is available now. BORE is a co-op horror game for 1–4 players. You can play alone or online with friends. Travel deep underground in a large drilling machine. Leave the machine to explore caves and collect valuable specimens. Bring the specimens back to the machine and close the door before a creature gets inside. Only nearby teammates can hear you through proximity voice chat. Monsters ca","occurred_at":null,"published_at":"2026-10-19T17:00:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691449","verified_at":"2026-10-20T20:17:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5000170-1846651706679743","game_id":"steam-5000170","kind":"announcement","title":"The final Next Fest demo is live: 17 updates in 38 days","summary":"THE FINAL NEXT FEST DEMO IS LIVE BORE Demo v0.8.16 is live on Steam now. This is the build you will play during Steam Next Fest, October 19-26: co-op survival horror for 1-4 players, solo or with a crew. Getting it here took 17 updates in 38 days. From September 8 to October 15 we deployed a new build to Steam roughly every two days, five of them in the first four days alone. If you tried the demo before September, it is a different machine now. Every update is summarized below, newest first. 38","occurred_at":null,"published_at":"2026-10-16T01:30:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706679743","verified_at":"2026-10-20T20:17:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5000170-1844751498231133","game_id":"steam-5000170","kind":"announcement","title":"THE FULL CONTRACT OPENS NOVEMBER 24","summary":"THE FULL CONTRACT OPENS TUESDAY, NOVEMBER 24 BORE launches on Steam on November 24, 2026, at $5.99, with 20% off for the first two weeks. The demo gave you the first two strata. The full contract opens the rest of the earth: THE OSSUARY, which is warm for reasons nobody wrote down, and THE HUSH, which the Bureau does not discuss. Deeper is richer. Deeper is louder. This also unlocks all the equipment and upgrades that were not available and/or visible in the demo. You still crew THE MULE, a colo","occurred_at":null,"published_at":"2026-09-28T10:33:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498231133","verified_at":"2026-10-20T20:17:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5000170-1842846814448038","game_id":"steam-5000170","kind":"announcement","title":"THE PROVISIONAL CONTRACT IS OPEN","summary":"THE BUREAU IS ACCEPTING PROVISIONAL CONTRACTS A demo is now posted. It is free, it is the real machine, and it runs the first two strata: THE FILL and THE OLD SEA. You will crew THE MULE, a church-sized drilling machine, and take it down. You will man its instruments, seal its door, and walk out into the dark for the specimens the Bureau calls the tribute. Built for a crew of two to four on proximity voice, and it runs solo if nobody answers the call. No weapons. Light, noise and nerve. WHAT IS ","occurred_at":null,"published_at":"2026-09-04T23:02:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814448038","verified_at":"2026-10-20T20:17:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5000170-1842846814445128","game_id":"steam-5000170","kind":"announcement","title":"CONTROLLER AND STEAM DECK SUPPORT","summary":"CONTROLLER AND STEAM DECK BORE has full controller support, and it runs on Steam Deck. This post is the detail. It gets updated as things change, so it is worth a second look after a patch. FULL CONTROLLER SUPPORT Every verb is on the pad: moving, the lamp, tools, the cabin stations, the Stores, the menus, the survey plot. Nothing is keyboard-only Prompts follow the device in your hands. Pick up a pad mid-session and the prompts change to match it, with no setting to flip Keyboard and pad are bo","occurred_at":null,"published_at":"2026-09-04T02:33:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814445128","verified_at":"2026-10-20T20:17:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5000170-1842212951297708","game_id":"steam-5000170","kind":"announcement","title":"Video & Streaming Policy / 配信ガイドライン","summary":"```BORE — Video & Streaming PolicyYou are welcome to record, stream, and publish videos of BORE (demo and fullgame) on any platform: YouTube, Twitch, TikTok, niconico, Bilibili, CHZZK,SOOP, VK, and anywhere else.- Monetization is allowed, including platform partner/membership programs,ads, and donations. This applies to individual creators AND corporate/agencycreators (VTuber agencies included).- Clips, VODs, compilations, thumbnails, and edits are all fine.- No permission request is needed. Thi","occurred_at":null,"published_at":"2026-08-26T17:39:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951297708","verified_at":"2026-10-20T20:17:19Z","discov