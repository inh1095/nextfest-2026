ull,"published_at":"2026-10-26T02:04:46Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114043401","verified_at":"2026-10-26T04:47:24Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4860400-1847286114030338","game_id":"steam-4860400","kind":"announcement","title":"HOT FIX","summary":"We're very sorry that, after the power went out, your adventure may have been cut short by... a coffee machine. It clearly thought it was the final boss, but its reign is over! We've already released an urgent fix. Update the demo on Steam and jump back in - the story isn't over yet! We fixed this critical bug within 24 hours of a player's report. Thanks to YAROSLAVE for telling us about the problem!What else has changed🔹 Your progress is protected - we've fixed issues with saves. 🔹 Optimization","occurred_at":null,"published_at":"2026-10-21T21:08:33Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114030338","verified_at":"2026-10-22T00:33:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4860400-1846018067937417","game_id":"steam-4860400","kind":"announcement","title":"THE DEMO WILL BE AVAILABLE THIS WEEK","summary":"Stock up on coffee!In one week, you'll be hosting a late-night stream.Full controller supportFor the demo's release, we've added full controller support on PC. Controls, menus, and on-screen prompts are adapted for each controller: ✅ DUALSHOCK 4 (PlayStation 4) ✅ DualSense (PlayStation 5) ✅ Xbox Wireless ControllerDON'T FORGET TO ADD Please, Tell Me Why? TO YOUR WISHLIST TO STAY UP TO DATE WITH THE LATEST NEWS!","occurred_at":null,"published_at":"2026-10-10T22:27:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067937417","verified_at":"2026-10-20T18:03:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4860400-1844115010502638","game_id":"steam-4860400","kind":"announcement","title":"Over 1,000 players are waiting for the game!","summary":"Hello, streamers!Set up your webcams, turn on the lights, and put on your headphones - the date of the first stream has already been set. You're Finally HereMore than 1,000 players have already added Please, Tell Me Why? to their wishlists, and we couldn't be happier to have every one of you here! The Night Begins at 8:00 PMHow you spend the night is entirely up to you. Play games on stream and chat with your viewers until dawn, search the apartment for clues to a mysterious past, or make no pla","occurred_at":null,"published_at":"2026-09-21T22:28:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010502638","verified_at":"2026-10-20T18:03:36Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4860400":{"last_attempt_at":"2026-10-26T14:52:09Z","status":"ok","all_sources_checked_at":"2026-10-26T14:52:08Z","error_codes":[]}},"news_last_attempt_at":{"steam-4860400":"2026-10-26T14:52:09Z"},"notices":[],"news_sources":{"4860400":{"last_attempt_at":"2026-10-26T14:52:08Z","last_success_at":"2026-10-26T14:52:08Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:52:08Z"},"4937710":{"last_attempt_at":"2026-10-26T14:52:09Z","last_success_at":"2026-10-26T14:52:09Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:52:09Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4860400","app_id":4860400,"app_scope":"base","observed_at":"2026-10-26T06:15:03Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_i