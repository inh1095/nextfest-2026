pid=5111950","error_code":null},{"game_id":"steam-2551970","metric":"price_final","observed_at":"2026-10-26T14:44:54Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":2551970,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":"KRW","divisor":100,"initial":null,"discount_percent":null,"is_free":true,"formatted_final_price":null,"is_free_field_present":true,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":null},{"game_id":"steam-2551970","metric":"review_count","observed_at":"2026-10-26T14:44:54Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":2551970,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-2551970","metric":"review_positive_percent","observed_at":"2026-10-26T14:44:54Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":2551970,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-2551970-1846018067931275","game_id":"steam-2551970","kind":"announcement","title":"The release date, new trailer, and ways to support Outcast Tales","summary":"The release is set for October 26 As promised before, the game is entirely free from day one. You will not find any paid DLC or microtransactions here. Just download Outcast Tales, play it, and enjoy. While you wait, the demo is available and ready for you. Your progress can be carried over to the full game. But if you still want to support usKeep your money. Instead, go tell your friends that the game is free, and wishlist it (if you haven't already). Or watch our brand new trailer! By the way,","occurred_at":null,"published_at":"2026-10-08T19:57:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067931275","verified_at":"2026-10-20T10:22:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2551970-1843481262701685","game_id":"steam-2551970","kind":"announcement","title":"Outcast Tales will be free","summary":"As in, completely free. No-strings-attached free. No microtransactions, no dark patterns, no catch. This is a game we wanted to make so very much: a funny story-driven roguelite with hard tactical battles where characters would occasionally act out. We poured a lot of work into it, and we love the result. We want you to play it And we don't want a price tag to stand between the game and the people who might enjoy it. These days, games and other media get banned or disappear, AAAAA-games receive ","occurred_at":null,"published_at":"2026-09-14T13:30:44Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262701685","verified_at":"2026-10-20T10:22:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2551970-1843481262692192","game_id":"steam-2551970","kind":"announcement","title":"Outcast Tales Demo Is Out Now!","summary":"This demo isn't the prologue. It's much larger. Think of it as the full experience, just cut in half. Playtime's roughly doubled: seven new bosses, four times the encounters. And yes, there's a new ending waiting for you on the other side of the desert. We also added a new mechanic. As you travel, every character can unlock one of two secret abilities tied to their class. The whole crew's still here, but the Alchemist we're saving for the full release. And don’t worry about progress! You will be","occurred_at":null,"published_at":"2026-09-10T13:18:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262692192","verified_at":"2026-10-20T10:22:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2551970-1841579228670281","game_id":"steam-2551970","kind":"announcement","title":"Outcast Tales isn't dead!","summary":"Greetings, misfits! It has been a while. More than 2 years, in fact. Long enough for some of you to reasonably wonder whether Outcast Tales wandered into the Wasteland and got eaten by something with far too many teeth. It hasn't; it was just stuck in a bit of a release limbo, which is now over. So, good news: we are alive. Better news: and fully ready to go. And we finally have something important to share: Outcast Tales has a new publisher. Meet Inner Pocket!What does this mean for the game? F","occurred_at":null,"published_at":"2026-08-21T22:53:24Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228670281","verified_at":"2026-10-20T10:22:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2551970-5842939267324163838","game_id":"steam-2551970","kind":"announcement","title":"Fallen Graces","summary":"Greetings, Misfits! We know it’s a bit frustrating to see these dark silhouettes under the available characters. https://i.imgur.com/oWXrmRl.png Who are they? What do they do? Why do they do what they do? These are the questions we aim to delve into with this devlog to ease the everlasting itch of seeing unavailable content. Meet the future outcasts! Their past was full of tales, yet now they have nobody but themselves. And even though the remains of society does not care for them, they struggle","occurred_at":null,"published_at":"2024-07-01T13:26:41Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5842939267324163838","verified_at":"2026-10-20T10:22:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2551970-5742731639330016645","game_id":"steam-2551970","kind":"announcement","title":"The Other Tales","summary":"Greetings, Misfits! The release of Outcast Tales is getting closer. We hope the game provides plenty of fun for everyone, with many hours of content to take a crack at. But don’t just sit on your hands simply replaying The First Journey over and over in anticipation, as we will be releasing an update to The First Journey, so you might want to wait before jumping into adventure with fresh eyes. How about you play or watch something else for now instead? And that’s why we’re here today. Together, ","occurred_at":null,"published_at":"2024-05-30T12:51:12Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5742731639330016645","verified_at":"2026-10-20T10:22:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2551970-5749481331441477817","game_id":"steam-2551970","kind":"announcement","title":"A Day's Journey — Part 2","summary":"Continuing from last time... One of your team-mates is exhausted after a long trip. Earth to Valery: we literally just camped out! You decide to urge your crewmate to keep going, but this choice comes with a personal check. Here’s where your personality comes into play. https://i.imgur.com/1qw9VXN.png This is definitely a task for Big Buddy. Being a big charming goofball, he gives his big speech and lifts everyone’s spirits. Nice choice! Finally, you arrive at your destination: the mysterious vi","occurred_at":null,"published_at":"2024-03-29T18:57:20Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5749481331441477817","verified_at":"2026-10-20T10:22:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2551970-5686430301733342926","game_id":"steam-2551970","kind":"announcement","title":"A Day's Journey — Part 1","summary":"Greetings, misfits! ...Who am I talking to? You three, obviously. You’ve got an important mission today, so let’s get on with it. Time for another day in the Wasteland. Let’s see if it proves fruitful, shall we? Setting out Nobody in their right mind would set out for adventure without assembling a party first. The world of Outcast Tales might seem brimming with total loons, and yet you don’t see any of them traveling alone, do you? Your team member’s personality type will determine their base s","occurred_at":null,"published_at":"2024-03-25T18:26:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5686430301733342926","verified_at":"2026-10-20T10:22:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2551970-5519792046263614932","game_id":"steam-2551970","kind":"announcement","title":"Outcast Tales: The First Journey is out NOW!","summary":"Time to finally set your foot into the dangerous world of Outcast Tales: the game’s free prologue chapter titled Outcast Tales: The First Journey is out now! This release is more than just a demo, but rather an epic introduction to the game proper! The prologue lets you: Play the shortened version of the game’s campaign, featuring tons of enemies, items, and unique events Mix-and-match your run with four heroes and five personalities available Extend your playtime even further by completing Cont","occurred_at":null,"published_at":"2024-01-29T18:01:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5519792046263614932","verified_at":"2026-10-20T10:22:51Z","discovery_method":