ke arcade cabinets, claw machin","occurred_at":null,"published_at":"2026-10-19T04:48:19Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706688822","verified_at":"2026-10-20T23:09:52Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5135980-1842846814442196","game_id":"steam-5135980","kind":"announcement","title":"Arcade Together — Steam page is now live!","summary":"We're excited to share that the Steam page for our new game, Arcade Together, is now live!It's a co-op arcade management sim for 2–4 players online. Run the arcade, play the arcade, together.Why we're making this gameWe're guessing a lot of you were like us: the arcade was the best place in the world when you were a kid. The tension of lining up a claw machine grab, the rush when a coin pusher finally spills over, tearing around a go-kart track with your friends…And then it hit us: back then, th","occurred_at":null,"published_at":"2026-09-03T04:25:13Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814442196","verified_at":"2026-10-20T23:09:52Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5135980":{"last_attempt_at":"2026-10-26T08:45:09Z","status":"ok","all_sources_checked_at":"2026-10-26T08:45:09Z","error_codes":[]}},"news_last_attempt_at":{"steam-5135980":"2026-10-26T08:45:09Z"},"notices":[],"news_sources":{"5135980":{"last_attempt_at":"2026-10-26T08:45:09Z","last_success_at":"2026-10-26T08:45:09Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:45:09Z"},"5139080":{"last_attempt_at":"2026-10-26T08:45:09Z","last_success_at":"2026-10-26T08:45:09Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:45:09Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5135980","app_id":513598