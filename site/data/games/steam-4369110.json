/v1/","context":{"app_id":4369110,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4369110","metric":"demo_ccu","observed_at":"2026-10-26T08:41:15Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4881290","error_code":null}],"events":[{"id":"steam-steam-4369110-1844115010500375","game_id":"steam-4369110","kind":"announcement","title":"We're joining Steam Next Fest! The demo now includes the main story \"DEMØNS GATE","summary":"We're joining Steam Next Fest: October 2026 (Oct 19–26, PT)! Available in Japanese, English and Simplified Chinese. Until now the demo only included the \"Paintball Ops\" part. From this update, the main story \"DEMØNS GATE\" is playable in the demo as well. The demo stays free, and save data is shared with the full game. Just launch the demo — the latest content is applied automatically, no re-download needed.","occurred_at":null,"published_at":"2026-09-21T05:30:41Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010500375","verified_at":"2026-10-20T13:45:05Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4369110-1836506165572478","game_id":"steam-4369110","kind":"announcement","title":"体験版リリースのお知らせ！","summary":"Demo Release Announcement!・Free to play — no purchase required, just like the full game!・Uses save data shared with the full game, so you can get a head start!・Enjoy Paintball (Survival Game) modes with absolutely no restrictions!・DLC purchases are not available from the demo.・The demo does not have a review feature — this is by Steam's design.","occurred_at":null,"published_at":"2026-07-04T14:01:24Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1836506165572478","verified_at":"2026-10-20T13:45:05Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4369110-1833968530892531","game_id":"steam-4369110","kind":"announcement","title":"Release Date Postponed","summary":"Today (May 29, 2026) was our planned release date, but this morning we received feedback from Steam Review asking us to resubmit. As a result, we are postponing the launch to late June 2026 or later.We sincerely apologize to everyone who was looking forward to release day.The feedback was primarily caused by a misalignment between Steam's stated requirements and our own interpretation. We are addressing the following four points:・Age-rating misinterpretation ─ Our self-declared items regarding s","occurred_at":null,"published_at":"2026-05-29T23:39:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833968530892531","verified_at":"2026-10-20T13:45:05Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4369110-1827626365764546","game_id":"steam-4369110","kind":"announcement","title":"2026年5月末リリースへの訂正","summary":"2026年4月中リリースへの訂正ぜひウィッシュリストに登録して応援してください！2026年5月末リリースへの訂正・2026年5月中リリースの予定としていましたが、 クオリティアップと審査期間の確保のため、発売を5月末に再調整します。・最大の理由 制作環境の変更。AIコーティングサポートに Google Antigravity を使用してきましたが、仕様変更に伴い Windsurf と Claude code への移行を行いました。・期待の理由 当初 DLCとして追加販売を予定していた「ゲーム音声・ボイスパック」の同梱を決めました！ 販売価格の変更はありません。お楽しみください。・現在の開発状況 ゲームシステム:約65%完成しており、順調に動作しています。 ストーリー:脚本は75%完成しており、現在ゲームへの統合作業に取り組んでいます。 ボイス・サントラ:音源の完成度は10％です。日本語、英語、中国語(簡)、3言語での同時リリースを目指しています!ゲームを最高のものにするために懸命に取り組んでいます。続報をお待ちください！ Revised Release Date: late May 2","occurred_at":null,"published_at":"2026-03-23T22:14:19Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1827626365764546","verified_at":"2026-10-20T13:45:05Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4369110-1825727806710698","game_id":"steam-4369110","kind":"announcement","title":"Revised Release Date: April 2026","summary":"Revised Release Date: April 2026Update on Release Schedule: While we initially planned for a March 2026 release, we have decided to adjust the launch to April 2026. This will allow us more time to polish the final quality and ensure a smooth review process.Current Development Status:Game Systems: Approximately 60% complete and running smoothly.Story: The script is 70% finished, and we are currently integrating it into the game.We are aiming for a simultaneous release in Japanese, English, and Si","occurred_at":null,"published_at":"2026-02-27T13:19:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1825727806710698","verified_at":"2026-10-20T13:45:05Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4369110":{"last_attempt_at":"2026-10-26T02:12:46Z","status":"ok","all_sources_checked_at":"2026-10-26T02:12:46Z","error_codes":[]}},"news_last_attempt_at":{"steam-4369110":"2026-10-26T02:12:46Z"},"notices":[],"news_sources":{"4369110":{"last_attempt_at":"2026-10-26T02:12:46Z","last_success_at":"2026-10-26T02:12:46Z","status":"ok","error_codes":[]},"4881290":{"last_attempt_at":"2026-10-26T02:12:46Z","last_success_at":"2026-10-26T02:12:46Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4369110","app_id":4369110,"app_scope":"base","observed_at":"2026-10-26T06:14:34Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"5ba5f9771f9929751bf34d437312ab182de8915a62f23414d74a953f654a2ba8","response_sha256":null,"