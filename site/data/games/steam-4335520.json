"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-4335520","metric":"review_count","observed_at":"2026-10-26T10:31:08Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4335520,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-4335520","metric":"review_positive_percent","observed_at":"2026-10-26T10:31:08Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4335520,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4335520-1846651706691842","game_id":"steam-4335520","kind":"announcement","title":"Announcing DAMM Games Discord ^^","summary":"Hello Little Miners, We hope you are having a great Steam Next Fest. :D We just created our Studio Discord where you will be able to give feedback, report bugs, interact with other players and with us, the indie devs, access future games' playtests, closed beta versions and more. https://discord.gg/FycdX72kX We hope we find you there very soon! Best regards, Anton & Dave ^^","occurred_at":null,"published_at":"2026-10-19T17:35:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691842","verified_at":"2026-10-20T13:43:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4335520-1843481262692457","game_id":"steam-4335520","kind":"announcement","title":"We're launching on November 11th!","summary":"Hello Fellow Miners, We are very excited to share with you that very soon you will be able to have this tiny miner living at the bottom of your screen! :DHave you ever wonder how a Treebeard-Gandalf character voice from LOTR sounds like?! Watch the release date trailer and find out! It's pretty awesome ^^If you haven’t, wishlist the game now so you get notified once it is released! Thank you very much for being part of this journey with us, Anton & Dave ^^","occurred_at":null,"published_at":"2026-09-10T14:48:32Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262692457","verified_at":"2026-10-20T13:43:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4335520-1842846814439050","game_id":"steam-4335520","kind":"update","title":"Demo Update! What's new in the demo?","summary":"Demo Update Hello Cozy Miners! So, what's new in the demo?We rebalanced the economy to make it smoother and to make the upgrade choices more meaningful.We added new weather, \"the rain\", for those cozy afternoons working from home with a hot cup of coffee. :) We replaced the Sunset Sky with the Night Sky so you can try both day and night aesthetics.We reduced the costs of all the environments.Also, we made some quality-of-life updates, like fixing the double outlines of some animals, reducing the","occurred_at":null,"published_at":"2026-09-02T02:11:07Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814439050","verified_at":"2026-10-20T13:43:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4335520-1841579228661120","game_id":"steam-4335520","kind":"announcement","title":"DEMO IS OUT NOW!","summary":"Hello, Cozy Miners! We’re very happy to announce that our demo is finally ready and available to play! After several weeks of playtesting and gathering your valuable feedback, we’ve added lots of new content and quality-of-life improvements: Multi-monitor support. Persistent save data for mine tile progress. New animated creatures for biomes, rooms, and the mine’s background. New rooms for Monty’s House. New animations and effects for the environments. We hope you enjoy the demo, and we’d love t","occurred_at":null,"published_at":"2026-08-18T23:08:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228661120","verified_at":"2026-10-20T13:43:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4335520-1837955055357709","game_id":"steam-4335520","kind":"announcement","title":"Demo Playtest Is Here!!! ^^","summary":"Hey little miners! We finally made it to the day when you can join our playtest! ^^We just uploaded a build of our demo for Valve to approve, so once you request access, you'll probably receive an email within the next week or two letting you know the demo playtest is available in your library.If you have any suggestions, feedback, or encounter any bugs, please feel free to send me an email at anton.indiedev@gmail.com ! We would love to hear your thoughts! Thank you for being part of this journe","occurred_at":null,"published_at":"2026-07-10T18:33:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1837955055357709","verified_at":"2026-10-20T13:43:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4335520-1836506165566459","game_id":"steam-4335520","kind":"announcement","title":"Introducing the New \"Library\" Room! How Does Monty's House Work?","summary":"Hello little miners! ^^ Mmm... where can we start? Well, maybe we can start with how you can access Monty's House. While we were testing our demo build, we realized it would be nice to have direct access to the house. That way, it's easier to check on your progress or simply watch as you unlock new little treasures.Whether you're zoomed in or zoomed out, just click the House Icon and you'll be taken straight to Monty's House. To switch between rooms, you just need to hit the \"Next Room\" arrows.T","occurred_at":null,"published_at":"2026-07-01T21:25:55Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1836506165566459","verified_at":"2026-10-20T13:43:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4335520-1833334318579615","game_id":"steam-4335520","kind":"announcement","title":"\"Monty's Idle Mine\" Page Launch ^^","summary":"Welcome little miners, ^^My name is Anton, I'm part of a two man indie team from Buenos Aires, Argentina.My friend Dave and I, are very happy to bring to you our new Desktop Companion game \"Monty's Idle Mine\".If you like games like Rusty's Retirement and Ropuka's Idle Island, we think that you are going to love this one too. We also wanted to announce that we're finishing cooking the demo and it will be out really soon after a potential playtest!!!So, please help us by wishlisting the game and s","occurred_at":null,"published_at":"2026-05-26T15:05:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318579615","verified_at":"2026-10-20T13:43:39Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4335520":{"last_attempt_at":"2026-10-26T02:11:19Z","status":"ok","all_sources_checked_at":"2026-10-26T02:11:19Z","error_codes":[]}},"news_last_attempt_at":{"steam-4335520":"2026-10-26T02:11:19Z"},"notices":[],"news_sources":{"4335520":{"last_attempt_at":"2026-10-26T02:11:19Z","last_success_at":"2026-10-26T02:11:19Z","status":"ok","error_codes":[]},"5068080":{"last_attempt_at":"2026-10-26T02:11:19Z","last_success_at":"2026-10-26T02:11:19Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4335520","app_id":4335520,"app_scope":"base","observed_at":"2026-10-26T06:14:33Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"2be80f578bf9f8b140fe4a8fe6262bdea12edf64ae92e92b7edfdbdd76dc3ce6","response_sha256":null,"source_fields":{"basic_info":{"short_description":"화면 하단에 살아가는 작은 광부와 함께하는 편안한 데스크톱 방치형 게임입니다. 몬티가 광물을 캐는 모습을 지켜보고, 더 많은 코인을 얻기 위해 스킬과 광물을 업그레이드하세요. 142개의 작은 보물을 찾거나 구매하고, 일하거나 공부하는 동안 그의 작은 세상을 꾸며보세요.","publishers":[{"name":"Electronic Playground LLC","creator_clan_account_id":45958909}],"developers":[{"name":"DAMM Games","creator_clan_account_id":45958854}]},"release":{"steam_release_date":1794421980,"is_coming_soon":true,"coming_soon_display":"date_full"},"trailers":{"highlights":[{"trailer_name":"Monty's Idle Mine Release Date Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1789039841","trailer_category":3,"microtrailer":[{"filename":"4335520/1345073047/d2d4a780fcb07cd701c2cfe4e6e181c1c644944c/1788816848/microtrailer.webm","type":"video/webm"},{"filename":"4335520/1345073047/d2d4a780fcb07cd701c2cfe4e6e181c1c644944c/1788816848/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4335520/1345073047/d2d4a780fcb07cd701c2cfe4e6e181c1c644944c/1788816848/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"4335520/1345073047/d2d4a780fcb07cd701c2cfe4e6e181c1c644944c/1788816848/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"4335520/1345073047/d2d4a780fcb07cd701c2cfe4e6e181c1c644944c/1788816848/hls_264_master.m3u8","encoding":"hls_h26