/v1/","context":{"app_id":4836960,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4836960-1842212951297346","game_id":"steam-4836960","kind":"announcement","title":"Why I'm building Cozy Burg","summary":"I'm an indie developer and Cozy Burg is my first game. It only exists because of the love of the games Ive played myself...I remember playing the original SimCity for hours on my father's Atari ST — leaning into that little screen, watching the cars drive on the streets I've built, taking people to their jobs. I loved solving the traffic problems, at least as best as I could.Decades later — a career, a family, I found Dorfromantik. It taught me nearly the opposite lesson: that a game's challenge","occurred_at":null,"published_at":"2026-08-26T15:45:23Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951297346","verified_at":"2026-10-20T17:48:04Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4836960-1841579228677026","game_id":"steam-4836960","kind":"announcement","title":"Let's begin with a few green tiles","summary":"Welcome to Cozy Burg.Here, you'll start with nothing at all — a piece of ground, and no particular hurry. Let a little water gather. Soften an edge with trees. Raise a mountain, so the horizon has something to say. Tuck in some homes, a few shops, a farm or two, and watch the little town come alive.And when you put down a pretty road... people find it. Every car after that is somebody going somewhere. Every town asks the same thing of you: keep people coming, before the tiles in your hand run ou","occurred_at":null,"published_at":"2026-08-25T01:29:55Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228677026","verified_at":"2026-10-20T17:48:04Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4836960":{"last_attempt_at":"2026-10-26T04:45:03Z","status":"ok","all_sources_checked_at":"2026-10-26T04:45:02Z","error_codes":[]}},"news_last_attempt_at":{"steam-4836960":"2026-10-26T04:45:03Z"},"notices":[],"news_sources":{"4836960":{"last_attempt_at":"2026-10-26T04:45:02Z","last_success_at":"2026-10-26T04:45:02Z","status":"ok","error_codes":[]},"5287620":{"last_attempt_at":"2026-10-26T04:45:03Z","last_success_at":"2026-10-26T04:45:03Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4836960","app_id":4836960,"app_scope":"base","observed_at":"2026-10-26T06:15:00Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"445f69ac678e2f6d7b896bc9789a5a9306b29e179c74ffbe80463ecf3e7dee47","response_sha256":null,"source_fields":{"basic_info":{"short_description":"A cozy hex city builder with real people and real jobs. You have to earn every resident: they want nature nearby, a job they can get to, and a street worth living on. You build it from a small hand of cards. Make it beautiful, make it work.","publishers":[{"name":"Noise Harbor"}],"developers":[{"name":"Noise Harbor"}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_quarter","is_early_access":true},"trailers":{"highlights":[{"trailer_name":"Cozy Burg — Official Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1791692520","trailer_category":1,"microtrailer":[{"filename":"4836960/2045518332/f29702d168be1404f9ab975bbe572d3bab875cf3/1791691480/microtrailer.webm","type":"video/webm"},{"filename":"4836960/2045518332/f29702d168be1404f9ab975bbe572d3bab875cf3/179