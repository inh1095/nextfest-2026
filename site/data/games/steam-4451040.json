"value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4973010","error_code":null}],"events":[{"id":"steam-steam-4451040-1844751498219526","game_id":"steam-4451040","kind":"update","title":"Visual Update!","summary":"The demo got updates and now looks like the full version in current development state!","occurred_at":null,"published_at":"2026-09-23T20:36:26Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498219526","verified_at":"2026-10-20T14:26:56Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4451040-1842846814447616","game_id":"steam-4451040","kind":"update","title":"New Update!","summary":"Watching lots of streamers playing the Corridor 13 demo I was able to spot things that i could improve with this patch. Also i saw streamers found some minor bugs.Due to the fact that Corridor 13 is an anomaly game, I cant tell much about the bugs and improvements because of spoilers, but I am sure, you will enjoy the demo now even more!New stuff in the Demo:One anomaly addedTwo anomalies are easier to spot or easier to masterDemo ends at Corridor 7","occurred_at":null,"published_at":"2026-09-04T19:27:36Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814447616","verified_at":"2026-10-20T14:26:56Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4451040-1839676055897777","game_id":"steam-4451040","kind":"update","title":"Another little Patch","summary":"Bugfixes:Fixed an Bug where players would not be able to look around anymore after an anomaly happened.Features:Added the option to stop anonymous collecting data about how long players need to find anomalies to further improve the games difficulty.","occurred_at":null,"published_at":"2026-08-04T16:05:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839676055897777","verified_at":"2026-10-20T14:26:56Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4451040-1839676055889784","game_id":"steam-4451040","kind":"announcement","title":"Improved demo","summary":"Patch 0801 - Demo ends now at corridor 8 instead of corridor 6. (Full game obviously will have 13)- Added another anomaly. Demo now has 14 anomalies. (Full game will have about 50)","occurred_at":null,"published_at":"2026-08-01T02:08:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839676055889784","verified_at":"2026-10-20T14:26:56Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4451040-1839676055883973","game_id":"steam-4451040","kind":"announcement","title":"Corridor 13 Demo is available","summary":"The demo contains 13 anomalies and finishes after corridor #6. Full game is planned with over 50 anomalies. Check it out!","occurred_at":null,"published_at":"2026-07-30T01:47:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839676055883973","verified_at":"2026-10-20T14:26:56Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4451040":{"last_attempt_at":"2026-10-26T12:30:09Z","status":"ok","all_sources_checked_at":"2026-10-26T12:30:09Z","error_codes":[]}},"news_last_attempt_at":{"steam-4451040":"2026-10-26T12:30:09Z"},"notices":[],"news_sources":{"4451040":{"last_attempt_at":"2026-10-26T12:30:09Z","last_success_at":"2026-10-26T12:30:09Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T12:30:09Z"},"4973010":{"last_attempt_at":"2026-10-26T12:30:09Z","last_success_at":"2026-10-26T12:30:09Z","status":"ok","error_codes":[],"la