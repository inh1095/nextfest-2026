/v1/","context":{"app_id":4753740,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4753740","metric":"demo_ccu","observed_at":"2026-10-26T09:47:16Z","value":8,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4755860","error_code":null}],"events":[{"id":"steam-steam-4753740-1847286114042399","game_id":"steam-4753740","kind":"announcement","title":"V0.8.49 - Combat Visualization","summary":"Hey all,V0.8.49 brings the following: Combat Visualization A big change how the combat ingame works. We are moving away from instant to visualizing the turns happening. You can see each round of combat play out. As a player this gives you now the option to retreat or reinforce during combat. Combat Audio clues: You can now hear combat happening when zoomed in. Let me know if you like it.Low resolution handlingThe game should now handle low resolution screens much better.","occurred_at":null,"published_at":"2026-10-25T17:03:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114042399","verified_at":"2026-10-25T20:39:31Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4753740-1847286114040512","game_id":"steam-4753740","kind":"announcement","title":"v0.8.36 - Bugfixes","summary":"Hi all, thanks for everyone checking out the Demo during the Next fest! I love all of your feedback. I am working hard trying to make any fixes I can before the game Launch next week :D V0.8.36Unit Procedural Animations: Added native 20 FPS procedural animation cycles (breathing, hovering, vibration, recoil) and directional weapon fire effects without pixel scaling or distortion. Configurable with live in-editor previewAdded weapon effectsAdded workbench in editor to define location for muzzle e","occurred_at":null,"published_at":"2026-10-24T19:34:20Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114040512","verified_at":"2026-10-24T22:58:50Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4753740-1847286114038236","game_id":"steam-4753740","kind":"announcement","title":"V0.8.25","summary":"Interface and economy- Added a UI Scale setting and improved window sizing at different display scales.- The top bar now shows resource income and upkeep per game hour.- Reworked the economy stock table with shortcuts to the market and a compact next-credit display.- Improved grouped choices in recruitment and construction menus, research requirement messages, and game speed controls.Research- Fixed research queues stopping after a finite technology completed.- Idle, funded research starts immed","occurred_at":null,"published_at":"2026-10-23T22:58:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114038236","verified_at":"2026-10-24T01:04:11Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4753740-1847286114032680","game_id":"steam-4753740","kind":"announcement","title":"V0.8.17 - Dark Mode + Bug Fix","summary":"Small patch brings 2 important changes.1. Dark mode as wished by users trying the demo (You can do system / Light / Dark)2. I fixed a bug that ended up rounding down resource income less than 1. That would null out any special resources on low yield tiles. Now the income is stored in a number instead of an integer, thus all credit should be given. Note, the resource display will still round down if its below 0.5.thanks all for playing","occurred_at":null,"published_at":"2026-10-22T13:36:22Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114032680","verified_at":"2026-10-22T16:16:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4753740-1847286114030404","game_id":"steam-4753740","kind":"announcement","title":"Worldkampf '72 V 0.8.13","summary":"Update V0.8.13 brings with it a slew of new \"Flavor Graphics\" as I am working hard to replace the last placeholders in the game with the final art pieces. Here a few Samples :) I am also working on the layout of the starting 1975 example and the exact start positions of the Goap players. Lots of polish is going in right now. Thanks all for you trying the demo and your feedback!","occurred_at":null,"published_at":"2026-10-21T21:35:35Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114030404","verified_at":"2026-10-21T23:55:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4753740-1847286114028547","game_id":"steam-4753740","kind":"update","title":"V0.8.10 Small Update","summary":"Quick Update thanks to user feedback. Solved an issue that caused games not to start correctly with users with non ASCII charactes in their windows username. Thank you!","occurred_at":null,"published_at":"2026-10-21T11:45:18Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114028547","verified_at":"2026-10-21T13:22:55Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4753740-1847286114025721","game_id":"steam-4753740","kind":"update","title":"Worldkampf '72 - Update 0.8.4","summary":"Major New Features & ImprovementsInteractive Guided Lessons & Visual HighlightsBased on demo feedback, the new player onboarding has been completely rebuilt. A new interactive lesson coach guides you step-by-step through the core game loop in 12 lessons: selecting armies, marching to neutral towns, managing game speed, resource production, tax balancing, market trading, research, developing rural focuses, recruiting troops, and saving your game.Focused visual highlight rings spotlight the exact ","occurred_at":null,"published_at":"2026-10-20T22:14:44Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114025721","verified_at":"2026-10-21T07:51:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4753740-1846651706688933","game_id":"steam-4753740","kind":"announcement","title":"Next Fest Stream (Final)","summary":"Launching our Demo = Enjoy the Stream :D(This time not limited to one hour)","occurred_at":null,"published_at":"2026-10-19T06:05:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706688933","verified_at":"2026-10-20T16:43:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4753740-1846651706688325","game_id":"steam-4753740","kind":"announcement","title":"Next Fest Stream","summary":"Launching our Demo = Enjoy the Stream :D","occurred_at":null,"published_at":"2026-10-18T23:51:24Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706688325","verified_at":"2026-10-20T16:43:06Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4753740":{"last_attempt_at":"2026-10-26T04:02:37Z","status":"ok","all_sources_checked_at":"2026-10-26T04:02:37Z","error_codes":[]}},"news_last_attempt_at":{"steam-4753740":"2026-10-26T04:02:37Z"},"notices":[],"news_sources":{"4753740":{"last_attempt_at":"2026-10-26T04:02:37Z","last_success_at":"2026-10-26T04:02:37Z","status":"ok","error_codes":[]},"4755860":{"last_attempt_at":"2026-10-