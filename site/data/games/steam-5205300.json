ror_code":"no_reviews"},{"game_id":"steam-5205300","metric":"demo_ccu","observed_at":"2026-10-26T07:10:59Z","value":3,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5332000","error_code":null}],"events":[{"id":"steam-steam-5205300-1847286114039363","game_id":"steam-5205300","kind":"announcement","title":"1000+ Wishlists Thank You!","summary":"Thank you so much to everyone who wishlisted our game and thank you to the people who tried out the demo! The Coast is Clear: Tidy up the Beach just passed 1,000 wishlists last night on Steam so it was a very nice surprise to wake up to for me. Seeing this many people interested in my little beach-cleaning game means so much to me and I hope I can make the game the best it can be! If you haven't tried it out yet and fancy a relaxing trip to the beach, rescue some turtles and restoring the coral ","occurred_at":null,"published_at":"2026-10-24T10:54:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114039363","verified_at":"2026-10-24T14:41:35Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5205300-1846651706688212","game_id":"steam-5205300","kind":"update","title":"Steam Next Fest update!","summary":"Expanded the demo beach with more litter, surfboards, swim rings and flamingo floats to tidy up, plus a tide pool to explore. Added fishing with three fish species to catch and discover. Added the Litter net to scoop up floating trash from the water. Added two Autosorter levels and the Sorter Pro skill, which highlights pieces that belong in the selected bin. Added equipment preview videos in the demo shop. The poking stick now comes with a trash bag. Added clearer stain markers, scanner filters","occurred_at":null,"published_at":"2026-10-18T22:34:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706688212","verified_at":"2026-10-21T00:16:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5205300-1846018067942087","game_id":"steam-5205300","kind":"update","title":"Update 1.0.1","summary":"Added murky waterMore wildlifeSmoother edges between grass and sandFewer stuttersNew optional Share stats switch in the main menuMore minor fixesOlder demo saves can no longer be loaded, so please start a new game.","occurred_at":null,"published_at":"2026-10-12T19:21:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067942087","verified_at":"2026-10-21T00:16:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5205300-1846018067929519","game_id":"steam-5205300","kind":"announcement","title":"Demo is now available!","summary":"Hi all, I'm excited to announce that the demo of The Coast is Clear: Tidy up the Beach! is now available on steam! :) Please enjoy and check out what the game has to offer in a cozy private beach setting. You can sort, clean, swim and explore the coral reef and even play fetch with your dog! I hope you guys enjoy it as much as I enjoyed working on it! If you do, please consider wishlisting the full game here. See y'all on the beach! - vvoiddev","occurred_at":null,"published_at":"2026-10-08T12:50:13Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067929519","verified_at":"2026-10-21T00:16:51Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5205300":{"last_attempt_at":"2026-10-26T09:29:35Z","status":"ok","all_sources_checked_at":"2026-10-26T09:29:34Z","error_codes":[]}},"news_last_attempt_at":{"steam-5205300":"2026-10-26T09:29:35Z"},"notices":[],"news_sources":{"5205300":{"last_attempt_at":"2026-10-26T09: