ind":"announcement","title":"Deal Flipper — Gameplay Stream | Play the Free Demo!","summary":"Watch Deal Flipper gameplay: haggle with sellers, unbox packages, stock your shelves and flip items for profit. Try the free demo now and add Deal Flipper to your wishlist — coming November 2!","occurred_at":null,"published_at":"2026-10-19T16:26:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691078","verified_at":"2026-10-20T17:26:47Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4819030-1844115010494957","game_id":"steam-4819030","kind":"update","title":"Deal Flipper Demo Update","summary":"When we released the demo on 7 September, the game had no audio and a few systems weren't as clear as we wanted them to be. Your feedback pointed at every single one of them. Today's update is our answer to that list — and if you've played the demo before, it's big enough to be worth a second run.The game has sound now Unboxing, the register, shelving, shop ambience, notifications etc. and music are in across the whole game. The rhythm of the game is completely different now, especially while op","occurred_at":null,"published_at":"2026-09-18T14:13:30Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010494957","verified_at":"2026-10-20T17:26:47Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4819030-1842846814453263","game_id":"steam-4819030","kind":"announcement","title":"The Deal Flipper demo is out now","summary":"The Deal Flipper demo is live — free, right now.Hunt for cheap items in an online marketplace, haggle with sellers inreal-time chat, and resell them for profit. Every seller has their ownknowledge, patience, greed and stubbornness — lowball the wrong personand they'll walk away.Found a bug or want to tell us what you think? There are buttons in themain menu for both. We read everything.Full game launches November 2.","occurred_at":null,"published_at":"2026-09-07T14:34:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814453263","verified_at":"2026-10-20T17:26:47Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4819030-1841579228674061","game_id":"steam-4819030","kind":"announcement","title":"We have a release date! 🗓️","summary":"Buy low, sell high. Master the art of the deal.Deal Flipper launches November 2nd, 2026 on Steam.Hunt an endless marketplace feed, haggle with sellers in real-time chat, and flip your way from pocket change to a full trading empire. Every seller thinks, reacts, and bargains differently — read them right, and the deal is yours. 👉 Wishlist Deal Flipper now","occurred_at":null,"published_at":"2026-08-23T21:03:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228674061","verified_at":"2026-10-20T17:26:47Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4819030":{"last_attempt_at":"2026-10-26T14:29:55Z","status":"ok","all_sources_checked_at":"2026-10-26T14:29:54Z","error_codes":[]}},"news_last_attempt_at":{"steam-4819030":"2026-10-26T14:29:55Z"},"notices":[],"news_sources":{"4819030":{"last_attempt_at":"2026-10-26T14:29:54Z","last_success_at":"2026-10-26T14:29:54Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:29:54Z"},"5187470":{"last_attempt_at":"2026-10-26T14:29:55Z","last_success_at":"2026-10-26T14:29:55Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:29:55Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4819030","app_id":4819030,"app_scope":"base","observed_at":"2026-10-26T06:14:59Z","source_url":"https://api.ste