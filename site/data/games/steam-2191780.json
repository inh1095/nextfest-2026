"value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5197210","error_code":null}],"events":[{"id":"steam-steam-2191780-1846018067935771","game_id":"steam-2191780","kind":"announcement","title":"250 wishlists. Thank you! ❤️","summary":"{STEAM_CLAN_IMAGE}/46268914/80d7a1c12ffa8d61e14061aa7dd769f9b6288988.jpg We’ve added two more flags to our little map. Thank you to everyone who has wishlisted Project Burnout—it means a lot that you’re interested in what we’re making. A small preview of what’s next: we’re planning to add Spanish to the demo soon as a beta translation. It’ll still be a work in progress, and we’d love your feedback when it’s ready. Thanks for being here!","occurred_at":null,"published_at":"2026-10-10T09:01:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067935771","verified_at":"2026-10-20T10:02:11Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2191780-1844751498230538","game_id":"steam-2191780","kind":"announcement","title":"Project Burnout Demo 1.0.9","summary":"Added in-game support for bug reports, feedback, and translation issues. Stress bars now preview expected increases and recovery while you plan your week. Decision events now preview reputation gains and losses. Projects in the task tabs are now grouped by deadline, with improved visuals for dependencies and completion states, plus clearer deadline warnings. The first task tab is now automatically selected at the start of each week. Reputation bars now also display your current reputation as a n","occurred_at":null,"published_at":"2026-09-28T04:56:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498230538","verified_at":"2026-10-20T10:02:11Z","discovery_method":"official_steam_news","content_review":"source_only"},