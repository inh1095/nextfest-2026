":"steam-steam-5052630-1844751498234093","game_id":"steam-5052630","kind":"update","title":"Demo update - 0.7.0","summary":"After feedback received during first demo playtests I've made some changes to the Demo and overall game: Item/Skill roll sequence - complete rework of the previous system, new one should be clearer and faster to manage. Combat rework - I've adjusted the combat feel and added multiple effects along the way to make it clearer to the player and to boost the gamefeel.Game rebalance - due to the numerous playthroughs under 10 minutes I've decided to completetly change the pace of the game and added a","occurred_at":null,"published_at":"2026-09-29T12:40:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498234093","verified_at":"2026-10-20T21:03:45Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5052630-1844751498217444","game_id":"steam-5052630","kind":"announcement","title":"Kazfall Demo is now LIVE!","summary":"Ladies and Gentlemen! Kazfall Demo is now live for initial tests. I would love to receive any feedback on the community section on Steam or directly on Discord. Thank you for participation and enjoy! Best regards, Krzysztof","occurred_at":null,"published_at":"2026-09-23T05:51:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498217444","verified_at":"2026-10-20T21:03:45Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5052630":{"last_attempt_at":"2026-10-26T07:38:17Z","status":"ok","all_sources_checked_at":"2026-10-26T07:38:17Z","error_codes":[]}},"news_last_attempt_at":{"steam-5052630":"2026-10-26T07:38:17Z"},"notices":[],"news_sources":{"5052630":{"last_attempt_at":"2026-10-26T07:38:17Z","last_success_at":"2026-10-26T07:38:17Z","status":"ok","error_codes":[],"last_ful