/v1/","context":{"app_id":2960760,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-2960760-1847286114029795","game_id":"steam-2960760","kind":"announcement","title":"Line Tower Wars","summary":"A new map was added, inspired by the old Warcraft 3 custom game, Line Tower Wars. It can be played by up to 4 players, and possibly more in the future.Send units to the player on your right, while defending yourself against the player on your left. You get more income when sending units, so strike a balance between sending and defending to be the last player standing.","occurred_at":null,"published_at":"2026-10-21T17:37:16Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114029795","verified_at":"2026-10-21T21:45:11Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2960760-1844751498235546","game_id":"steam-2960760","kind":"announcement","title":"Demo 1.1","summary":"The new demo features a lot of balance changes, new units, new spells and terrain as well as UI upgrades. But biggest of all is the co-op feature. Play up to 4 players on the same campaign maps as the normal single player game, or play on specially designed maps for co-op, typically with 1 lane per player. Another quality of life feature worth mentioning is that you can now restart from the previous day when losing! And too many other things to mention. Try the demo and see for yourself!","occurred_at":null,"published_at":"2026-09-29T21:57:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498235546","verified_at":"2026-10-20T10:44:53Z","discovery_method":"official_steam_news","content_review":"source_only"},{