ror_code":"no_reviews"},{"game_id":"steam-5137340","metric":"demo_ccu","observed_at":"2026-10-26T06:31:15Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5326360","error_code":null}],"events":[{"id":"steam-steam-5137340-1847286114041540","game_id":"steam-5137340","kind":"announcement","title":"Demo 0.1.4: Clearer Auto Battle Controls & Map Guidance","summary":"This Demo update makes the handoff from the tutorial to your first map choices easier to follow. Auto Battle controls The combat button now distinguishes Tarot setup, Pause Auto Battle, and Resume Auto Battle. Updated the tooltip to explain that pausing takes effect after the current action. Tarot effects remain active and the spread stays locked for the battle. The tutorial explanation and completion screen now introduce the button and the B shortcut for pausing and resuming in regular battles.","occurred_at":null,"published_at":"2026-10-25T09:33:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114041540","verified_at":"2026-10-25T12:11:14Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5137340-1847286114035609","game_id":"steam-5137340","kind":"update","title":"Demo Update: Clearer First Steps","summary":"We've polished the Demo's opening tutorial to make the next action and the results of your combos easier to understand. Instructions now follow your chosen controls. Keyboard & mouse gets click instructions; camera gestures get gesture instructions and demonstrations. A camera remains optional. The Tarot explanation between your first Performance and the control selection is shorter: five dialogue beats instead of nine. The key rules for Upright/Reversed, Auto Battle, and locking your spread are","occurred_at":null,"published_at":"2026-10-23T09:20:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114035609","verified_at":"2026-10-23T10:40:47Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5137340-1846651706688772","game_id":"steam-5137340","kind":"update","title":"Demo Update — Talent Compass, Wishlist Gift & Achievements","summary":"Added a one-time support gift: visit the main game’s Steam store from the Talent Compass or your first victory/defeat result screen to receive 300 Stardust and 25 Warranty Crowns. One claim per save; wishlist membership is not checked. Talent purchases and resets are restricted to outside active runs, including suspended runs. The map utility and pause-menu shortcut now open the Encyclopedia. Clarified the Talent Compass return button as “Return to Main Menu”. Added a clearly visible Achievement","occurred_at":null,"published_at":"2026-10-19T04:10:50Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706688772","verified_at":"2026-10-20T23:10:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5137340-1846651706673029","game_id":"steam-5137340","kind":"announcement","title":"The Stop Reading the Cards Demo Is Out Now!","summary":"Hello everyone! The free demo for Stop Reading the Cards is now available on Steam. Stop Reading the Cards is a satirical single-player deckbuilding roguelike. Build a deck, define its action priorities, and watch your strategy run in automated battles. Your job is to design combos, adjust the rules, and look like you planned it when things go wrong. Visit our store page and download the demo The game is still in development, and we'd love to hear how your run went. Which combinations were fun? ","occurred_at":null,"published_at":"2026-10-14T03:20:23Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706673029","verified_at":"2026-10-20T23:10:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5137340-1844751498224542","game_id":"steam-5137340","kind":"announcement","title":"Demo Coming Soon! Registered for October Steam Next Fest","summary":"https://clan.fastly.steamstatic.com/images/46279097/43557ce96961acb3eedef71c7cb13b3f269c7276.png Hello, deck designers! The Stop Reading the Cards demo is coming soon. We've submitted it to Steam for review and are preparing for October Steam Next Fest. Put your strategy to work Stop Reading the Cards is a satirical single-player roguelike card game. Assemble a deck, decide its priorities, and turn your cards into an automated combat system. Discover combinations, watch your plan unfold, and ref","occurred_at":null,"published_at":"2026-09-25T13:23:18Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498224542","verified_at":"2026-10-20T23:10:06Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5137340":{"last_attempt_at":"2026-10-25T23:00:46Z","status":"ok","all_sources_checked_at":"2026-10-25T23:00:45Z","error_codes":[]}},"news_last_attempt_at":{"steam-5137340":"2026-10-25T23:00:46Z"},"notices":[],"news_sources":{"5137340":{"last_attempt_at":"2026-10-25T23:00:45Z","last_success_at":"2026-10-25T23:00:45Z","status":"ok","error_codes":[]},"5326360":{"last_attempt_at":"2026-10-25T23:00:46Z","last_success_at":"2026-10-25T23:00:46Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5137340","app_id":5137340,"app_scope":"base","observed_at":"2026-10-26T06:15:35Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"87253a4204d74