/v1/","context":{"app_id":4905420,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4905420-1845383656378933","game_id":"steam-4905420","kind":"update","title":"Rinha de Waifus Patch 0.5.0 Notes","summary":"Version 0.5.0 is here! ːlunar2020confidentroosterːThis update brings weather to the battlefield, a new field, battle effects recreated in pixel art, a tutorial that introduces every waifu, and battles that depend less on luck. Let's go to the changes!Weather:Battlefields now have weather: Sunny, Cloudy, Rain, Storm, Windy and Snow.Weather is rolled together with the field, and its name shows on the placement screen.In a best of 5, the weather stays the same from the start to the end of the serie","occurred_at":null,"published_at":"2026-09-30T20:59:41Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656378933","verified_at":"2026-10-20T18:28:07Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4905420-1843481262696177","game_id":"steam-4905420","kind":"update","title":"Rinha de Waifus Patch 0.4.0 Notes","summary":"Version 0.4.0 is here, and it is the biggest update since the demo launched! ːlunar2020confidentroosterːThis update brings a whole new mode with its own leaderboard, puts a real weapon in every waifu's hands, and adds a lot of visual improvements to make the battles feel more alive. Let's go to the changes!New mode: LadderBest of 5 series worth Points. Your results affect your score.Your opponent does not come from a list. It is generated dynamically, adapting to the player.The higher you climb,","occurred_at":null,"published_at":"2026-09-11T18:49:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262696177","verified_at":"2026-10-20T18:28:07Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4905420-1842846814441803","game_id":"steam-4905420","kind":"update","title":"Rinha de Waifus Patch 0.3.2 Notes","summary":"First update after the demo launch! ːsteamhappyːThis one just brings some small improvements to the menus inside the planning screen, plus a few features to make importing and exporting formation codes easier. Let's got to the changes!Formation code system rework:You can now choose which side you want to copy the code for. (Both included)You can also load codes with formations for both sides at once. Just copy using the \"Copy Both\" option, or put a \";\" between two valid codes (CODE1;CODE2).The \"","occurred_at":null,"published_at":"2026-09-03T00:25:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814441803","verified_at":"2026-10-20T18:28:07Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4905420-1842212951297407","game_id":"steam-4905420","kind":"announcement","title":"The Rinha de Waifus demo is available!","summary":"Steam has just approved Rinha de Waifus demo!Leading up to the launch, we’ll be treating the demo as an open playtest. It will feature all the latest game updates and new content. Your feedback is highly welcome, as it will help me shape the future of Rinha de Waifus.I truly hope you have as much fun with RDW as I do!","occurred_at":null,"published_at":"2026-08-26T16:03:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951297407","verified_at":"2026-10-20T18:28:07Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4905420":{"last_attempt_at":"2026-10-26T05:10:21Z","status