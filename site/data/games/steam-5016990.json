efore you ha","occurred_at":null,"published_at":"2026-09-25T06:53:50Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498223544","verified_at":"2026-10-20T20:19:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5016990-1842846814454604","game_id":"steam-5016990","kind":"announcement","title":"The free demo is out now","summary":"Desktop Forge — the free demo is out now Hi, I'm Nulpoyo. The little forge that runs in the corner of your desktop is now something you can actually play. What's in the demo It runs to workshop rank 20 — around 5 to 10 hours of play After that the rank stops, but you can keep forging, appraising, arming adventurers, filling the codex and climbing the leaderboards The demo stays up after Steam Next Fest (starting 20 October) What the game is Every artisan has their own traits, specialties, likes ","occurred_at":null,"published_at":"2026-09-08T03:34:51Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814454604","verified_at":"2026-10-20T20:19:30Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5016990":{"last_attempt_at":"2026-10-26T07:14:59Z","status":"ok","all_sources_checked_at":"2026-10-26T07:14:59Z","error_codes":[]}},"news_last_attempt_at":{"steam-5016990":"2026-10-26T07:14:59Z"},"notices":[],"news_sources":{"5016990":{"last_attempt_at":"2026-10-26T07:14:59Z","last_success_at":"2026-10-26T07:14:59Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T07:14:59Z"},"5069600":{"last_attempt_at":"2026-10-26T07:14:59Z","last_success_at":"2026-10-26T07:14:59Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T07:14:59Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5016990","app_id":5016990,"app_scope":"base","observed_at":"