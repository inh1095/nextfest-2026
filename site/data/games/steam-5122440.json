ror_code":"no_reviews"},{"game_id":"steam-5122440","metric":"demo_ccu","observed_at":"2026-10-26T06:27:22Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5148100","error_code":null},{"game_id":"steam-5122440","metric":"price_final","observed_at":"2026-10-26T10:31:31Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5122440,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-5122440","metric":"review_count","observed_at":"2026-10-26T10:31:31Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5122440,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-5122440","metric":"review_positive_percent","observed_at":"2026-10-26T10:31:31Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5122440,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-5122440","metric":"demo_ccu","observed_at":"2026-10-26T11:40:56Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5148100","error_code":null}],"events":[{"id":"steam-steam-5122440-1846018067936241","game_id":"steam-5122440","kind":"announcement","title":"The Demo Finally Has Its Sound","summary":"Hey all. First, an apology: until this update, the demo never played its music, and every sound effect was a placeholder beep. That's fixed, so turn it up. On top of that, every boss can now end your run, every stage opens with its own entrance, the city's props stand up off the floor, and there's a long list of fixes, plenty of them for online co-op.The demo has its soundThe music plays, from the main menu through both districts and their boss fights to the results.Sound effects play their real","occurred_at":null,"published_at":"2026-10-10T13:09:12Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067936241","verified_at":"2026-10-20T22:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5122440-1845383656389106","game_id":"steam-5122440","kind":"announcement","title":"The Subway is Open","summary":"Hey all. This is the biggest demo update we've done. The Subway is open, with its own Deep at the end of the line. Every run now fields its own roster of machines, and twelve of them are brand new. Elites can now take you down in one blow, and they show you exactly when it's coming. There's a CODEX, a paint shop, a map you can drive with a mouse, sixteen new cards and a long list of fixes. Grab a drink. Here's everything.The Subway is openBeat the PRIME Warden to clear the Streets, and the Subwa","occurred_at":null,"published_at":"2026-10-03T12:48:46Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656389106","verified_at":"2026-10-20T22:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5122440-1844751498226697","game_id":"steam-5122440","kind":"announcement","title":"Elites are back","summary":"Another week, another demo update, and this one is a big one. Elites are back as a proper tier: sixteen new machines, each with a move of its own. The whole horde moves now too, with legs that walk and bodies that come apart when they die. Enemy attacks got clearer warnings, and anyone who joins a friend's game gets a round of fixes. Here's everything.Elites are backUntil now, elites were just regular machines made bigger, tougher and purple. Those are gone. Instead, about every minute and a hal","occurred_at":null,"published_at":"2026-09-26T07:18:07Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498226697","verified_at":"2026-10-20T22:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5122440-1844115010497148","game_id":"steam-5122440","kind":"announcement","title":"Commanders Have Arrived","summary":"Hey all. A week after the last demo update, here's another one. There's one big new thing in it, Horde Commanders, and a long list of fixes. A few of those fixes are for bugs in the last build that were honestly pretty significant, so if something felt off when you played it, there's a good chance it's sorted below.Horde CommandersThe horde has officers now. From around the three-minute mark, every second elite that spawns is a Commander. A Commander doesn't carry a gun. It stays back behind its","occurred_at":null,"published_at":"2026-09-19T13:31:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010497148","verified_at":"2026-10-20T22:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5122440-1843481262697068","game_id":"steam-5122440","kind":"announcement","title":"The City Plays Too","summary":"This is a big one. Nothing in it is a new place to go — it's the same twenty minutes, and it looks and sounds like a different game.The city plays tooThe pitch has always been that the city is the enemy. Mechanically it wasn't; it was furniture. You levelled, drew three, took one and compounded, and the city answered by spawning more things.Now it drafts as well. At minute three, and every three and a half minutes after, the city takes something and keeps it. It never takes the same thing twice,","occurred_at":null,"published_at":"2026-09-12T07:54:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262697068","verified_at":"2026-10-20T22:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5122440-1842846814455787","game_id":"steam-5122440","kind":"announcement","title":"There's a city under the city","summary":"There's a city under the cityKill the PRIME Warden and the ground opens.THE GATE IS OPEN. Take it and you go down into the Interchange — a whole second act underneath District 1, with its own Warden, its own landmarks, and no way back up once you commit. There's a gatehouse on the way in: you get staged, healed and handed a draft before the door shuts, because what's down there does not care that you just killed a boss.Then you hold. Survive the Final Stand and you extract with Cores. Don't, and","occurred_at":null,"published_at":"2026-09-08T14:15:14Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814455787","verified_at":"2026-10-20T22:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5122440-1842212951307698","game_id":"steam-5122440","kind":"announcement","title":"Now In Your Language","summary":"Now in your languageSCRAPSTORM plays in German, Spanish, French, Brazilian Portuguese, Russian, Japanese, Korean and Simplified Chinese, alongside English.Not just the menus — card text, help text, the results screen, and every achievement name and description. The game's own title travels too: in Chinese, Japanese and Korean it's 废铁风暴, スクラップストーム and 스크랩스톰. \"SCRAPSTORM\" in Latin letters isn't a name in those markets, it's a puzzle.It also picks your language on its own now. It asks Steam what yo","occurred_at":null,"published_at":"2026-08-30T14:47:14Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951307698","verified_at":"2026-10-20T22:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5122440":{"last_attempt_at":"2026-10-26T08:24:54Z","status":"ok","all_sources_checked_at":"2026-10-26T08:24:54Z","error_codes":[]}},"news_last_attempt_at":{"steam-5122440":"2026-10-26T08:24:54Z"},"notices":[],"news_sources":{"5122440":{"last_attempt_at":"2026-10-26T08:24:54Z","last_success_at":"2026-10-26T08:24:54Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:24:54Z"},"5148100":{"last_attempt_at":"2026-10-26T08:24:54Z","last_success_at":"2026-10-26T08:24:54Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:24:54Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5122440","app_id":5122440,"app_scope":"base","observed_at":"2026-10-26T06:15:33Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"1f9ce0dfcc06441f5ca1006b4a83109a1ec3b863086aa68c419bec89e92dcbbc","response_sha256":null,"source_fields":{"basic_info":{"short_description":"도시 전체가 당신을 사냥하는 1-4인용 탄막 서바이버 로그라이트. 레벨마다 카드를 드래프트해 빈약한 권총을 화면을 뒤덮는 참사로 바꿔라. 차량 흐름과 제3궤조, 그리고 각 구역을 쥐고 있는 것을 조심할 것.","publishers":[{"name":"Pixiliated"}],"developers":[{"name":"Pixiliated"}]},"release":{"is_coming_soon":true,"custom_release_date_message":"출시 예정","coming_soon_display":"text_comingsoon","is_early_access":true},"trailers":{"