/v1/","context":{"app_id":4141460,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4141460-1843481262703508","game_id":"steam-4141460","kind":"announcement","title":"New Fighter Introduced!","summary":"Meet D'Artagnan. Sneaky little guy. He's got a dangerous uppercut, and watch out for his dirty tactics! There are also more bug fixes. Revamped cutscenes, some new artwork, crowd anims and sounds and more. Some tweaks to the combat have landed too with more to come! Thanks!Rodrigo","occurred_at":null,"published_at":"2026-09-15T03:49:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262703508","verified_at":"2026-10-20T12:57:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4141460-1842212951314732","game_id":"steam-4141460","kind":"announcement","title":"We're Back With Major Bug Fixes","summary":"Language and keybindings were written to the same file by two systems, neither of which loaded before saving — so rebinding keys then changing language wiped your bindings, and vice versa. Fixed. Borderless Fullscreen and Windowed now supported. Language can be selected from the main menu and pause menu now. We will be making some gameplay tweaks as well. Some visual tweaks to lessen visual \"noise\" with so many popups at once. Dialogue tweaks, much more! Thanks for hanging in there with me!Rodri","occurred_at":null,"published_at":"2026-09-01T21:16:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951314732","verified_at":"2026-10-20T12:57:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4141460-1822556746164829","game_id":"steam-4141460","kind":"announcement","title":"Balancing, Improvements and Bug Fixes","summary":"🥊 New Health Bar UI Fresh new health bar design that better fits the game's aesthetic. Visual Feedback ImprovementsHealth bars flash red when critically lowStamina bars flash cyan when running low - watch your energy! Combat BalancePunches are faster across the board - combat feels snappier!Jabs no longer counter enemy attacks - use your stronger punches to counterFixed a bug where liver shots were causing knockdowns too easily Bug Fixes & PolishVarious stability improvementsUI tweaks","occurred_at":null,"published_at":"2026-01-25T04:28:04Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1822556746164829","verified_at":"2026-10-20T12:57:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4141460-1822556746157488","game_id":"steam-4141460","kind":"update","title":"Demo Available + First Update – We Listened to Your Feedback","summary":"The Fight Like a Chicken demo is live – and it just got better.After hearing from early players, I've already shipped improvements:WHAT'S NEW:- Rematch system – Jump back into any fight without replaying earlier ones- Expanded tutorials – Clearer guidance on timing mechanics and defensive optionsWHAT'S IN THE DEMO:- 3 story fights – from tutorial to tank to pure aggression- 1 bonus fight – unlocks after completing the demo- 20-25 minutes of hand-drawn, timing-based combatYou play as Benny Bantam","occurred_at":null,"published_at":"2026-01-21T18:56:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1822556746157488","verified_at":"2026-10-20T12:57:32Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4141460":{"last_attempt_at":"2026-10-26T01:46:48Z","status":"ok","all_sources_checke