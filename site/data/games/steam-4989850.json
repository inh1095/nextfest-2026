pening inside your facil","occurred_at":null,"published_at":"2026-10-19T12:22:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706689981","verified_at":"2026-10-20T19:56:26Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4989850-1846651706684239","game_id":"steam-4989850","kind":"announcement","title":"Demo 0.1.18: Research, Early Automation & Save Changes","summary":"Hello everyone! Version 0.1.18 brings a new technology tree, early facilities that help you move from manual synthesis toward automation, and a range of improvements to controls, reminders and voice lines.Please read the save information below before deciding whether to continue your old world or start again in the new version.IMPORTANT: A fresh start is requiredThis update reworks research and early facility progression. Progress from version 0.1.17 and earlier cannot be imported into 0.1.18. Y","occurred_at":null,"published_at":"2026-10-17T10:13:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706684239","verified_at":"2026-10-20T19:56:26Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4989850":{"last_attempt_at":"2026-10-26T05:55:56Z","status":"ok","all_sources_checked_at":"2026-10-26T05:55:55Z","error_codes":[]}},"news_last_attempt_at":{"steam-4989850":"2026-10-26T05:55:56Z"},"notices":[],"news_sources":{"4989850":{"last_attempt_at":"2026-10-26T05:55:55Z","last_success_at":"2026-10-26T05:55:55Z","status":"ok","error_codes":[]},"5000200":{"last_attempt_at":"2026-10-26T05:55:56Z","last_success_at":"2026-10-26T05:55:56Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4989850","app_id":4989850,"app_scope":"base","observed_at":"2026-10-26T06:15:14Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"1c090d31b9de99e4ba614d1bca12c2afe4380e1a93f74914fb409dfbdf901998","response_sha256":null,"source_fields":{"basic_info":{"short_description":"물, 바람, 흙, 돌에서 시작해 카드 조합으로 나만의 문명을 만들어 보세요. 자원 관리와 자동화에 메타 요소를 더한 이 게임에서는 새로운 제작법을 발견하고, 일꾼에게 일을 맡기고, 생산 라인을 연결하며 작은 시작을 별을 향한 여정으로 바꿔 갑니다. 새로운 발견은 또 다른 조합의 출발점이 됩니다. 조합한 카드들이 하나둘 모여, 눈앞의 캔버스가 살아 움직이는 세계로 변하는 모습을 지켜보세요. 혹은… 곁에 있는 내레이터에게 장난을 쳐 보는 건 어떨까요? 당신의 엉뚱한 조합과 새로운 시도에는 그도 한마디 보탤 준비가 되어 있으니까요.","publishers":[{"name":" Geometry Workshop"}],"developers":[{"name":" Geometry Workshop"}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_month"},"trailers":{"highlights":[{"trailer_name":"概念宣传片","trailer_url_format":"steam/apps/${FILENAME}?t=1791226859","trailer_category":0,"microtrailer":[{"filename":"4989850/912244615/c5d1444ef9cf766b943d62243fb007496c1ad198/1791224488/microtrailer.webm","type":"video/webm"},{"filename":"4989850/912244615/c5d1444ef9cf766b943d62243fb007496c1ad198/1791224488/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4989850/912244615/c5d1444ef9cf766b943d62243fb007496c1ad198/1791224488/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"4989850/912244615/c5d1444ef9cf766b943d62243fb007496c1ad198/1791224488/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"4989850/912244615/c5d1444ef9cf766b943d62243fb007496c1ad198/1791224488/hls_264_master.m3u8","encoding":"hls_h264"}],"screenshot_medium":"257447606/77931975b89ad96da802c8211c316c05281b222e/movie_600x337.jpg","screenshot_full":"257447606/77931975b89ad96da802c8211c316c05281b222e/movie_full.jpg","trailer_base_id":1363341,"all_ages":true},{"trailer_name":"采访现场","trailer_url_format":"steam/apps/${FILENAME}?t=1791226859","trailer_category":0,"microtrailer":[{"filename":"4989850/1756823187/fe7a6d192f23227e0719b9c1782c7a66414