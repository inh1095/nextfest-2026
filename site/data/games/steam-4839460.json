ong way around. Whateve","occurred_at":null,"published_at":"2026-07-18T09:05:51Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1838407329261526","verified_at":"2026-10-20T17:48:18Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4839460":{"last_attempt_at":"2026-10-26T14:50:05Z","status":"ok","all_sources_checked_at":"2026-10-26T14:32:15Z","error_codes":[]}},"news_last_attempt_at":{"steam-4839460":"2026-10-26T14:50:05Z"},"notices":[],"news_sources":{"4839460":{"last_attempt_at":"2026-10-26T14:32:15Z","last_success_at":"2026-10-26T14:32:15Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:32:15Z"},"4872910":{"last_attempt_at":"2026-10-26T14:50:05Z","last_success_at":"2026-10-26T14:50:05Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:50:05Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4839460","app_id":4839460,"app_scope":"base","observed_at":"2026-10-26T06:15:00Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"4d6b7983b5e2e426501605e712ef7ef55479d95bca2b405ef92971dc041843bd","response_sha256":null,"source_fields":{"basic_info":{"short_description":"탄막 전투, 암시장 거래, 성간 전략 사이에서 분기형 성도 항로를 직접 설계하세요. 산탄·미사일·유도·레이저 네 무기군을 자유롭게 조합하고, 100종 이상의 아이템과 30종 이상의 무작위 성도 이벤트에 맞서세요. 매 출격마다 화력과 빌드가 바뀌고, 매 항해가 달라집니다. 미지의 성계에서 위험과 보상을 저울질하며, 불꽃과 성운 사이에 당신만의 궤적을 새기세요.","publishers":[{"name":"Starzen Interactive"}],"developers":[{"name":"Starzen Interactive"}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_year"},"trailers":{"highlights":[{"trailer_name":"Stardust Protocol Video-English","trailer_url_format":"steam/apps/${FILENAME}?t=1792398387","trailer_category":2,"micro