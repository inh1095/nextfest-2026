ind":"announcement","title":"Next Fest Demo is LIVE!","summary":"Next Fest is here, and so is the demo! As a reminder, this free demo for Sol Protocol lasts from October 19th to the 26th, and includes the tutorial alongside three sectors to explore in multiplayer. If you need help finding a crew, be sure to join our Discord where you can more easily coordinate with other players and let us know what you think. We hope you have fun and stay tuned for more news on Sol Protocol's upcoming Steam release!","occurred_at":null,"published_at":"2026-10-19T19:38:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706692467","verified_at":"2026-10-20T13:20:59Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4250370-1846651706683154","game_id":"steam-4250370","kind":"announcement","title":"Sol Protocol is Coming to Next Fest!","summary":"Sol Protocol is coming to Next Fest! After a good couple weeks of ironing out bugs and getting our builds in order, we are finally ready to announce that we will have a free demo for Sol Protocol during Steam's Next Fest from October 19th to the 26th. This demo is specifically made with introducing new players in mind, with it including the tutorial and three sectors to explore in multiplayer. We're hoping this will be a great way to introduce a wider audience to what Sol Protocol is all about a","occurred_at":null,"published_at":"2026-10-16T21:32:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706683154","verified_at":"2026-10-20T13:20:59Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4250370-1841579228669734","game_id":"steam-4250370","kind":"announcement","title":"Crossplay Playtest Set for End of August","summary":"It's been some time since we've had news for the Steam version of Sol Protocol, but now we are happy to announce that you'll be able to player even earlier than early access! While we're not quite ready for early access on Steam just yet (keep your eyes on October), our alpha tests over on the Sol Protocol Discord can now support PCVR players. Crossplay is also enabled, so whatever headset or storefront you're on, you'll be able to play together. Our next playtest is set for the end of August, s","occurred_at":null,"published_at":"2026-08-21T18:29:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228669734","verified_at":"2026-10-20T13:20:59Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4250370":{"last_attempt_at":"2026-10-26T11:46:41Z","status":"ok","all_sources_checked_at":"2026-10-26T11:46:41Z","error_codes":[]}},"news_last_attempt_at":{"steam-4250370":"2026-10-26T11:46:41Z"},"notices":[],"news_sources":{"4250370":{"last_attempt_at":"2026-10-26T11:46:41Z","last_success_at":"2026-10-26T11:46:41Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T11:46:41Z"},"5326070":{"last_attempt_at":"2026-10-26T11:46:41Z","last_success_at":"2026-10-26T11:46:41Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T11:46:41Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4250370","app_id":4250370,"app_scope":"base","observed_at":"2026-10-26T06:14:30Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"e12d6c3764bb99501aa4db335bffef56fdc3bf283fe5fa516fb943679c1f20d0","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Sol Protocol is a dynamic VR Co-Op roguelike where you team up and physically pilot a spaceship through dangerous, procedurally generated stellar systems. Manage your spaceship, man the turrets, explore abandoned stations on foot, and make strategic decisions as you push deeper into the deep space.","publishers":[{"name":"Singular Perception"}],"developers":[{"name":"Singular Perception"}]},"release":{"steam_release_date":1794420000,"is_coming_soon":true,"coming_soon_display":"date_full","is_early_access":true},"trailers":{"highlights":[{"trailer_name":"October Early Access Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1792571468","trailer_category":1,"microtrailer":[{"filename":"4250370/684272850/fd53ea071f4f45e4f215c536b2c2456c68d404e4/1792102647/microtrailer.webm","type":"video/webm"},{"filename":"4250370/684272850/fd53ea071f4f45e4f215c536b2c2456c68d404e4/1792102647/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4250370/684272850/fd53ea071f4f45e4f215c536b2c2456c68d404e4/1792102647/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"4250370/684272850/fd53ea071f4f45e4f215c536b2c2456c68d404e4/1792102647/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"4250370/684272850/fd53ea071f4f45e4f215c536b2c2456c68d404e4/1792102647/hls_264_master.m3u8","encoding":"hls_h264"}],"screenshot_medium":"257432945/10172c5184434c706cf9b06fa7636a357a6e9e39/movie_600x337.jpg","screenshot_full":"257432945/10172c5184434c706cf9b06fa7636a357a6e9e39/movie_full.jpg","trailer_base_id":1341520,"all_ages":true},{"trailer_name":"Sol Protocol - Steam Release Window Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1792571469","trailer_category":1,"microtrailer":[{"filename":"4250370/690201849/61bba424544b3ce3d709a6675d6509b8dec6228b/1782205753/microtrailer.webm","type":"video/webm"},{"filename":"4250370/690201849/61bba424544b3ce3d709a6675d6509b8dec6228b/1782205753/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4250370/690201849/61bba424544b3ce3d709a6675d6509b8dec6228b/1782205753/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"4250370/690201849/61bba424544b3ce3d709a6675d6509b8dec