ouncements/1845383656388063","verified_at":"2026-10-20T15:12:14Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4589160-1833334318575971","game_id":"steam-4589160","kind":"announcement","title":"Aptamirror Demo is LIVE!","summary":"The Aptamirror demo is now playable on Steam.Fold molecules into target shapes across 20 puzzles spanning the first four chapters of the full game. The demo includes the introduction to all four folding tools (Grab, Mutate, Cleave, Ligate) and demonstrates the meditative puzzle approach the full game will explore in depth in the full release. The full game launches in Q4 2026 with 50 puzzles across 10 chapters... or maybe more if your skills are up to the tests ahead.If you enjoy the demo, pleas","occurred_at":null,"published_at":"2026-05-24T20:24:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318575971","verified_at":"2026-10-20T15:12:14Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4589160":{"last_attempt_at":"2026-10-26T12:54:38Z","status":"ok","all_sources_checked_at":"2026-10-26T12:54:38Z","error_codes":[]}},"news_last_attempt_at":{"steam-4589160":"2026-10-26T12:54:38Z"},"notices":[],"news_sources":{"4589160":{"last_attempt_at":"2026-10-26T12:54:38Z","last_success_at":"2026-10-26T12:54:38Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T12:54:38Z"},"4718410":{"last_attempt_at":"2026-10-26T12:54:38Z","last_success_at":"2026-10-26T12:54:38Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T12:54:38Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4589160","app_id":4589160,"app_scope":"base","observed_at":"2026-10-26T06:14:41Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","err