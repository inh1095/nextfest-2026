/v1/","context":{"app_id":4878750,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4878750-1841579228673977","game_id":"steam-4878750","kind":"announcement","title":"DEMO 1.0.2","summary":"DEMO UPDATE 1.0.2 is now available!While I continue working on the full game, I’m also adding improvements and fixes to the DEMO. A new monster is now available. I call him Astroman. He will play an important role in the story. New gameplay elements have also been added.Download the DEMO here:I’d also be very happy if you joined my Discord server and shared your thoughts about the game. I’m active there and can listen to your feedback: https://discord.gg/gDNqWgrS56","occurred_at":null,"published_at":"2026-08-23T19:44:14Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228673977","verified_at":"2026-10-20T18:05:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4878750-1841579228668579","game_id":"steam-4878750","kind":"announcement","title":"CO-OP DEMO","summary":"Dear friends, after releasing the first DEMO, I noticed that quite a lot of players jumped in right away. The DEMO is a one-hour single-player story experience. I decided to expand the DEMO and open up the co-op mode for you. I’ve released an update where you can now test CO-OP. Welcome!You can download the DEMO here:I’d also be very happy if you joined my Discord server and shared your thoughts about the game. I’m active there and will be able to listen to your feedback: https://discord.gg/gDNq","occurred_at":null,"published_at":"2026-08-21T12:28:55Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228668579","verifi