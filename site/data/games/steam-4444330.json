/v1/","context":{"app_id":4444330,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4444330-1846651706692065","game_id":"steam-4444330","kind":"update","title":"Demo Update v0.8.0+alpha!","summary":"A small update to celebrate Steam Next Fest! AddedAdded Discord Rich Presence support. Shows what level you are currently playing and for how long.Added new achievement icons for a few achievements.Added new setting: VSync. This was always enabled before, but now players can toggle it off as they please. When toggled off, the game will target the monitor's refresh rate without synchronizing to it.ChangedIncreased the rate of particles that appear when a block is placed on a target location, to m","occurred_at":null,"published_at":"2026-10-19T18:09:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706692065","verified_at":"2026-10-20T14:26:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4444330-1839041357036623","game_id":"steam-4444330","kind":"update","title":"Demo Update v0.7.1+alpha!","summary":"Small patch to the Quackoban Demo to help with some resolution issues that playtesters have reported - along with another master volume slider setting.AddedAdded new resolution picker in settings menu, to allow for more flexibility in choosing a resolution. (or rather... to be able to correct the incorrectly detected resolution at startup).Added new master volume slider in settings.ChangedImproved logging for debugging purposes.FixedFixed issue where game would occasionally render at sub-pixel p","occurred_at":null,"published_at":"2026-07-27T19:58:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839041357036623","verified_at":"2026-10-20T14:26:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4444330-1834602721193512","game_id":"steam-4444330","kind":"update","title":"Demo Update v0.7.0+alpha!","summary":"Summer's here and another update to the Quackoban Demo has arrived!TL;DR: Made some levels a bit less tedious, all levels now count towards progress locks, and less backtracking when you've finished a region with multiple ways back to the main island!ChangedLevel Windmill hopefully a bit less tedious with fewer required moves to complete.Level soko... something also a bit less tedious with fewer blocks to move around.Added separate review and wishlist buttons at the end of the demo, to hopefully","occurred_at":null,"published_at":"2026-06-06T11:19:33Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1834602721193512","verified_at":"2026-10-20T14:26:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4444330-1830797770240219","game_id":"steam-4444330","kind":"update","title":"Demo Update v0.6.0+alpha!","summary":"Hey everyone! About 2 weeks have passed since the demo's release, and I've got some updates for you all!TL;DR: Added a few more levels, undo/redo now speeds up when holding them down, and fixed some UI issues.Added Added a few new levels to the demo. Added Swedish translation.Changed Level names are now shown at the top of the screen for 5 seconds instead of 2. Skipping a level can now only be done after 3 minutes of playing, instead of 1 minute. Southern snowy region has now been split into two","occurred_at":null,"published_at":"2026-04-26T14:07:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1830797770240219","verified_at":"2026-10-20T14:26:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4444330-1830163047255931","game_id":"steam-4444330","kind":"announcement","title":"Quackoban Demo is LIVE!","summary":"Hey everyone! I'm very happy to announce that the FREE Quackoban Demo is finally here for all of you to try out! It should serve as a bit of a taste test for what you can expect in the full game, it features:11 Levels!3 Achievements!3 unlockable ducks, (and 1 bonus non-duck...) and 2 unlockable hats!It touches almost all of the currently available mechanics in the game, however, some mechanics are only seen for certain alternative solutions for certain levels... I'll let you figure that out by y","occurred_at":null,"published_at":"2026-04-15T20:18:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1830163047255931","verified_at":"2026-10-20T14:26:41Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4444330":{"last_attempt_at":"2026-10-26T02:31:23Z","status":"ok","all_sources_checked_at":"2026-10-26T02:31:23Z","error_codes":[]}},"news_last_attempt_at":{"steam-4444330":"2026-10-26T02:31:23Z"},"notices":[],"news_sources":{"4444330":{"last_attempt_at":"2026-10-26T02:31:23Z","last_success_at":"2026-10-26T02:31:23Z","status":"ok","error_codes":[]},"4523490":{"last_attempt_at":"2026-10-26T02:31:23Z","last_success_at":"2026-10-26T02:31:23Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4444330","app_id":4444330,"app_scope":"base","observed_at":"2026-10-26T06:14:37Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"e1e389be06c2ae74ebae5239f4eebf8358990b198fe0f4824b732419be32b4cc","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Quackoban에서는 블록을 밀어 합체시키고, 텔레포트하고, 그룹으로 이동시켜야 합니다. 고전적인 '소코반' 방식에 신선한 영감을 더해, '도형' 단위로 사고해야 하는 새로운 차원의 퍼즐을 선보입니다.","publishers":[{"name":"kronkware"}],"developers":[{"name":"kronkware"}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_quarter"},"trailers":{"highlights":[{"trailer_name":"Quackoban Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1773088902","trailer_category":1,"microtrailer":[{"filename":"4444330/1374662454/620b3f120a57f1dbc11199ac024bbf3eff1c04de/1773000864/microtrailer.webm","type":"video/webm"},{"filename":"4444330/1374662454/620b3f120a57f1dbc11199ac024bbf3eff1c04de/1773000864/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4444330/1374662454/620b3f120a57f1dbc11199ac024bbf3eff1c04de/1773000864/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"4444330/1374662454/620b3f120a57f1dbc11199ac024bbf3eff1c04de/1773000864/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"4444330/1374662454/620b3f120a57f1dbc11199ac024bbf3eff1c04de/1773000864/hls_264_master.m3u8","encoding":"hls_h264"}],"screenshot_medium":"257299160/7dc78c65cb56bd1fd9e028379393207e15fa988f/movie_600x337.jpg","screenshot_full":"257299160/7dc78c65cb56bd1fd9e028379393207e15fa988f/movie_full.jpg","trailer_base_id":1126199,"all_ages":true}]}},"field_present":{"basic_info":true,"release":true,"trailers":true},"field_status":{"basic_info":"ok","release":"ok","trailers":"ok"},"field_errors":{},"developers":["kronkware"],"publishers":["kronkware"],"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_quarter"},"trailers":{"highlights":[{"trailer_name":"Quackoban Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1773088902","trailer_category":1,"microtrailer":[{"filename":"4444330/1374662454/620b3f120a57f1dbc11199ac024bbf3eff1c04de/1773000864/microtrailer.webm","type":"video/webm"},{"filename":"4444330/1374662454/620b3f120a57f1dbc11199ac024bbf3eff1c04de/1773000864/microtrailer.mp4",