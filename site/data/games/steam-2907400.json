/v1/","context":{"app_id":2907400,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-2907400","metric":"demo_ccu","observed_at":"2026-10-26T07:33:40Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5209360","error_code":null}],"events":[{"id":"steam-steam-2907400-1847286114035758","game_id":"steam-2907400","kind":"announcement","title":"Hokko Spaces is Steam Deck Verified! ✅","summary":"Hey residents! 👋 We're excited to announce that Hokko Spaces is Steam Deck Verified! ✅🎉 We're thrilled that handheld Steam players will be able to enjoy our game on Steam Deck, both from the comfort of your home and on the move 🥳 🥳 Hokko Spaces launches on 29th October on SteamNot long now 👀 Hokko Spaces launches in just six days time!We're so excited for players to get hands-on with the full game at the end of the month! Discover more about our game and release date below:Keep up with all thing","occurred_at":null,"published_at":"2026-10-23T10:00:41Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114035758","verified_at":"2026-10-23T11:41:44Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2907400-1847286114029412","game_id":"steam-2907400","kind":"announcement","title":"Devlog #4 - World Building 🌍⛏️ | Hokko Spaces","summary":"Hey residents! 👋 Welcome to our fourth and final Hokko Spaces Devlog before launch with Robert Tatnell! 👋 In today's Devlog, we cover off all things world building in Hokko Spaces, including world-building tools, terrain block types, and more! 🌱💗 Play our demo in Steam Next Fest!Our Steam Demo is out now, and we also have a new Design Contest! Create Patches' Spring Escape in our template demo space, and one contest winner will receive a Deluxe Edition copy of Hokko Spaces when the game launches","occurred_at":null,"published_at":"2026-10-21T16:00:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114029412","verified_at":"2026-10-21T16:25:46Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2907400-1846651706677617","game_id":"steam-2907400","kind":"announcement","title":"Hokko Spaces launches on 29th October for Steam! 🌱🎉","summary":"Hey residents! 👋 We're thrilled to share that Hokko Spaces launches on 29th October on Steam. We're so excited for players to get hands-on with the full game at the end of the month! Hokko Spaces is a creative sandbox game! You'll design miniature diorama worlds and complete tasks to unlock villagers. Once in your space, villagers interact with the environment built for them! 🌱 Demo Now LiveCan't wait until 29th October? We've got you covered! 🤝 Our Steam Demo is currently live, where you can jo","occurred_at":null,"published_at":"2026-10-15T13:00:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706677617","verified_at":"2026-10-20T10:44:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2907400-1846651706674761","game_id":"steam-2907400","kind":"announcement","title":"Devlog #3 - Weather & Lighting 🌧️🌞 | Hokko Spaces","summary":"Hey residents! 👋 Our third Devlog for Hokko Spaces is out now with solo-dev Robert Tatnell! In this Devlog, we explore the weather and lighting in Hokko Spaces, the dynamic time-of-day system, the particle effects of water in the game, background scenery, and more! 🌧️🌞🥳 Demo Now Live!Our Steam Demo is out now, and we also have a new Design Contest! Create Patches' Spring Escape in our template demo space, and one contest winner will receive a Deluxe Edition copy of Hokko Spaces when the game lau","occurred_at":null,"published_at":"2026-10-14T16:00:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706674761","verified_at":"2026-10-20T10:44:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2907400-1846018067926434","game_id":"steam-2907400","kind":"announcement","title":"Devlog #2 - Items 🔭 | Hokko Spaces","summary":"Hey residents! 👋 We've just released our second Devlog for Hokko Spaces with solo-dev Robert Tatnell! 🌱In today's Devlog, we look at items in Hokko Spaces, including what items are in the game, how villagers interact with the items you place, and how interactable areas are built into the game, which allow multiple villagers to interact with one item in Hokko Spaces and more!🥳 Demo Now Live!In case you missed it, our Steam Demo is now live! Jump into our Demo and build cozy spaces for our cute vi","occurred_at":null,"published_at":"2026-10-07T15:00:07Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067926434","verified_at":"2026-10-20T10:44:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2907400-1845383656396347","game_id":"steam-2907400","kind":"announcement","title":"Patches' Spring Escape Design Contest 🌸🎨| Demo Live for Hokko Spaces","summary":"Hey residents! 👋 Patches needs your help sprucing up this space, as the Hokko Spaces Demo is now live! 🥳🌸 Patches' Spring Escape Design Contest Patches is relaxing on an empty island, but needs your help making this space a true Spring Escape! 🍃 Download our demo on our Steam page, design this template Space, and send your island design entries to us via the Wonderscope Games \\ Discord server or share your creations on socials with #HokkoSpacesContest to enter!If you're in need of inspiration, S","occurred_at":null,"published_at":"2026-10-06T13:00:48Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656396347","verified_at":"2026-10-20T10:44:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2907400-1845383656378177","game_id":"steam-2907400","kind":"announcement","title":"Devlog #1 - Villagers 👋 | Hokko Spaces","summary":"Hey residents! 👋 Welcome to our first Video Devlog for Hokko Spaces, covering all things Villagers! Discover how solo dev Robert Tatnell worked on the character designs for Hokko Life, how they were converted into Hokko Spaces, and some of the ideas and inspirations behind Hokko's animation style.If you enjoy the Video Devlog, then we have good news! 🥳 We have a couple of more videos covering the development of Hokko Spaces with Robert, all dropping over the next few weeks. Keep your eyes peeled","occurred_at":null,"published_at":"2026-09-30T16:00:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656378177","verified_at":"2026-10-20T10:44:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2907400-1844115010501307","game_id":"steam-2907400","kind":"announcement","title":"Thank you for taking part in our Playtest! 💖 September Playtest Finished","summary":"Hey residents! 👋 Our September Playtest for Hokko Spaces is now finished. We wanted to thank you all for joining both our second Playtest and our first Design Contest.Leonard has LOVED seeing all his new island designs and can't wait to announce the contest winner before the end of the month 💗 Keep an eye on our socials and Discord for the winner announcement! If you missed out on our September Steam Playtest, don't worry! We'll be back next month with another Playtest for our peaceful sandbox g","occurred_at":null,"published_at":"2026-09-21T13:00:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010501307","verified_at":"2026-10-20T10:44:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2907400-1842846814453035","game_id":"steam-2907400","kind":"announcement","title":"Leonard's Island Design Contest 🏝️🎨| September Playtest Live | Hokko Spaces","summary":"Hey residents! 👋 Our second playtest for Hokko Spaces is now live, and this time, we have a special Contest for you to take part in... 👀 🏝️ Leonard's Island Design Contest Leonard is on an empty desert island and needs your help renovating it! Jump into our playtest, design this template Space, and send your island design entries to us via the Wonderscope Games \\ Discord server.We're looking for spaces themed around the beach setting and Leonard's love for archaeology! Overall, we're excited to ","occurred_at":null,"published_at":"2026-09-07T13:00:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814453035","verified_at":"2026-10-20T10:44:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2907400-1836506165562073","game_id":"steam-2907400","kind":"announcement","title":"Thank you for your Hokko Spaces Playtest feedback! 💗🌱 June Playtest Finished","summary":"Hey residents! 👋 Our June Playtest for Hokko Spaces is now over, and we wanted to thank you all for your support towards the first playtest of our peaceful world-building game! We appreciate you all for joining our June Playtest, sharing screenshots in our Discord server of the worlds you've designed, and leaving feedback in our Playtest feedback forms 💚 Your suggestions and feedback will help shape Hokko Spaces and make it the most relaxing and comforting experience it can be when we launch lat","occurred_at":null,"published_at":"2026-06-30T10:19:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1836506165562073","verified_at":"2026-10-20T10:44:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2907400-1834602721194228","game_id":"steam-2907400","kind":"announcement","title":"Announcing Hokko Spaces 🌱 A cozy sandbox set in the world of Hokko Life!","summary":"Hey residents! 👋 Today, we're excited to finally share our next game set in the cozy world of Hokko Life, as we just revealed Hokko Spaces in Wholesome Direct 2026! ✨ Hokko Spaces is a creative sandbox experience where you can design beautifully detailed miniature diorama-style worlds, developed by Robert Tatnell at Wonderscope Games and published by Team17. We want to provide a relaxing experience as you create beautiful, lively spaces inhabited by adorable characters, both new villagers and on","occurred_at":null,"published_at":"2026-06-06T17:04:44Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1834602721194228","verified_at":"2026-10-20T10:44:32Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-2907400":{"last_attempt_at":"2026-10-26T00:20:52Z","status":"ok","all_sources_checked_at":"2026-10-26T00:20:52Z","error_codes":[]}},"news_last_attempt_at":{"steam-2907400":"2026-10-26T00:20:52Z"},"notices":[],"news_sources":{"2907400":{"last_attempt_at":"2026-10-26T00:20:52Z","last_success_at":"2026-10-26T00:20:52Z","status":"ok","error_codes":[]},"5209360":{"last_attempt_at":"2026-10-26T00:20:52Z","last_success_at":"2026-10-26T00:20:52Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-2907400","app_id":2907400,"app_scope":"base","observed_at":"2026-10-26T06:14:10Z","source_url":"https://api.steampowered.com/IStoreBrowseService/Get