/v1/","context":{"app_id":4443400,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4443400-1846651706691283","game_id":"steam-4443400","kind":"announcement","title":"Play TFCH DEMO on STEAM NEXT FEST!","summary":"hi guysThis Flash Contains Horrors Demo is the part of the Steam Next Fest! its a great opportunity to try out the demo if you havent already! just a reminder: the demo includes 2 out of the 5 games - LOOP and ROMASHKA! take on the role of a home farmer, or perhaps someone lost to despair and alcoholism also, if you really enjoyed the game (or didnt enjoy it), i would appreciate it if you left a review and shared the game with your friends! you can download free demo here:","occurred_at":null,"published_at":"2026-10-19T16:58:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691283","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4443400-1846018067926012","game_id":"steam-4443400","kind":"announcement","title":"TFCH Demo Is Available Now!","summary":"Hi guys! This Flash Contains Horrors is finally HERE! You can play LOOP and ROMASHKA today for free! LOOP – A short psychological horror game about a man who has lost control of his life. After being laid off, the main character tries to cope with despair through alcohol. With each passing day, reality becomes heavier, and his attempts to dull the pain only drag him further into a vicious cycle. ROMASHKA – A short psychological horror game where you’ve been promised easy money. There’s only one ","occurred_at":null,"published_at":"2026-10-07T12:57:26Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067926012","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4443400-1845383656390665","game_id":"steam-4443400","kind":"announcement","title":"The playtest closes tomorrow","summary":"hi guys just a reminder that TFCH Playtest endes tomorrow and TFCH Demo launches on october 7th!so, i want to briefly tell you about the demo (although, if you follow my twitter, you will not learn much new. btw, heres my twitter - (https://x.com/soup_o_stat) ABOUT THE DEMO the demo will include two games: LOOP and ROMASHKA (LOOP will differ slightly from the playtest version). completing the game will take between 15 and 30 minutes VOICE ACTORSim happy to tell you that i have brought in two rea","occurred_at":null,"published_at":"2026-10-04T07:15:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656390665","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4443400-1844751498230829","game_id":"steam-4443400","kind":"announcement","title":"Demo news, playtest news and more","summary":"hi! today i would like to share some news about my game with you DEMO NEWSThis Flash Contains Horrors Demo is coming very soon - on october 7th! in addition to the updated LOOP, it will also feature another story: ROMASHKA! please note: the demo has its own steam store page, here it is: PLAYTEST NEWSthanks to everyone who played the TFCH playtest! if you havent done so yet, you have until october 5th. after that date, the playtest will no longer be available for download or playNEW DISCORD SERVE","occurred_at":null,"published_at":"2026-09-28T08:08:33Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498230829","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4443400-1843481262701437","game_id":"steam-4443400","kind":"announcement","title":"TFCH Playtest is available NOW","summary":"hi! im happy to announce that the This Flash Contains Horrors Playtest is now available and playable until october 5th! the playtest features one of the anthologys five games - LOOP - a psychological horror game about despair and alcohol. i hope you enjoy it!download it now (and if you didnt sign up, you can still access the playtest via the games store page)! - Soup-o-Stat","occurred_at":null,"published_at":"2026-09-14T11:39:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262701437","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4443400-1843481262698933","game_id":"steam-4443400","kind":"announcement","title":"TFCH Playtest launches tomorrow!","summary":"hi!im happy to announce that the This Flash Contains Horrors playtest launches tomorrow at 12:00 UTC-5! make sure you are signed up for the playtest (if you havent signed up yet, you can do so on the games page) i hope you enjoy the game! also, subscribe to my social media! X: https://x.com/soup_o_stat Telegram: https://t.me/soup_o_stats_closet Youtube: -Soup-o-Stat","occurred_at":null,"published_at":"2026-09-13T07:01:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262698933","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4443400-1842212951305452","game_id":"steam-4443400","kind":"announcement","title":"Sign up for the TFCH playtest now!","summary":"hi guys!im happy to announce that you can now sign up for the This Flash Contains Horrors playtest!the playtest will feature LOOP, now updated with changes and improvements based on feedback from our testers and visitors at INDIECONplaytest applications are open now, with approvals starting september 14Sign up for the playtest: thank you for supporting This Flash Contains Horrors! - Soup-o-Stat","occurred_at":null,"published_at":"2026-08-29T11:24:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951305452","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4443400-1839676055885379","game_id":"steam-4443400","kind":"announcement","title":"TFCH at INDIECON 2.0!","summary":"Hello everyone!I have some exciting news - This Flash Contains Horrors will be showcased at INDICON 2.0 in Moscow!This will be the first opportunity for many people to experience the game in person, so I'd love to invite you to the event. If you're planning to visit INDICON, be sure to stop by! I'd be happy to meet you, chat, and hear what you think.What will be playable?Visitors will be able to play LOOP, one of the five stories included in This Flash Contains Horrors.Each story explores its ow","occurred_at":null,"published_at":"2026-07-30T14:13:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839676055885379","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4443400-1833968530896549","game_id":"steam-4443400","kind":"announcement","title":"Lineup change: welcome GambleHeart!","summary":"hello everyone!during development, i decided to make a small change to the anthology's lineup. originally, the collection was going to include a short game called Wrong Button, focused on trying to stop a nuclear missile launch. however, as development progressed, i realized that it created a very different emotional experience compared to the rest of the anthology.most of the games in the collection focus on personal struggles, addiction, the consequences of one's actions, and gradual self-dest","occurred_at":null,"published_at":"2026-06-01T05:56:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833968530896549","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4443400-1832700592791894","game_id":"steam-4443400","kind":"announcement","title":"The soundtrack from the trailer is out!","summary":"Hi! I am pleased to announce that the soundtrack by cyrowout from the game trailer has been released on Soundcloud and Bandcamp! Listen now, support the young composer! Bandcamp: https://cyrowout.bandcamp.com/track/sleep-paralysis Soundcloud: https://soundcloud.com/cyrowout/sleep-paralysis","occurred_at":null,"published_at":"2026-05-15T12:53:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1832700592791894","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4443400-1832065502819665","game_id":"steam-4443400","kind":"announcement","title":"This Flash Contains Horrors Steam page is live. Whats next?","summary":"The Steam page for This Flash Contains Horrors is finally live.The game has been in development for several months, and during that time the project has grown far beyond its original concept.It will include fully reworked versions of my older horror projects - redesigned, rebuilt, and improved - along with two completely new experiences created specifically for this release.I’ll be sharing development updates, behind-the-scenes details, progress clips, and new information as often as possible on","occurred_at":null,"published_at":"2026-05-10T17:00:31Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1832065502819665","verified_at":"2026-10-20T14:26:38Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4443400":{"last_attempt_at":"2026-10-26T02:31:20Z","status":"ok","all_sources_checked_at":"2026-10-26T02:31:20Z","error_codes":[]}},"news_last_attempt_at":{"steam-4443400":"2026-10-26T02:31:20Z"},"notices":[],"news_sources":{"4443400":{"last_attempt_at":"2026-10-26T02:31:20Z","last_success_at":"2026-10-26T02:31:20Z","status":"ok","error_codes":[]},"4642150":{"last_attempt_at":"2026-10-26T02:31:20Z","last_success_at":"2026-10-26T02:31:20Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4443400","app_id":4443400,"app_scope":"base","observed_at":"2026-10-26T06:14:37Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"a9605efb1fe686c56193ee2d73ca15681ec4d780cdea54443af2bc5d02c7c113","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Psychological horror collection, which includes 5 games: GambleHeart, ROMASHKA, You Are Doxxed, B*tch!, LOOP and COLORFOOD Inc. These are stories about anxiety, pressure, and internal tension linked by a shared atmosphere.","publishers":[{"name":"Soup-o-Stat","creator_clan_account_id":45895546}],"developers":[{"name":"Soup-o-Stat","creator_clan_account_id":45895546}]},"release":{"steam_release_date":1830240000,"is_coming_soon":true,"coming_soon_display":"date_year"},"trailers":{"highlights":[{"trailer_name":"Announcement trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1792689210","trailer_category":1,"microtrailer":[{"filename":"4443400/1269608435/1c17182c95a4d3907ce7fe7c4d3a0ef292a59eb5/1778325128/microtrailer.webm","type":"video/webm"},{"filename":"4443400/126