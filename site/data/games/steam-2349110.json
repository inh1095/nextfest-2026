iscovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2349110-1846018067938689","game_id":"steam-2349110","kind":"announcement","title":"The Lunar Wardens demo is moving to October 19","summary":"Hello Wardens,We planned to release the Lunar Wardens demo tomorrow. That is not going to happen, and we want to tell you why.Every demo on Steam has to pass a review before it can go live. Ours is still in that review, and we cannot release it until it is approved. So we are moving the demo to a date we can keep:The Lunar Wardens demo will be out on October 19.Nothing about the demo itself has changed. The build is ready, and you will get everything we planned to give you. We are using the extr","occurred_at":null,"published_at":"2026-10-11T15:08:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067938689","verified_at":"2026-10-20T10:02:45Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-2349110":{"last_attempt_at":"2026-10-26T09:53:17Z","status":"ok","all_sources_checked_at":"2026-10-26T09:53:17Z","error_codes":[]}},"news_last_attempt_at":{"steam-2349110":"2026-10-26T09:53:17Z"},"notices":[],"news_sources":{"2349110":{"last_attempt_at":"2026-10-26T09:53:17Z","last_success_at":"2026-10-26T09:53:17Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:53:17Z"},"5359530":{"last_attempt_at":"2026-10-26T09:53:17Z","last_success_at":"2026-10-26T09:53:17Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:53:17Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-2349110","app_id":2349110,"app_scope":"base","observed_at":"2026-10-26T06:14:08Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item