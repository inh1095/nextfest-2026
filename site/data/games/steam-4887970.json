l,"published_at":"2026-10-25T22:00:02Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114043069","verified_at":"2026-10-26T05:08:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4887970-1846651706683337","game_id":"steam-4887970","kind":"update","title":"PATCH NOTES 0.3","summary":"Descendants: This is the last update before Steam Next Fest. The grass hides more than ever, the big creatures no longer wait still for their turn, and every run leaves its chronicle behind. {STEAM_CLAN_IMAGE}/46269699/adb6307960ae8a919f9b00890c102d2ea311b356.png {STEAM_CLAN_IMAGE}/46269699/d47d49d8eaed70c49844f1bc18a2849dd20f3490.gif The Spear-Riddled Boar no longer sleeps alone. The Poacher crouches behind a clump of dry grass and pricks at you while she snores. Beat her awake and she gets up ","occurred_at":null,"published_at":"2026-10-16T22:54:32Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706683337","verified_at":"2026-10-20T18:26:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4887970-1846018067927539","game_id":"steam-4887970","kind":"update","title":"PATCH NOTES 0.2","summary":"Descenders, This is a big one. The descent now has someone to show you the way, there are new elites for those who want punishment, and Borrowed Flesh speaks two more languages. The rag Jester teaches you to survive The tutorial now has a narrator: a fairground jester who has hung from his strings for far too long. He has his own voice, never shuts up, and knows the descent better than anyone. Let him introduce himself. {STEAM_CLAN_IMAGE}/46269699/32f8413ecb1001d47374dce023227fe0a7af269e.jpg He ","occurred_at":null,"published_at":"2026-10-07T20:47:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067927539","verified_at":"2026-10-20T18:26:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4887970-1844751498227282","game_id":"steam-4887970","kind":"announcement","title":"The Borrowed Flesh demo is out: play Act 1 for free","summary":"The demo is here You can now download the Borrowed Flesh demo for free. It's a deckbuilding roguelike steeped in body horror: Slay the Spire meets Fear & Hunger. Your party dies for real, sanity is just another resource to spend, and every decision matters. What's inside The complete Act 1, from the first room to the boss that guards it. You start with three heroes: Amós the Butcher, Isolt the Medic and Sela the Huntress. They share a single deck; when one falls, their cards become useless. Beat","occurred_at":null,"published_at":"2026-09-26T13:59:16Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498227282","verified_at":"2026-10-20T18:26:19Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4887970":{"last_attempt_at":"2026-10-26T05:08:33Z","status":"ok","all_sources_checked_at":"2026-10-26T05:08:32Z","error_codes":[]}},"news_last_attempt_at":{"steam-4887970":"2026-10-26T05:08:33Z"},"notices":[],"news_sources":{"4887970":{"last_attempt_at":"2026-10-26T05:08:32Z","last_success_at":"2026-10-26T05:08:32Z","status":"ok","error_codes":[]},"4902720":{"last_attempt_at":"2026-10-26T05:08:33Z","last_success_at":"2026-10-26T05:08:33Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4887970","app_id":4887970,"app_scope":"base","observed_at":"2026-10-26T06:15:04Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"