Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4912990,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-4912990","metric":"review_count","observed_at":"2026-10-26T14:45:15Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4912990,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-4912990","metric":"review_positive_percent","observed_at":"2026-10-26T14:45:15Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4912990,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4912990-1846651706691468","game_id":"steam-4912990","kind":"announcement","title":"The Rug Racket: The Cleaning Is the Honest Part","summary":"The cleaning is honest work. The clientele is the problem. You inherit a rundown rug cleaning shop, and with it a dark-comedy mob story that plays out across three acts. A job comes in and you take it the whole way: dust it down, test it for colorfast, wash, rinse, extract. Then you're graded on it. How clean the rug came out, how much fiber you wrecked getting there, what you left behind. The grade is the pay, and a Showroom finish pays best. The catch is in the tools. The Brush covers ground f","occurred_at":null,"published_at":"2026-10-19T17:00:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691468","verified_at":"2026-10-20T18:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4912990-1846651706682087","game_id":"steam-4912990","kind":"announcement","title":"The Rug Racket Demo Is Out, and There's a Discord","summary":"The Rug Racket demo is out. We also have a Discord now, and we'd rather you came and used it. Join us: discord.gg/jHEgmUmsnh It's new, it's quiet and it's the best place to tell us what you think while we can still do something about it. Bugs, things that felt wrong, a rug you're proud of. All welcome. The demo is one day in the shop, about twenty minutes. A rug comes in and you take it the whole way: dust, colorfast test, wash, rinse, extract. Then you get graded on how clean it came out, how m","occurred_at":null,"published_at":"2026-10-16T16:00:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706682087","verified_at":"2026-10-20T18:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4912990-1843481262695746","game_id":"steam-4912990","kind":"announcement","title":"The Rug Racket: Pause Actually Pauses Now","summary":"Small batch this month. The first one's been quietly ruining shop days. Pause actually pauses The day clock used to keep running while the game was telling you it was Paused. So your shop day was ticking away behind a screen that said nothing was happening. Sorry about that. Fixed. You can read your mastery now The mastery band was showing exactly one readable line. It shows six. Controllers, menus first Before this build a gamepad got you as far as the title screen and then abandoned you there.","occurred_at":null,"published_at":"2026-09-11T16:00:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262695746","verified_at":"2026-10-20T18:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4912990-1840310314352033","game_id":"steam-4912990","kind":"announcement","title":"Introducing The Rug Racket","summary":"The Rug Racket now has a Steam page This is the first proper look at The Rug Racket. The store page just went live, so if this is the first time you are seeing the game, consider this the introduction. What it isInherit a rundown rug-cleaning shop and master a satisfying craft. Dust, wash, rinse and revive rugs one stain at a time. A deep, tactile cleaning craft. 5 stages, real fiber/colorfast/heat rules, a point-of-no-return for the careless. A dark-comedy mob story across three acts, with a bu","occurred_at":null,"published_at":"2026-08-10T16:47:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840310314352033","verified_at":"2026-10-20T18:48:17Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4912990":{"last_attempt_at":"2026-10-26T05:11:19Z","status":"ok","all_sources_checked_at":"2026-10-26T05:11:19Z","error_codes":[]}},"news_last_attempt_at":{"steam-4912990":"2026-10-26T05:11:19Z"},"notices":[],"news_sources":{"4912990":{"last_attempt_at":"2026-10-26T05:11:19Z","last_success_at":"2026-10-26T05:11:19Z","status":"ok","error_codes":[]},"5054660":{"last_attempt_at":"2026-10-26T05:11:19Z","last_success_at":"2026-10-26T05:11:19Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4912990","app_id":4912990,"app_scope":"base","observed_at":"2026-10-26T06:15:06Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_