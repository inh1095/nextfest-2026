ind":"announcement","title":"Deductopia Demo Stream","summary":"Get a taste of the game with this stream of me playing rooms one and two. Don't worry, I save room three for you to discover on your own!","occurred_at":null,"published_at":"2026-10-21T21:44:38Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114030423","verified_at":"2026-10-21T23:05:18Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4429720-1846018067942690","game_id":"steam-4429720","kind":"announcement","title":"New Demo Out Now","summary":"Our updated demo is out now! It now matches the full game, featuring the two smaller tutorial rooms (Chess Game and Sandbox) and the first room of the main map (our old friend Bring Your Pet to School Day). Plus, enjoy updated art and new music from our lovely musician, Starling Tan.If you didn't get a chance to play the other rooms available in the old demo (Scout Camp and Hill and Dale), never fear--they will be in the full game, which comes out on October 28!","occurred_at":null,"published_at":"2026-10-13T02:25:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067942690","verified_at":"2026-10-20T14:06:46Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4429720-1846018067939711","game_id":"steam-4429720","kind":"update","title":"Demo Update","summary":"To bring the Deductopia demo in line with the beginning full game, tomorrow we will be changing which rooms are available in the demo. It will now feature the two smaller tutorial rooms (Chess Game and Sandbox) and the first room of the main map (our old friend Bring Your Pet to School Day).This means that Scout Camp and Hill and Dale will no longer be available as part of the demo, so if you're in the middle of one of those rooms, get it done now!Alas, you will also lose your demo save games. A","occurred_at":null,"published_at":"2026-10-12T01:23:30Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067939711","verified_at":"2026-10-20T14:06:46Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4429720-1833334318570007","game_id":"steam-4429720","kind":"announcement","title":"Thinky Direct 2026","summary":"I am so honored that Deductopia will be featured in the 2026 Thinky Direct event presented by Draknek & Friends! The Draknek crew has made some of my favorite puzzle games of all time and it's thrilling to be featured alongside them!","occurred_at":null,"published_at":"2026-05-21T20:00:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318570007","verified_at":"2026-10-20T14:06:46Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4429720":{"last_attempt_at":"2026-10-26T02:30:40Z","status":"ok","all_sources_checked_at":"2026-10-26T02:30:40Z","error_codes":[]}},"news_last_attempt_at":{"steam-4429720":"2026-10-26T02:30:40Z"},"notices":[],"news_sources":{"4429720":{"last_attempt_at":"2026-10-26T02:30:40Z","last_success_at":"2026-10-26T02:30:40Z","status":"ok","error_codes":[]},"4448510":{"last_attempt_at":"2026-10-26T02:30:40Z","last_success_at":"2026-10-26T02:30:40Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4429720","app_id":4429720,"app_scope":"base","observed_at":"2026-10-26T06:14:37Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"910cd70216bcd05adb6e8bdd64b8f8c6de70942ce3dc59201a24ea4b6e8b9c5b","response_sha256":null,"source_fields":{"basi