Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5039790,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-5039790","metric":"review_count","observed_at":"2026-10-26T14:45:21Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5039790,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-5039790","metric":"review_positive_percent","observed_at":"2026-10-26T14:45:21Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5039790,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-5039790","metric":"demo_ccu","observed_at":"2026-10-26T16:15:51Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5273190","error_code":null}],"events":[{"id":"steam-steam-5039790-1847286114033642","game_id":"steam-5039790","kind":"announcement","title":"The night staff","summary":"You work with six doctors in the demo. John Dervishi painted their portraits. Dr. Danny Mercer is fast and sure of himself. His misses tend to be the dangerous ones. Dr. Maya Chen is steady and catches most things. Dr. Andre Okafor is slow and thorough, and he tells you when he isn't sure. Dr. Anne Walsh is ambitious and quick. She keeps count of your mistakes, and Mercer's. Dr. Jordan Rivers is an intern. He's nervous and honest about it. Dr. Sarah Adeyemi is experienced and guarded. She's bett","occurred_at":null,"published_at":"2026-10-22T17:30:48Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114033642","verified_at":"2026-10-22T17:46:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5039790-1846651706696157","game_id":"steam-5039790","kind":"announcement","title":"Two patients with the same complaint","summary":"Every night in The Attending has a few patients who arrive in pairs, with the same complaint and almost the same triage note. One of them is sick. The other one isn't. Two women come in saying they can't breathe and they're panicking. Both have a history of panic attacks. One is having another one. The other has a blood clot in her lung. Two men come in drunk after falling outside a bar. Both smell of alcohol and have a scrape on the head. One needs to sleep it off. The other is bleeding inside ","occurred_at":null,"published_at":"2026-10-20T17:30:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706696157","verified_at":"2026-10-20T21:01:22Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5039790-1846651706688301","game_id":"steam-5039790","kind":"announcement","title":"The demo is free to play during Steam Next Fest","summary":"The Attending demo is on Steam now, and it is part of Steam Next Fest from October 19 to 26.You run one night shift in an emergency department. You put patients in beds, give cases to your doctors, and sign their plans. Some of those plans are wrong. The debrief shows you which ones, and the minute you signed.The first time you launch it, the charge nurse walks you through night #0213. After that, every shift is a new night.If something breaks or doesn't make sense, post in the Demo feedback thr","occurred_at":null,"published_at":"2026-10-18T23:31:55Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706688301","verified_at":"2026-10-20T21:01:22Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5039790":{"last_attempt_at":"2026-10-26T07:36:06Z","status":"ok","all_sources_checked_at":"2026-10-26T07:36:06Z","error_codes":[]}},"news_last_attempt_at":{"steam-5039790":"2026-10-26T07:36:06Z"},"notices":[],"news_sources":{"5039790":{"last_attempt_at":"2026-10-26T07:36:06Z","last_success_at":"2026-10-26T07:36:06Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T07:36:06Z"},"5273190":{"last_attempt_at":"2026-10-26T07:36:06Z","last_success_at":"2026-10-26T07:36:06Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T07:36:06Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5039790","app_id":5039790,"app_scope":"base","observed_at":"2026-10-26T06:15:19Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"6e3b0388d7b1d7e1774bfec1ad18fd37056b6e8d21486a05ad00c4a77444b88a","response_sha256":null,"source_fields":{"basic_info":{"short_description":"You are the attending on the night shift in an emergency department. Your doctors work the cases and bring you their plans to sign. Read the chart, find the patient who is sicker than the workup says, and decide which of your doctors you trust.","publishers":[{"name":"Abreu Data Works"}],"developers":[{"name":"Abreu Data Works"}]},"release":{"is_coming_soon":true,"custom_release_date_message":"발표 예정","coming_soon_display":"text_