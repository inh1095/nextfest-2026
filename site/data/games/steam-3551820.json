/v1/","context":{"app_id":3551820,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-3551820-1846651706692039","game_id":"steam-3551820","kind":"announcement","title":"Castlebound is at Steam Next Fest! Play Our New Demo!","summary":"Castlebound is part of Steam Next Fest, and we've just released a brand-new demo for everyone to enjoy!Jump into our fast-paced action platforming roguelite, explore a living castle, and get ready for an adventure you can play with up to 4 players!📅 Castlebound launches November 11, 2026!We're getting closer to release, and we can't wait for you to experience the full game!❤️ Play the new demo, add Castlebound to your Steam Wishlist, and help us spread the word!Thank you so much for supporting C","occurred_at":null,"published_at":"2026-10-19T18:05:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706692039","verified_at":"2026-10-20T11:29:27Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3551820-1846651706675608","game_id":"steam-3551820","kind":"announcement","title":"🏰 Castlebound Launches November 11, 2026! 🎉","summary":"We're incredibly excited to announce that Castlebound officially launches on November 11, 2026! ⚔️Get ready for a fast-paced, 1–4 player co-op platforming roguelite where you and your friends must fight through dangerous lands, defeat powerful bosses, and protect your living castle!🎬 Watch Our Release Date Trailer!To celebrate the announcement, we've released a brand-new trailer!🎮 Get Ready for November 11!Castlebound is coming to Steam, Nintendo Switch, and Nintendo Switch 2 on November 11, 202","occurred_at":null,"published_at":"2026-10-14T21:11:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706675608","verified_at":"2026-10-20T11:29:27Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3551820-1842212951314604","game_id":"steam-3551820","kind":"announcement","title":"Castlebound is LIVE on Kickstarter! ⚔️","summary":"Hello everyone!We have some very exciting news today: the Castlebound Kickstarter campaign is officially LIVE! 🎉After two years of development, we're asking for your help to take Castlebound to the finish line and make the game even bigger and better.🏰 Join the Castlebound Kickstarter!Castlebound is our fast-paced platforming roguelite for 1–4 players, coming to Steam, Nintendo Switch 2, and Nintendo Switch.The Kickstarter features a variety of digital and physical rewards, including game copies","occurred_at":null,"published_at":"2026-09-01T20:08:36Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951314604","verified_at":"2026-10-20T11:29:27Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3551820-1842212951297895","game_id":"steam-3551820","kind":"announcement","title":"Castlebound Kickstarter coming on September 1st! 🔥","summary":"Castlebound Kickstarter Launches September 1st! ⚔️🏰The wait is almost over!We’re excited to announce that the Castlebound Kickstarter campaign will officially launch on September 1st! 🎉We’ve been working hard to prepare the campaign, with plenty of exciting rewards and surprises for you! including Steam copies among the rewards!Follow the campaign and get notified at launch!🔗 https://www.kickstarter.com/projects/ogrepixel/castlebound-action-platforming-roguelike-for-1-4-players/Thank you so much","occurred_at":null,"published_at":"2026-08-26T18:56:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951297895","verified_at":"2026-10-20T11:29:27Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3551820-1834602721188262","game_id":"steam-3551820","kind":"announcement","title":"Castlebound Joins the Official Latin American Games Showcase 2026!","summary":"Hello everyone!We’re thrilled to announce that Castlebound has been selected as part of the official lineup for the Latin American Games Showcase 2026! 🎉As part of the event, we’ve released an updated demo featuring improved gameplay... Now the Castle walks!Whether you're discovering Castlebound for the first time or returning for another run, we hope you enjoy the latest version of the game.But that’s not all...We’re also preparing to launch our Kickstarter campaign very soon! The campaign will","occurred_at":null,"published_at":"2026-06-04T17:22:26Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1834602721188262","verified_at":"2026-10-20T11:29:27Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3551820-1823191198607874","game_id":"steam-3551820","kind":"announcement","title":"Castlebound is coming to Kickstarter! 🎉","summary":"Hey everyone!We’re incredibly excited to announce that Castlebound will be launching on Kickstarter soon! 🎯If you’ve been following the development of the game and want to help us bring it to life, this is your chance to support the project, unlock exclusive rewards, and be part of the Castlebound journey.👉 Click here to visit our Kickstarter preview page and hit \"Notify me on launch\": https://www.kickstarter.com/projects/ogrepixel/castlebound-action-platforming-roguelike-for-1-4-playersBy subsc","occurred_at":null,"published_at":"2026-01-31T18:25:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1823191198607874","verified_at":"2026-10-20T11:29:27Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3551820-1808061939352427","game_id":"steam-3551820","kind":"announcement","title":"Castlebound New Demo!","summary":"Hi everyone!First of all, we want to thank everyone who has taken the time to give Castlebound a try!Thanks to the feedback, we decided to improve the demo!We have uploaded a new v0.2.3 with the following improvements:Game pacing improvement: We removed a lot of unnecessary waits that were breaking the game pacing and made it more continuous.Choose your path changed: We have changed the way players can choose their path inside the run by offering two options after a slot is finished. Here, we ar","occurred_at":null,"published_at":"2025-08-14T21:41:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1808061939352427","verified_at":"2026-10-20T11:29:27Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3551820-1802893906873244","game_id":"steam-3551820","kind":"announcement","title":"New Demo version 0.1.7 and Remote Play Together activated!","summary":"Hi everyone! We hope you all are greatWe are happy to share that we have been working hard on improving the Castlebound Demo.Latest v0.1.7 has the following upgrades:Player controller improved!Gameplay is more fun (more enemies coming)!Now it is easy to add/remove players for Multiplayer modeOther minor bugs and improvements!*The game works great on Steam DeckWe have also enabled the Remote Play Together feature on Steam and it works great!It is better to play with game controllers and there is ","occurred_at":null,"published_at":"2025-06-23T23:43:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1802893906873244","verified_at":"2026-10-20T11:29:27Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3551820-1801617199469112","game_id":"steam-3551820","kind":"announcement","title":"Demo out now!","summary":"Hi everyone!We are happy to share that finally we have a Demo for Castlebound!To celebrate we created a new Trailer, here it is, we hope you like itPlease consider giving the demo a try and share your feedback and comments! That helps a lot!Aaaand if you like it please wishlist it!SteveOgre Pixelwww.ogrepixel.com","occurred_at":null,"published_at":"2025-06-07T20:56:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1801617199469112","verified_at":"2026-10-20T11:29:27Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3551820":{"last_attempt_at":"2026-10-26T00:41:42Z","status":"ok","all_sources_checked_at":"2026-10-26T00:41:42Z","error_codes":[]}},"news_last_attempt_at":{"steam-3551820":"2026-10-26T00:41:42Z"},"notices":[],"news_sources":{"3551820":{"last_attempt_at":"2026-10-26T00:41:42Z","last_success_at":"2026-10-26T00:41:42Z","status":"ok","error_codes":[]},"3767490":{"last_attempt_at":"2026-10-26T00:41:42Z","last_success_at":"2026-10-26T00:41:42Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3551820","app_id":3551820,"app_scope":"base","observed_at":"2026-10-26T06:14:18Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"ebae36eaca1295b35b5ed98faf0281def8409a3089e562a6a4545875139ca971","response_sha256":null,"source_fields":{"basic_info":{"short_description":"이 독특하고 액션으로 가득 찬 로그라이크 게임에서 움직이는 성에서 영웅 그룹을 이끌고 끝없이 몰려오는 적들과 싸우세요!","publishers":[{"name":"Ogre Pixel","creator_clan_account_id":43212066}],"developers":[{"name":"Ogre Pixel","creator_clan_account_id":43212066}]