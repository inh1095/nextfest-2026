/v1/","context":{"app_id":3842950,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-3842950-1846651706682955","game_id":"steam-3842950","kind":"announcement","title":"Shrike Steam Next Fest Broadcast","summary":"A broadcast of a season 1 run by myself (the game dev) for Steam Next Fest. The demo is available if you want to try out a run.","occurred_at":null,"published_at":"2026-10-16T19:59:38Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706682955","verified_at":"2026-10-20T11:53:20Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3842950-1846651706679139","game_id":"steam-3842950","kind":"announcement","title":"Shrike Dev Stream for Birds of Play Festival","summary":"I will be playing the Shrike demo for the Birds of Play festival. Starting a fresh run, aiming to complete all the season 1 challenges and possibly an attempt at a speedrun.This is my first time ever streaming so let me know if any issues pop up on your end!","occurred_at":null,"published_at":"2026-10-15T19:57:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706679139","verified_at":"2026-10-20T11:53:20Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3842950-1845383656379203","game_id":"steam-3842950","kind":"update","title":"Demo Update 0.0.15","summary":"A few small updates:Game tips added to reward screen at end of each levelGlossary section added to the event tile tooltips in reward and oracle event tilesA few color tweaksA few bug fixes","occurred_at":null,"published_at":"2026-09-30T23:25:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656379203","verified_at":"2026-10-20T11:53:20Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3842950-1844751498232726","game_id":"steam-3842950","kind":"update","title":"Demo Update 0.0.14","summary":"Small balance update: the 2x multiplier is back across different biomes for reward tiles, with a changeVillages no longer double every reward tileThe 2x is broken out in subsets across Forest, Mountain, and Arctic Villages","occurred_at":null,"published_at":"2026-09-28T23:35:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498232726","verified_at":"2026-10-20T11:53:20Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3842950-1844751498226086","game_id":"steam-3842950","kind":"update","title":"Demo Update 0.0.13: New Event Tiles!","summary":"4 New Event Tiles with a focus on deck building:Smith: Purchase charges for cards in your deckPreen: Choose 1 of 3 random cards in your deck to chargeMimic: Choose 1 of 3 random cards in your deck to create a copy ofMorph: Reroll 1 of 3 random cards in your deckYou now start with only 2 pickpocket cards and 1 random starter cardRenamed Trader to OracleSeason unlock text added to win screenNew sfx and animations for event tilesOther bug fixes","occurred_at":null,"published_at":"2026-09-25T22:38:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498226086","verified_at":"2026-10-20T11:53:20Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3842950-1844115010493491","game_id":"steam-3842950","kind":"update","title":"Demo Update 0.0.12: New Bribe Cards!","summary":"5 new cards with a bribe mechanic, coins become part of the casting cost to perform actions like paying enemies to look the other way.1 new slumber mark card.Passive attack on terns, chickadees, and plovers is now based on awake enemies of a specific type instead of all enemies of a specific type.Slumber marks no longer can be placed underneath decoys.Fix owl and hummingbird asleep log bug.","occurred_at":null,"published_at":"2026-09-17T23:47:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010493491","verified_at":"2026-10-20T11:53:20Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3842950-1843481262705298","game_id":"steam-3842950","kind":"update","title":"Demo Update 0.0.11","summary":"Enemy birds now spawn in smaller groupings instead of larger more random poolsLog system that tracks details of what occurRemoved field guide enemy turn log (in favor of new log system)Add new control (hold left mouse button to hide board tooltips) to instructions Tune Thicket level procedural generation so it is less narrow","occurred_at":null,"published_at":"2026-09-15T18:06:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262705298","verified_at":"2026-10-20T11:53:20Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3842950-1841579228664014","game_id":"steam-3842950","kind":"update","title":"Demo Patch 0.0.10: Tutorial Added!","summary":"Hey Everyone!Based on feedback, I have added a new \"Season 0\" to the demo which acts as a tutorial season. It is a more gradual introduction to the basic mechanics before throwing you into Season 1. If you have feedback on the new tutorial then please reach out. I want to ensure it is as easy as possible to learn how to play.Best,Quirx Games","occurred_at":null,"published_at":"2026-08-20T00:22:30Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalp