metric":"review_count","observed_at":"2026-10-26T14:45:02Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4311660,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-4311660","metric":"review_positive_percent","observed_at":"2026-10-26T14:45:02Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4311660,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4311660-1847286114039630","game_id":"steam-4311660","kind":"update","title":"Demo hotfix 0.4.5","summary":"Demo hotfix 0.4.5 changelogFixed a pop-up not showing in the recap when resigning with possibility of removing utilities and/or foodRefreshed the look of the recap to remove clutter and make it easier to read.","occurred_at":null,"published_at":"2026-10-24T13:31:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114039630","verified_at":"2026-10-24T16:30:18Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4311660-1847286114028753","game_id":"steam-4311660","kind":"update","title":"Demo Hotfix 0.4.4","summary":"Demo hotfix 0.4.4 changelog:Fixed a bug with a character's truck ID not showing on day 5Fixed a news that was not fitting the frameFixed the \"End day\" button that was working with the \"E\" key even if no money leftThank you for playing the game :)","occurred_at":null,"published_at":"2026-10-21T12:51:04Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114028753","verified_at":"2026-10-21T17:32:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4311660-1846651706691411","game_id":"steam-4311660","kind":"update","title":"The Steam Next Fest Demo Update is here!","summary":"Welcome to the Next Fest DemoImportant DisclaimerIf you have played the demo before, you need to start a new contract (erase previous saves if they appear). Old saves will break the game, be careful!Graphic updateA whole bunch of new assets were added to the game. Better visuals, better visibility, better performance!New screensThe welcome screen was reworked, no more paper memos, it's all on the main screen!The recap screen also got a revamp, not on paper anymore, it's also accompanied by a end","occurred_at":null,"published_at":"2026-10-19T17:00:52Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691411","verified_at":"2026-10-20T13:42:44Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4311660-1840944183776908","game_id":"steam-4311660","kind":"update","title":"Demo 0.3.1.1 Hotfix","summary":"Thanks to one of our Discord member, a very annoying bug (and a lot of typos) was found.Hotfix:Fixed items on the lists of the special cargo manual appearing twiceFixed a character that was coming back even after being replacedFixed typos on several documents","occurred_at":null,"published_at":"2026-08-13T14:17:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840944183776908","verified_at":"2026-10-20T13:42:44Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4311660-1840944183773535","game_id":"steam-4311660","kind":"update","title":"Demo update 3.0.1","summary":"Demo update 3.0.1Bug Fixes:Fixed loading screen overlapping with menu under itFixed a glitch on the sound of the accept buttonFixed the recap not showing the correct amount of errorsFixed some typosSome QOL improvementsModified content:I noticed that some of the company logo differences were only of color change, which could result in colorblind players to not be able to see the differences. I reworked all the \"wrong\" logos so now there's always something \"structurally\" different, not just color","occurred_at":null,"published_at":"2026-08-12T09:55:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840944183773535","verified_at":"2026-10-20T13:42:44Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4311660-1835236783568782","game_id":"steam-4311660","kind":"update","title":"Demo 0.2.7 - Patch Notes","summary":"New Content:Added 3 new overlays for the cameras to better show that we are on a space station :)I still need to make it look even better, working on it!Bug Fixes:Fixed the Company Book showing duplicate entries on second day (thanks to Pecanz72 for the bug report)Removed the graphics settings, since the big update I did on all the assets, the higher graphical setting is not needed anymore.Fixed the deep scan not finding a contraband object when changing layers.","occurred_at":null,"published_at":"2026-06-15T01:08:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1835236783568782","verified_at":"2026-10-20T13:42:44Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4311660-1834602721186819","game_id":"steam-4311660","kind":"announcement","title":"Tiny Teams Festival! (and bug fixes)","summary":"Before the announce, bug fixes:Bug Fixes:Thanks to some reviews and discussions on the forum, we identified two major bugs and were able to fix them. Thank you for your support and help in finding the bugs!Fixed Trucks sometimes getting stuck and/or invisible Fixed the Company Book showing wrong information or broken layout.This one actually required a big refactor in the code so there could still be some bugs. It was tested intensively, but when changing the code that much, anything can happen!","occurred_at":null,"published_at":"2026-06-04T08:02:51Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1834602721186819","verified_at":"2026-10-20T13:42:44Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4311660-1833968530888411","game_id":"steam-4311660","kind":"update","title":"Demo 0.2.6.1 - HotFix","summary":"Just a little hotfix:Fixed the story of one of the character showing up even tho the character is gone.","occurred_at":null,"published_at":"2026-05-28T14:58:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833968530888411","verified_at":"2026-10-20T13:42:44Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4311660-1833334318577229","game_id":"steam-4311660","kind":"update","title":"Demo 0.2.6 - Patch Notes","summary":"Demo Patch notes for version 0.2.6:Bug Fixes:Fixed missing truck on last dayFixed Delivery order showing multiple Computer PartsFixed story order cargo temp at 0 degreeThank youI also wanted to say thank you for all of you who played the demo! I am grateful for the time you spent playing it and giving feedback. Sorry if I was late to respond to the community hub messages, I didn't receive any notifications... I will do my best to check them everyday from now on!The easiest and fastest way to giv","occurred_at":null,"published_at":"2026-05-25T13:55:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_comm