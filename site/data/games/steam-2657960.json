/v1/","context":{"app_id":2657960,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-2657960","metric":"demo_ccu","observed_at":"2026-10-26T07:32:48Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5056500","error_code":null}],"events":[{"id":"steam-steam-2657960-1846651706696542","game_id":"steam-2657960","kind":"update","title":"Demo Update V.1.1.3","summary":"Controller Support Enhanced controller navigation throughout the game. All settings in the Options menu are now fully accessible via controller. You can now return to the Main Menu from the post-match score screen using a controller.Combat Improvements Improved animation synchronization by changing character distance detection from line traces to sphere traces. Reduced cases where characters could be launched unexpectedly due to sword collision interactions.Stability Fixed server-related issues ","occurred_at":null,"published_at":"2026-10-20T19:32:22Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706696542","verified_at":"2026-10-21T01:22:03Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2657960-1844115010493714","game_id":"steam-2657960","kind":"announcement","title":"Enemy Reveal: John Pitchfork","summary":"From the harvest fields comes John PitchforkTired of life as a villager and the endless routine of farm work, it is easy for any man to dream of dangerous adventures. So, after saving enough money to buy a fine helmet, John abandoned his old life in search of fame and excitement.John has no formal training whatsoever. He fights purely on instinct, relying on courage and determination rather than skill. He may not seem like a difficult opponent, but who knows? He might just surprise the arena.","occurred_at":null,"published_at":"2026-09-18T03:06:20Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010493714","verified_at":"2026-10-20T10:23:31Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2657960-1842846814452738","game_id":"steam-2657960","kind":"announcement","title":"Enemy Reveal: Niketas ho Kybeutēs","summary":"Every fight is a wager: Niketas ho Kybeutēs awaits.From Constantinople emerges Niketas \"the Gambler\", a man whose destiny was handed over to chance itself.Niketas thrived on the thrill of wagers, risking fortunes on races and duels. But when his addiction drove his debts beyond his winnings, betrayal cast him into the arena. Now he fights to repay what he owes, or die trying.His style is reckless and daring. By abandoning the shield, he gains speed, but leaves himself dangerously exposed. Facing","occurred_at":null,"published_at":"2026-09-07T10:17:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814452738","verified_at":"2026-10-20T10:23:31Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2657960-1842846814444597","game_id":"steam-2657960","kind":"announcement","title":"New Enemy Reveal: Tugorkan Bıyıklı","summary":"From the Turkic Steppes Emerges Tugorkan BıyıklıBehind his mask—carved with a strange, enigmatic smile—lies the brutality of a warrior condemned to the arena.Once the leader of a band of thieves, Tugorkan was captured following a series of raids. His followers were executed, but a different fate awaited him: eternal combat. Now, he fights not for freedom, but for survival.With a slower, defensive fighting style, Tugorkan is a fortress on the battlefield. Breaking his guard to land a blow is a tr","occurred_at":null,"published_at":"2026-09-03T20:53:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814444597","verified_at":"2026-10-20T10:23:31Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2657960-1842212951304318","game_id":"steam-2657960","kind":"update","title":"Demo Update V.1.1.2","summary":"Fixes:PerformanceOptimized Medium, High, and Epic graphic settings, reducing GPU usage without compromising visual quality.General improvements to texture rendering across all graphic levels.Removed redundant stadium objects, resulting in greater stability.Adjusted map lighting for better visual balance.VisualUpdated the default player skin: the old metallic armor has been replaced with a more colorful version, making it easier to distinguish from enemies.Fixed a bug in the options menu where se","occurred_at":null,"published_at":"2026-08-28T20:36:51Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951304318","verified_at":"2026-10-20T10:23:31Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-2657960":{"last_attempt_at":"2026-10-26T09:55:01Z","status":"ok","all_sources_checked_at":"2026-10-26T09:55:01Z","error_codes":[]}},"news_last_attempt_at":{"steam-2657960":"2026-10-26T09:55:01Z"},"notices":[],"news_sources":{"2657960":{"last_attempt_at":"2026-10-26T09:55:01Z","last_success_at":"2026-10-26T09:55:01Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:55:01Z"},"5056500":{"last_attempt_at":"2026-10-26T09:55:01Z","last_success_at":"2026-10-26T09:55:01Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:55:01Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-2657960","app_id":2657960,"app_scope":"base","observed_at":"2026-10-26T06:14:09Z","source_ur