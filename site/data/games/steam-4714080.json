/v1/","context":{"app_id":4714080,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4714080","metric":"demo_ccu","observed_at":"2026-10-26T09:27:22Z","value":2,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5247850","error_code":null}],"events":[{"id":"steam-steam-4714080-1847286114031523","game_id":"steam-4714080","kind":"announcement","title":"Full Metal Hell Is Now Playable on Steam Deck!","summary":"Take the carnage on the go—the Full Metal Hell demo now supports Steam Deck!","occurred_at":null,"published_at":"2026-10-22T07:12:32Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114031523","verified_at":"2026-10-22T10:54:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4714080-1847286114028892","game_id":"steam-4714080","kind":"announcement","title":"You can never have too much firepower—the Cannon is here!","summary":"Steam Next Fest won’t stop the updates! Meet the newest addition to the explosive arsenal: the Cannon!Other updates:Revive Coins now revive you on the spot instead of restarting the stage.Fixed missing characters in the leaderboard text.Added a record of the highest stage cleared with each vehicle.","occurred_at":null,"published_at":"2026-10-21T13:39:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114028892","verified_at":"2026-10-21T18:38:29Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4714080-1846651706687216","game_id":"steam-4714080","kind":"announcement","title":"All Set and Ready for Steam Next Fest","summary":"Hello everyone, after daily updates—one version per day—the median playtime for players has now reached 26 minutes, and the average playtime is over an hour. It’s already in a fairly polished state, and we’re just waiting for players to show up (are they here yet?). Today is the last major update before Steam Next Fest, and it includes the following:Reopened Endless Mode and added a leaderboard.Revised most of the button UI.Launched the meta shop, where you can buy powerful items to use in the g","occurred_at":null,"published_at":"2026-10-18T15:18:21Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706687216","verified_at":"2026-10-20T16:20:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4714080-1846651706677349","game_id":"steam-4714080","kind":"announcement","title":"Improved Enemy Spawning for More Balanced Combat","summary":"Hello everyone! After two weeks of updates, the Full Metal Hell demo has changed dramatically. A huge thank you to everyone who has tried the game and shared feedback—your input makes these improvements possible! Here's what's new in today's update: Improved enemy spawning Enemies will no longer bunch up when they accumulate. Instead, they'll respawn based on the player's position. New enemy: Missile Trooper A new ranged enemy that spawns in small numbers and fires missiles from beyond your view","occurred_at":null,"published_at":"2026-10-15T11:45:04Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706677349","verified_at":"2026-10-20T16:20:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4714080-1846018067936649","game_id":"steam-4714080","kind":"update","title":"Major Demo Update","summary":"Added a player color indicator to help you spot yourself in chaotic battles.Fixed various bugs.Updated key bindings.Supply crates can now be destroyed by ramming them.Added new scaling items.Switched to a new vehicle: the hovercraft.","occurred_at":null,"published_at":"2026-10-10T16:30:36Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067936649","verified_at":"2026-10-20T16:20:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4714080-1846018067930813","game_id":"steam-4714080","kind":"update","title":"Patch Notes","summary":"Improved game balance.Improved combat feedback and sound effects.Updated enemy models.Added attack warnings for some enemies.","occurred_at":null,"published_at":"2026-10-08T17:27:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067930813","verified_at":"2026-10-20T16:20:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4714080-1845383656391213","game_id":"steam-4714080","kind":"update","title":"Demo Update: Enhanced Combat Feel","summary":"Added weapon recoil and shell ejection effects.Improved rendering.Optimized performance.","occurred_at":null,"published_at":"2026-10-04T12:37:21Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656391213","verified_at":"2026-10-20T16:20:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4714080-1845383656386896","game_id":"steam-4714080","kind":"update","title":"Demo Update!","summary":"Thank you all for playing and for your feedback! Once we started hearing directly from players, we began improving the game faster than ever.This update includes:Added a new player tutorialRebalanced game valuesImproved combat impact and feedbackAdded more sound effectsFixed various bugsImproved localization for Latin-script languages","occurred_at":null,"published_at":"2026-10-02T15:59:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656386896","verified_at":"2026-10-20T16:20:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4714080-1844751498234081","game_id":"steam-4714080","kind":"announcement","title":"Full Metal Inferno Demo Is Now Available!","summary":"Thank you all for your support and for waiting patiently.The Full Metal Inferno Demo is now officially available!In the Demo, you can experience:6 playable vehicles30+ weapons100+ items5 difficulty levelsDozens of in-game achievementsController supportPlease note that achievements completed in the Demo do not count toward Steam Achievements.The Demo is still being adjusted and improved, particularly when it comes to game balance, weapon and item values, and the overall difficulty curve. There ma","occurred_at":null,"published_at":"2026-09-29T12:36:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498234081","verified_at":"2026-10-20T16:20:08Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4714080":{"last_attempt_at":"2026-10-26T03:41:37Z","status":"ok","all_sources_checked_at":"2026-10-26T03:41:36Z","error_codes":[]}},"news_last_attempt_at":{"steam-4714080":"2026-10-26T03:41:37Z"},"notices":[],"news_sources":{"4714080":{"last_attempt_at":"2026-10-26T03:41:36Z","last_success_at":"2026-10-26T03:41:36Z","status":"ok","error_codes":[]},"5247850":{"last_attempt_at":"2026-10-26T03:41:37Z","last_success_at":"2026-10-26T03:41:37Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4714080","app_id":4714080,"app_scope":"base","observed_at":"2026-10-26T06:14:53Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"