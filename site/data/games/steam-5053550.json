batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-5053550-1846651706694883","game_id":"steam-5053550","kind":"announcement","title":"stream live","summary":"live steam","occurred_at":null,"published_at":"2026-10-20T11:39:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706694883","verified_at":"2026-10-20T21:03:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5053550-1846651706688116","game_id":"steam-5053550","kind":"announcement","title":"To All CCR Players: A Letter Before Steam Next Fest","summary":"Hello everyone!I'm happy to announce that Cosmic Card Realm (CCR) will be participating in Steam Next Fest, from October 19 to 26!Before the festival begins, I'd like to share a few updates about the game, as well as some personal thoughts on why I started creating CCR in the first place.A Few Updates from the DeveloperAt the end of September, CCR ran into a Windows 11 code-signing issue that prevented some players from launching the game properly.Although CCR hasn't generated any revenue yet, I","occurred_at":null,"published_at":"2026-10-18T21:49:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706688116","verified_at":"2026-10-20T21:03:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5053550-1844751498231332","game_id":"steam-5053550","kind":"announcement","title":"Windows 11 Launch Issue (you can still play the CCR game with Steam Deck)","summary":"We have received reports that, starting today, some players on Windows 11 are unable to launch CCR normally.Our current investigation indicates that the issue is related to Windows Smart App Control and the digital signing of the game executable.We are already working on resolving the digital signature issue and will update the Windows build as soon as the fix is ready.We apologize for the inconvenience and appreciate your patience while we address this issue.Thank you for your understanding and","occurred_at":null,"published_at":"2026-09-28T12:18:23Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498231332","verified_at":"2026-10-20T21:03:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5053550-1844115010489429","game_id":"steam-5053550","kind":"announcement","title":"CCR is live!","summary":"CCR is live!After seven months of development, the demo of my solo-developed indie game, CCR is finally live!You’re very welcome to give it a try. Since the game is still in active development, you may run into bugs, confusing mechanics, or things that simply don’t feel right. If you encounter any problems, please let me know. I read your feedback, and I’ll do my best to investigate and fix the issues as quickly as I can.If you’ve just discovered CCR，then...The game may feel a little confusing a","occurred_at":null,"published_at":"2026-09-16T15:19:02Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010489429","verified_at":"2026-10-20T21:03:58Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5053550":{"last_attempt_at":"2026-10-26T07:38:30Z","status":"ok","all_sources_checked_at":"2026-10-26T07:38:30Z","error_codes":[]}},"news_last_attempt_at":{"steam-5053550":"2026-10-26T07:38:30Z"},"notices":[],"news_sources":{"5053550":{"last_attempt_at":"2026-10-26T07:38:30Z","last_success_at":"2026-10-26T07:38:30Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T07:38:30Z"},"5134780":{"last_attempt_at":"2026