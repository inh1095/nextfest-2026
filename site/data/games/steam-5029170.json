/v1/","context":{"app_id":5029170,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-5029170-1847286114038170","game_id":"steam-5029170","kind":"update","title":"PUBLIC LOBBIES UPDATE!!","summary":"Patch 0.2.3You asked, we delivered – public lobbies are live! Please let us know if you have any further feature requests regarding our public lobby system.You can create a private, password-protected lobby,Hosts can kick any player,You can blacklist players you do not want to play with – they will not be able to join a lobby you are hosting,Lobbies can be filtered by distance and tagged to indicate to other players how serious players in it are.","occurred_at":null,"published_at":"2026-10-23T22:29:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114038170","verified_at":"2026-10-24T02:44:04Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5029170-1847286114033849","game_id":"steam-5029170","kind":"update","title":"Demo Patch 0.2.2","summary":"Hey everyone! This is a quick one, just a small bug-fixing patch. We've got new content coming soon!Fixed BugsEars not hiding for certain head cosmetics.Cosmetics not sorting consistently.Sprint not getting reset if you sprint into an interactable and use it.","occurred_at":null,"published_at":"2026-10-22T18:36:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114033849","verified_at":"2026-10-22T23:22:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5029170-1846651706691877","game_id":"steam-5029170","kind":"update","title":"Demo Patch 0.2.1","summary":"Demo Patch 0.2.1Fixed BugsAdditional customisation menu controller support.Fixed head clipping for certain head cosmetic items.Fixed multiple bugs when a client is in the customisation menu and the host starts a new game.Removed buggy outlines in the lobby.Forced username to display on one line.Fixed crown displaying at the incorrect position if you joined with a saved outfit.MiscellaneousBalanced spatialization attenuation on Ghost Cats and did a minor balancing pass over all the Fish Heist SFX","occurred_at":null,"published_at":"2026-10-19T17:40:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691877","verified_at":"2026-10-20T20:40:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5029170-1846651706683912","game_id":"steam-5029170","kind":"update","title":"Spooky Next Fest Update!!","summary":"Patch 0.2.0This is a big one! To celebrate our participation in Steam Next Fest, we’re dropping a bunch of new content! We’ve added a new game mode, a new map, and cosmetics, so hop on RAT TAG! and give it a whirl :)Added FeaturesNew Game Mode: Fish HeistIn Fish Heist, you must steal as many fish crackers as you can from a pack of hungry ghost cats, or slap the crackers out of your friends for profit! Let us know if you enjoy this game mode, and if the balance of crackers-to-players ratio feels ","occurred_at":null,"published_at":"2026-10-17T06:32:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706683912","verified_at":"2026-10-20T20:40:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5029170-1846018067927636","game_id":"steam-5029170","kind":"update","title":"Demo Patch 0.1.4","summary":"Demo Patch 0.1.4Hey Rats! Thanks for checking out our demo! We’ve gotten some great feedback from y’all and have our first patch for bug fixes and some quality-of-life updates.Added FeaturesRearview CameraHold the “E” key (or R3 on controller) to look directly backwards from your camera’s current direction. You can still activate powerups, so this should make it easier to chuck a honey pot at a Tagger breathing down your neck!Disable Slapping in Lobby OptionIn your settings menu, toggle the “All","occurred_at":null,"published_at":"2026-10-07T21:44:31Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067927636","verified_at":"2026-10-20T20:40:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5029170-1845383656387780","game_id":"steam-5029170","kind":"announcement","title":"Thank You for 500 Wishlists!","summary":"It's time to slap your friends! We released our Demo this Monday!!Thank you to everyone who played and wishlisted our game! We've hit 500 wishlists this week, which is awesome! Please leave a review to let us know what you think!If you're looking for people to play with, would like to give us more direct feedback, or just want to hang out and chat, you can join the official RAT TAG! Discord server here!Thank you everyone, and go slap some rats!- David :D","occurred_at":null,"published_at":"2026-10-02T21:35:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656387780","verified_at":"2026-10-20T20:40:17Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5029170":{"last_attempt_at":"2026-10-26T07:16:39Z","status":"ok","all_sources_checked_at":"2026-10-26T07:16:38Z","error_codes":[]}},"news_last_attempt_at":{"steam-5029170":"2026-10-26T07:16:39Z"},"notices":[],"news_sources":{"5029170":{"last_attempt_at":"2026-10-26T07:16:38Z","last_success_at":"2026-10-26T07:16:38Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T07:1