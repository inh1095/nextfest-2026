ror_code":"no_reviews"},{"game_id":"steam-5234330","metric":"demo_ccu","observed_at":"2026-10-26T07:11:20Z","value":6,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5287960","error_code":null}],"events":[{"id":"steam-steam-5234330-1847286114042556","game_id":"steam-5234330","kind":"update","title":"Update: Custom Input Mapping has been added! And bug fix!","summary":"You can now set custom key binding for inputs!Fixed wrong display count.You can now pick up coins even when your hands are full.Lucky capsule name fixed.","occurred_at":null,"published_at":"2026-10-25T17:53:52Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114042556","verified_at":"2026-10-25T18:00:20Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5234330-1847286114037358","game_id":"steam-5234330","kind":"announcement","title":"A capsule machine added! Updated language support and many bug fixed","summary":"The click issue has been fixed, now it's smooth and react as it supposed to. No more repeat click needed.Mid-air stuck should have been fixed! Let me know if it still happens.An upgrade of sorting balls in hand has been added. It can be combined to use with your liking.Language support has been added! It can now detect to match system language and also a manual selection in setting. Right now most menu has been translated, the setting menu is still in English at the moment, will be translated so","occurred_at":null,"published_at":"2026-10-23T17:32:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114037358","verified_at":"2026-10-23T22:07:42Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5234330-1847286114033435","game_id":"steam-5234330","kind":"update","title":"Update Lucky Balls and bug fix","summary":"Some lucky balls have been added to the capsules where you could have temporary effect. Might trigger chain reaction. :) A bug reporter has been added. You can know press F9 when in game and submit bug report, it also sends a screenshot and a 60s in-game recording automatically. Some other bugs fixed.","occurred_at":null,"published_at":"2026-10-22T16:36:46Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114033435","verified_at":"2026-10-22T19:15:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5234330-1846651706695224","game_id":"steam-5234330","kind":"update","title":"Update Bug Fix","summary":"Fixed the vacuum upgrade doesn't show expected interface. Now it's functioning as expected. A few lucky items have been added to game. More to come. :)","occurred_at":null,"published_at":"2026-10-20T13:15:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706695224","verified_at":"2026-10-21T00:17:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5234330-1846651706682286","game_id":"steam-5234330","kind":"update","title":"Demo Update v0.2","summary":"Upgrades have been added to the game! You can now get upgrades at the panel on the wall. There are a few upgrades and the Vacuum to accelerate your work! Try it out and share what you think. Any suggestions are welcome! There are more upgrades to be added later! Cheers!ːsteamhappyː","occurred_at":null,"published_at":"2026-10-16T16:38:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706682286","verified_at":"2026-10-21T00:17:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5234330-1846651706674277","game_id":"steam-5234330","kind":"update","title":"Demo Update Bug Fix","summary":"Hot fix and minor updates The issue of balls stuck behind containers has been fixed. Balls on shelf with messed up numbers and layout has been fixed, some extra balls will be respawned to the matching number. Some other minor updates.","occurred_at":null,"published_at":"2026-10-14T13:24:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706674277","verified_at":"2026-10-21T00:17:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5234330-1846018067944718","game_id":"steam-5234330","kind":"update","title":"Demo Update","summary":"More language localizations added.Fixes some known issues.And the pit ball containers are counted to the total shelves now.","occurred_at":null,"published_at":"2026-10-13T16:45:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067944718","verified_at":"2026-10-21T00:17:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5234330-1846018067942069","game_id":"steam-5234330","kind":"announcement","title":"Demo Released! v0.1","summary":"Demo v0.1 just released! This version has limited features with only 1000 balls to sort, and no upgrades or multiplayer. But it will be updated to have more features in the later versions! Stay tuned! Demo is here :)","occurred_at":null,"published_at":"2026-10-12T19:11:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067942069","verified_at":"2026-10-21T00:17:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5234330-1843481262700716","game_id":"steam-5234330","kind":"announcement","title":"DISCORD ONLINE","summary":"JOIN DISCORD for future updates and playtests! And wel