/v1/","context":{"app_id":3002010,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-3002010-1846651706689727","game_id":"steam-3002010","kind":"announcement","title":"Steam Next Fest is here!","summary":"Rejoice, for we are showcasing our demo at the Steam Next fest! If you happened to try our game these last few weeks, you might have noticed some bugs going on that made the game stop at some point, and also some other bugs that might have turned down the game music way way too long. For that we apologize and hope you like our game with fixed bugs! This demo features 3 of our fights within the game, and hopefully you will have fun even with this very short preview of our game! The full one will ","occurred_at":null,"published_at":"2026-10-19T11:01:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706689727","verified_at":"2026-10-20T10:45:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3002010-1831432155579823","game_id":"steam-3002010","kind":"announcement","title":"Split Decision is featured in Psychodelic Festival!","summary":"The Psychodelic Festival is live from May 4 to May 11, as it brings together games that explore visuals with a strong focus on experimental and sensory-driven experiences. Among them you may find Split Decision, our strong-coloured game about boxing and match fixing. For now you can play our demo, and tell us what you think about the game after you play it! Our discord is always up and open for discussions on the game.You can find more about the festival here:store.steampowered.com/curator/45579","occurred_at":null,"published_at":"2026-05-05T11:46:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1831432155579823","verified_at":"2026-10-20T10:45:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3002010-1828894815554029","game_id":"steam-3002010","kind":"update","title":"Demo update","summary":"We are back with a couple more demo tweaks, this time with some changes in the storyline itself.Since this is the intro to the whole world of Split Decision, we wanted to make the story more \"in your face\", which means starting the game with more higher-stakes fights that will in a way announce on what is to come next (spoilers: even higher stakes!). This also means adding more reoccurring fighters like Naughty Bobby Neville, whom we'll hope you will love as much as we do. There are also a lot o","occurred_at":null,"published_at":"2026-04-01T08:41:24Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1828894815554029","verified_at":"2026-10-20T10:45:08Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3002010":{"last_attempt_at":"2026-10-26T00:21:28Z","status":"ok","all_sources_checked_at":"2026-10-26T00:21:28Z","error_codes":[]}},"news_last_attempt_at":{"steam-3002010":"2026-10-26T00:21:28Z"},"notices":[],"news_sources":{"3002010":{"last_attempt_at":"2026-10-26T00:21:28Z","last_success_at":"2026-10-26T00:21:28Z","status":"ok","error_codes":[]},"3826050":{"last_attempt_at":"2026-10-26T00:21:28Z","last_success_at":"2026-10-26T00:21:28Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3002010","app_id":3002010,"app_scope":"base","observed_at":"2026-10-26T06:14:11Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"93798fbcc33