g it to your Wishlist means a ","occurred_at":null,"published_at":"2026-07-22T02:02:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839041357022849","verified_at":"2026-10-20T18:26:37Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4890600":{"last_attempt_at":"2026-10-26T05:08:51Z","status":"ok","all_sources_checked_at":"2026-10-26T05:08:50Z","error_codes":[]}},"news_last_attempt_at":{"steam-4890600":"2026-10-26T05:08:51Z"},"notices":[],"news_sources":{"4890600":{"last_attempt_at":"2026-10-26T05:08:50Z","last_success_at":"2026-10-26T05:08:50Z","status":"ok","error_codes":[]},"4892090":{"last_attempt_at":"2026-10-26T05:08:51Z","last_success_at":"2026-10-26T05:08:51Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4890600","app_id":4890600,"app_scope":"base","observed_at":"2026-10-26T06:15:05Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"8330d38eb8e3e49895f5fa5ee0c7d7a2d1095c91524e247a44ef200e93e9c7d3","response_sha256":null,"source_fields":{"basic_info":{"short_description":"FrontierLord는 변경 요새를 건설하고 수비하는 픽셀 전략 게임입니다. 군주로서 마을을 짓고 목재와 광석을 채집해 생산을 운영하세요. 공성 장비와 성벽 함정을 설치하고 병사를 훈련해 약탈자를 물리치세요. 건설과 방어의 균형을 맞추고 나만의 요새를 만들어 변경 전설을 완성하세요.\r\n자원 개발과 방어의 균형을 잡고 독자적인 요새 배치를 꾸며 변경 요새를 지키며 밤낮의 수비로 당신만의 변경 전설을 만들어갑니다.","publishers":[{"name":"WallYard Studio"}],"developers":[{"name":"WallYard"}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_quarter","is_early_access":true},"trailers":{"highlights":[{"trailer_name":"FrontierLord_OfficialGameplayTrailer","trailer_url_format":"steam/apps/${FILENAME}?t=1783920963","trailer_category":3,"microtrailer":[{"filename":"4890600/515181164/6a4