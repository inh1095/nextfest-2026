/v1/","context":{"app_id":5077930,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-5077930-1845383656394328","game_id":"steam-5077930","kind":"update","title":"Vehicle Driving & Service Management Update","summary":"A new gameplay update is now available!This update makes your workshop more interactive by introducing manual vehicle driving, a new service management panel, and several improvements to the tutorial, vehicle handling, audio, and user interface.DRIVE CUSTOMER VEHICLESYou can now choose how customer vehicles are moved into the workshop.• Choose Automatic to place the vehicle directly on the assigned lift.• Choose Manual to drive the vehicle yourself.• Press B to enter or exit the vehicle.• Drive ","occurred_at":null,"published_at":"2026-10-05T18:18:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656394328","verified_at":"2026-10-20T21:40:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5077930-1844751498226057","game_id":"steam-5077930","kind":"announcement","title":"Rankings, Steam Leaderboards & Workshop Improvements","summary":"RANKINGS, STEAM LEADERBOARDS & WORKSHOP IMPROVEMENTSOver the past few days, we have been working on a substantial collection of new features, gameplay improvements, and visual refinements for Tire Dealer Simulator.This update introduces a complete ranking system, real Steam leaderboards, workshop navigation improvements, vehicle collision updates, and several interface refinements.LOCAL AND GLOBAL RANKINGSA new Rankings section is now available from the in-game management computer.You can compet","occurred_at":null,"published_at":"2026-09-25T22:20:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498226057","verified_at":"2026-10-20T21:40:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5077930-1842846814456779","game_id":"steam-5077930","kind":"update","title":"Demo Update: Faster Service, Extra Tips & Your First Employee!","summary":"Hey everyone!This demo update brings extra rewards for quick service, a clearer introduction to your first employee, and improvements to the shop HUD.Earn tips for fast serviceEvery completed customer service—including your first tutorial job—can now earn an extra tip:Very fast service: Finish within 105 in-game minutes to earn $60.Fast service: Finish in over 105 and up to 150 in-game minutes to earn $30.Normal service: Take longer than 150 in-game minutes and receive your regular payment, with","occurred_at":null,"published_at":"2026-09-08T21:22:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814456779","verified_at":"2026-10-20T21:40:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5077930-1842846814452873","game_id":"steam-5077930","kind":"update","title":"Demo Hotfix: Tutorial, Customer Flow & HUD Improvements","summary":"Hotfix: Tutorial, Customer Flow & HUD ImprovementsHello, tire dealers!We have released a new hotfix focused on improving the tutorial experience, customer flow, HUD clarity, controls, and audio settings.Customer Flow FixesFixed an issue that could stop normal customers from arriving while the tutorial was still active.New customers can now continue arriving after the tutorial sale has been accepted.Customers may arrive while you are working on another vehicle, keeping the workshop active and cha","occurred_at":null,"published_at":"2026-09-07T11:23:30Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814452873","verified_at":"2026-10-20T21:40:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5077930-1842846814450010","game_id":"steam-5077930","kind":"update","title":"Demo Hotfix – Tutorial Guidance, Interaction Fixes & Localization","summary":"Hello everyone!We've been watching your gameplay and listening to your feedback. This hotfix makes the tutorial easier to follow and addresses several interaction and localization issues.Tutorial Improvements• Added visual highlights throughout the tutorial to help you find the right equipment, items, and interaction points.• Added aiming guidance for the impact wrench to show how to target lug nuts with the tip of the tool.• Improved guidance for the lift controls, tire changer, wheel balancer,","occurred_at":null,"published_at":"2026-09-06T01:09:04Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814450010","verified_at":"2026-10-20T21:40:19Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5077930":{"last_attempt_at":"2026-10-26T08:00:37Z","status":"ok","all_sources_checked_at":"2026-10-26T08:00:36Z","error_codes":[]}},"news_last_attempt_at":{"steam-5077930":"2026-10-26T08:00:37Z"},"notices":[],"news_sources":{"5077930":{"last_attempt_at":"2026-10-26T08:00:36Z","last_success_at":"2026-10-26T08:00:36Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:00:36Z"},"5196880":{"last_attempt_at":"2026-10-26T08:00:37Z","last_success_at":"2026-10-26T08:00:37Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:00:37Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5077930","app_id":5077930,"app_scope":"base","observed_at":"2026-10-26T06:15:24Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","lang