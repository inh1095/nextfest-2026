ror_code":"no_reviews"},{"game_id":"steam-5145540","metric":"demo_ccu","observed_at":"2026-10-26T06:32:54Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5149610","error_code":null}],"events":[{"id":"steam-steam-5145540-1847286114039403","game_id":"steam-5145540","kind":"announcement","title":"Tomorrow Is the Final Playtest Day: Thank You for Your Feedback!","summary":"Hello, card duelists! Tomorrow, Sunday, October 25, is the final day of the current Phantom Cardia: Astral Card Duel Playtest. Before it wraps up, we want to say: thank you. Thank you to everyone who explored the Star Map, tried new decks and challenged the Bosses, and to everyone who shared impressions, suggestions or bug reports. Playing takes time. Writing down a problem or explaining an idea takes patience, too. We appreciate that help. One more round before we wrap up Still have an academy ","occurred_at":null,"published_at":"2026-10-24T11:26:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114039403","verified_at":"2026-10-24T14:33:35Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5145540-1847286114039094","game_id":"steam-5145540","kind":"update","title":"October Update: Room Voice Chat, Clearer Tutorials & Localization","summary":"Hello, card duelists! It has been a little while since our last post. We have been working on making Phantom Cardia: Astral Card Duel easier to pick up and more convenient to play with friends. Here is a look at the recent updates. Talk through your next move Optional real-time voice chat is now available in two-player Playtest rooms, through both Steam friends and LAN, for private duels and Co-op Raids. Plan your next card, ask your teammate to save a heal, or call out a big turn without leavin","occurred_at":null,"published_at":"2026-10-24T08:02:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114039094","verified_at":"2026-10-24T09:02:34Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5145540-1845383656377627","game_id":"steam-5145540","kind":"announcement","title":"New Tactics & Playtest Now Open! Duel or Team Up with Friends","summary":"Hello, card duelists! New tactical skills have arrived in Phantom Cardia: Astral Card Duel, and the Playtest is now open. Experiment with your deck, challenge a friend, or join forces against supercharged Bosses! Seven tactics. Which two will you bring? Before battle, choose two skills from Cheer, Persuade, Gamble, Regroup, Cleanse, Group Heal, and Seal. Each equipped tactic can be used once per battle. Cheer on a key minion, try to persuade an opponent's strongest unit, or save your healing and","occurred_at":null,"published_at":"2026-09-30T13:25:55Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656377627","verified_at":"2026-10-20T23:30:26Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5145540-1842846814442440","game_id":"steam-5145540","kind":"announcement","title":"Co-op Raid Is Live — Now Playable in the Demo!","summary":"Co-op Raid is now available in Phantom Cardia: Astral Card Duel, and the free Demo has received its own replayable AI Co-op trial. Bring your deck, join forces with a companion, and face supercharged Bosses together!Two Decks, One Common EnemyIn Co-op Raid, you and an AI companion or one friend each bring a 30-card deck. Both fighters separately manage their own Health, hand, Mana, and board, taking turns before the Boss phase begins.Watch whether your companion summoned, cast a spell, attacked,","occurred_at":null,"published_at":"2026-09-03T06:56:24Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814442440","verified_at":"2026-10-20T23:30:26Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5145540-1842212951298943","game_id":"steam-5145540","kind":"announcement","title":"Phantom Cardia Demo Is Now Live!","summary":"The Phantom Cardia: Astral Card Duel Demo is now available on Steam!Experience the core card-battle gameplay, build your deck, explore card fusion, and begin your journey through the Astral world.We would love to hear your feedback—especially about:• Tutorial clarity• Card balance and battle pacing• Controller navigation• UI readability and handheld experience• Bugs or localization issuesIf you enjoy the Demo, please consider adding the full game to your wishlist. It helps us enormously!Thank yo","occurred_at":null,"published_at":"2026-08-27T05:14:48Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951298943","verified_at":"2026-10-20T23:30:26Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5145540":{"last_attempt_at":"2026-10-26T08:46:36Z","status":"ok","all_sources_checked_at":"2026-10-26T08:46:36Z","error_codes":[]}},"news_last_attempt_at":{"steam-5145540":"2026-10-26T08:46:36Z"},"notices":[],"news_sources":{"5145540":{"last_attempt_at":"2026-10-26T08:46:36Z","last_success_at":"2026-10-26T08:46:36Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:46:36Z"},"5149610":{"last_attempt_at":"2026-10-26T08:46:36Z","last_success_at":"2026-10-26T08:46:36Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:46:36Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5145540","app_id":5145540,"app_scope":"base","observed_at":"2026-10-26T06:15:35Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"