/v1/","context":{"app_id":3998220,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-3998220","metric":"demo_ccu","observed_at":"2026-10-26T08:17:17Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5357340","error_code":null}],"events":[{"id":"steam-steam-3998220-1847286114041033","game_id":"steam-3998220","kind":"update","title":"Patch notes 1.0.7","summary":"Bug FixesFixed a rare bug where splitting a stack in a container could leave behind a ghost item icon. Every patch brings us closer to the game we want to make, and that is thanks to you! Keep the feedback coming, and stay tuned for what is next.","occurred_at":null,"published_at":"2026-10-25T01:54:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114041033","verified_at":"2026-10-25T02:56:43Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3998220-1847286114035587","game_id":"steam-3998220","kind":"update","title":"Patch notes 1.0.6","summary":"ImprovementsAdded quest reminders when quests are not being tracked.Improved performance for the cabin quest.Improved quest tracking UI.Reduced how often doors are locked.Thank you for playing and for all the feedback so far! It helps us keep improving, and more updates are on the way.","occurred_at":null,"published_at":"2026-10-23T09:14:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114035587","verified_at":"2026-10-23T12:11:07Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3998220-1847286114032164","game_id":"steam-3998220","kind":"update","title":"Patch notes 1.0.5","summary":"Bug FixesFixed issues with the item pool list.Fixed some quest icons remaining active after completion.Fixed some quests being given twice.Closed off back doors on the police station.Fixed main menu music not using the master volume.Fixed incorrect LOD settings for certain props.ImprovementsDecreased stamina consumption.Added an option to remove phone vibration sounds.Reduced muzzle flash size. Thanks to all the players who have tried the game so far! We are working on more updates, so stay tune","occurred_at":null,"published_at":"2026-10-22T10:59:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114032164","verified_at":"2026-10-22T14:40:56Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3998220-1847286114028240","game_id":"steam-3998220","kind":"update","title":"Patch notes Demo 1.0.4","summary":"ImprovementsInventory fast-move: hold CTRL to instantly pick up an item without dragging.Head bob toggle: added an option to disable camera movement/head bob.FOV slider: you can now adjust your field of view.Balance ChangesMemento Ring: reworked. Entering critical health now grants 15 seconds of invulnerability.Bug FixesFixed a bug where inventory could load incorrectly. Thanks again for the 500+ wishlists! More changes are on the way.","occurred_at":null,"published_at":"2026-10-21T09:52:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114028240","verified_at":"2026-10-21T11:35:53Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3998220-1847286114027261","game_id":"steam-3998220","kind":"update","title":"Hotfix Demo 1.0.3","summary":"Fixed a bug where inventory could load incorrectly under certain conditions. We just crossed 500 wishlists in a day, thank you so much for the support, it genuinely means a lot. More fixes and improvements are on the way.","occurred_at":null,"published_at":"2026-10-21T01:49:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114027261","verified_at":"2026-10-21T03:14:41Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3998220-1844115010493456","game_id":"steam-3998220","kind":"announcement","title":"Steam Next Fest is coming!","summary":"Hope Falls will be part of Steam Next Fest, running October 19 – October 26, starting at 10 AM.Try the demo, explore the world, and let us know what you think!👉 https://store.steampowered.com/sale/nextfest","occurred_at":null,"published_at":"2026-09-17T23:17:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010493456","verified_at":"2026-10-20T12:35:27Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3998220-1824459501605065","game_id":"steam-3998220","kind":"announcement","title":"Welcome to HOPE FALLS","summary":"Hello, and welcome to our first dev log! When we started this project two years ago, we felt the action survival genre had begun to feel too... familiar. Many games were built on the same foundations. Some did a few things brilliantly but struggled elsewhere. Others lowered the barrier so much that the experience became forgettable.Many survival games are either deeply hardcore, demanding dozens of hours just to feel competent, or they are lightweight experiences that do not leave much of a mark","occurred_at":null,"published_at":"2026-02-11T23:39:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1824459501605065","verified_at":"2026-10-20T12:35:27Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"