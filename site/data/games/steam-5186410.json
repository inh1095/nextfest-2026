om fills in as you go. {STEAM_CLAN_IM","occurred_at":null,"published_at":"2026-10-19T17:00:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691469","verified_at":"2026-10-21T00:15:00Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5186410-1843481262694341","game_id":"steam-5186410","kind":"announcement","title":"The free Hist Maker: ReMake demo is out now! Play 8 levels plus the tutorial","summary":"Hi everyone! The free Hist Maker: ReMake demo is now available on Steam!This demo includes all 8 current levels and the tutorial, free to play. These levels have been remade from the original Hist Maker, with a redesigned interface and newly illustrated civilization panoramas. Returning players can see how familiar puzzles have changed, while newcomers can start with the tutorial.Hist Maker: ReMake is a history-themed element-combination puzzle game. Choose two elements you've already discovered","occurred_at":null,"published_at":"2026-09-11T07:49:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262694341","verified_at":"2026-10-21T00:15:00Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5186410":{"last_attempt_at":"2026-10-26T09:27:45Z","status":"ok","all_sources_checked_at":"2026-10-26T09:27:44Z","error_codes":[]}},"news_last_attempt_at":{"steam-5186410":"2026-10-26T09:27:45Z"},"notices":[],"news_sources":{"5186410":{"last_attempt_at":"2026-10-26T09:27:44Z","last_success_at":"2026-10-26T09:27:44Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:27:44Z"},"5225210":{"last_attempt_at":"2026-10-26T09:27:45Z","last_success_at":"2026-10-26T09:27:45Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:27:45Z"}},"context_snapshots":[{"schema_version":1,