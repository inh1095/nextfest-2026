/v1/","context":{"app_id":2520780,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-2520780","metric":"demo_ccu","observed_at":"2026-10-26T07:32:22Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=2524430","error_code":null}],"events":[{"id":"steam-steam-2520780-1847286114039905","game_id":"steam-2520780","kind":"update","title":"Next Fest Demo Update and a Note from the Team","summary":"Hello, this is Obliqon, the team behind Net Raiders.First, we owe you an apology. We've been so focused on development that we neglected to keep you informed and to talk with you. The demo has been updated many times, but because we never shared what changed, it may have looked as if the game had stood still. Going forward, we'll do our best to share news about how the game is changing more often.Here's what's new in the demo for Steam Next Fest:• Improved tutorial: Reworked to make Card Merge e","occurred_at":null,"published_at":"2026-10-24T15:31:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114039905","verified_at":"2026-10-24T20:35:09Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2520780-1846651706695315","game_id":"steam-2520780","kind":"announcement","title":"Developer Demo Playthrough – Red Null & Six","summary":"Welcome to the Net Raiders developer playthrough!This broadcast shows full runs of our Steam Next Fest demo with both playable characters:• Red Null builds Rage from damage taken and hits harder as it stacks.• Six loads Revolver Ammo and marks enemies for powerful follow-up shots.Each run goes from Virtual Training through Sector 1 to the boss, so you can see card merging (Supply, Enhance, Transform), random events, the Data Station shop, and elite and boss fights.This is a pre-recorded broadcas","occurred_at":null,"published_at":"2026-10-20T13:42:46Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706695315","verified_at":"2026-10-21T01:02:04Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2520780-1819386365107509","game_id":"steam-2520780","kind":"update","title":"To All Raiders: Core System Update & Patch Notes","summary":"Hello, Raiders. This is Obliqon Games.First, we would like to sincerely apologize for the lack of frequent communication. Despite the great interest you’ve shown in our game, our small team size has made it challenging to stay as connected with our community as we would have liked. During this time, we have been quietly focusing all our efforts on development, driven by the desire to present results we can be proud of.While our pace may not be the fastest, we are steadily improving the game's qu","occurred_at":null,"published_at":"2025-12-25T06:44:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1819386365107509","verified_at":"2026-10-20T10:22:41Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-2520780":{"last_attempt_at":"2026-10-26T09:54:11Z","status":"ok","all_sources_checked_at":"2026-10-26T09:54:11Z","error_codes":[]}},"news_last_attempt_at":{"steam-2520780":"2026-10-26T09:54:11Z"},"notices":[],"news_sources":{"2520780":{"last_attempt_at":"2026-10-26T09:54:11Z","last_success_at":"2026-10-26T09:54:11Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:54:11Z"},"2524430":{"last_attempt_at":"2026-10-26T09:54:11Z","last_success_at":"2026-10-26T09:54:11Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:54: