ror_code":"no_reviews"},{"game_id":"steam-5107230","metric":"demo_ccu","observed_at":"2026-10-26T06:24:16Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5176510","error_code":null}],"events":[{"id":"steam-steam-5107230-1846651706684599","game_id":"steam-5107230","kind":"announcement","title":"Lose the run. Keep the factory.","summary":"You told me I was deleting your factory.Every run, you'd wire up something beautiful - and the moment the run ended, I threw it in the bin. Factory players spotted it straight away: \"Why would I build a factory I lose every run?\" Ouch. Also: correct. So I built the Foundry. How it worksYour run ends. Your factory doesn't. Win or lose, the last room you built is banked as a blueprint. It goes on the Foundry floor - one factory that never resets. One run, one new machine. Wire it into Research. Fe","occurred_at":null,"published_at":"2026-10-17T13:33:46Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706684599","verified_at":"2026-10-20T22:26:23Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5107230-1846018067929253","game_id":"steam-5107230","kind":"update","title":"Patch 0.4.0 - atmosphere update","summary":"This update is about atmosphere. Every act, room and boss now has its own look, bosses make a proper entrance, and Act 3 gets nine new rooms. New Each act is now its own place - the Assembly Floor, the Vaults, then the Forge - and opens on a title card, the first act included. Every room now has a backdrop: an industrial setting behind the canvas, with a floor tinted to the resource the room asks for. Elite and boss rooms get their own frame and lighting. Bosses now make an entrance: a title car","occurred_at":null,"published_at":"2026-10-08T11:06:02Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067929253","verified_at":"2026-10-20T22:26:23Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5107230-1844751498231357","game_id":"steam-5107230","kind":"update","title":"Minor update 0.3.0","summary":"This one is about seeing what your factory is doing: a number on every port, wires that light up under the cursor, and a tutorial that points at the right thing. Every sound in the game was re-voiced along the way. New Nodes now show what they make on each output, and sinks show their share of the room's demand. Hover a node to light its wires. Hold Shift over a tooltip to expand its extra detail - the slow hover timer is gone. A wire dropped on a port that already has one now replaces it, inste","occurred_at":null,"published_at":"2026-09-28T12:30:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498231357","verified_at":"2026-10-20T22:26:23Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5107230-1844115010494428","game_id":"steam-5107230","kind":"update","title":"patch notes v0.2.1","summary":"NewRoom replays, in Previous Runs and at the end of a run, now play on the real room canvas with throughput shown on every node. Boss replays show locked nodes and cut wires as they happened, and \"the Harvest\" replay shows which Sink was scoring each tick. A replay that no longer matches the run it recorded now tells you so. The Encyclopedia opens on an overview of your completion, with tabs and filters in each section. You can open the Encyclopedia from the pause menu without leaving the room. ","occurred_at":null,"published_at":"2026-09-18T10:54:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010494428","verified_at":"2026-10-20T22:26:23Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5107230-1843481262705110","game_id":"steam-5107230","kind":"update","title":"Patch v0.2.0","summary":"New A new Tutorial teaches the game in three Parts, from your first wire to a full run with the shop, rewards and research. Every node card shows a signature row: what the node does on your canvas, green when it beats its base value and red when it falls short. A wire that can't be placed now says why, right at the port. Winning a room now awards a canvas slot, announced on the rewards screen. Underlined words in descriptions show what they mean when you hover them, and tooltips stay open while ","occurred_at":null,"published_at":"2026-09-15T16:41:48Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262705110","verified_at":"2026-10-20T22:26:23Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5107230":{"last_attempt_at":"2026-10-26T08:22:22Z","status":"ok","all_sources_checked_at":"2026-10-26T08:22:22Z","error_codes":[]}},"news_last_attempt_at":{"steam-5107230":"2026-10-26T08:22:22Z"},"notices":[],"news_sources":{"5107230":{"last_attempt_at":"2026-10-26T08:22:22Z","last_success_at":"2026-10-26T08:22:22Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:22:22Z"},"5176510":{"last_attempt_at":"2026-10-26T08:22:22Z","last_success_at":"2026-10-26T08:22:22Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:22:22Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5107230","app_id":5107230,"app_scope":"base","observed_at":"2026-10-26T06:15:30Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"2e1e78b26604eac06bc361549e29249024ddef9cc7c23a6f236e25de09829ff3","response_sha256":null,"source_fields":{"basic_info":{"short_description":"A roguelike where every run is a factory you wire together on a canvas. Draft nodes, connect them into a production line, then press Run and find out. Each room demands more than the last - build the combo engine that keeps up, or stall three ticks from the target.","publishers":[{"name":"Mouniou","creator_clan_account_id":46265973}],"developers":[{"name":"Mouniou","creator_clan_account_id":46265973}]},"release":{"is_coming_soon":true,"custom_release_date_message":"출시 예정","coming_soon_display":"text_comingsoon","is_early_access":true},"trailers":{"highlights":[{"trailer_name":"Main Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1792242359","trailer_category":3,"microtrailer":[{"filename":"5107230/2081659539/736141002b7bfee58a9f7a3b500448187cf0aad9/1792240530/microtrailer.webm","type":"video/webm"},{"filename":"5107230/2081659539/736141002b7bfee58a9f7a3b500448187cf0aad9/1792240530/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"5107230/2081659539/736141002b7bfee58a9f7a3b500448187cf0aad9/1792240530/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"5107230/2081659539/736141002b7bfee58a9f7a3b500448187cf0aad9/1792240530/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"5107230/2081659539/736141002b7bfee58a9f7a3b500448187cf0aad9/1792240530/hls_264_master.m3u8","encoding":"hls_h264"}],"screenshot_medium":"257411956/3031d66abb84fe8596b665f0bb067056871866db/movie_600x337.jpg","screenshot_full":"257411956/3031d66abb84fe8596b665f0bb067056871866db/movie_full.jpg","trailer_base_id":1307858,"all_ages":true},{"trailer_name":"Gameplay","trailer_url_format":"steam/apps/${FILENAME}?t=1792242361","trailer_category":0,"microtrailer":[{"filename":"5107230/2081861201/b4c5f70fe65a60dea1c388622b2ffe6eeaf01f73/1792241760/microtrailer.webm","type":"video/webm"},{"filename":"5107230/2081861201/b4c5f70fe65a60dea1c388622b2ffe6eeaf01f73/1792241760/microtrailer.mp4","type":"vi