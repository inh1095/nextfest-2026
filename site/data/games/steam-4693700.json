/v1/","context":{"app_id":4693700,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4693700","metric":"demo_ccu","observed_at":"2026-10-26T09:26:12Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4957060","error_code":null}],"events":[{"id":"steam-steam-4693700-1846651706691494","game_id":"steam-4693700","kind":"announcement","title":"The Infinite Library is in Steam Next Fest","summary":"I've put The Infinite Library into Steam Next Fest this week. The demo is free, about 30 to 60 minutes, and ends at the first Redraft, which is where the strangeness starts. It's an incremental game about a library that reads itself. You write words, words become books, books fill shelves, and after a while you start to notice the Library has opinions about what you're doing. No cutscenes. The story is in the interface.What's running on this pageThere's a playthrough of the demo broadcasting her","occurred_at":null,"published_at":"2026-10-19T17:01:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691494","verified_at":"2026-10-20T16:17:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4693700-1842212951313977","game_id":"steam-4693700","kind":"announcement","title":"New key art","summary":"The Infinite Library has new key art. It was painted by Komarca Art, who I commissioned back in August. Everything you can see on the store page now comes from him. The capsules, the logotype, the library itself. Why The old capsule was mine, made with AI image tools, and it was a placeholder from the start. It did a job while I got the game finished. It was never going to be the thing people saw first on launch day. So the AI content disclosure on this page has changed too. It now reads: Key ar","occurred_at":null,"published_at":"2026-09-01T16:22:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951313977","verified_at":"2026-10-20T16:17:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4693700-1839041357030178","game_id":"steam-4693700","kind":"announcement","title":"The free demo is now on Steam","summary":"The demo is live on SteamUntil today the demo lived in a browser on itch. From today you can install it from this page, full desktop build, saves that persist, no tab required.What's in the demoThe core writing loop: words become pages, pages become books6 genres to unlock, each changing how your library growsWord discovery and undocumented Phrase craftingThe Weight of Knowledge building toward your first Redraft30–60 minutes. The demo ends where the strangeness begins.New in the demo (0.7)A \"wh","occurred_at":null,"published_at":"2026-07-24T16:51:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839041357030178","verified_at":"2026-10-20T16:17:48Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4693700":{"last_attempt_at":"2026-10-26T03:39:17Z","status":"ok","all_sources_checked_at":"2026-10-26T03:39:16Z","error_codes":[]}},"news_last_attempt_at":{"steam-4693700":"2026-10-26T03:39:17Z"},"notices":[],"news_sources":{"4693700":{"last_attempt_at":"2026-10-26T03:39:16Z","last_success_at":"2026-10-26T03:39:16Z","status":"ok","error_codes":[]},"4957060":{"last_attempt_at":"2026-10-26T03:39:17Z","last_success_at":"2026-10-26T03:39:17Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4693700","app_id":4693700,"app_scope":"base","observed_at":"2026-10-26T06:14: