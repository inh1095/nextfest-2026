/v1/","context":{"app_id":3660290,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-3660290","metric":"demo_ccu","observed_at":"2026-10-26T07:55:58Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=3698860","error_code":null}],"events":[{"id":"steam-steam-3660290-1846651706682930","game_id":"steam-3660290","kind":"update","title":"Demo Update / Fix","summary":"Hey! Another demo update - i did my best to fix ALL the bugs you reported. We've also prepared some new soundtrack made exclusively for Soul Containers!Fixed bugs:NEW MUSIC! We've created new tracks specifically for Soul Containers, so your videos won't get taken down for copyright anymore (Sorry, licensing issues ;-;)LOADING TIME HAVE BEEN REDUCED! (This is a test - if it messes up the optimization, we'll revert it to the previous version)Added the missing control instructions - picking up and ","occurred_at":null,"published_at":"2026-10-16T19:48:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706682930","verified_at":"2026-10-20T11:31:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3660290-1836506165547225","game_id":"steam-3660290","kind":"announcement","title":"SC DEMO STREAM with VOICE ACTORS","summary":"What's planned:Playthrough of the demo with commentary from the developer and voice actorsDiscussion about the full version of the gameSpecial, game related announcementsLeaks about future content :>","occurred_at":null,"published_at":"2026-06-24T22:13:21Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1836506165547225","verified_at":"2026-10-20T11:31:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3660290-1833334318568962","game_id":"steam-3660290","kind":"update","title":"Demo Update / Fix","summary":"Hey! The demo has been slightly fixed, so if you abandoned it earlier due to bugs - I recommend checking it out again!Achievements have also been added!Fixed bugs:Pausing cutscenes was breaking them, so now you can't do that.Pressing \"esc\" during a sequence where the mouse is needed would block the ability to proceed - this has been fixed.Issues related to lack of collision with walls in the levels with the raccoon and evelyn have been resolved.Gaps in the Polish language version have been patch","occurred_at":null,"published_at":"2026-05-21T13:39:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318568962","verified_at":"2026-10-20T11:31:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3660290-1830163047255313","game_id":"steam-3660290","kind":"announcement","title":"Soul Containers on Magnificon!","summary":"Let's meet in person for the first time!Right after the public release of the game demo, we'll have a chance to meet at the convention. Not only will you be able to ask us extra questions, but you can also pre-order the game, grab limited-edition merch, and take part in our RIDDLE.If you're attending the event, stopping by our booth is the biggest way to show your support!Where will it be?!Magnificon - Expo Kraków, from May 15 to 17 during convention hours! We'll be waiting in the Dunaj Hall wit","occurred_at":null,"published_at":"2026-04-15T15:45:31Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1830163047255313","verified_at":"2026-10-20T11:31:21Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_s