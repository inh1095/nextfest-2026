마 아카데미』는 여자 경마 아카데미를 무대로 펼쳐지는 스토리 중심의 경마 게임입니다. 이곳에서 경주는 단순한 속도 경쟁이 아닌, 명예와 돈, 권력과 사람들의 이해관계가 충돌하는 전장입니다. 개성 넘치는 소녀 기수들과 경쟁하고, 동맹을 맺거나 맞서며 화려한 학교 뒤에 숨은 진정한 규칙을 밝혀내세요.","publishers":[{"name":"Gamemiracle Co. Ltd."}],"developers":[{"name":"Gamemiracle Co. Ltd."}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_year"},"trailers":{"highlights":[{"trailer_name":"Trailer - horse racing gameplay","trailer_url_format":"steam/apps/${FILENAME}?t=1792571991","trailer_category":1,"microtrailer":[{"filename":"4822160/1103543720/02ff33a8fb84e9da1824d64d238533d3f7b8faa2/1792571076/microtrailer.webm","type":"video/webm"},{"filename":"4822160/1103543720/02ff33a8fb84e9da1824d64d238533d3f7b8faa2/1792571076/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4822160/1103543720/02ff33a8fb84e9da1824d64d238533d3f7b8faa2/1792571076/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"4822160/1103543720/02ff33a8fb84e9da1824d64d238533d3f7b8faa2/1792571076/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"4822160/1103543720/02ff33a8fb84e9da1824d64d238533d3f7b8faa2/1792571076/hls_264_master.m3u8","encoding":"hls_h264"}],"screenshot_medium":"257472224/047e2ee71343cac4eb6455759375958ce5cc112e/movie_600x337.jpg","screenshot_full":"257472224/047e2ee71343cac4eb6455759375958ce5cc112e/movie_full.jpg","trailer_base_id":1397057,"all_ages":true},{"trailer_name":"Training","trailer_url_format":"steam/apps/${FILENAME}?t=1791543470","trailer_category":1,"microtrailer":[{"filename":"4822160/161939810/8834e0912b3dd26c11fcf12acd42ff9071af55cb/1791542888/microtrailer.webm","type":"video/webm"},{"filename":"4822160/161939810/8834e0912b3dd26c11fcf12acd42ff9071af55cb/1791542888/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4822160/161939810/8834e0912b3dd26c11fcf12acd42ff9071af55cb/1791542888/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"4822160/161939810/8834e0912b3dd26c11fcf12acd42ff9071af55cb/1791542888/dash_h264.mp