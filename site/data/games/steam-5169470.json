ror_code":"no_reviews"},{"game_id":"steam-5169470","metric":"demo_ccu","observed_at":"2026-10-26T07:08:44Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5169730","error_code":null}],"events":[{"id":"steam-steam-5169470-1846651706691220","game_id":"steam-5169470","kind":"announcement","title":"Climb the turbine to help us climb the Next Fest charts","summary":"We’re counting the days until launch (Nov 12, just fyi) and the next part of the puzzle is here; Next Fest. We released the demo when the storepage went live to gather some early feedback, and that’s gone back into the full game to help with launch. We don’t want to spoil any of the surprises but we have worked hard to make the game more open and accessible, which you will all see on launch!Judge your remaining stamina and grip strength by the pace of your breathing and the shaking of your hands","occurred_at":null,"published_at":"2026-10-19T16:50:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691220","verified_at":"2026-10-20T23:53:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5169470-1846018067941905","game_id":"steam-5169470","kind":"announcement","title":"Developer Demo Playthrough","summary":"Can you survive the climb? Can we?Thank you to everyone who tuned in to the Harvest of Terror Showcase for our debut trailer! If you missed it, here's 2+ hours of horror goodnessWe're braving the elements to bring you the Below The Blades demo run through. It's not easy and the smart money is on us dying...a lot.Try the demo, leave a nice review, join the conversation on social and wishlist the game. It releases Nov 12 so NOT LONG NOW!X: https://x.com/TenImageLtdInstagram: https://www.instagram.","occurred_at":null,"published_at":"2026-10-12T17:56:32Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067941905","verified_at":"2026-10-20T23:53:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5169470-1846018067927136","game_id":"steam-5169470","kind":"announcement","title":"Lovecraftian monsters. A megalithic wind turbine. What more could you ask for?","summary":"Welcome to Below The Blades! If you tuned into today’s Harvest of Terror showcase, from the wonderful Horror Game Awards, you will have seen us announce this new first person climbing survival horror game! What’s that, you say? You haven’t seen the trailer? Let’s rectify that. Below the Blades is a tense, first person climbing game with some seriously ominous vibes. Isolated location? Check. Chilling sound effects? Check. Looming shadows? No backup. A stalking monster that longs to throw you to ","occurred_at":null,"published_at":"2026-10-07T18:44:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067927136","verified_at":"2026-10-20T23:53:16Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5169470":{"last_attempt_at":"2026-10-26T09:07:48Z","status":"ok","all_sources_checked_at":"2026-10-26T09:07:47Z","error_codes":[]}},"news_last_attempt_at":{"steam-5169470":"2026-10-26T09:07:48Z"},"notices":[],"news_sources":{"5169470":{"last_attempt_at":"2026-10-26T09:07:47Z","last_success_at":"2026-10-26T09:07:47Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:07:47Z"},"5169730":{"last_attempt_at":"2026-10-26T09:07:48Z","last_success_at":"2026-10-26T09:07:48Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:07:48Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5169470","app_id":5169470,"app_scope":"base","observed_at":"2026-10-26T06:15:39Z","source_url":"https://api.steampowered.com/IStoreB