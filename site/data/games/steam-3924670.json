/v1/","context":{"app_id":3924670,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-3924670-1835871199311065","game_id":"steam-3924670","kind":"announcement","title":"Devlog #14: Designing the Final Boss (and other things)","summary":"That's right! New devlog ahoy! This game is a mere decade away. Just kidding. It might be done in six months. Or twelve. Or maybe twenty-four, or three. I don't know. Don't ask me. If you want this game done, you're going to have to start motivating me a bit.","occurred_at":null,"published_at":"2026-06-21T14:56:18Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1835871199311065","verified_at":"2026-10-20T12:14:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3924670-1835236783568221","game_id":"steam-3924670","kind":"announcement","title":"Squid Chess DEMO - June 19th","summary":"Can you believe it? I sure can't, and that's surprising, because I developed the dang thing. Anyway, the Squid Chess demo is coming out on this Friday. Play it! Enjoy it! ... (or else ....)A full announcement is below.","occurred_at":null,"published_at":"2026-06-14T17:50:20Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1835236783568221","verified_at":"2026-10-20T12:14:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3924670-1826362059928180","game_id":"steam-3924670","kind":"announcement","title":"New devlog for Squid Chess! Lots of changes!","summary":"Hello, good folks of the Steam Community! ːsteamhappyːI have made a short video on the progress over the past few months:This proves that I am still working on it! I'm not releasing this game until it's dang good and ready!Anyway, anyone who signed up to play-testing is now welcome to enjoy the new features at any time, If you didn't, and you'd like to play-test, feel free to reach out! :)Enjoy! (when it's done.)-Alex","occurred_at":null,"published_at":"2026-03-08T11:52:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1826362059928180","verified_at":"2026-10-20T12:14:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3924670-1822556746167812","game_id":"steam-3924670","kind":"announcement","title":"The Playtest Begins!","summary":"The time has come. The time for you to play my game and tell me what you like about it, or more likely (because it's still early), what you don't. If you encounter any bugs, or something doesn't make sense, come tell me about it! You can use the comments section here, or the Discussion/Community area in the main game. Either one is fine. Or, you can message me on Discord directly, by joining my server here: https://discord.gg/tDqGy3RFor the time being, the negative feedback is going to be more v","occurred_at":null,"published_at":"2026-01-26T19:33:02Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1822556746167812","verified_at":"2026-10-20T12:14:17Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3924670":{"last_attempt_at":"2026-10-26T01:00:43Z","status":"ok","all_sources_checked_at":"2026-10-26T01:00:42Z","error_codes":[]}},"news_last_attempt_at":{"steam-3924670":"2026-10-26T01:00:43Z"},"notices":[],"news_sources":{"3924670":{"last_attempt_at":"2026-10-26T01:00:42Z","last_success_at":"2026-10-26T01:00:42Z","status":"ok","error_codes":[]},"4851170":{"last_attempt_at":"2026-10-26T01:00:43Z","last_success_at":"2026-10-26T01:00:43Z","status":"ok"