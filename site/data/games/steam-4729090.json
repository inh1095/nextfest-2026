/v1/","context":{"app_id":4729090,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4729090","metric":"demo_ccu","observed_at":"2026-10-26T09:46:12Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4948910","error_code":null}],"events":[{"id":"steam-steam-4729090-1846651706693605","game_id":"steam-4729090","kind":"update","title":"【Steam Next Fest】Full-Voice Demo Update Now Available","summary":"The demo for Senti Metrica, our psychological thriller × otome game, has now been updated with full character voice acting!We’re also participating in Steam Next Fest: October 2026.In the demo, you can experience:・Full character voice acting・The battle systemIf you’ve already played the previous version of the demo, we’d love for you to revisit it with the new full-voice update!And if you discovered Senti Metrica through Steam Next Fest, we hope you’ll give the demo a try!","occurred_at":null,"published_at":"2026-10-20T03:57:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706693605","verified_at":"2026-10-20T16:40:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4729090-1843481262694284","game_id":"steam-4729090","kind":"update","title":"【Demo Update Notice】 Battle System Added","summary":"The Senti Metrica demo has been updated!With this update, a new battle system has been added to the final section of the demo.The story content and overall scope of the demo remain unchanged, but players can now experience the newly implemented battle system at the end of the demo.We’ll continue improving the game to provide a smoother and more enjoyable experience. Thank you for playing!","occurred_at":null,"published_at":"2026-09-11T07:21:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262694284","verified_at":"2026-10-20T16:40:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4729090-1842846814447764","game_id":"steam-4729090","kind":"update","title":"English Support Added to the First Demo / Combat Update Coming in September","summary":"English support is now available for the first demo of Senti Metrica!The demo can now be played in English, Japanese, and Korean.We’re also planning an additional combat system update later this September. This update will include further improvements to stability and game balance, as we continue refining the overall gameplay experience.Please look forward to more news soon! Thank you as always for your support. 🫶","occurred_at":null,"published_at":"2026-09-04T20:31:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814447764","verified_at":"2026-10-20T16:40:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4729090-1842212951296510","game_id":"steam-4729090","kind":"update","title":"【Demo Update Notice】","summary":"We have fixed several text-related issues in the Senti Metrica demo.In this update, we corrected an issue in the Korean version where an outdated text file had been mistakenly applied, and replaced it with the latest version.We also fixed an issue affecting both the Korean and Japanese versions where speaker names were not displayed correctly in certain scenes, along with a number of minor text errors.We apologize for any confusion this may have caused during gameplay. We will continue reviewing","occurred_at":null,"published_at":"2026-08-26T10:33:19Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951296510","verified_at":"2026-10-20T16:40:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4729090-1841579228664405","game_id":"steam-4729090","kind":"update","title":"Demo – Minor Update Notice","summary":"A small update has been released for the Senti Metrica demo.This update includes typo fixes in the Japanese text, as well as general typo corrections and proofreading throughout the Korean text.There are no major changes to the game itself, but we’ve made some small adjustments to improve the overall reading experience.Thank you, as always, for supporting Senti Metrica! ✨ We truly appreciate your continued support.","occurred_at":null,"published_at":"2026-08-20T05:17:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228664405","verified_at":"2026-10-20T16:40:54Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4729090":{"last_attempt_at":"2026-10-26T04:00:26Z","status":"ok","all_sources_checked_at":"2026-10-26T04:00:25Z","error_codes":[]}},"news_last_attempt_at":{"steam-4729090":"2026-10-26T04:00:26Z"},"notices":[],"news_sources":{"4729090":{"last_attempt_at":"2026-10-26T04:00:25Z","last_success_at":"2026-10-26T04:00:25Z","status":"ok","error_codes":[]},"4948910":{"last_attempt_at":"2026-10-26T04:00:26Z","last_success_at":"2026-10-26T04:00:26Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4729090","app_id":4729090,"app_scope":"base","observed_at":"2026-10-26T06:14:53Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"1591030c97364b30064ee436b93abfb27937e135479282df7179ba54a1702b10","response_sha256":null,"source_fields":{"basic_info":{"short_