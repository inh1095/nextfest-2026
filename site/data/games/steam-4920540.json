red_at":null,"published_at":"2026-08-23T11:02:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228673175","verified_at":"2026-10-20T18:49:13Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4920540-1839676055896865","game_id":"steam-4920540","kind":"announcement","title":"The Elementors demo is live!","summary":"Hi everyone,The demo is live. It's free and it's on the store page right now.If you're seeing Elementors for the first time, the short version: it's a merge autobattler where the randomness is something you assemble yourself. Before a run you build a twelve-sided die out of elements, and that die is what you'll be drawing from for the rest of the game. On the board you merge creatures and stack two kinds of synergy at the same time, one from the creature's type and one from the element you infus","occurred_at":null,"published_at":"2026-08-04T08:55:24Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839676055896865","verified_at":"2026-10-20T18:49:13Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4920540-1839676055882719","game_id":"steam-4920540","kind":"announcement","title":"Elementors is on Steam","summary":"Hi everyone,The Steam page for Elementors is live. That's the news.Demo is next. It isn't out yet, but it's close. I'm finishing the last pieces and playing them, and I'd rather put it out when it holds up than push it out this week. When it's ready, this is the first place it gets posted.If you want to catch it the day it goes live, add the game to your wishlist. Steam will email you when the demo drops, and it helps a lot with visibility on my side.See you soon.","occurred_at":null,"published_at":"2026-07-29T14:39:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839676055882719","verified_at":"2026-10-20T18:49:13Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4920540":{"last_attempt_at":"2026-10-26T05:12:15Z","status":"ok","all_sources_checked_at":"2026-10-26T05:12:15Z","error_codes":[]}},"news_last_attempt_at":{"steam-4920540":"2026-10-26T05:12:15Z"},"notices":[],"news_sources":{"4920540":{"last_attempt_at":"2026-10-26T05:12:15Z","last_success_at":"2026-10-26T05:12:15Z","status":"ok","error_codes":[]},"4940370":{"last_attempt_at":"2026-10-26T05:12:15Z","last_success_at":"2026-10-26T05:12:15Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4920540","app_id":4920540,"app_scope":"base","observed_at":"2026-10-26T06:15:08Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"6c3cb32f05737adaded927badeaced06a398cfdab73025e4deac89bddbacbbc8","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Merge-autobattler where every unit fights on two synergy fronts at once. Forge your own d12 of elements, roll it every round, and fuse with creatures. 13 types × 13 elements. Every element you apply is permanent — choose wisely.","publishers":[{"name":"ORPG","creator_clan_account_id":46194209}],"developers":[{"name":"ORPG","creator_clan_account_id":46194209}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_quarter","is_early_access":true},"trailers":{"highlights":[{"trailer_name":"ELEMENTORS","trailer_url_format":"steam/apps/${FILENAME}?t=1792181175","trailer_category":1,"microtrailer":[{"filename":"4920540/1646464031/d81a754843bb9a6a72ca1e9c26c9265b8c7b9e1c/1792180739/microtrailer.webm","type":"video/webm"},{"filename":"4920540/1646464031/d81a754843bb9a6a72ca1e9c26c