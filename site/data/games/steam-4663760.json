24:57Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5167860","error_code":null}],"events":[{"id":"steam-steam-4663760-1847286114039991","game_id":"steam-4663760","kind":"announcement","title":"30,000 Wishlists. Thank You, Inspectors!","summary":"Anomaly Inspector Simulator has just passed 30,000 wishlists on Steam!Thank you to everyone who wishlisted the game, played the demo during Steam Next Fest, filled out the playtest questionnaires, and joined us on Discord. Your feedback shapes the game with every update. For a small indie team, this level of support means a lot. Every wishlist, every completed questionnaire and every message on Discord helps us make Anomaly Inspector Simulator a better game.Mind Creations team.","occurred_at":null,"published_at":"2026-10-24T16:05:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114039991","verified_at":"2026-10-24T17:16:10Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4663760-1847286114032929","game_id":"steam-4663760","kind":"update","title":"Demo Update: Bug Fixes and Graphics Improvements","summary":"Thank you for playing the Anomaly Inspector Simulator demo and sharing your feedback! A new update is now live. Graphics and Performance- Fixed upscaler Ultra Performance settings- Fixed upscaler UI in 3D- Volumetrics are now disabled on unsupported hardware- Removed capsule shadowsGameplay and UI- Improved anomaly focus- Improved the Order Assembly screen UI- Fixed the EM noise scanner audio bar size- Fixed navigation settingsBug Fixes- Fixed a projector issue- Fixed NullReference errorsThe Min","occurred_at":null,"published_at":"2026-10-22T14:34:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114032929","verified_at":"2026-10-22T15:53:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4663760-1846651706690265","game_id":"steam-4663760","kind":"announcement","title":"The Demo Is Out Now!","summary":"Greetings, Inspectors! The day has finally come. The game’s demo is now available to everyone!In this demo, you’ll experience your first few days on the job at your new workplace.Here’s what awaits you:- 9 in-game days;- Over a dozen different types of anomalies;- Tools for analyzing anomalies;- Unique orders from the military and scientists hunting down anomalies;- Unique events tied to anomaly behavior;- A base upgrade system;- A human experimentation mechanic.The demo will continue to receive","occurred_at":null,"published_at":"2026-10-19T13:37:21Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706690265","verified_at":"2026-10-20T15:56:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4663760-1846018067935914","game_id":"steam-4663760","kind":"announcement","title":"Playtest 2.0 Is Live","summary":"Attention, all Inspectors. This is the Bureau Headquarters speaking.First of all, we would like to thank everyone who took part in the previous playtest for your help!Our headquarters is currently in full preparation for Steam Next Fest. We are putting the final touches on the demo, and once again, we need your help.Playtest 2.0 is now live! New invitations are being sent out, and we are looking forward to your feedback, comments, and ideas.Access to the playtest also remains available to everyo","occurred_at":null,"published_at":"2026-10-10T10:31:38Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067935914","verified_at":"2026-10-20T15:56:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4663760-1843481262689098","game_id":"steam-4663760","kind":"announcement","title":"Playtest Is Live + New Game Name","summary":"Playtest Is Live + New Game NameHey everyone! The playtest is live on Steam! During the playtest we'll be shaping the build for Steam Next Fest in October 2026, so your feedback really matters right now. The playtest runs in several waves, so don't worry if you don't get access right away, you'll have another chance in a later round! We'd really appreciate it if you filled out the survey after finishing the playtest and shared your thoughts. Also, join our Discord to share your feedback with the","occurred_at":null,"published_at":"2026-09-09T13:46:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262689098","verified_at":"2026-10-20T15:56:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4663760-1838407329268861","game_id":"steam-4663760","kind":"announcement","title":"20,000 Wishlists. Thank You!","summary":"20,000 wishlists. Thank you.For a four-person studio, this isn't just a number on a dashboard. It's the signal that keeps us moving and brings the release closer.Stay with us. Mind Creations","occurred_at":null,"published_at":"2026-07-21T12:24:48Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1838407329268861","verified_at":"2026-10-20T15:56:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4663760-1837955055365734","game_id":"steam-4663760","kind":"announcement","title":"10,000 Wishlists in Under 4 Days","summary":"10,000 wishlists in under 4 days. Didn't see this coming.Thank you to everyone who wishlisted, shared, and told a friend. You're the reason this is happening!Mind Creations","occurred_at":null,"published_at":"2026-07-14T10:30:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1837955055365734","verified_at":"2026-10-20T15:56:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4663760-1837955055358849","game_id":"steam-4663760","kind":"announcement","title":"The Bureau Is Now Hiring — Meet Anomaly Control Simulator","summary":"Hello everyone,We're Mind Creations — a small independent studio, and Anomaly Control Simulator is our debut title. After a long stretch of quiet work behind closed doors, we're incredibly excited to finally open up and share the project with you! How to stay close to the project:⭐ Wishlist the game right here on Steam - it genuinely helps us more than you might think💬 Join our Discord community https://discord.gg/QnYQTeyftj📡 Follow us for regular updates and dev diariesThank you for being here ","occurred_at":null,"published_at":"2026-07-11T07:52:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1837955055358849","verified_at":"2026-10-20T15:56:06Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4663760":{"last_attempt_at":"2026-10-26T13:17:42Z","status":"ok","all_sources_checked_at":"2026-10-26T13:17:41Z","error_codes":[]}},"news_last_attempt_at":{"steam-4663760":"2026-10-26T13:17:42Z"},"notices":[],"news_sources":{"4663760":{"last_attempt_at":"2026-10-26T13:17:41Z","last_success_at":"2026-10-26T13:17:41Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T13:17:41Z"},"5167860":{"last_attempt_at":"2026-10-26T13:17:42Z","last_success_at":"2026-10-26T13:17:42Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T13:17:42Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4663760","app_id":4663760,"app_scope":"base","observed_at":"2026-10-26T06:14:46Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1