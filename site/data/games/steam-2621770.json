/v1/","context":{"app_id":2621770,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-2621770-1846018067933578","game_id":"steam-2621770","kind":"announcement","title":"HEXRITE DEMO OUT NOW! 🪄","summary":"The most recent demo for Hexrite is now available for all to download from the Steam store page! ✨You'll be able to play through the tutorial, meet important NPC's at the hub zone and play a portion of Witchgrave, the first main level in the game! If you encounter any bugs or issues during your playthrough, please don't hesitate in letting us know either on the Steam forums or through our Discord, we'll be applying patches with fixes and small changes whilst the demo stays up.We're looking forwa","occurred_at":null,"published_at":"2026-10-09T14:56:38Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067933578","verified_at":"2026-10-20T10:23:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2621770-1833968530889280","game_id":"steam-2621770","kind":"announcement","title":"HEXRITE COMING LATER THIS YEAR!🔮","summary":"Our all-new official trailer is here:🔮 Invoke powerful magical domes! 👹 Make pacts with gods!✨️ Choose from a vast arsenal of spells!🌌 Travel haunted cities and floating towers!We're planning to have our main demo available this summer, please stay tuned and make sure to wishlist to keep track of upcoming news!","occurred_at":null,"published_at":"2026-05-28T19:45:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833968530889280","verified_at":"2026-10-20T10:23:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2621770-1809235871625221","game_id":"steam-2621770","kind":"announcement","title":"Hexrite is releasing 2026!","summary":"✨ We are excited to announce that Hexrite will be releasing in 2026! ✨It's been a long time coming but alongside a brand-new gameplay trailer, we are happy to let you know that you'll be able to get your hands on the full game next year!You can support us until then by wishlisting the game and telling your friends and family! 🪄We have temporarily removed the demo from the Steam page to apply a crucial update and will be uploading it again in September! We'll have more updates and news to share s","occurred_at":null,"published_at":"2025-08-29T16:55:21Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1809235871625221","verified_at":"2026-10-20T10:23:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2621770-1799088287991372","game_id":"steam-2621770","kind":"update","title":"Hexrite Demo Patch 1 Notes","summary":"The Hexrite Demo has been out for a few weeks and we've been listening and noting down all your feedback and bug reports, and we have now released our first major patch to make your demo experience better and smoother. You'll find that you're playing the right version if you see 'Hexrite v.0.4.4' on the top right corner of your screen whilst playing. Please check out the patch notes below: Player Feedback 📝 After performing an air attack, you can now finish it up with a follow-up. You can also n","occurred_at":null,"published_at":"2025-05-13T13:59:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1799088287991372","verified_at":"2026-10-20T10:23:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2621770-1797820624427043","game_id":"steam-2621770","kind":"announcement","title":"Hexrite Demo Out Now!","summary":"We're proud to announce that the demo for Hexrite has now released on Steam! You can download it straight from the main store page! Explore the coral-filled Nuvemar, face a series of challenging bizarre enemies and meet the Dream Empress at the top of her ruined castle! Don't forget to join our Discord for any bug reports or feedback you might have, alternatively you can talk with us through the Steam Forums, enjoy the demo and thank you for all your support thus far!","occurred_at":null,"published_at":"2025-04-23T13:05:16Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1797820624427043","verified_at":"2026-10-20T10:23:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2621770-5395937983657720855","game_id":"steam-2621770","kind":"announcement","title":"Hexrite wins Best Game at the PlayStation Talents Awards!","summary":"Last week during our first public showing of Hexrite at both Lisboa Games Week and MEO XL Games, Hexrite was one of the 10 finalists for the PlayStation Talents Awards, being nominated for 3 categories: Best Game Award, Press Award and Best Art Award. We're happy to announce we've won 2 of these: 🏆 Best Game Award! 🏆 Press Award! This award means that in the future we'll be able to not only release the game on Steam (PC) but also consoles linked to the PlayStation environment, this will also hel","occurred_at":null,"published_at":"2023-11-29T15:12:04Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5395937983657720855","verified_at":"2026-10-20T10:23:16Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-2621770":{"last_attempt_at":"2026-10-26T00:18:52Z","status":"ok","all_sources_checked_at":"2026-10-26T00:18:51Z","error_codes":[]}},"news_last_attempt_at":{"steam-2621770":"2026-10-26T