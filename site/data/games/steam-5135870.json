d_at":null,"published_at":"2026-10-20T11:40:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706694886","verified_at":"2026-10-20T23:09:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5135870-1846651706687178","game_id":"steam-5135870","kind":"announcement","title":"《胡来！文字麻将》Steam 新品节试玩直播","summary":"欢迎来到《胡来！文字麻将》Steam 新品节直播间！ 这是一款支持 2–4 人联机的爆笑文字派对游戏。和朋友一起摸字、出牌、拼出离谱胡句，看看谁的脑洞最大！ 直播期间将循环播放游戏玩法演示。欢迎下载免费 Demo 体验，喜欢的话记得加入 Steam 愿望单！","occurred_at":null,"published_at":"2026-10-18T15:01:41Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706687178","verified_at":"2026-10-20T23:09:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5135870-1846651706684131","game_id":"steam-5135870","kind":"announcement","title":"【抽兑换码】《胡来！文字麻将》新品节福利加码！","summary":"《胡来！文字麻将》正在参加 Steam 新品节！感谢大家一直以来的关注和支持，我们决定追加一波愿望单挑战福利！愿望单达到目标，抽奖名额越多，奖励持续解锁！奖励梯度当愿望单累计达5千时，抽取1名玩家送出CDK当愿望单累计达8千时，额外抽取2名玩家送出CDK当愿望单累计达1万时，额外抽取2名玩家送出CDK参与步骤将《胡来！文字麻将》加入Steam个人愿望单愿望单页面截图，包含清晰Steam账号（参考示例图）填写活动报名表，并按要求上传愿望单截图👉 活动报名入口：https://wj.qq.com/s2/28236842/1ga9/ 【复制链接到浏览器：填写活动表单链接】📅 活动时间活动时间： 10月17日至10月29日结果公布： 10月30日📌 活动细则每个 Steam 账号限参与一次，重复提交不增加中奖概率。截图需清晰显示 Steam 账号及《胡来！文字麻将》已加入愿望单的状态。禁止盗用他人截图、伪造截图或通过其他违规方式参与，一经发现将取消活动资格。在信息单内完整填写的真实信息，将作为获奖后团队联系您的渠道。未完整填写信息、填写错误信息均视为无效参与。领取方式：奖品将在正式版上线后统一","occurred_at":null,"published_at":"2026-10-17T08:57:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706684131","verified_at":"2026-10-20T23:09:51Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5135870":{"last_attempt_at":"2026-10-26T08:45:08Z","status":"ok","all_sources_checked_at":"2026-10-26T08:45:08Z","error_codes":[]}},"news_last