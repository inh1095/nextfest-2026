ror_code":"no_reviews"},{"game_id":"steam-5112140","metric":"demo_ccu","observed_at":"2026-10-26T06:25:12Z","value":4,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5177470","error_code":null},{"game_id":"steam-5112140","metric":"price_final","observed_at":"2026-10-26T10:31:31Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5112140,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-5112140","metric":"review_count","observed_at":"2026-10-26T10:31:31Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5112140,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-5112140","metric":"review_positive_percent","observed_at":"2026-10-26T10:31:31Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":5112140,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-5112140","metric":"demo_ccu","observed_at":"2026-10-26T11:40:04Z","value":3,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5177470","error_code":null}],"events":[{"id":"steam-steam-5112140-1847286114031286","game_id":"steam-5112140","kind":"announcement","title":"Thank you for Next Fest, and duels worth watching","summary":"The free demo has been updated with cinematic officer duels: momentum you can see, signature moves the heroes actually perform, and a finishing blow. Plus what changed during Next Fest because of what you told me. Thank you. Over the last few days, a lot of you downloaded the demo, played it, wishlisted the game and took the time to tell me what worked and what didn't. Next Fest is the first time this many people have played Three Kingdoms Reimagined at once, and reading your comments and watchi","occurred_at":null,"published_at":"2026-10-22T05:42:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114031286","verified_at":"2026-10-22T07:35:34Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1846018067942645","game_id":"steam-5112140","kind":"announcement","title":"Officers who make a name: deeds, titles and court honors","summary":"Officers now remember what they did in your service, earn titles for it, and want things from you in return. Out today in the free demo and the full game. Guan Yu used to start a campaign as \"Retainer, Untested Blade\", and whatever happened after that, the History tab only listed experience awards: \"Field battle won, +30 XP\", once per battle. In a 240-day test campaign Cao Cao fought 29 battles and came out of them without a single memory. The officers are the reason people love this period, and","occurred_at":null,"published_at":"2026-10-13T01:49:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067942645","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1845383656382065","game_id":"steam-5112140","kind":"announcement","title":"A campaign for two: play Three Kingdoms Reimagined with a friend","summary":"Two players share one campaign as allies or rivals. It is in the free demo now, ahead of Steam Next Fest, October 19 to 26. Since the demo went up, the request I have heard most often is to play it with someone else. I have spent the last few weeks on exactly that. Two people can now share a whole campaign: the same map, the same year 196, and the same rival houses, with each of you leading your own warlord from your own seat. You decide how the two of you stand. The host chooses whether you beg","occurred_at":null,"published_at":"2026-10-01T16:12:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656382065","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1844751498229276","game_id":"steam-5112140","kind":"announcement","title":"Closer to the fight: rebuilt battles, single combat and a character of your own","summary":"The last devlog was about the campaign crises that lead to the great battles. Since then I have spent nearly all of my time on the battles themselves. I played through them as a new player would see them and kept running into things that still looked like placeholders: soldiers that could have walked out of a medieval European game, duels you could barely see, and sieges where nobody climbed a ladder. The demo on Steam now has the rebuilt versions, and it still covers the first fifty campaign da","occurred_at":null,"published_at":"2026-09-27T14:18:51Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498229276","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1844751498223241","game_id":"steam-5112140","kind":"announcement","title":"Turning Points: make your own Three Kingdoms epic","summary":"Guandu and Red Cliffs are the kinds of battles I keep coming back to when thinking about Three Kingdoms Reimagined. I want that feeling of a campaign reaching a confrontation where the armies on the field carry the weight of everything that came before them. Who did you bring into your service, and who did you trust to speak for you? How much of your treasury were you willing to put behind an uncertain promise? Turning Points are the campaign crises I have been building around that idea. They br","occurred_at":null,"published_at":"2026-09-25T03:31:41Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498223241","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1844751498218922","game_id":"steam-5112140","kind":"update","title":"Demo update: council plans, contact reports and battle aftermath","summary":"Council advice now stays with you after the meeting. Before a battle, a new report shows who's at contact. After a victory, you choose what the army does with the losses and spoils. A council plan you can follow When you accept a civil proposal, the map shows the current course and the next order needed to begin it. Choose an eligible officer to supervise the work; accepting the plan alone does not start construction or spend the assignment cost. Once work begins, the course names the officer an","occurred_at":null,"published_at":"2026-09-23T16:07:38Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498218922","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1844115010487821","game_id":"steam-5112140","kind":"announcement","title":"A clearer start: tutorials, council and the first 50 days","summary":"Players told us the opening put too many mechanics and too much text on screen at once. We've reworked the tutorial around the action you need next, shortened the early explanations, and made council decisions easier to understand. The updated 50-day demo is available now on Steam. One lesson at a time The campaign guide now shows one task and a Show Me button that opens the right screen or marks your destination. Extra explanations and reward details are available under Details. Later sealed le","occurred_at":null,"published_at":"2026-09-16T00:46:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010487821","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1843481262700336","game_id":"steam-5112140","kind":"announcement","title":"Custom Battles: Choose Your Field, Army and Opening Plan","summary":"Following the Custom Battle release, we have rebuilt the setup around three steps: Field, Host, and Plan. Pick the ground, build both armies, set an opening formation, and begin. Begin battle stays available from every stage once both armies are ready. Choose the field Five biomes are available: plains, riverland, steppe, mountain, and basin. Reroll the seed for a new layout, then set clear, rain, or fog. Weather changes the battle for real: rain slows marching, shortens missile range, and weake","occurred_at":null,"published_at":"2026-09-13T23:14:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262700336","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1843481262698258","game_id":"steam-5112140","kind":"announcement","title":"Custom Battle is now in the demo","summary":"The updated Steam demo adds Custom Battle. Choose Custom Battle from the main menu to build both armies, select a field, and take the fight through deployment and real-time combat. {STEAM_CLAN_IMAGE}/46285229/00d635dd33c4ee8a947c5d3f94dbda6246f3c6cc.gif Build the matchup you want Choose from 147 historical officers. Each army can have up to five officers, including its commander. Once an officer joins either side, that officer leaves the shared selection pool. Historical stats and traits stay fi","occurred_at":null,"published_at":"2026-09-12T20:25:35Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262698258","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1843481262696380","game_id":"steam-5112140","kind":"announcement","title":"The free Steam demo is available now","summary":"Hi everyone, The free Windows demo of Three Kingdoms Reimagined is now available on Steam. Thank you to everyone who has followed development, tried an earlier build, or joined the community. I'm excited to finally put this version in your hands. Download the demo from the Steam store page by clicking Download Demo. Your first 50 campaign days Begin in China in 196 AD as a historical ruler or create your own landed house. Decide where to expand on the pausable real-time campaign map, manage sett","occurred_at":null,"published_at":"2026-09-11T20:41:02Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262696380","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1842846814456313","game_id":"steam-5112140","kind":"update","title":"Development Update — Beyond the Result","summary":"I want Auto Resolve to leave me with a sense of the battle I just fought. This pass improves which officers and troops the calculation counts, then presents the outcome in a short battle account. These are development-build changes following Taking Command, not an announcement of a new downloadable build. The screenshots and motion excerpt use staged encounters running through the current game. The animated account illustrates an already-resolved battle; it is not a replay of a hidden tactical s","occurred_at":null,"published_at":"2026-09-08T17:01:32Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814456313","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1842846814454072","game_id":"steam-5112140","kind":"update","title":"Development Update — Taking Command","summary":"Since the last update, I've been working on a problem that becomes more obvious the longer I play: having plenty of choices is only useful if I can understand them in the middle of a campaign. That has meant bringing officer information together, making the menus feel like part of the same game, and going back over sieges from both sides of the wall. This post covers the development work after Making the next order clear, through gameplay commit 2f9eb05. These are development-build changes, not ","occurred_at":null,"published_at":"2026-09-07T21:20:24Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814454072","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1842846814449752","game_id":"steam-5112140","kind":"update","title":"Development Update — Making the next order clear","summary":"I kept running into the same problem while testing: the answer was in one place, and the action was in another. I could see that an army was selected without being able to tell which officers were in it. A commission named a settlement in the journal while the map asked me to interpret a different marker. None of those gaps is huge by itself, but together they make the campaign feel unfinished. The Three Kingdoms sandbox I want to make still comes down to familiar people and an ending you can ma","occurred_at":null,"published_at":"2026-09-05T20:09:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814449752","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1842846814445166","game_id":"steam-5112140","kind":"update","title":"Development Update — The War Remembers","summary":"The Three Kingdoms sandbox I want to make As a solo developer, the vision I keep coming back to is a Three Kingdoms sandbox—or maybe a toybox is the better word—that players can truly make their own. I love this period because I have come to know these characters, their ambitions, their friendships, and their grudges. But I do not want the game to simply march everyone toward the ending we already know. I want Cao Cao, Liu Bei, Yuan Shao, Sun Ce, Lu Bu, and the rest of the cast to enter the worl","occurred_at":null,"published_at":"2026-09-04T02:59:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814445166","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5112140-1842846814439299","game_id":"steam-5112140","kind":"announcement","title":"The Steam page is live","summary":"Three Kingdoms Reimagined now has a public Steam page.The gameplay trailer follows the core campaign chain: rule a landed house in China in 196 AD, turn visible problems into orders carried by named officers, command the battles and sieges those orders create, and carry wounds, captures, loot, and ownership changes back into the campaign.The free Steam demo has been uploaded and is still under Valve review. It is not playable on Steam yet. A free 50-campaign-day Windows demo remains available on","occurred_at":null,"published_at":"2026-09-02T04:58:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814439299","verified_at":"2026-10-20T22:46:30Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5112140":{"last_attempt_at":"2026-10-26T08:23:09Z","status":"ok","all_sources_checked_at":"2026-10-26T08:23:09Z","error_codes":[]}},"news_last_attempt_at":{"steam-5112140":"2026-10-26T08:23:09Z"},"notices":[],"news_sources":{"5112140":{"last_attempt_at":"2026-10-26T08:23:09Z","last_success_at":"2026-10-26T08:23:09Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:23:09Z"},"5177470":{"last_attempt_at":"2026-10-26T08:23:09Z","last_success_at":"2026-10-26T08:23:09Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T08:23:09Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5112140","app_id":5112140,"app_scope":"base","observed_at":"2026-10-26T06:15:32Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"072de2c0f8b362e9e4753fe838516d557eb88c7bb18521f92faab3ac32acdf33","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Rule a house in China in 196 AD, alone or with a friend. Expand on a pausable real-time campaign map, command thousands of soldiers in field battles, sieges and duels, and keep a court of officers who remember your promises, rage when a sworn brother falls and carry every wound into the campaign.","publishers":[{"name":"Jeremy Cabaccang"}],"developers":[{"name":"Jeremy Cabaccang"}]},"release":{"steam_re