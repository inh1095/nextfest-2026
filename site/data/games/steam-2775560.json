/v1/","context":{"app_id":2775560,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-2775560","metric":"demo_ccu","observed_at":"2026-10-26T07:33:12Z","value":1,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=3009000","error_code":null}],"events":[{"id":"steam-steam-2775560-5842939267361730664","game_id":"steam-2775560","kind":"announcement","title":"You now have Puzzles!","summary":"I've just added puzzles to Chess Twist. Those will allow you to play quick games, without requiring the same time commitment as a typical chess game. There are currently 1200 different ones, of various difficulties. And I plan to add many more in the coming weeks and months. Some puzzles should be really easy, giving a good taste of the new strategies in Chess Twist. And others should really challenge your gears. For instance, in this one below, you can checkmate with black in 4 moves or less. C","occurred_at":null,"published_at":"2024-07-11T20:46:31Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5842939267361730664","verified_at":"2026-10-20T10:24:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2775560-5746109972563588312","game_id":"steam-2775560","kind":"update","title":"Demo Update #2","summary":"Hey hey. I'm still working on the feedback received from the demo last week. Pawn moves One that stood out was regarding the movement of the pawns. My initial reaction was not to change what was already in place, as it seemed to me to be working just fine. How pawns moved before? The way it worked was that the pawns would follow the exact same rules as classic chess, which is that they can only move forward. And the forward direction in the boards generated here was toward the edge of the tile t","occurred_at":null,"published_at":"2024-06-10T14:07:55Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5746109972563588312","verified_at":"2026-10-20T10:24:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2775560-5742731639348337930","game_id":"steam-2775560","kind":"update","title":"Demo Update #1","summary":"Last week end was a blast, the demo got popular on twitter and reddit. Thanks a ton to everybody who played the game, and especially to those who took the time to provide feedback. So here are fixes for 3 issues that got mentioned: Board Look The previous textures used for the board were too contrasted. This was a bit distracting and made the board not as easy to read as it could be. So I looked at this again, tested with several new textures, tweaked some colors and we now have something that i","occurred_at":null,"published_at":"2024-06-04T13:28:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5742731639348337930","verified_at":"2026-10-20T10:24:17Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-2775560":{"last_attempt_at":"2026-10-26T00:19:52Z","status":"ok","all_sources_checked_at":"2026-10-26T00:19:52Z","error_codes":[]}},"news_last_attempt_at":{"steam-2775560":"2026-10-26T00:19:52Z"},"notices":[],"news_sources":{"2775560":{"last_attempt_at":"2026-10-26T00:19:52Z","last_success_at":"2026-10-26T00:19:52Z","status":"ok","error_codes":[]},"3009000":{"last_attempt_at":"2026-10-26T00:19:52Z","last_success_at":"2026-10-26T00:19:52Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-2775560","app_id":2775560,"app_scope":"base","observed_at":"2026-10-26T06:14:10Z","source_url":"https://a