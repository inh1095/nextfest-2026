ms/v1/","context":{"app_id":3927170,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-3927170","metric":"demo_ccu","observed_at":"2026-10-26T08:16:24Z","value":6,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4638510","error_code":null}],"events":[{"id":"steam-steam-3927170-1846018067930521","game_id":"steam-3927170","kind":"announcement","title":"CH13: Rest Stop Releases on October 28!","summary":"CH13: Rest Stop has an official release date - October 28, 2026 :) I’ve also uploaded a New Official Trailer, along with an Updated Demo! It’s a more polished version of what was there before - I wanted it to better reflect how the full game will look. This is the final version before release. So if you haven’t played the demo yet, now is a great time to check it out :) If you’ve already played it before, I’d probably recommend waiting for the full game. The beginning has changed a little, but o","occurred_at":null,"published_at":"2026-10-08T16:50:48Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067930521","verified_at":"2026-10-20T12:14:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3927170-1833968530884149","game_id":"steam-3927170","kind":"announcement","title":"Demo: added Accessibility Audio Mode + small fixes","summary":"Changes:added Accessibility Audio Mode - it adds additional visual cues, recommended for players without headphones, spatial audio, or with hearing difficultiesadded information that all music and sounds are copyright-freecorrected spelling mistake xdother small fixes and improvementsThank you for all the feedback and bug reports!","occurred_at":null,"published_at":"2026-05-27T00:54:00Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833968530884149","verified_at":"2026-10-20T12:14:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3927170-1833334318575299","game_id":"steam-3927170","kind":"announcement","title":"Thank you for all the support!","summary":"I just wanted to say thank you :) I got a lot of feedback from you in reviews, steam discussion and in private messages on Instagram and X/Twitter. I still can’t believe how positive the response has been!Thank you all for your support! I’m truly grateful :)I’m so glad that you're enjoying something I've worked on for so long.I’ll give it my all to make the full game the best it can be!","occurred_at":null,"published_at":"2026-05-24T12:21:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318575299","verified_at":"2026-10-20T12:14:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3927170-1833334318566917","game_id":"steam-3927170","kind":"announcement","title":"CH13: Rest Stop Demo is OUT NOW!","summary":"Hey everyone! It took me a year, but I finally released a demo for CH13: Rest Stop! 📢It's around 15-20 minutes long and it gives you first look at the atmosphere and horror experience I’m building for the full game. I’d be really happy if you decided to give it a try, and I’d love to hear what you think! You can leave a review on Steam or message me on X/Twitter: @Yell0wSmile If you enjoy it, please consider wishlisting the full game! Full game will probably be ready at the end of the 2026.Thank","occurred_at":null,"published_at":"2026-05-20T17:29:51Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318566917","verified_at":"2026-10-20T12:14:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3927170-1808061939511800","game_id":"steam-3927170","kind":"update","title":"Development update","summary":"Hello everyone! 👋When I first created this store page, my initial plan was to release Rest Stop for free. After giving it more thought, I’ve decided to set a small price instead. This will help me cover some development costs and support future projects.The game is still in early development. I’m pouring all my energy into it and hope it’ll be an experience you’ll enjoy.Thank you for your understanding and for supporting my work! 💙","occurred_at":null,"published_at":"2025-08-19T20:08:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1808061939511800","verified_at":"2026-10-20T12:14:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3927170-1807332909734991","game_id":"steam-3927170","kind":"announcement","title":"Steam page is now LIVE!","summary":"📢 It's official!You can now visit the page for Rest Stop and:\"View new screenshots and the official game description\"\"Watch Rest Stop announcement trailer\"\"Learn more about Rest Stop story and setting\"\"Follow the project for updates and release news\"\"Add it to your wishlist so you don't miss launch day\"Rest Stop is a short, atmospheric psychological horror set in early 2000s Poland. You play as Wojciech, a young father on a long, lonely night drive through the forest. Fatigue starts to take over","occurred_at":null,"published_at":"2025-08-12T14:46:23Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1807332909734991","verified_at":"2026-10-20T12:14:21Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3927170":{"last_attempt_at":"2026-10-26T01:00:47Z","status":"ok","al