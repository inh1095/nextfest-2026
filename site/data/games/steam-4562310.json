/v1/","context":{"app_id":4562310,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4562310","metric":"demo_ccu","observed_at":"2026-10-26T09:03:48Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4694260","error_code":null}],"events":[{"id":"steam-steam-4562310-1846651706690999","game_id":"steam-4562310","kind":"update","title":"Ultimate Classic Car Racing 2 — Demo 3.0 Update Changelog","summary":"Ultimate Classic Car Racing 2 — Demo 3.0 Update ChangelogThis will be the final major demo update before the full release of Ultimate Classic Car Racing 2 on November 12.With Steam Next Fest underway, we wanted to bring the demo up to date with the latest improvements and give players one last look at the game before launch.Thank you to everyone who has played the demo and shared feedback. steamhappyThis update focuses on improving vehicle readability, collisions, weapon balance, and camera beha","occurred_at":null,"published_at":"2026-10-19T16:12:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706690999","verified_at":"2026-10-20T14:51:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4562310-1844751498232556","game_id":"steam-4562310","kind":"announcement","title":"DEMO OFFLINE","summary":"A big thank you to everyone who played the UCCR2 Demo 2.0. I’m taking it offline for now to polish it and bring it up to the standard of the game's Version 1.0 and final release. I’ll be preparing a build for Demo Version 3.0 in time for the October Next Fest which kicks off just before the game's official launch on November 12th. Thanks again for the feedback and for getting a taste of what’s to come see you in November!!!ːsteamhappyː","occurred_at":null,"published_at":"2026-09-28T21:28:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498232556","verified_at":"2026-10-20T14:51:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4562310-1842846814453874","game_id":"steam-4562310","kind":"announcement","title":"Ultimate Classic Car Racing 2 — Demo 2.0 Changelog","summary":"Game ModesːsteamhappyːRaceImproved the overall race flow.Improved the lap and position systems.Added bot support.Improved bot behavior during races.Added recovery systems for vehicles that get stuck.Improved vehicle behavior after finishing a race.Vehicles that cross the finish line now stop using smoke and nitro effects.Players who finish a race are no longer considered valid targets for certain weapons.Improved the transition between the end of the race and the results screen.Improved the came","occurred_at":null,"published_at":"2026-09-07T18:55:21Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814453874","verified_at":"2026-10-20T14:51:39Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4562310":{"last_attempt_at":"2026-10-26T02:54:37Z","status":"ok","all_sources_checked_at":"2026-10-26T02:54:36Z","error_codes":[]}},"news_last_attempt_at":{"steam-4562310":"2026-10-26T02:54:37Z"},"notices":[],"news_sources":{"4562310":{"last_attempt_at":"2026-10-26T02:54:36Z","last_success_at":"2026-10-26T02:54:36Z","status":"ok","error_codes":[]},"4694260":{"last_attempt_at":"2026-10-26T02:54:37Z","last_success_at":"2026-10-26T02:54:37Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4562310","app_id":4562310,"app_scope":"base","observed_at":"2026-10-26T06:14:41Z","source_url":"https://api.