e_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706685629","verified_at":"2026-10-21T00:37:52Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5285160-1846018067934056","game_id":"steam-5285160","kind":"announcement","title":"Silk Collector Demo Is Out Now","summary":"Hello Collectors,Thank you to everyone who added Silk Collector to their wishlist. Today the demo is finally out. You can now step inside House of Laurent and start putting the store back in order.What’s in the DemoGround FloorThe demo opens the entrance and the ground floor of House of Laurent.ClothesOut of the 4,012 clothes in the full game, 240 are waiting for you in the demo, across 2 types of clothing.Skills and PowersYou can try the first level of 2 skills and 3 powers, each one built to m","occurred_at":null,"published_at":"2026-10-09T17:00:36Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067934056","verified_at":"2026-10-21T00:37:52Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5285160-1846018067931267","game_id":"steam-5285160","kind":"announcement","title":"Thanks for 2,000 Wishlists in 5 Days, Demo Coming Tomorrow","summary":"Hello Collectors,Silk Collector reached 2,000 Wishlists in just 5 days. We honestly did not expect it to happen this fast, and we want to thank every one of you who added the game to your wishlist.Every wishlist tells us that a clothing store full of scattered clothes and a fairy is something you want to play.Demo Coming TomorrowTomorrow you can step inside House of Laurent and start shelving the clothes yourself. We would love to hear what you think, so after you play, tell us on Steam discussi","occurred_at":null,"published_at":"2026-10-08T19:53:54Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067931267","verified_at":"2026-10-21T00:37:52Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5285160-1844751498234215","game_id":"steam-5285160","kind":"announcement","title":"Silk Collector Is Officially Announced","summary":"Hello Collectors,Silk Collector is now officially announced, and its Steam page is live. You may know us from Tailor Simulator, and since this is our second game, I am really excited to be writing this announcement. First, let me tell you a little about Silk Collector.Core GameplayEvery piece on the floor already has a place somewhere across three floors. The shelves are sorted by type and size, so a medium gown and a large gown never share a shelf. You can carry several pieces at once, and plan","occurred_at":null,"published_at":"2026-09-29T13:15:22Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498234215","verified_at":"2026-10-21T00:37:52Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5285160":{"last_attempt_at":"2026-10-26T09:31:20Z","status":"ok","all_sources_checked_at":"2026-10-26T09:31:19Z","error_codes":[]}},"news_last_attempt_at":{"steam-5285160":"2026-10-26T09:31:20Z"},"notices":[],"news_sources":{"5285160":{"last_attempt_at":"2026-10-26T09:31:19Z","last_success_at":"2026-10-26T09:31:19Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:31:19Z"},"5375680":{"last_attempt_at":"2026-10-26T09:31:20Z","last_success_at":"2026-10-26T09:31:20Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:31:20Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5285160","app_id":5285160,"app_scope":"base","observed_at":"2026-10-26T06:15:42Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_