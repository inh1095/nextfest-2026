/v1/","context":{"app_id":5032520,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-5032520-1847286114033776","game_id":"steam-5032520","kind":"update","title":"📱🗣️ Demo Update! - The phone glow up + new voices 📱🗣️","summary":"🦑🥸 Hello everyone, happy Next Fest! 🥸🦑We hope you’re enjoying the demo and leaving lovely reviews on the page 😉💕We’re just as hyped as you are about this weird little queer kid (Masc, Mask & Masked), so we pushed a new demo update!📱🗣️ The phone got a glow-up (and the voices got an update)! 🗣️📱Thank you so much for all the feedback since the demo. We listened, we cried a little, and we got to work. This update is about two big things, the phone and voices. 💕📱 The phone has like a million new thin","occurred_at":null,"published_at":"2026-10-22T18:09:52Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114033776","verified_at":"2026-10-22T23:23:17Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5032520-1846651706685227","game_id":"steam-5032520","kind":"announcement","title":"Masc, Mask & Masked is taking part in October's Next Fest!","summary":"Hello!!! 🐙👋 We’re excited to announce that Masc, Mask & Masked is part of Steam Next Fest! The demo is available for the whole festival, so now’s the perfect time to give it a try. Playing one route is about 20min of cosmic comedy, but if you want to get to the end of the demo and unravel it's secret, it can be 1h of gameplay full of twinks, bears, dolls and tentacles. 💌🐙✨ Mini demo update 🔧We’ve also made a few minor fixes to the demo. One of them is the new streamer mode, so you can record and","occurred_at":null,"published_at":"2026-10-17T17:53:14Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706685227","verified_at":"2026-10-20T20:40:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5032520-1846018067930306","game_id":"steam-5032520","kind":"announcement","title":"Demo available now!","summary":"🦑🥸 The cosmic prophecy is being fulfilled! 🥸🦑We are excited to announce that the Masc, Mask & Masked demo is out now! 🎉 We'll be participating in this October's Next Fest, but since you are all so nice and we can't wait to share our weird stuff with you, the demo is out early! 💜What you'll find in the demo 🎭 Three different picturesque characters to catfish 💬 Their respective routes, conversations and endings 🦑 A healthy dose of absurd cosmic comedy But, don't get too comfortable! For the full r","occurred_at":null,"published_at":"2026-10-08T15:59:04Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067930306","verified_at":"2026-10-20T20:40:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5032520-1844751498227689","game_id":"steam-5032520","kind":"announcement","title":"Masc, Mask & Masked is going to be at the San Diego Comic-Con Málaga! 🥳🥸","summary":"Hello, guys! We are thrilled to announce that we are debuting our demo at an in-person event. The event is none other than the San Diego Comic-Con Málaga! 🥳🥸 We are going to show the demo for the first time! We will bring stickers, prints , and maybe some more cool things with us. If you want to try the game or say hi to the devs, please stop by our booth! Also, make sure to follow us on our socials to stay tuned to this adventure and more: https://linktr.ee/mascmaskmasked See you there! 🦑","occurred_at":null,"published_at":"2026-09-26T17:31:51Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498227689","verified_at":"2026-10-20T20:40:58Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5032520":{"last_attempt_at":"2026-10-25T22:14:31Z","status":"ok","all_sources_checked_at":"2026-10-25T22:14:31Z","error_codes":[]}},"news_last_attempt_at":{"steam-5032520":"2026-10-25T22:14:31Z"},"notices":[],"news_sources":{"5032520":{"last_attempt_at":"2026-10-25T22:14:31Z","last_success_at":"2026-10-25T22:14:31Z","status":"ok","error_codes":[]},"5207690":{"last_attempt_at":"2026-10-25T22:14:31Z","last_success_at":"2026-10-25T22:14:31Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5032520","app_id":5032520,"app_scope":"base","observed_at":"2026-10-26T06:15:18Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"c5c8739cd146ea7ef988034cad465280287dac68ee6733cc12f08a3c4937a172","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Masc, Mask & Masked is a game that combines mini-games with a visual novel in a terrifyingly cute 2D style. Search through your mobile, chat to your potential dates and recover the powerful mask of Niarlatoted.","publishers":[{"name":"3DGoblinDev"},{"name":"ladamaduende"},{"name":"Sanktuary"}],"developers":[{"name":"3DGoblinDev"},{"name":"ladamaduende"},{"name":"Sanktuary"}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_quarter"},"trailers":{"highlights":[{"trailer_name":"Masc, Mask & Masked - Demo out now trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1791476011","trailer_category":0,"microtrailer":[{"filename":"5032520/1586074015/889e270bf44a82f016ca1ba820b830a6aba5dbb9/1791475503/microtrailer.webm","type":"video/webm"},{"filename":"5032520/1586074015/889e270bf44a82f01