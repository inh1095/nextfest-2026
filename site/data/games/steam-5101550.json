ror_code":"no_reviews"},{"game_id":"steam-5101550","metric":"demo_ccu","observed_at":"2026-10-26T06:22:56Z","value":1,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5248310","error_code":null}],"events":[{"id":"steam-steam-5101550-1847286114036184","game_id":"steam-5101550","kind":"announcement","title":"The Geek Cupboard Plays KAARTEL!","summary":"A huge thank you to The Geek Cupboard for taking the time to play and make this video!And another big thank you to everyone who's downloaded the demo, joined the Discord, reported bugs, or simply shared their thoughts. It means a lot to me as a solo developer.Haven't played KAARTEL yet?The free demo is available on Steam!","occurred_at":null,"published_at":"2026-10-23T12:23:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114036184","verified_at":"2026-10-23T15:58:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5101550-1847286114031817","game_id":"steam-5101550","kind":"announcement","title":"Escape Mode is Coming to KAARTEL — Play as the Thief!","summary":"You've caught enough thieves. Now it's your turn.I've been working on a new way to play KAARTEL, and this time, we're flipping the chase around.Introducing Escape Mode!Instead of hunting down a thief across Europe, you play as the thief.Plan your route, make your way through Europe's rail and ferry network, and try to stay one step ahead of whoever's chasing you.The very same map you used to hunt criminals becomes your escape route. Suddenly, every connection, detour, and destination looks a lit","occurred_at":null,"published_at":"2026-10-22T09:04:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114031817","verified_at":"2026-10-22T12:52:13Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5101550-1846651706684951","game_id":"steam-5101550","kind":"announcement","title":"KAARTEL is coming to Steam Next Fest!","summary":"We're excited to announce that KAARTEL is joining Steam Next Fest, October 19–26!In KAARTEL, you're chasing a moving thief across Europe's rail and ferry networks. Ask questions, narrow down their possible locations, and use clever tactics to intercept them before they escape.The free demo is already available, and we're continuing to improve the game based on player feedback.We're a tiny indie studio, so every playthrough, suggestion, and wishlist means a lot.Play the demo, tell us what you thi","occurred_at":null,"published_at":"2026-10-17T16:04:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706684951","verified_at":"2026-10-20T22:25:35Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5101550-1845383656396689","game_id":"steam-5101550","kind":"announcement","title":"KAARTEL Demo Is Out Now!","summary":"Someone has stolen something. They're on the run across Europe. And it's your job to catch them.The free demo of KAARTEL is now available to play! If you enjoy the game, please wishlist KAARTEL and share your feedback. As a solo developer, your feedback helps me improve the game ahead of release.No luck. Just deduction.— Jion Interactive","occurred_at":null,"published_at":"2026-10-06T14:53:52Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656396689","verified_at":"2026-10-20T22:25:35Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5101550":{"last_attempt_at":"2026-10-25T22:54:29Z","status":"ok","all_sources_checked_at":"2026-10-25T22:54:28Z","error_codes":[]}},"news_last_attempt_at":{"steam-5101550":"2026-10-25T22:54:29Z