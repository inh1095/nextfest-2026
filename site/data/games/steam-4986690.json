ublished_at":"2026-09-17T17:08:12Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010492761","verified_at":"2026-10-20T19:55:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4986690-1843481262697498","game_id":"steam-4986690","kind":"update","title":"Demo update 0.9.6.3","summary":"Demo update 0.9.6.3 — the factory now tells you what's wrongThe first days of the demo taught me one thing very clearly: the game knew why you were stuck, and kept it to itself. Several players sat watching an accepted order go nowhere, with no idea why. This update fixes the silence, not the difficulty. No threshold, penalty, quantity or timing has been changed.Orders now explain themselvesAn order that isn't moving now says why, right on its card, with real numbers and the exact material and f","occurred_at":null,"published_at":"2026-09-12T13:45:54Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262697498","verified_at":"2026-10-20T19:55:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4986690-1843481262693185","game_id":"steam-4986690","kind":"announcement","title":"BOTTLECAPEPRS DEMO IS OUT NOW","summary":"Hi Bottlecappers,I've been working on this game for a while now, in the evenings and on weekends whenever I can. I think the best way to explain what kind of game it is, and whether you might like it, is simply to let you play it. So the demo is out.The demo lets you play a full, winnable run. The only real limitation is that you play with one investor, the first one: the Cortesu Family. The progression tree that unlocks the other investors is closed for now.Beyond letting you try the game, the ","occurred_at":null,"published_at":"2026-09-10T18:52:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262693185","verified_at":"2026-10-20T19:55:58Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4986690":{"last_attempt_at":"2026-10-26T05:55:28Z","status":"ok","all_sources_checked_at":"2026-10-26T05:55:27Z","error_codes":[]}},"news_last_attempt_at":{"steam-4986690":"2026-10-26T05:55:28Z"},"notices":[],"news_sources":{"4986690":{"last_attempt_at":"2026-10-26T05:55:27Z","last_success_at":"2026-10-26T05:55:27Z","status":"ok","error_codes":[]},"5187560":{"last_attempt_at":"2026-10-26T05:55:28Z","last_success_at":"2026-10-26T05:55:28Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4986690","app_id":4986690,"app_scope":"base","observed_at":"2026-10-26T06:15:14Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"b64f4ecca0afea365485ab0ae201a2afd1acbb4133b593cb28c1466265259db5","response_sha256":null,"source_fields":{"basic_info":{"short_description":"병뚜껑 공장을 짓고, 생산 라인을 자동화하고, 단 하나의 숫자로 당신을 평가하는 투자자들의 분기별 심사에서 살아남으세요. 풍자적인 공장 경영 로그라이트: 그들의 KPI를 달성하고, 모든 지분을 되사들인 뒤, 문밖으로 정중히 모셔 드리세요.","publishers":[{"name":"ShardanaForge"}],"developers":[{"name":"ShardanaForge"}]},"release":{"is_coming_soon":true,"custom_release_date_message":"출시 예정","coming_soon_display":"text_comingsoon"},"trailers":{"highlights":[{"trailer_name":"Bottlecappers - coming soon - demo out","trailer_url_format":"steam/apps/${FILENAME}?t=1790976984","trailer_category":2,"microtrailer":[{"filename":"4986690/1345126786/d94ae95eb099b21396339ac61f17c0eaa9d4c3c8/1790975724/microtrailer.webm","type":"video/webm"},{"filename":"4986690/1345126786/d94ae95eb099b21396339ac61f17c0eaa9d4c3c8/1790975724/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4986690/1345126786/d94ae95