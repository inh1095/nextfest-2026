Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4971070,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-4971070","metric":"review_count","observed_at":"2026-10-26T14:45:17Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4971070,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-4971070","metric":"review_positive_percent","observed_at":"2026-10-26T14:45:17Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4971070,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4971070","metric":"demo_ccu","observed_at":"2026-10-26T15:52:50Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5074380","error_code":null}],"events":[{"id":"steam-steam-4971070-1847286114034780","game_id":"steam-4971070","kind":"announcement","title":"Somewhere out in that parking lot are a dozen stray carts","summary":"Somewhere out in that parking lot are a dozen stray carts, and corporate would like them back before your shift ends.Chain them into a train, up to five at a time, and haul the whole snake back across the lot before the next rush hits the front doors. Halfway through the fest, store 1's still free if you haven't clocked in yet.","occurred_at":null,"published_at":"2026-10-23T02:42:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114034780","verified_at":"2026-10-23T04:13:45Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4971070-1847286114030706","game_id":"steam-4971070","kind":"announcement","title":"The shelves don't restock themselves. You do, by throwing crates at them","summary":"The shelves don't restock themselves. You do, by throwing crates at them from across the store. Wind up, aim, let go. Hit the shelf and it's stocked. Miss and whatever was in that crate is now the mess you'll be mopping up on your next lap. Corporate calls this \"an efficiency initiative.\"","occurred_at":null,"published_at":"2026-10-22T00:39:31Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114030706","verified_at":"2026-10-22T01:13:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4971070-1847286114029508","game_id":"steam-4971070","kind":"announcement","title":"The register doesn't care how your day is going.","summary":"Every scan chains into the next if you keep the rhythm. Miss the beat and the combo resets, along with your tip. It's the fastest way to turn a bad shift into a good one, assuming the line hasn't already wrapped around the frozen aisle.Still five days left in the fest. Store 1 is free the whole time.","occurred_at":null,"published_at":"2026-10-21T16:27:04Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114029508","verified_at":"2026-10-21T19:48:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4971070-1846651706691426","game_id":"steam-4971070","kind":"announcement","title":"Next Fest starts now. The demo is live.","summary":"ValuCo #3 is failing, corporate noticed, and you're the fix. Store 1 of Cleanup on Aisle 3 is free to play all week: five days, one competent employee, and a store that gets worse every shift.The full game opens November 3. Seven stores, and this is the easy one. Wishlist it while you're here.","occurred_at":null,"published_at":"2026-10-19T17:00:54Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706691426","verified_at":"2026-10-20T19:34:35Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4971070-1846018067939640","game_id":"steam-4971070","kind":"update","title":"Update 0.7.5: A Streamer Got Fired, So We Fixed Some Things","summary":"Helana Matta played Cleanup on Aisle 3 on stream this weekend, then posted a video. She was fired on day 9. She laughed about it, which is more than most people manage. We watched all of it and took notes. This update is those notes. The menus now answer to a mouse Two different streamers have reached for the mouse on the title screen and found nothing there. Now there is something there. Move the mouse on any menu and a cursor appears. Point at a row to select it, left click to choose, right cl","occurred_at":null,"published_at":"2026-10-12T00:15:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067939640","verified_at":"2026-10-20T19:34:35Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4971070-1844115010500345","game_id":"steam-4971070","kind":"announcement","title":"The free demo is open for business","summary":"ValuCo has a store that needs a manager, and the pay is exposure to valuable retail experience.The Cleanup on Aisle 3 demo is out now, free, on this page. Take over a failing grocery store and keep it afloat: stock the shelves, run the checkout lines, round up the carts, and pick an upgrade from corporate each night to decide how tomorrow goes wrong.Play solo, or hand a second controller to someone on the couch and press A to clock them in. Remote Play Together works too.If you have it wishliste","occurred_at":null,"published_at":"2026-09-21T04:58:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010500345","verified_at":"2026-10-20T19:34:35Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4971070":{"last_attempt_at":"2026-10-26T15:58:09Z","status":"ok","all_sources_checked_at":"2026-10-26T15:58:09Z","error_codes":[]}},"news_last_attempt_at":{"steam-4971070":"2026-10-26T15:58:09Z"},"notices":[],"news_sources":{"4971070":{"last_attempt_at":"2026-10-26T15:58:09Z","last_success_at":"2026-10-26T15:58:09Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T15:58:09Z"},"5074380":{"last_attempt_at":"2026-10-26T15:58:09Z","last_success_at":"2026-10-26T15:58:09Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T15:58:09Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4971070","app_id":4971070,"app_scope":"base","observed_at":"2026-10-26T06:15:12Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"7ded571ddd779e016071d398d7f3b953b5948ba646546b23dc927f72a42408c0","response_sha256":null,"source_fields":{"basic_info":{"short_description":"You are the only competent employee (or bring a friend). Keep a failing grocery store alive while corporate makes everything worse: hurl crates, chain combos, wrangle cart trains. PlateUp-style escalation, seven stores, couch co-op and Remo