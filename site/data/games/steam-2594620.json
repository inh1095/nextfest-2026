"value":2,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4733860","error_code":null}],"events":[{"id":"steam-steam-2594620-1819386365122375","game_id":"steam-2594620","kind":"announcement","title":"New Modelpack System is finally here!","summary":"Figure Drawing Garden just got a massive update. The new Modelpack System lets you dynamically load custom 3D models for your studies, and a new Modelpack Creator project means you can build your own Modelpacks right now too. Maybe classical sculptures aren't your cup of tea, you want a fun break from study, or maybe you just really want to draw dinosaurs, mech, or anime characters. With Figure Drawing Gardens brand new Modelpack system, you can import custom modelpacks, mix and match, and even ","occurred_at":null,"published_at":"2026-01-04T22:15:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1819386365122375","verified_at":"2026-10-20T10:23:07Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2594620-1819386365095002","game_id":"steam-2594620","kind":"update","title":"❄️ Winter Comes to Figure Drawing Garden — December Mini Update","summary":"Just a very small December update adding some holiday theming. This release was mainly about getting seasonal events working for the future, but if you download the latest demo on Gamejolt / Itch right now - you’ll find the ponds frozen, snow falling, and some festive music until the end of December.In addition, the Human Scans model pack has received a few new additions. Just open the Model Packs tab and enable Human Scans to check them out.Happy holidays!","occurred_at":null,"published_at":"2025-12-19T12:16:07Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1819386365095002","verified_at":"2026-10-20T10:23:07Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-2594620-1808601382477214","game_id":"steam-2594620","kind":"announcement","title":"Devlog: Where Did the Idea Come From?","summary":"Remember during the pandemic everyone started a \"lockdown project\"? — Mine was a video game to practice drawing. Well it's now 2025, and my “lockdown project” is finally starting to take shape, so I thought it's about time I made the first devlog for — Figure Drawing Garden.ORIGIN OF THE IDEA...Back in 2020, before the world came to a complete stop, I was on Erasmus in Paris, studying animation at Gobelins L'École de L’Image. My favorite thing to do while there was draw in the Louvre's magnifice","occurred_at":null,"published_at":"2025-08-22T12:28:26Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1808601382477214","verified_at":"2026-10-20T10:23:07Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-2594620":{"last_attempt_at":"2026-10-26T09:54:37Z","status":"ok","all_sources_checked_at":"2026-10-26T09:54:37Z","error_codes":[]}},"news_last_attempt_at":{"steam-2594620":"2026-10-26T09:54:37Z"},"notices":[],"news_sources":{"2594620":{"last_attempt_at":"2026-10-26T09:54:37Z","last_success_at":"2026-10-26T09:54:37Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:54:37Z"},"4733860":{"last_attempt_at":"2026-10-26T09:54:37Z","last_success_at":"2026-10-26T09:54:37Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:54:37Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-2594620","app_id":2594620,"app_scope":"base","observed_at":"2026-10-26T06:14:09Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"fada959