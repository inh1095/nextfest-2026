ror_code":"no_reviews"},{"game_id":"steam-5174790","metric":"demo_ccu","observed_at":"2026-10-26T07:09:13Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5234520","error_code":null}],"events":[{"id":"steam-steam-5174790-1846651706693717","game_id":"steam-5174790","kind":"update","title":"Small Update: Easier-to-Spot Cursor, Easier Coin Pickup","summary":"Hi Commanders! This small demo update tweaks two things about how the game feels to play: New gold mouse cursor: a bigger gold arrow with a thick outline and a soft shadow, so it's easy to spot over sand, grass and the night battlefield. The cursor scales with your resolution: 32 px at 720p and below, 48 px at 1080p, 64 px above that. 1.5× coin pickup range: the pickup radius when you sweep the mouse over coins goes from 70 to 105, so you no longer have to chase coins down one by one. Thanks for","occurred_at":null,"published_at":"2026-10-20T04:56:46Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706693717","verified_at":"2026-10-20T23:54:15Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5174790-1844751498222929","game_id":"steam-5174790","kind":"update","title":"Demo update: HD battle visuals","summary":"This update redraws the Demo's battle visuals from top to bottom. The art style is the same, but every unit, boss, battlefield and effect is now much sharper. No gameplay numbers have changed. Units and bosses All Human and Undead units, and every enemy you meet in waves 1–40, are now in HD at twice the previous resolution. They stay crisp when scaled up, with no more jagged edges. The Headsman and the Bone Dragon King have been redrawn and now have a front-facing walk. Soldiers no longer shuffl","occurred_at":null,"published_at":"2026-09-24T23:51:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498222929","verified_at":"2026-10-20T23:54:15Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5174790-1844115010496657","game_id":"steam-5174790","kind":"update","title":"Demo update: 8 new languages","summary":"The Demo now supports 11 interface languages. This update also fixes a few issues found since the last one. New languages German, French, Spanish (Spain), Portuguese (Brazil), Russian, Japanese, Korean and Italian. On first launch the game follows your system language. You can switch at any time under Settings → Language, from the main menu or the pause menu. Every screen has been laid out again for the new languages: longer text now shrinks slightly or wraps instead of spilling out of its frame","occurred_at":null,"published_at":"2026-09-19T05:41:52Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010496657","verified_at":"2026-10-20T23:54:15Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5174790-1844115010493576","game_id":"steam-5174790","kind":"update","title":"Demo update: kill streak pot, checkpoints, a nemesis and Steam rankings","summary":"This update gives the Demo a \"push your luck\" short-term goal, plus a Steam leaderboard. Kill streak pot Chaining kills builds a streak, shown at the top of the screen. The higher your streak within a wave, the more XP goes into the pot when the wave ends. The pot isn't yours yet. Every 5 waves a checkpoint appears: cash out to bank the whole pot and head to the Star Map, or keep defending and push your luck. If the castle falls, only half the pot survives. At the end of each wave, XP now flies ","occurred_at":null,"published_at":"2026-09-18T01:19:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010493576","verified_at":"2026-10-20T23:54:15Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5174790-1843481262701555","game_id":"steam-5174790","kind":"update","title":"Demo update: Traditional Chinese","summary":"The demo now supports Traditional Chinese. Added Traditional Chinese (Taiwan wording). Switch it in Settings → Language: 简体中文 / 繁體中文 / English. If your system language is Traditional Chinese and you haven't picked a language yet, the game now starts in Traditional Chinese. If you already picked one, nothing changes. The first time you prestige, a short comic plays. Press any key or click to skip it. Thanks for playing! If any Traditional Chinese wording reads oddly, tell us on Discord or in the ","occurred_at":null,"published_at":"2026-09-14T12:30:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262701555","verified_at":"2026-10-20T23:54:15Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5174790":{"last_attempt_at":"2026-10-26T09:08:47Z","status":"ok","all_sources_checked_at":"2026-10-26T09:08:47Z","error_codes":[]}},"news_last_attempt_at":{"steam-5174790":"2026-10-26T09:08:47Z"},"notices":[],"news_sources":{"5174790":{"last_attempt_at":"2026-10-26T09:08:47Z","last_success_at":"2026-10-26T09:08:47Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:08:47Z"},"5234520":{"last_attempt_at":"2026-10-26T09:08:47Z","last_success_at":"2026-10-26T09:08:47Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:08:47Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5174790","app_id":5174790,"app_scope":"base","observed_at":"2026-10-26T06:15:39Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null