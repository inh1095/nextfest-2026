/v1/","context":{"app_id":4932110,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4932110-1847286114039167","game_id":"steam-4932110","kind":"update","title":"100 Wishlisters + DEMO UPDATE","summary":"We recently hit 100 wishlisters! Thank you all for the support, I really do appreciate it! As a thank you, I have released an update to the DEMO! I've added a new walkable area with some new story bits when you beat the first level! This area is ONLY accessible once you beat the first level so make sure to beat it again to access it! I think you guys will like it :) Take care everyone! -N8tus","occurred_at":null,"published_at":"2026-10-24T08:59:18Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114039167","verified_at":"2026-10-24T13:05:07Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4932110-1845383656388182","game_id":"steam-4932110","kind":"update","title":"Demo Patch #1","summary":"Bug fixes:You can now exit the keymapping menu if you try changing keyboard specific keys with a controller.Empty title screen screen is fixed when launching the tutorial and then exiting to main menu.No way to exit the simulation from tutorial screen. Button added.Random flashing of the mouse in certain scenes when using gamepad has been fixed.Enhancements:Braking now feels way better. Ship does not fall when braking.","occurred_at":null,"published_at":"2026-10-03T01:34:31Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656388182","verified_at":"2026-10-20T19:09:55Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4932110-1845383656384773","game_id":"steam-4932110","kind":"announcement","title":"Steam Demo OUT NOW!","summary":"The Epsilon Hyperpunk demo is out now!!! It comes with a few improvements!!The New Steam Demo Features:Key Mapping!Better VisualsImproved audioThe demo will also be a part of next fest! Exciting!! This demo serves as a way for me to gather feedback and suggestions. Please do not hesitate to leave a review on the demo page!Thank you everyone for the continued support :)-N8tus","occurred_at":null,"published_at":"2026-10-02T03:17:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656384773","verified_at":"2026-10-20T19:09:55Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4932110-1844751498233099","game_id":"steam-4932110","kind":"announcement","title":"Steam Demo Releasing Soon!","summary":"The Epsilon Hyperpunk demo is (Finally) coming to Steam! It comes with a few improvements that differ from the regular itch.io demo, with Key Mapping being the biggest feature! Right now, I am simply waiting for Steam to approve the game page and build, and we will be good to go ;) This should realistically take a week (Maybe even sooner?)The New Steam Demo Features:Key Mapping!Better VisualsImproved audioThe demo will also be a part of next fest! Exciting!! Another announcement will go out once","occurred_at":null,"published_at":"2026-09-29T04:09:30Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498233099","verified_at":"2026-10-20T19:09:55Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4932110":{"last_attempt_at":"2026-10-26T05:30:55Z","status":"ok","all_sources_checked_at":"2026-10-26T05:30:55Z","error_codes":[]}},"news_last_attempt_at":{"steam-4932110":"2026-10-26T05:30:55Z"},"notices":[],"news_sources":{"493211