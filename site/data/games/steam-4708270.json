s you made.Amara's conversation has been extended to help find the different outcomes.Najma's vignette portrait has been replaced with one that represents her better.Surfaced a bit more reactivity to the player's choices.If you have already played through the demo know that these changes are not significant.What's Next?I will continue working on the game with ","occurred_at":null,"published_at":"2026-07-12T23:08:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1837955055361998","verified_at":"2026-10-20T16:19:25Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4708270":{"last_attempt_at":"2026-10-26T03:40:54Z","status":"ok","all_sources_checked_at":"2026-10-26T03:40:53Z","error_codes":[]}},"news_last_attempt_at":{"steam-4708270":"2026-10-26T03:40:54Z"},"notices":[],"news_sources":{"4708270":{"last_attempt_at":"2026-10-26T03:40:53Z","last_success_at":"2026-10-26T03:40:53Z","status":"ok","error_codes":[]},"4713470":{"last_attempt_at":"2026-10-26T03:40:54Z","last_success_at":"2026-10-26T03:40:54Z","status":"ok","error_codes":[]}}}
