2026-10-26T02:59:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114043474","verified_at":"2026-10-26T12:32:05Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1847286114041013","game_id":"steam-4500530","kind":"update","title":"DEMO Update Ver 0.7.2","summary":"Added background settings for the option menu.\\ NORMAL, DARK, LOW CONTRAST\\ NORMAL, DARK, LOW CONTRAST, BLACK, BRIGHT*Note: The \"NORMAL\" setting has been made slightly darker.","occurred_at":null,"published_at":"2026-10-25T01:40:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114041013","verified_at":"2026-10-25T03:42:22Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1847286114030729","game_id":"steam-4500530","kind":"update","title":"DEMO Update Ver 0.7.1","summary":"To make it easier to notice when the FUSION gauge has fully recovered, we have added an animation around the player and increased the volume of the associated sound effect.","occurred_at":null,"published_at":"2026-10-22T00:53:33Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114030729","verified_at":"2026-10-22T04:37:39Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1846651706690095","game_id":"steam-4500530","kind":"announcement","title":"Raging Blasters 2 joins Steam Next Fest (October 2026)","summary":"Raging Blasters 2 is coming to Steam Next Fest: October 2026 Edition. The demo lets you play Caravan Mode, Arcade Mode (up to Stage 2), and Training Mode (up to Stage 2). You are free to stream your gameplay and share screenshots. We hope you enjoy the game!","occurred_at":null,"published_at":"2026-10-19T13:00:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706690095","verified_at":"2026-10-20T14:28:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1846651706686150","game_id":"steam-4500530","kind":"update","title":"DEMO Update Ver 0.7.0","summary":"Minor revisions","occurred_at":null,"published_at":"2026-10-18T05:14:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706686150","verified_at":"2026-10-20T14:28:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1846651706676800","game_id":"steam-4500530","kind":"update","title":"DEMO Update Ver 0.6.9","summary":"Performance tuning","occurred_at":null,"published_at":"2026-10-15T08:29:36Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706676800","verified_at":"2026-10-20T14:28:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1846651706673255","game_id":"steam-4500530","kind":"update","title":"DEMO Update Ver 0.6.8","summary":"Some minor tuning","occurred_at":null,"published_at":"2026-10-14T05:54:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706673255","verified_at":"2026-10-20T14:28:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1846018067940517","game_id":"steam-4500530","kind":"update","title":"DEMO Update Ver 0.6.7","summary":"Added bonus categories to the results screen.Before: CRYSTALAfter: CRYSTAL, MAX CHAIN, SHIP, NO DAMAGE","occurred_at":null,"published_at":"2026-10-12T10:12:51Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067940517","verified_at":"2026-10-20T14:28:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1846018067938581","game_id":"steam-4500530","kind":"update","title":"DEMO Update Ver 0.6.6","summary":"Adjusted enemy placement and other elements in Caravan Mode to make it easier to maintain chains.Other minor adjustments.","occurred_at":null,"published_at":"2026-10-11T14:19:54Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067938581","verified_at":"2026-10-20T14:28:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1846018067931796","game_id":"steam-4500530","kind":"update","title":"DEMO Update Ver 0.6.5","summary":"Added the Dual Play feature.When selecting \"2 Players\" from the main menu, if Controller 2 is not connected, you will be asked whether to enable Dual Play (select YES or NO).Once Dual Play is enabled, you can control Player 2 using the Right Stick.","occurred_at":null,"published_at":"2026-10-09T00:46:44Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067931796","verified_at":"2026-10-20T14:28:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1846018067928536","game_id":"steam-4500530","kind":"update","title":"DEMO Update Ver. 0.6.4","summary":"Added keyboard controls for player movement to the button settings. Players can now choose between WASD, QZSD, and Arrow keys.","occurred_at":null,"published_at":"2026-10-08T06:49:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067928536","verified_at":"2026-10-20T14:28:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1846018067924567","game_id":"steam-4500530","kind":"announcement","title":"Raging Blasters 2 demo now available.","summary":"TERARIN GAMES has released a demo for its new game, Raging Blasters 2, on Steam. The game will also be featured in the Steam Next Fest: October 2026 Edition. In the demo version, you can play Caravan Mode, Arcade Mode (up to Stage 2), and Training Mode (up to Stage 2).You are free to stream your gameplay and share screenshots. We hope you enjoy the game!","occurred_at":null,"published_at":"2026-10-06T23:36:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067924567","verified_at":"2026-10-20T14:28:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1843481262688266","game_id":"steam-4500530","kind":"announcement","title":"Raging Blasters 2 Concept Document","summary":"I created concept documents for \"Raging Blasters 2\". If you're interested, please take a look. English: https://www.teraringames.com/entry/2026/09/09/154202 Japanese: https://www.teraringames.com/entry/2026/09/09/154251","occurred_at":null,"published_at":"2026-09-09T07:25:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262688266","verified_at":"2026-10-20T14:28:54Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4500530-1842846814445499","game_id":"steam-4500530","kind":"announcement","title":"Steam Deck Compatibility","summary":"This game is fully functional on steam Deck, and works great with the built-in controls and display.All functionality is accessible when using the default controller configrationSteam Deck CompatibilityIn-game interface text is legible on Steam DeckThis game's default graphics configuration performs well on Steam Deck","occurred_at":null,"published_at":"2026-09-04T06:40:30Z","time_precision":"minute","