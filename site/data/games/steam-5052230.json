/v1/","context":{"app_id":5052230,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-5052230-1846018067929324","game_id":"steam-5052230","kind":"announcement","title":"The BrickOps demo opens tomorrow — October 9","summary":"Who's joining us tomorrow? The free BrickOps demo opens Friday, October 9 at 4 PM CEST / 2 PM UTC! {STEAM_CLAN_IMAGE}/46283274/c570a60d09d77dc2bb217500c97a1f8b85821735.png Bring your friends, jump into matches and build your own arenas. We'd love to see what you make — and hear what you think. We're still working on BrickOps. Fixes and updates will continue throughout the demo. We'll announce every update on Discord and let you know about planned maintenance. Our community is still growing, so l","occurred_at":null,"published_at":"2026-10-08T11:36:13Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067929324","verified_at":"2026-10-20T21:03:40Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5052230-1844115010503722","game_id":"steam-5052230","kind":"announcement","title":"Join the free BrickOps playtest on October 3 and 4","summary":"Bring your squad. Our first free public playtest is coming to Windows on Steam on October 3 and 4. Play. Build. Customize. Get into a match, create your own map and make your character your own. We’re inviting our community, gaming groups, creators and streamers to a weekend of playing, building and feedback. When to join Servers open Saturday, October 3 at 12:00 CEST.Main community session Saturday, October 3 at 20:00 CEST. Join us then to meet up and play together.Servers close Monday, October","occurred_at":null,"published_at":"2026-09-22T10:00:32Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010503722","verified_at":"2026-10-20T21:03:40Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5052230-1843481262699108","game_id":"steam-5052230","kind":"announcement","title":"Play. Build. Customize. — Watch the BrickOps Gameplay Trailer","summary":"Our gameplay trailer is here! It brings together the three things at the heart of BrickOps: Play. Build. Customize. https://www.youtube.com/watch?v=h7vCqwgQMLU PLAY Fight for the next point in Team Deathmatch, bring the flag home in Capture the Flag, or battle over a firework charge in Defuse. BUILD Create an arena block by block in the map builder. In Build & Destroy, prepare your cover before the fight begins. CUSTOMIZE Choose your outfits and accessories, then put together your loadout of wea","occurred_at":null,"published_at":"2026-09-13T09:42:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262699108","verified_at":"2026-10-20T21:03:40Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5052230-1843481262688543","game_id":"steam-5052230","kind":"announcement","title":"Introducing BrickOps","summary":"Hi everyone!We’d like to introduce BrickOps and start sharing more about its development here on Steam.What is BrickOps?BrickOps is an online shooter with block-built arenas. Build your own maps, share them with the community and compete against other players. Alongside Team Deathmatch, Deathmatch and Capture the Flag, we’re planning Defuse and Build & Destroy for release.Build first. Then fight.In Build & Destroy, each round starts with a team building phase. Put up cover, create routes and pre","occurred_at":null,"published_at":"2026-09-09T09:46:30Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262688543","verified_at":"2026-10-20T21:03:40Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5052230":{"last_attempt_at":"2026-10-25T22:32:12Z","status":"ok","all_sources_checked_at":"2026-10-25T22:32:11Z","error_codes":[]}},"news_last_attempt_at":{"steam-5052230":"2026-10-25T22:32:12Z"},"notices":[],"news_sources":{"5052230":{"last_attempt_at":"2026-10-25T22:32:11Z","last_success_at":"2026-10-25T22:32:11Z","status":"ok","error_codes":[]},"5309970":{"last_attempt_at":"2026-10-25T22:32:12Z","last_success_at":"2026-10-25T22:32:12Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5052230","app_id":5052230,"app_scope":"base","observed_at":"2026-10-26T06:15:21Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"cbe3fe20e5e2ed882820ae1379b67b2325ecf204844054ca9ef3031ac1e6eb55","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Play. Build. Customize. BrickOps는 알록달록한 멀티플레이 아레나 슈팅 게임입니다. 목표를 두고 싸우고, 나만의 맵을 만들고, 의상과 액세서리, 장비로 캐릭터를 꾸미세요. 엄폐물을 짓고 적의 깃발을 기지로 가져오거나 Defuse에서 불꽃으로 하늘을 밝혀 보세요.","publishers":[{"name":"KOI","creator_clan_account_id":46296464}],"developers":[{"name":"KOI","creator_clan_account_id":46296464}]},"release":{"steam_release_date":1806476400,"is_coming_soon":true,"coming_soon_display":"date_quarter"},"trailers":{"highlights":[{"trailer_name":"BrickOps Official Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1789240274","trailer_category":3,"microtrailer":[{"filename":"5052230/557853949/b0a8510eb41a17023368004e4eabd23dfa766d3e/1789237936/microtrailer.webm","type":"video/webm"},{"filename":"5052230/557853949/b0a8510eb41a17023368004e4eabd23dfa766d3e/1789237936/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"5052230/55785