"value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5203990","error_code":null},{"game_id":"steam-3950670","metric":"price_final","observed_at":"2026-10-26T14:44:59Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":3950670,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-3950670","metric":"review_count","observed_at":"2026-10-26T14:44:59Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":3950670,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-3950670","metric":"review_positive_percent","observed_at":"2026-10-26T14:44:59Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":3950670,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-3950670-1846651706687989","game_id":"steam-3950670","kind":"announcement","title":"Discord Server","summary":"Hi! I just wanted to do a quick update and let you know I created a Discord server for Fireworks Incremental. Come hang out and let's talk about fireworks or anything else :) Here's the link: https://discord.gg/Xw5AUF7yTJCheers! - Filip","occurred_at":null,"published_at":"2026-10-18T20:52:00Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706687989","verified_at":"2026-10-20T12:15:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3950670-1846651706676852","game_id":"steam-3950670","kind":"update","title":"Demo Update 3","summary":"If you haven't already please leave me a Steam review, it really helps me a lot!Demo Update 3 is here and it brings a bunch of polishing changes, minor balance changes and a highly requested ability to zoom out. Here's the full changelog:ZoomYou can now zoom out. The game uses a fixed zoom out scale because I want to preserve the pixel perfect look of the game as much as I can. The zoom out scale depends on your screen and is typically 1.5x or 1.33xHUD and UI elements stay their normal sizeIf yo","occurred_at":null,"published_at":"2026-10-15T08:48:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706676852","verified_at":"2026-10-20T12:15:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3950670-1844751498234000","game_id":"steam-3950670","kind":"update","title":"Demo Update 2","summary":"Wizard Tower Rework is here!Demo Update 2 brings a change I'm quite excited about: you'll now be able to freely change where Arcane Overload happens, thanks to being able to select the Arcane Sparks target.In order to change the target of Arcane Overload, simply hover over the Wizard Tower and click on \"SELECT\" button next to the building you'd like to target. By default Arsenal is targeted, but after unlocking University and Observatory you can freely switch between them.Once you unlock Tier 2 ","occurred_at":null,"published_at":"2026-09-29T11:56:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498234000","verified_at":"2026-10-20T12:15:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3950670-1844115010501397","game_id":"steam-3950670","kind":"update","title":"Demo Update 1","summary":"First major demo updated has landed!I'm thrilled that so many of you have enjoyed Fireworks Incremental and I'm also very thankful for the feedback you've sent.The game is in a pretty good state but it could also use some balancing changes as well as quality of life improvements and that's my goal for this update - to make the game feel and play better.Here's a full list of changes that I've made over the last week since releasing the demo:Balance and pacingUnlocking Prestige Hall is now faster ","occurred_at":null,"published_at":"2026-09-21T13:32:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010501397","verified_at":"2026-10-20T12:15:06Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3950670-1843481262701438","game_id":"steam-3950670","kind":"announcement","title":"Fireworks Incremental demo is here!","summary":"Fireworks Incremental demo is here!The Bad Wizard has arrived and he put a Magical Dome over the land. Use fireworks to destroy it and free everybody from the Bad Wizard's grip.Demo contains about 45-60 minutes of gameplay and will take you through all of the game's systems and you'll be able to experience what the full game will be like.Can't wait to hear what you think. If you have any feedback, let me know in the comments, Steam discussions or you can use this form here: https://docs.google.c","occurred_at":null,"published_at":"2026-09-14T11:39:54Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262701438","verified_at":"2026-10-20T12:15:06Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3950670":{"last_attempt_at":"2026-10-26T11:20:49Z","status":"ok","all_sources_checked_at":"2026-10-26T11:20:49Z","error_codes":[]}},"news_last_attempt_at":{"steam-3950670":"2026-10-26T11:20:49Z"},"notices":[],"news_sources":{"3950670":{"last_attempt_at":"2026-10-26T11:20:49Z","last_success_at":"2026-10-26T11:20:49Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T11:20:49Z"},"5203990":{"last_attempt_at":"2026-10-26T11:20:49Z","last_success_at":"2026-10-26T11:20:49Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T11:20:49Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3950670","app_id":3950670,"app_scope":"base","observed_at":"2026-10-26T06:14:24Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"38d32eac842b641305f33ccd4c3ea0eaf195a9aa468956541efc70ee70ce6a66","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Bad Wizard covered the land with a Magical Dome and the only way to destroy it is with fireworks! Hire units, unlock buildings, buy upgrades, discover powerful synergies, turn a few tiny explosions into a ridiculous spectacle and ultimately defeat The Bad Wizard himself!","publishers":[{"name":"Frajda Games","creator_clan_account_id":46304949}],"developers":[{"name":"Frajda Games","creator_clan_account_id":46304949}]},"release":{"steam_release_date":1806476400,"is_coming_soon":true,"coming_soon_display":"date_quarter"},"trailers":{"highlights":[{"trailer_name":"Demo Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1792260930","trailer_category":1,"microtrailer":[{"filename":"3950670/1734658729/76af260337525f5a9c816ee705c4b9332aa81592/1792260570/microtrailer.webm","type":"video/webm"},{"filename":"3950670/1734658729/76af260337525f5a9c816ee705c4b9332aa81592