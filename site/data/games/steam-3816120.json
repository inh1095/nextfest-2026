tems/v1/","context":{"app_id":3816120,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-3816120","metric":"demo_ccu","observed_at":"2026-10-26T07:57:14Z","value":18,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4307310","error_code":null}],"events":[{"id":"steam-steam-3816120-1846651706693774","game_id":"steam-3816120","kind":"announcement","title":"The Gameplay Is More Than Just Romance! Re 2: I Rise Alone Set for November 13","summary":"Re2: I Rise Alone, a real-person interactive film game developed by Popcorn Interactive and published by Yixiang Interactive Technology, will make its global debut on Steam on November 13! This is the second title from the core team behind Rebirth: Do I Still Have to Fall in Love?, and the team spent nearly two years reworking the gameplay, introducing a great many innovative mechanics. Compared with the first installment, this one is more like a fusion of simulation, RPG, and interactive film g","occurred_at":null,"published_at":"2026-10-20T05:25:23Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706693774","verified_at":"2026-10-20T11:52:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3816120-1846651706693575","game_id":"steam-3816120","kind":"announcement","title":"Re 2: I Rise Alone\" New Demo Now Live","summary":"Hello everyone!Rebirth 2: I Rise Alone will officially launch on Steam on November 13, 2026. During the Steam Next Fest, we will also host live streams to give you a full look at the journey from a cramped urban village rental to a complete life turnaround.Release InformationGame Title: Rebirth 2: I Rise AloneRelease Date: November 13, 2026Platform: PC (Steam)Genres: Live-action interactive film game, RPG, dating sim, choice-driven, exploration","occurred_at":null,"published_at":"2026-10-20T03:40:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706693575","verified_at":"2026-10-20T11:52:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3816120-1846651706684070","game_id":"steam-3816120","kind":"update","title":"“Re2：I Rise Alone” October 17 Demo Update Announcement","summary":"Dear Players,\\Demo save data will not carry over to the full game. Please plan your playtime accordingly to avoid unnecessary wasted time.\\For players with integrated graphics or low-spec PCs: If the new game stutters or you are unable to enter the game, you can switch the game quality to \"Low\" in the settings to enter the game normally.\\Fixed several known bugs to improve game stability and gameplay experience.\\Added a new item that lowers QTE difficulty: Obtained after failing the \"Young and D","occurred_at":null,"published_at":"2026-10-17T08:22:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706684070","verified_at":"2026-10-20T11:52:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3816120-1840944183788489","game_id":"steam-3816120","kind":"update","title":"Demo Update Announcement – August 18","summary":"1.Fixed the progress-stuck bug and other known issues.2.Optimized the Street Fighter battle – full skill set now available for experience.3.Added bulk purchase option for lottery tickets.Thank you all for your feedback on the demo. We are still investigating some other issues and will continue to optimize. We truly appreciate your support, and we hope to bring you the full game soon.— Zhao Ashai","occurred_at":null,"published_at":"2026-08-18T11:07:16Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840944183788489","verified_at":"2026-10-20T11:52:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3816120-1840944183783456","game_id":"steam-3816120","kind":"announcement","title":"Before You Rise: Notes & Tips for Re2: I Rise Alone","summary":"🎀Before You Play🎀First of all, a huge thank you to the first wave of testers for your feedback. We‘d like to take a moment to walk you through some key aspects of the game, so you can get the most out of your experience.📌Action Points – The Core of the Game:The entire game is driven by the Action Point system. Earning Action Points and planning how to use them is the key to unlocking more events and boosting your stats. For example: eating daily meals, buying an e-scooter, using special items – ","occurred_at":null,"published_at":"2026-08-16T07:08:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840944183783456","verified_at":"2026-10-20T11:52:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3816120-1840944183778938","game_id":"steam-3816120","kind":"announcement","title":"\"Rebirth 2: I Alone Counterattack\" Demo Is Coming Soon!","summary":"Foreword: To all our friends who support the game – Thank you so much for coming to try our demo. We are a small team, and there may inevitably be some bugs during gameplay. We appreciate your understanding. We also welcome any feedback – every word you say, even if it's criticism, is fuel for our progress. We've been working overtime and will refine and improve the content based on your feedback for the official release. We've been grinding on this for nearly two years, and we hope you enjoy it","occurred_at":null,"published_at":"2026-08-14T08:36:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840944183778938","verified_at":"2026-10-20T11:52:58Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3816120":{"last_attempt_at":"2026-10-26T00:46:28Z","status":"ok","all_sources_checked_at":"2026-10-26T00:46:27Z","error_codes":[]}},"news_last_attempt_at":{"steam-3816120":"2026-10-26T00:46:28Z"},"notices":[],"news_sources":{"3816120":{"last_attempt_at":"2026-10-26T00:46:27Z","last_success_at":"2026-10-26T00:46:27Z","status":"ok","error_codes":[]},"4307310":{"last_attempt_at":"2026-10-26T00:46:28Z","last_success_at":"2026-10-26T00:46:28Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3816120","app_id":3816120,"app_scope":"base","observed_at":"2026-10-26T06:14:22Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"217f43581f3907851b8f0e77efc819a8feedb5857c56fd9ac728da11e18fecd4","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Interactive movie‑game blending SLG gameplay and real‑life romance simulation: Step into the shoes of an underdog and live out a power‑fantasy rags‑to‑riches story. Combat, character progression, drinking and romance — all in one! 100‑GB content volume- redefines your power‑fantasy experience!","publishers":[{"name":"Proudmate Entertainment"},{"name":"一相逢互动娱乐","creator_clan_account_id":45928459}],"developers":[{"name":"Proudmate Entertainment"}]},"release":{"steam_release_date":1794556800,"is_coming_soon":true,"coming_soon_display":"date_full"},"trailers":{"highlights":[{"trailer_name":"定档PV","trailer_url_format":"steam/apps/${FILENAME}?t=1792470493","trailer_category":3,"microtrailer":[{"filename":"3816120/126170389/020322b7b261af31a9daa387a885fcb46b758f9e/1792470184/microtrail