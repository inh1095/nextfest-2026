rror_code":"no_reviews"},{"game_id":"steam-5205090","metric":"demo_ccu","observed_at":"2026-10-26T07:10:57Z","value":3,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5269690","error_code":null}],"events":[{"id":"steam-steam-5205090-1846651706690057","game_id":"steam-5205090","kind":"update","title":"Demo update 0.3.0.34: new islands, Chapter 1, damage & repair, guns, 8 players","summary":"Ten days and fourteen builds since the last notes, nearly all of it driven by your playtests. Here is what changed. Note: worlds saved before this update can't be loaded, so please start a new world. Key bindings and graphics settings were also reset. Highlights All three islands rebuilt, with new landmarks, a smugglers' camp, a lighthouse to repair and a volcano that can erupt. Chapter 1: rob the smugglers, drop a bomb into the volcano and reach the finale, plus a 14-goal checklist with bonuses","occurred_at":null,"published_at":"2026-10-19T12:48:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706690057","verified_at":"2026-10-21T00:16:49Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5205090-1846651706687861","game_id":"steam-5205090","kind":"announcement","title":"Our sofa is flying into Steam Next Fest!","summary":"A sofa. Two propellers. A crew with terrible ideas. Will It Launch? is joining Steam Next Fest, October 19–26! Our free demo is already available. Build your own junk aircraft, fly cargo between islands, and see whether your crew can bring it back in one piece. Play solo or with friends — 1–8 players. Bring your crew and try the demo. If you enjoy the chaos, wishlist the full game to follow its development. Play the free demo on Steam","occurred_at":null,"published_at":"2026-10-18T19:38:35Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706687861","verified_at":"2026-10-21T00:16:49Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5205090-1846018067933167","game_id":"steam-5205090","kind":"update","title":"Demo update 0.3.0.19: instant carry, crouch, towing and a pile of fixes","summary":"Thanks to everyone who played the demo in its first days. This update is almost entirely your feedback. Carrying Picking things up is now instant: press E and it's in your hands. You keep your running speed with any load, and heavy loads accelerate the same way as light ones. Tall loads like the fridge are carried overhead instead of being dragged. Your hands are empty while you carry, so tools no longer clip through the cargo. You always get back up after being knocked down. Fixed players and l","occurred_at":null,"published_at":"2026-10-09T12:31:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067933167","verified_at":"2026-10-21T00:16:49Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5205090":{"last_attempt_at":"2026-10-25T23:40:40Z","status":"ok","all_sources_checked_at":"2026-10-25T23:40:40Z","error_codes":[]}},"news_last_attempt_at":{"steam-5205090":"2026-10-25T23:40:40Z"},"notices":[],"news_sources":{"5205090":{"last_attempt_at":"2026-10-25T23:40:40Z","last_success_at":"2026-10-25T23:40:40Z","status":"ok","error_codes":[]},"5269690":{"last_attempt_at":"2026-10-25T23:40:40Z","last_success_at":"2026-10-25T23:40:40Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5205090","app_id":5205090,"app_scope":"base","observed_at":"2026-10-26T06:15:41Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success