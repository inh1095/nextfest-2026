"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"currency":null,"divisor":100,"initial":null,"discount_percent":null,"is_free":false,"formatted_final_price":null,"is_free_field_present":false,"is_coming_soon":true,"is_coming_soon_field_present":true},"error_code":"price_not_announced"},{"game_id":"steam-4326820","metric":"review_count","observed_at":"2026-10-26T10:31:08Z","status":"ok","value":0,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4326820,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":null},{"game_id":"steam-4326820","metric":"review_positive_percent","observed_at":"2026-10-26T10:31:08Z","status":"unavailable","value":null,"source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"app_id":4326820,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4326820","metric":"demo_ccu","observed_at":"2026-10-26T13:34:35Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4976900","error_code":null}],"events":[{"id":"steam-steam-4326820-1847286114038043","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.20","summary":"Two updates on the same day?!That is right! We have been very hard at work today to provide even more updated features to everyone that is playing. Thanks to the automated crash logging doing its work, we have been able to identify, track down and fix multiple big errors and bugs that would eventually lead to crashes. So that should provide a more stable experience.ChangesA new option in the settings menu to hide the newly added controls on your screen.Increased mouse sensitivity so that players","occurred_at":null,"published_at":"2026-10-23T21:33:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114038043","verified_at":"2026-10-23T23:36:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1847286114035350","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.18","summary":"Automatic Crash LoggingThanks to the dedication of our playerbase in finding new bugs, we decided that we needed an easier way to be able to track down the origins of these bugs. So, as of V1.18 Rolling Stock now has automatic crash logging, which means that whenever the game runs into an Error, Warning or Fatal crash, we will receive a notification about it in real-time.All the information we receive is completely anonymous and allows us to look at the internal logging of the engine to track do","occurred_at":null,"published_at":"2026-10-23T07:52:23Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114035350","verified_at":"2026-10-23T12:54:43Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846651706694399","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.15","summary":"Rolling Stock is now available in Korean!FixesKorean language is actually selectable now.Master Volume has been translated now for some languages. Other languages will receive the translation soon.Until next time,Happy Loading Yardmaster,Cassidy & Chunky","occurred_at":null,"published_at":"2026-10-20T09:15:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706694399","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846651706692657","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.14","summary":"V1.14 brings a small number of important changesFixesThe flow where the host leaves the game before clients do, has been updated to correctly handle the disconnecting of all the clients before the host closes the game.ChangesThe last level of the demo has been slightly reworked to become slightly easier. No more balancing of the large flat boxes.There is a new Master Volume slider that can be used to adjust the master volume.Coming up soon:More improvements to levels, network performance and add","occurred_at":null,"published_at":"2026-10-19T20:34:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706692657","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846651706692606","game_id":"steam-4326820","kind":"update","title":"Recent Windows Update Issues","summary":"Windows Update 2026.H2 Causes Desyncs between Host and Client.We have spent a whole day, from 8am until now (10pm), trying to figure out where a recent bug has come from. Namely the desync between the host and a connected client when the train horn was pulled.After many hours, we have finally isolated the issue down to the latest Windows update that was released a few days ago... Thanks Bill...The fixSo this is not something we can fix ourselves, BUT, there is a temporary fix that can be applied","occurred_at":null,"published_at":"2026-10-19T20:17:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706692606","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846651706684757","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.12 & V1.13","summary":"V1.12 & V1.13 bring about some big changes to the demo and the full game.Looks like I (Chunky) forgot to post the patch notes for V1.12, sorry about that! No worries though, below you can find those changes and the new changes snugly sitting together.Fixes\\ If a player joined a game that was ending (demo) then they would get hardlocked. This is now fixed.\\ Fixed a crash that would occur when a client was controlling the UFO and disconnected the game.Similarly to the previous, clients can now act","occurred_at":null,"published_at":"2026-10-17T14:54:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706684757","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846651706674556","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.11","summary":"Characters models sync properly (Probably)This has been an intense patch to get ready, so let's hope that it is as stable as we think it is.FixesImproved physics interpolation for when a player uses the unstuck button.The player no longer collides with the train horn.Improved collisions for all train cars.Player models now sync properly for everyone to make sure it is the same for everyone.Until next time, happy loading Yardmaster!Cassidy & Chunky","occurred_at":null,"published_at":"2026-10-14T14:56:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706674556","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846018067944422","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.09","summary":"New feature: Physics Interpolation!So after seeing you play the demo, one of the things that has been on our wishlist that we think would improve the game greatly, is to add physics interpolation. And today that train is rolling into the station!This means that it will be a buttery smooth experience* for everyone, whether you are the host or the client.FixesUkrainian and Japanese translations of the send trian poster, work again.The Mallard Locomotive (the blue one) now has the appropriate mater","occurred_at":null,"published_at":"2026-10-13T15:21:26Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067944422","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846018067941048","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.08","summary":"Added localization, improved grabbing onto objects.FixesProperly localized the send train onboarding poster.Fixed the use of the right font and outline on the text behind sliders in the settings menu.Pressing the B button on an xbox controller in the settings menu caused the settings menu and the pause menu to close at the same time. Now it only closes the settings menu.Changing window modes no longer incorrectly shows the resolution option for borderless fullscreen and fullscreen windowmode.Cha","occurred_at":null,"published_at":"2026-10-12T14:00:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067941048","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846018067936169","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.07","summary":"Demo Update V1.07 is rolling into station today and brings a few reworks.Fixes & Changes:A complete rework of the way the game handles controller input in the menus. This makes it much easier to navigate the menus using a controller.A complete rework of the visual design of the settings menu. (Part 1 of 2) This already makes the menu more accesible and easier to read.Added information to all slider based settings so you can actually see the value you are setting it to.Informed Steam that we do a","occurred_at":null,"published_at":"2026-10-10T12:30:51Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067936169","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846018067933417","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.06","summary":"A small fix that goes a long way.We noticed some of you are getting stuck in the second level, so we wanted to push a quick update to fix the issue of a small box disappearing from the bulk cargo train, to sit behind it, close to the wall.Additionally, we also added more collision boxes around the connection between trains and locomotives to make it impossible for players to get stuck there.Oh and the debug tools have been removed as well ;)Other fixes are being worked on and should also be inte","occurred_at":null,"published_at":"2026-10-09T14:04:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067933417","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846018067931471","game_id":"steam-4326820","kind":"update","title":"Demo Patch Notes V1.02","summary":"Thanks for reporting the bugs!It has been seriously helpful to already see so many of you playing the demo and reporting the bugs you find! So, just before we head off for a quick sleep, here are already some bugs that were low risk fixes that we also could finish within a reasonable timeframe.Fixes:Fixed the report a bug button not being centered in some languages.Fixed the discord link in the main menu linking to the bug report channel instead of the general channel in the community discord (h","occurred_at":null,"published_at":"2026-10-08T21:32:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067931471","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4326820-1846018067930592","game_id":"steam-4326820","kind":"announcement","title":"Rolling Stock Demo Released!","summary":"Hello everyone, The day is finally here! The Rolling Stock Demo has gone live! Check it out here:It would be a great help if you joined our community discord (https://discord.gg/9Bn4rpkMXV), so that we can learn better about what you do and don't like before we get to the full release!The full release is planned for the 27th of October, just after Next Fest!Happy Loading Yardmaster,Cassidy & Chunky","occurred_at":null,"published_at":"2026-10-08T16:57:59Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067930592","verified_at":"2026-10-20T13:43:21Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4326820":{"last_attempt_at":"2026-10-26T12:07:34Z","status":"ok","all_sources_checked_at":"2026-10-26T12:07:33Z","error_codes":[]}},"news_last_attempt_at":{"steam-4326820":"2026-10-26T12:07:34Z"},"notices":[],"news_sources":{"4326820":{"last_attempt_at":"2026-10-26T12:07:33Z","last_success_at":"2026-10-26T12:07:33Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T12:07:33Z"},"4976900":{"last_attempt_at":"2026-10-26T12:07:34Z","last_success_at":"2026-10-26T12:07:34Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T12:07:34Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4326820","app_id":4326820,"app_