"value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4134220","error_code":null}],"events":[{"id":"steam-steam-3468530-1846651706681692","game_id":"steam-3468530","kind":"announcement","title":"🎮 B.E.S.T 2 — THE FREE DEMO IS NOW AVAILABLE! 🔥","summary":"Whether you've already experienced the first game or you're discovering the B.E.S.T universe for the very first time, this is your chance to get a taste of what's coming.🔥 What can you expect?🎮 Experience the Prologue of B.E.S.T 2 — Your journey begins with the consequences of the past and the promise of an entirely new adventure.❤️ Reconnect with familiar faces — Your favorite characters are back, and your relationships still matter.🔄 Continue your story — Played B.E.S.T 1? Import your progress","occurred_at":null,"published_at":"2026-10-16T14:26:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706681692","verified_at":"2026-10-20T11:09:24Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3468530-1845383656394187","game_id":"steam-3468530","kind":"announcement","title":"🔥🔥 B.E.S.T 2 IS FINALLY BECOMING PLAYABLE ON STEAM 🔥🔥","summary":"The time is almost here.On October 16th, the B.E.S.T 2 Demo will become available on Steam.For the first time, you’ll be able to play the Prologue of B.E.S.T 2, just a few days before we take part in Steam Next Fest, October 19–26.The goal of this demo is simple:to let you step into B.E.S.T 2 for the first time and get a taste of what comes next.🎮 DISCOVER THE PROLOGUE OF B.E.S.T 2The demo lets you experience the beginning of B.E.S.T 2 and the first scenes that set this new adventure in motion.Y","occurred_at":null,"published_at":"2026-10-05T17:23:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656394187","verified_at":"2026-10-20T11:09:24Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3468530-1829528821318013","game_id":"steam-3468530","kind":"announcement","title":"BEST 2 Season Premiere on STEAM !!!!","summary":"B.E.S.T 2 is coming to Steam in Early Access 🎉We have some important news to share with you.Earlier in the process, Steam had refused Early Access for B.E.S.T 2, so the plan we shared at the time was different.Since then, the situation has changed, and B.E.S.T 2 has now officially been approved for Early Access on Steam.For us, this is genuinely the best possible outcome.What happens next?The next big step will be:• OCTOBER 2026: Steam Next Fest with the B.E.S.T 2 Prologue demo available during ","occurred_at":null,"published_at":"2026-04-14T14:43:22Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1829528821318013","verified_at":"2026-10-20T11:09:24Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3468530":{"last_attempt_at":"2026-10-26T10:38:13Z","status":"ok","all_sources_checked_at":"2026-10-26T10:38:13Z","error_codes":[]}},"news_last_attempt_at":{"steam-3468530":"2026-10-26T10:38:13Z"},"notices":[],"news_sources":{"3468530":{"last_attempt_at":"2026-10-26T10:38:13Z","last_success_at":"2026-10-26T10:38:13Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T10:38:13Z"},"4134220":{"last_attempt_at":"2026-10-26T10:38:13Z","last_success_at":"2026-10-26T10:38:13Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T10:38:13Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3468530","app_id":3468530,"app_scope":"base","observed_at":"2026-10-26T06:14:18Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_