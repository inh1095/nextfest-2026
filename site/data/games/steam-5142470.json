ror_code":"no_reviews"},{"game_id":"steam-5142470","metric":"demo_ccu","observed_at":"2026-10-26T06:32:28Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5201410","error_code":null}],"events":[{"id":"steam-steam-5142470-1847286114038162","game_id":"steam-5142470","kind":"update","title":"Art Asset Update and Patch Notes","summary":"As a solo dev I don't announce what just updated often. But usually I commit more than 20 changes per day to make the game better. What’s new since Sep 28A new pixel-art look. The streets, the Thought Gravity Field, the Omega fight and the menus are all pixel art now. The hero and NPCs are new 3D models, and the Core Base has a new layout.Every battle is on the front line. Disasters push against your walls and you can see the next hit coming. Each boss has its own music. Your HP carries over thr","occurred_at":null,"published_at":"2026-10-23T22:27:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114038162","verified_at":"2026-10-24T03:31:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142470-1844751498230221","game_id":"steam-5142470","kind":"update","title":"Genius Simulator Demo Update: Master's Deeper Meaning","summary":"Thank you so much for all your support! Genius Simulator has arrived at its final major update for the Demo version. With this update, we are officially introducing the brand-new core system: \"Master's Deeper Meaning\"! Through this mechanic, players will truly experience how every tiny, mundane action you take in this world is wildly over-interpreted by \"experts\" as a profound, genius stroke of mastermind planning. I will continue full-speed ahead with the development of the full release while l","occurred_at":null,"published_at":"2026-09-28T01:03:35Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498230221","verified_at":"2026-10-20T23:10:50Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142470-1844115010504652","game_id":"steam-5142470","kind":"update","title":"A fun update for your demo journey","summary":"tweet~ happy pird join your team","occurred_at":null,"published_at":"2026-09-22T15:52:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010504652","verified_at":"2026-10-20T23:10:50Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142470-1844115010503072","game_id":"steam-5142470","kind":"update","title":"update","summary":"We fixed an issue where unprocessed borders exposed background edges during card battles. If this causes any performance issues or stuttering, please let us know. Thank you!","occurred_at":null,"published_at":"2026-09-22T04:18:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010503072","verified_at":"2026-10-20T23:10:50Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142470-1844115010501826","game_id":"steam-5142470","kind":"update","title":"Vehicle Interior Default Visual Update & Classic Skin Announcement","summary":"Hello Everyone,Following thousands of playtests and our recent adjustments to the in-vehicle camera angle, we noticed that the original interior visual presentation still created a strong sense of visual pressure and fatigue during extended gameplay.To provide a clearer, more open, and comfortable driving experience, we have officially updated the default look of the vehicle interior in this patch.Looking for the Classic Original Skin? For those who truly love and miss the original cockpit look,","occurred_at":null,"published_at":"2026-09-21T16:12:35Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010501826","verified_at":"2026-10-20T23:10:50Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142470-1844115010492757","game_id":"steam-5142470","kind":"update","title":"v0.3.1 Update: Simplified Prologue Omega Fight","summary":"Hello everyone!This update focuses on reworking the prologue fight against Omega.We heard your feedback about being thrown into late-game mechanics and unfamiliar jargon right from the start before even getting a handle on basic card play. We completely agree, so we've restructured the opening battle.Prologue Battle ReworkObjective: Your goal upon entering is simple: defeat Omega. Start by playing cards normally.Phase 3 Guidance: After clearing his first two health bars, Omega's third phase hits","occurred_at":null,"published_at":"2026-09-17T17:06:48Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010492757","verified_at":"2026-10-20T23:10:50Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142470-1844115010488282","game_id":"steam-5142470","kind":"update","title":"Genius Simulator Update: Pseudo-3D Visuals & Enhanced Battle Scenes!","summary":"\\What’s New in This Update\\We are excited to bring you the latest update for \\Genius Simulator\\! Here is what we’ve improved:\\\\ \\Pseudo-3D Visual Effects:\\ Enhanced depth and visual immersion across the game.\\ \\Upgraded Card Battle Scenes:\\ Smoother animations and refined interfaces for a better combat experience.\\---\\Performance & Support\\If you encounter any performance issues or bugs while playing, please reach out to us! Our support team is always here to assist you and ensure a smooth exper","occurred_at":null,"published_at":"2026-09-16T06:55:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010488282","verified_at":"2026-10-20T23:10:50Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142470-1843481262704134","game_id":"steam-5142470","kind":"announcement","title":"1,600+ Downloads & Huge Thanks! What’s Next for Genius Simulator","summary":"Over the past few weeks, I’ve been reading all your feedback and rolling out daily patches and improvements (even if I didn’t always have time to post full update announcements!). As a solo developer, seeing you play and engage with the game means everything to me.In our latest Demo update, we just released the brand-new Card Pack system for you to try out! With this addition, we are officially wrapping up the major content updates for the Demo version for now.Why I Started Making Genius Simulat","occurred_at":null,"published_at":"2026-09-15T10:02:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262704134","verified_at":"2026-10-20T23:10:50Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5142470":{"last_attempt_at":"2026-10-25T23:01:30Z","status":"ok","all_sources_checked_at":"2026-10-25T23:01:29Z","error_codes":[]}},"news_last_attempt_at":{"steam-5142470":"2026-10-25T23:01:30Z"},"notices":[],"news_sources":{"5142470":{"last_attempt_at":"2026-10-25T23:01:29Z","last_success_at":"2026-10-25T23:01:29Z","status":"ok","error_codes":[]},"5201410":{"last_attempt_at":"2026-10-25T23:01:30Z","last_success_at":"2026-10-25T23:01:30Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5142470","app_id":5142470,"app_scope":"base","observed_at":"2026-10-26T06:15:35Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":10