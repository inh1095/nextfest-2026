red_at":null,"published_at":"2026-10-21T18:52:48Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114030000","verified_at":"2026-10-21T19:49:30Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4977470-1846651706690788","game_id":"steam-4977470","kind":"announcement","title":"Our Updated Demo is Here to join for Steam Next Fest today!","summary":"Hey, time travelers!Today, we're releasing a new update for our demo, packed with new features and improvements for you to explore!And that's not all we're excited to announce that we're taking part in Steam Next Fest!There's never been a better time to jump in, try out the game, and see what's new. Whether you're checking out our demo for the first time or coming back for another round, we'd love to hear what you think!Play the updated demo, share your feedback, and help us make the game even b","occurred_at":null,"published_at":"2026-10-19T15:29:36Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706690788","verified_at":"2026-10-20T19:54:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4977470-1846018067944284","game_id":"steam-4977470","kind":"announcement","title":"Our Demo Is Now Available on Steam!","summary":"Hey, time travelers!We’re excited to announce that the playable demo for Red Timewarp: Beyond Reality is now LIVE on Steam!We’ve been working hard for more than 1.5 years to bring our game to life, and we’re thrilled to finally give you the chance to experience it for yourselves.Red Timewarp: Beyond Reality is built on our own in-house game engine, which has been in development for over 15 years.What can you expect from the demo?1 playable character, Max. Play this character and discover his uni","occurred_at":null,"published_at":"2026-10-13T14:47:56Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067944284","verified_at":"2026-10-20T19:54:38Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4977470-1845383656393401","game_id":"steam-4977470","kind":"announcement","title":"We’re Looking for Translation Testers","summary":"Hey, time travelers!As we get closer to releasing our upcoming game, we’re working hard to make sure players around the world get the best experience possible.One area where we could use some extra help is localization testing.We’re looking for native or highly fluent speakers who can help us review our translations and spot things that are easy to miss: awkward wording, incorrect context, unnatural expressions, mistranslations, and other small details that can make a big difference.Languages we","occurred_at":null,"published_at":"2026-10-05T12:57:30Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656393401","verified_at":"2026-10-20T19:54:38Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4977470":{"last_attempt_at":"2026-10-26T05:54:09Z","status":"ok","all_sources_checked_at":"2026-10-26T05:54:08Z","error_codes":[]}},"news_last_attempt_at":{"steam-4977470":"2026-10-26T05:54:09Z"},"notices":[],"news_sources":{"4977470":{"last_attempt_at":"2026-10-26T05:54:08Z","last_success_at":"2026-10-26T05:54:08Z","status":"ok","error_codes":[]},"5331730":{"last_attempt_at":"2026-10-26T05:54:09Z","last_success_at":"2026-10-26T05:54:09Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4977470","app_id":4977470,"app_scope":"base","observed_at":"2026-10-26T06:15:12Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"