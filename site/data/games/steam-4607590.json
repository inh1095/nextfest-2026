batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-4607590","metric":"demo_ccu","observed_at":"2026-10-26T09:05:08Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4702830","error_code":null}],"events":[{"id":"steam-steam-4607590-1846651706688500","game_id":"steam-4607590","kind":"announcement","title":"GummyGom Delivery Is Going Free-to-Play","summary":"Hello, everyone!This is the GummyGom Delivery Development Team.First of all, we would like to sincerely thank everyone who has shown interest in and supported our game.After careful discussions within our team, we have decided to transition GummyGom Delivery from a paid game to a permanently free title.■ Why We're Making This ChangeOur team has been discussing the future direction of the project, and we believe that making the game freely available will allow more players to enjoy GummyGom Deliv","occurred_at":null,"published_at":"2026-10-19T01:44:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706688500","verified_at":"2026-10-20T15:13:29Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4607590-1843481262689025","game_id":"steam-4607590","kind":"announcement","title":"PatchNote V5","summary":"Update NotesNew ContentExpanded session content and map layouts across Stages 1, 2, and 3.Added exhibition and demo maps with session briefing slides.Added snowball cannons with knockback and a cupcake cargo-drop mechanic.Added portals, arrow boost pads, and dynamite triggers.Added co-op Morse puzzles and progress guides to Stage 2.Added a plank-pushing guide to Stage 1 Session 4.Added ten hat customization items.Gameplay ImprovementsAdded entry boosts, speed-based steering, and improved sliding","occurred_at":null,"published_at":"2026-09-09T13:29:20Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262689025","verified_at":"2026-10-20T15:13:29Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4607590-1833334318575346","game_id":"steam-4607590","kind":"announcement","title":"PatchNote V4","summary":"Update Notes Fixed an issue where the rabbit doll could not be picked up again after being thrown away in the lobby. Fixed an issue where the player count was not displayed correctly in the lobby. Fixed an issue where player characters were duplicated in certain sessions. Fixed an intermittent issue where the camera would become fixed after entering a session and returning to the lobby. Fixed an issue where players would become stiff after sitting on chairs in the lobby. Fixed an issue where wea","occurred_at":null,"published_at":"2026-05-24T13:12:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318575346","verified_at":"2026-10-20T15:13:29Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4607590-1832700592799702","game_id":"steam-4607590","kind":"announcement","title":"PatchNote V3","summary":"Patch NoteChanged the Intro Video","occurred_at":null,"published_at":"2026-05-18T23:15:25Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1832700592799702","verified_at":"2026-10-20T15:13:29Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4607590-1832700592797783","game_id":"steam-4607590","kind":"announcement","title":"PatchNote V2","summary":"Update NoteImproved the slingshot logic.Improved several sections of Stage 1.Fixed an issue with the save point in Stage 1.The developer stayed after work to continue development.","occurred_at":null,"published_at":"2026-05-18T09:55:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1832700592797783","verified_at":"2026-10-20T15:13:29Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4607590-1832700592792875","game_id":"steam-4607590","kind":"announcement","title":"PatchNote V1","summary":"Update DetailsFixed a rendering issue with the wing assets.Resolved a bug where the player count in the lobby was displayed incorrectly.Disabled the single-player feature. This was unintended, and a minimum of 2 players is now required to start.Dev Note: This update was fueled by midnight oil and late-night coding.","occurred_at":null,"published_at":"2026-05-15T18:19:12Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1832700592792875","verified_at":"2026-10-20T15:13:29Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4607590-1832700592790730","game_id":"steam-4607590","kind":"announcement","title":"GummyGom Delivery is finally here!","summary":"Hello, this is NEONORI.After a long wait, the demo version of GummyGom Delivery has finally been released on Steam.In this demo, you can experience the following features:Improved Stages: Refined gameplay environments.Character Customization: Personalize your own character.Achievement System: Three unique achievements to unlock.Important Notice While the game can be played with fewer than 4 players, please note that it may be challenging as the game design and levels are optimized for a 4-player","occurred_at":null,"published_at":"2026-05-15T02:29:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1832700592790730","verified_at":"2026-10-20T15:13:29Z","discovery_method":"official_steam_ne