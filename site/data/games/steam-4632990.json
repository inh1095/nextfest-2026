ost/steam_community_announcements/1847286114034294","verified_at":"2026-10-23T02:42:27Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4632990-1846651706692926","game_id":"steam-4632990","kind":"announcement","title":"NODGE DEMO IS LIVE","summary":"It's finally here, NODGE is playable right now as part of Steam Next Fest (October 19–26). It's free. Go try it.The core loop is dead simple: dodge obstacles, stay alive, get better. One mistake and you're restarting. No checkpoints, no second chances—just you and increasingly impossible patterns set to music. It sounds brutal because it is. But that's kind of the point.The difficulty doesn't ease up. The longer you survive, the more the game throws at you. Patterns get chaotic, timing gets tigh","occurred_at":null,"published_at":"2026-10-19T22:17:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706692926","verified_at":"2026-10-20T15:34:35Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4632990":{"last_attempt_at":"2026-10-25T20:14:33Z","status":"ok","all_sources_checked_at":"2026-10-25T20:14:32Z","error_codes":[]}},"news_last_attempt_at":{"steam-4632990":"2026-10-25T20:14:33Z"},"notices":[],"news_sources":{"4632990":{"last_attempt_at":"2026-10-25T20:14:32Z","last_success_at":"2026-10-25T20:14:32Z","status":"ok","error_codes":[]},"4852620":{"last_attempt_at":"2026-10-25T20:14:33Z","last_success_at":"2026-10-25T20:14:33Z","status":"ok","error_codes":[]}}}
