ind":"announcement","title":"Ten new screenshots, and how the explosions ended up looking like this","summary":"{STEAM_CLAN_IMAGE}/46227385/b612fb366b09995c25bf9bc7a560a309b35f03df.jpg As of today the store page opens on ten new screenshots. They come from a couple of evenings of running battles with the HUD off, parking the camera on a capital ship, and waiting for something big to blow up next to it. I like them more than anything I have shot for the game so far, so I want to say a bit about where the look came from and then ask you what you think. Space is a black canvas. Early on that was the whole pr","occurred_at":null,"published_at":"2026-08-18T09:02:38Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1840944183788227","verified_at":"2026-10-20T16:20:38Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4718360":{"last_attempt_at":"2026-10-26T03:59:34Z","status":"ok","all_sources_checked_at":"2026-10-26T03:59:34Z","error_codes":[]}},"news_last_attempt_at":{"steam-4718360":"2026-10-26T03:59:34Z"},"notices":[],"news_sources":{"4718360":{"last_attempt_at":"2026-10-26T03:59:34Z","last_success_at":"2026-10-26T03:59:34Z","status":"ok","error_codes":[]},"5047040":{"last_attempt_at":"2026-10-26T03:59:34Z","last_success_at":"2026-10-26T03:59:34Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4718360","app_id":4718360,"app_scope":"base","observed_at":"2026-10-26T06:14:53Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"98d692c133df9a21cab1cbac4189e9936060cc0c4f8b33c1ae6e34bd725e7e61","response_sha256":null,"source_fields":{"basic_info":{"short_description":"함대 전체를 지휘하거나, 그 한복판에서 전투기 한 대에 올라타 뛰어드세요. Strike Wings는 고전 우주전 DOS 게임에 바치는, 완전히 새로 만든 오마주입니다. 풀보이스 캠페인 3편, 16개 성계를 잇는 지속 전쟁, 24인 멀티플레이어, 전투 편집기, 그리고 칠흑 같은 우주에 터지는 불꽃놀이.","publishers":[{"name":"Strike Wings Games"}],"developers":[{"name":"Strike Wings Games"}]},"release":{"steam_release_date":1796025600,"is_coming_soon":true,"coming_soon_display":"date_month"},"trailers":{"highlights":[{"trailer_name":"Strike Wings Demo Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1789244499","trailer_category":3,"microtrailer":[{"filename":"4718360/464085956/9aded19729686013e4e3f80d414b748a86171e82/1789243966/microtrailer.webm","type":"video/webm"},{"filename":"4718360/464085956/9aded19729686013e4e3f80d414b748a86171e82/1789243966/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4718360/464085956/9aded19729686013e4e3f80d414b748a86171e82/1789243966/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"4718360/464085956/9aded19729686013e4e3f80d414b748a86171e82/1789243966/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"4718360/464085956/9aded19729686013e4e3f80d414b748a86171e82/1789243966/hls_264_master.m3u8","encoding":"hls_h264"}],"screenshot_medium":"257423596/43f34ff64c691f8905609421d6566cc8862b1f21/movie_600x337.jpg","screenshot_full":"257423596/43f34ff64c691f8905609421d6566cc8862b1f21/movie_full.jpg","trailer_base_id":1326422,"all_ages":true},{"trailer_name":"Strike Wings Come On Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1784897331","trailer_category":0,"microtrailer":[{"filename":"4718360/115058672/ea344c18dce55ba5c5aff40de26cb337aa4d3e5d/1784361853/microtrailer.webm","type":"video/webm"},{"filename":"4718360/115058672/ea344c18dce55ba5c5aff40de26cb337aa4d3e5d/1784361853/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4718360/115058672/ea344c18dce55ba5c5aff40de26cb337aa4d3e5d/1784361853/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"4718360/115058672/ea344c18dce55ba5c5aff40de26cb337aa4d3e5d/1784361853/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"4718360/115058672/ea3