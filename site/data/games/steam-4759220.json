reens to improve readability.","occurred_at":null,"published_at":"2026-10-04T09:13:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656390835","verified_at":"2026-10-20T17:02:21Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4759220-1844751498232613","game_id":"steam-4759220","kind":"announcement","title":"Démo v2.0 !","summary":"Dear Tamers, Thank you so much for all your support. To prepare for Steam Next Fest, I've completely reworked the demo from the ground up. I've fixed many of the existing systems and rebuilt almost the entire game to bring it much closer to my original vision. Here are the main changes: NEW: Completely reworked visuals and lighting. New Mutation System. New bosses. Improved combat feedback. New progression system. IMPROVED: Late-game performance. Team balancing. User interface. If you encounter ","occurred_at":null,"published_at":"2026-09-28T22:04:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498232613","verified_at":"2026-10-20T17:02:21Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4759220":{"last_attempt_at":"2026-10-26T14:07:01Z","status":"ok","all_sources_checked_at":"2026-10-26T14:07:00Z","error_codes":[]}},"news_last_attempt_at":{"steam-4759220":"2026-10-26T14:07:01Z"},"notices":[],"news_sources":{"4759220":{"last_attempt_at":"2026-10-26T14:07:00Z","last_success_at":"2026-10-26T14:07:00Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:07:00Z"},"4823790":{"last_attempt_at":"2026-10-26T14:07:01Z","last_success_at":"2026-10-26T14:07:01Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T14:07:01Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4759220","app_id":4759220,"app_scope":"base","observed_a