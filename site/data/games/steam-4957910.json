batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4957910-1847286114035515","game_id":"steam-4957910","kind":"announcement","title":"Chinese and Spanish Support Added","summary":"Veyrasol now supports Chinese and Spanish!Some of you asked for these languages on the forum, thank you. This is another step toward letting more players enjoy the game in their own language.If you notice any translation issues or odd wording, let us know and we'll be happy to fix them.Thank you for following Veyrasol's development.","occurred_at":null,"published_at":"2026-10-23T08:57:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114035515","verified_at":"2026-10-23T09:29:32Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4957910-1842846814450192","game_id":"steam-4957910","kind":"announcement","title":"Brazilian Portuguese Support Added","summary":"Veyrasol now supports Brazilian Portuguese!This is another step toward making the game accessible to more players around the world. If you notice any translation issues, we’d be happy to hear your feedback.Thank you for following Veyrasol’s development.","occurred_at":null,"published_at":"2026-09-06T04:54:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814450192","verified_at":"2026-10-20T19:32:47Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4957910-1842212951301175","game_id":"steam-4957910","kind":"announcement","title":"Veyrasol Kickstarter pre-launch page is now live","summary":"Hello everyone,Today I activated the Kickstarter pre-launch page for Veyrasol.This campaign is being prepared to support the game's native Unity desktop client. The browser version is still continuing in beta, and I'm currently planning to launch the Kickstarter campaign on October 1.If you'd like, you can already follow the page and get notified on launch day here:Kickstarter pre-launch pageA real thank you to everyone who has followed the project, wishlisted it, played it, and shared feedback ","occurred_at":null,"published_at":"2026-08-27T20:04:20Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951301175","verified_at":"2026-10-20T19:32:47Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4957910-1841579228673582","game_id":"steam-4957910","kind":"announcement","title":"October 19: Steam Next Fest Demo & Open Beta","summary":"Commanders,We've been working toward this for a while, and we're excited to share it: on October 19, two things happen at once.We're opening Open Beta on Web + PWA and iOS the same day, anyone outside the closed beta list will be able to join the Veyra Spiral.And that same week, October 19-26, we're taking part in Steam Next Fest. During the festival, a playable demo will be live on Steam (not the full release, but enough to get a real feel for Veyrasol: colony building, fleet command, alliances","occurred_at":null,"published_at":"2026-08-23T15:11:21Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228673582","verified_at":"2026-10-20T19:32:47Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4957910-1839676055898283","game_id":"steam-4957910","kind":"update","title":"Alpha Testing Complete: Development Update","summary":"Hello Commanders,We are excited to share an important milestone in the development of Veyrasol.Alpha testing has been successfully completed.Thank you to everyone who participated, explored the Veyra Spiral, reported issues, and shared valuable feedback. The information collected during the alpha phase will help us improve the game and prepare for the next stage of development.Current platform status:• The Veyrasol Steam Coming Soon page is live, and the game can now be added to your wishlist.• ","occurred_at":null,"published_at":"2026-08-04T19:28:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1839676055898283","verified_at":"2026-10-20T19:32:47Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4957910":{"last_attempt_at":"2026-10-26T05:51:29Z","status":"ok","all_sources_checked_at":"2026-10-26T05:51:29Z","error_codes":[]}},"news_last_attempt_at":{"steam-4957910":"2026-10-26T05:51:29Z"},"notices":[],"news_sources":{"4957910":{"last_attempt_at":"2026-10-26T05:51:29Z","last_success_at":"2026-10-26T05:51:29Z","status":"ok","error_codes":[]},"5186720":{"last_attempt_at":"2026-10-26T05:51:29Z","last_success_at":"2026-10-26T05:51:29Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4957910","app_id":4957910,"app_scope":"base","observed_at":"2026-10-26T06:15:11Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"b402c18c0f28565aced344498036ad98d6c020a74620efa9e287d30d795448b2","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Veyrasol is a real-time MMO strategy game set in the Veyra Spiral galaxy. Build colonies, command fleets, forge alliances, and battle for dominance across ~120-day seasons in this free-to-play browser-born strategy experience.","publishers":[{"name":"Minata Entertainment"}],"developers":[{"name":"Suleyman Ozcan"}]},"release":{"steam_release_date":1793106000,"is_coming_soon":true,"coming_soon_display":"date_fu