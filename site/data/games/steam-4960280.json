red_at":null,"published_at":"2026-10-26T02:21:44Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114043419","verified_at":"2026-10-26T05:51:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4960280-1847286114029233","game_id":"steam-4960280","kind":"update","title":"Demo Update (v0.2.6)","summary":"Thank you for playing! We've updated the demo (v0.2.6). New features Exchange SP: you can now exchange skill points for money or Fame from the Learn skills screen. A notice now appears when your title goes up. Your own horses that have built up fatigue now have a glowing red fatigue face. Click it to talk about sending the horse to pasture. The chance of a slow break is now shown before the start. Horse cards (such as Notable progeny) now show the race record. The farm catalogue now lists candid","occurred_at":null,"published_at":"2026-10-21T15:24:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114029233","verified_at":"2026-10-21T19:47:12Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4960280-1846651706674207","game_id":"steam-4960280","kind":"update","title":"Demo Update (v0.2.0)","summary":"Thank you for playing! We've updated the demo (v0.2.0). Balance adjustments Display and UI improvements Several bug fixes Please share your thoughts and any bugs you find in the \"Bug Reports\" thread in the Discussions.","occurred_at":null,"published_at":"2026-10-14T12:52:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706674207","verified_at":"2026-10-20T19:33:09Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4960280-1846018067943018","game_id":"steam-4960280","kind":"announcement","title":"JOCKEY RISING: BLOODLINE – Free Demo Out Now!","summary":"Thank you for your support of JOCKEY RISING: BLOODLINE! The wait is over: the free demo is out now! Free Demo Out Now Download the demo for free from the store page. Start your career as an 18-year-old rookie jockey at your family's small stable. Build your deck, take on races, accept riding offers, and raise your horses. The demo lets you play through June of your first year. Now in 6 Languages We've added Traditional Chinese. The game is now available in English, Japanese, Simplified Chinese, ","occurred_at":null,"published_at":"2026-10-13T06:02:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067943018","verified_at":"2026-10-20T19:33:09Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4960280":{"last_attempt_at":"2026-10-26T05:51:51Z","status":"ok","all_sources_checked_at":"2026-10-26T05:51:51Z","error_codes":[]}},"news_last_attempt_at":{"steam-4960280":"2026-10-26T05:51:51Z"},"notices":[],"news_sources":{"4960280":{"last_attempt_at":"2026-10-26T05:51:51Z","last_success_at":"2026-10-26T05:51:51Z","status":"ok","error_codes":[]},"5322840":{"last_attempt_at":"2026-10-26T05:51:51Z","last_success_at":"2026-10-26T05:51:51Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4960280","app_id":4960280,"app_scope":"base","observed_at":"2026-10-26T06:15:11Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"9c9eed6713759b618a515997c05217f21f6e681091318dace4f5bcb942b7da69","response_sha256":null,"source_fields":{"basic_info":{"short_description":"JOCKEY RISING: BLOODLINE is a jockey life sim with deck-building races. Start at 18 as a rookie, ride and raise horses at yo