am_community_announcements/1846651706688800","verified_at":"2026-10-20T16:41:13Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4731330-1844751498232739","game_id":"steam-4731330","kind":"announcement","title":"Abjure v0.4 alpha: 16 new relics, 5 new bosses, and relic builds","summary":"v0.4 alpha is out, and it's a big one: 16 new relics, 5 new boss modifiers, 5 new crossroads events, a new gambit, a new hand type and 16 new achievements. Everything new is translated into all 19 languages.Relic buildsRelics now belong to builds: Flush, Sets, Straight, Tempo and Control, plus Economy. Every relic in the shop shows which build it feeds and how many of that build you already hold, so you can tell at a glance whether it belongs in your run. The Deck & Relics screen sums up the bui","occurred_at":null,"published_at":"2026-09-28T23:44:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498232739","verified_at":"2026-10-20T16:41:13Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4731330-1843481262693602","game_id":"steam-4731330","kind":"update","title":"Abjure v0.3 alpha — The Reckoning Update","summary":"This is the biggest update Abjure has had. Beating the game is no longer the end of a run, every level has a new kind of event round, there is a daily run shared by every player, the whole game now plays in 19 languages, and every screen can be driven from a keyboard or a controller. Both the full game and the demo are updated.In short:The Reckoning — press on past the final boss into rounds 25–32 for score.Crossroads — one optional, non-fight event per level with a real decision in it.Daily Cha","occurred_at":null,"published_at":"2026-09-10T23:02:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262693602","verified_at":"2026-10-20T16:41:13Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4731330-1835236783566907","game_id":"steam-4731330","kind":"update","title":"New Update: v0.2 Alpha","summary":"TutorialA tutorial is added. The tutorial will be suggested when you start the game for the first time, and you can replay the tutorial by clicking \"How to Play\" on main menu and then clicking the green \"Interactive Tutorial\" button near the top of the \"How to Play\" screen.19 New LanguagesThe game can now be played in:English, Traditional Chinese, Simplified Chinese, Japanese, Korean, Vietnamese, Thai, Russian, Ukrainian, Spanish, Brazilian Portuguese, Turkish, German, French, Indonesian, Italia","occurred_at":null,"published_at":"2026-06-14T00:51:33Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1835236783566907","verified_at":"2026-10-20T16:41:13Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4731330":{"last_attempt_at":"2026-10-26T04:00:41Z","status":"ok","all_sources_checked_at":"2026-10-26T04:00:41Z","error_codes":[]}},"news_last_attempt_at":{"steam-4731330":"2026-10-26T04:00:41Z"},"notices":[],"news_sources":{"4731330":{"last_attempt_at":"2026-10-26T04:00:41Z","last_success_at":"2026-10-26T04:00:41Z","status":"ok","error_codes":[]},"4797500":{"last_attempt_at":"2026-10-26T04:00:41Z","last_success_at":"2026-10-26T04:00:41Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4731330","app_id":4731330,"app_scope":"base","observed_at":"2026-10-26T06:14:54Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"3bfd9a86462ad87bda3996a1093cc1438b46bbec3df77e69b4d2316aff1668d1","response_sha256":