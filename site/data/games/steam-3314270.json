/v1/","context":{"app_id":3314270,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-3314270-1846651706684931","game_id":"steam-3314270","kind":"announcement","title":"Demo Release","summary":"Hello IDS ASSET We are excited to announce the release of the demo! Play for free today with your friends, with a bunch more content is coming with the full release. This is a super cool day for us, we hope you enjoy it, and we look forward to sharing more updates in the future.We have a post on the discussions page, if you have any feedback or issues please reach out and let us know there! Thank you for your continued service. Next stop: full release.-The Detroy Studios team","occurred_at":null,"published_at":"2026-10-17T16:00:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706684931","verified_at":"2026-10-20T11:07:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3314270-1834602721199356","game_id":"steam-3314270","kind":"announcement","title":"Reviving Packaged Employees","summary":"Hello IDS ASSET Welcome back to another Planetary Delivery Boys development log.Last time we introduced the sacrifice mechanic and the ability to use players as fuel. Today we're pleased to announce that not all packaged players are destined for the furnace. Should a packaged employee remain unfueled, teammates can transport them to a designated restoration unit. After placing, the system will begin reconstructing the employee's body from its compressed package form by using some power. Once fin","occurred_at":null,"published_at":"2026-06-08T15:54:14Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1834602721199356","verified_at":"2026-10-20T11:07:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3314270-1833334318572886","game_id":"steam-3314270","kind":"announcement","title":"Introducing the Sacrifice Mechanic","summary":"Hello IDS ASSET We are beginning development logs for Planetary Delivery Boys, where we'll be showcasing mechanics, enemies, and systems as they are being developed.In today's devlog we're showcasing the new sacrifice mechanic and packaged players. When situations become desperate and the train begins starving for power, you and your friends can make the ultimate corporate contribution by entering the Sacrifice Pod. Once processed, your body is converted into energy dense packages which can be u","occurred_at":null,"published_at":"2026-05-22T22:12:12Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1833334318572886","verified_at":"2026-10-20T11:07:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3314270-1819386365121462","game_id":"steam-3314270","kind":"announcement","title":"Planetary Delivery Boys: Demo Announcement","summary":"Hello IDS ASSET Following our recent release date adjustment, we've been heads-down and focused on the core experience of the Planetary Delivery Boys. Today, we are thrilled to announce that a Playable Demo will be arriving within the next few months!! The demo serves as a direct snippet of our core game loop. You'll get your first real taste of the tension, logistics and dangers of being a Planetary Delivery Boy. Gather some friends, watch your back, and get ready to deliver... No matter the co","occurred_at":null,"published_at":"2026-01-04T08:08:53Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1819386365121462","verified_at":"2026-10-20T11:07:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3314270-1789580505478082","game_id":"steam-3314270","kind":"update","title":"Development Update","summary":"Hello Delivery Boys! With almost a month into the new year, we've been hard at work at Detroy Studios, and we're proud to say we're on track for our release this year! There's a whole lot to uncover within the Planetary Delivery Boys, but we'd love for you to see a sneak peek into what we're currently working on, the 'Gambling Machine'. {STEAM_CLAN_IMAGE}/45280385/20ce2428b6d2f23433c4f14a4ff85b5c16c6ae07.png To risk death for profit, will you sacrifice your life for the corporation? Thank you fo","occurred_at":null,"published_at":"2025-01-28T20:00:15Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1789580505478082","verified_at":"2026-10-20T11:07:36Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3314270":{"last_attempt_at":"2026-10-26T00:24:42Z","status":"ok","all_sources_checked_at":"2026-10-26T00:24:42Z","error_codes":[]}},"news_last_attempt_at":{"steam-3314270":"2026-10-26T00:24:42Z"},"notices":[],"news_sources":{"3314270":{"last_attempt_at":"2026-10-26T00:24:42Z","last_success_at":"2026-10-26T00:24:42Z","status":"ok","error_codes":[]},"4230880":{"last_attempt_at":"2026-10-26T00:24:42Z","last_success_at":"2026-10-26T00:24:42Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3314270","app_id":3314270,"app_scope":"base","observed_at":"2026-10-26T06:14:17Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"a96ee42c76091a91228d9c0d7f01e2ed59713b0f8c59dedc3fbf082b7e18a5e5","response_sha256":null,"source_fields":{"basic_info":{"short_description