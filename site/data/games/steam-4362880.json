/v1/","context":{"app_id":4362880,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4362880-1846651706694554","game_id":"steam-4362880","kind":"announcement","title":"TOP STEED Next Fest demo is out!","summary":"The TOP STEED Next Fest demo is fresh out of the oven! Race solo or online across two tracks, Tokyo Shift and Kings Field, and hit the tutorial arena for some practice laps.Please take a moment to fill out our feedback form (also linked in the demo’s main menu). And if you’re enjoying the game, a wishlist genuinely helps us out.Now slip into your fastest riding boots and show everyone who’s got the TOP STEED!","occurred_at":null,"published_at":"2026-10-20T10:01:26Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706694554","verified_at":"2026-10-20T13:44:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4362880-1843481262704323","game_id":"steam-4362880","kind":"announcement","title":"That's a wrap on Playtest 2!","summary":"Thank you to everyone who rode with us. Next up: a public demo at Steam Next Fest, 19 to 26 October. Wishlist now so you get the ping when it goes live.","occurred_at":null,"published_at":"2026-09-15T11:36:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262704323","verified_at":"2026-10-20T13:44:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4362880-1843481262691999","game_id":"steam-4362880","kind":"announcement","title":"PLAYTEST 2 extended through the weekend","summary":"We're extending TOP STEED's multiplayer playtest through the weekend! The new end date is Monday, September 14 at 10:00 AM PT / 7:00 PM CEST.We greatly appreciate your feedback - and remember to wishlist!","occurred_at":null,"published_at":"2026-09-10T12:05:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262691999","verified_at":"2026-10-20T13:44:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4362880-1842846814446411","game_id":"steam-4362880","kind":"announcement","title":"PLAYTEST 2 - Online Multiplayer","summary":"First of all, a huge thank you to all who participated in TOP STEED's Playtest 1 and sent us feedback! It's invaluable in helping us shape the game.Playtest 1 closes on September 4 at 10:00 AM PT / 7:00 PM CEST, and Playtest 2 opens right after, running a full week through September 11.Playtest 2 is all about online multiplayer, and a new track, Kings Field, has been added! Single-player mode against bots and the Tokyo and tutorial tracks are available, as well.Once you've played, please take a ","occurred_at":null,"published_at":"2026-09-04T12:59:00Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814446411","verified_at":"2026-10-20T13:44:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4362880-1842212951303765","game_id":"steam-4362880","kind":"announcement","title":"Playtest 1 is live!","summary":"Welcome to the first-ever playtest of TOP STEED! To get started, hit the Request Access button on the store page if you haven't already. The playtest ends September 7 at 10:00 AM PT / 7:00 PM CEST.After playing, please take a moment to fill out the feedback form (also linked in the main menu). And if you're enjoying the game, wishlist TOP STEED — it means a lot to us.Now take the reins and race your way to the podium!","occurred_at":null,"published_at":"2026-08-28T16:34:54Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951303765","verified_at":"2026-10-20T13:44:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4362880-1841579228662466","game_id":"steam-4362880","kind":"announcement","title":"Sign up for the first Playtest!","summary":"Get Ready to Saddle Up!On Friday, August 28, we're handing you the reins for the first time. In this single-player playtest you'll be racing bots around the Tokyo downtown track. A tutorial track will also be available. The second playtest will focus on online multiplayer, so stay tuned for that as well!The main menu will include a link to a short feedback form. Hearing your thoughts on the current state of the game is very important to us, so we hope that you'll take a moment to fill it out.New","occurred_at":null,"published_at":"2026-08-19T12:41:09Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1841579228662466","verified_at":"2026-10-20T13:44:48Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4362880-1825093633185851","game_id":"steam-4362880","kind":"announcement","title":"TOP STEED joins Steam Horse Fest","summary":"We’re excited to join Steam Horse Fest with TOP STEED! Saddle up, virtually, and load in to a once-in-a-lifetime racing experience! TOP STEED combines the best elements of high-speed car racing with the excitement of a steeplechase as you gallop through the holographic track, clearing obstacles (or crashing through scenery).Riders will feel right at home with the realistic controls, using both legs and reins to guide their horse, while the arcade controls offer a more classic feel. And yes, your","occurred_at":null,"published_at":"2026-02-19T18:05:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1825093633185851","verified_at":"2026-10-20T13:44:48Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4362880":{"last_attempt_at":"2026-10-26T02:12:29Z","status":"ok","all_sources_checked_at":"2026-10-26T02:12:29Z","error_codes":[]}},"news_last_attempt_at":{"steam-4362880":"2026-10-26T02:12:29Z"},"notices":[],"news_sources":{"4362880":{"last_attempt_at":"2026-10-26T02:12:29Z","last_success_at":"2026-10-26T02:12:29Z","status":"ok","error_codes":[]},"5218830":{"last_attempt_at":"2026-10-26T02:12:29Z","last_success_at":"2026-10-26T02:12:29Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4362880","app_id":4362880,"app_scope":"base","observed_at":"2026-10-26T06:14:34Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"1f70872dcdafbb1641471c5fd07313edf774e1dbd3cadc8ca28a5fbcb4576252","response_sha256":null,"source_fields":{"basic_info":{"short_description":"고속 경마 레이싱의 세계로 들어오세요! 안장에 올라 화려한 트랙을 드리프트로 질주하는 사실적인 승마 조작의 멀티플레이어 레이싱 게임. 당신의 TOP STEED와 함께 승리를 거머쥐세요!","publishers":[{"name":"Coyote Time Publishing","creator_clan_account_id":45898754}],"developers":[{"name":"Minuscule Mayhem"}]},"release":{"steam_release_date":1796025600,"is_coming_soon":true,"coming_soon_display":"date_month"},"trailers":{"highlights":[{"trailer_name":"TOP STEED","trailer_url_format":"steam/apps/${FILENAME}?t=1770382691","trailer_category":2,"microtrailer":[{"filename":"4362880/1298737554/65c24339d564bedf6b86a55e79e572a55b203ca1/1770381596/microtrailer.webm","type":"video/webm"},{"filename":"4362880/1298737554/65c24339d564bedf6b86a55e79e572a55b203ca1/1770381596/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4362880/1298737554/65c24339d564bedf6b86a55e79e572a55b203ca1/1770381596/dash_av1.mpd","enco