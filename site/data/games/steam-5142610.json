ror_code":"no_reviews"},{"game_id":"steam-5142610","metric":"demo_ccu","observed_at":"2026-10-26T06:32:19Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5277130","error_code":null}],"events":[{"id":"steam-steam-5142610-1847286114029570","game_id":"steam-5142610","kind":"announcement","title":"We’re Replacing Echo Doodle’s Artwork with Hand-Drawn Art!","summary":"Hello, I’m the developer creating Echo Doodle on my own. Thank you to everyone who has visited the page and is taking the time to read this announcement.Echo Doodle currently includes some images created with the use of generative AI.Recently, I realized that there are far more people who feel strongly opposed to games using AI-generated artwork than I had expected. After thinking it over, I decided to replace all AI-generated images used in the game with artwork drawn by myself.I have already f","occurred_at":null,"published_at":"2026-10-21T16:53:39Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114029570","verified_at":"2026-10-21T20:58:29Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142610-1846651706689620","game_id":"steam-5142610","kind":"update","title":"Next Fest Update — Event Stage Rework & Reward System Overhaul","summary":"Echo Doodle UpdateThis update brings a major overhaul to Event Stages, improvements to the reward selection system and UI, skill and boss balance changes, and several bug fixes.Event Stage ReworkRemoved the previous Easy / Normal / Hard selection system.Event Stage choices are now Defense / Attack / Gamble.Clearing an Event Stage now presents a reward pool based on the selected event type.Simple damage-increase rewards have been moved to the Attack Event reward pool.Rewards & Selection SystemAdj","occurred_at":null,"published_at":"2026-10-19T10:31:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706689620","verified_at":"2026-10-20T23:10:53Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142610-1846018067939926","game_id":"steam-5142610","kind":"update","title":"Echo Doodle Demo Update - October 12, 2026","summary":"\\Added contextual gameplay tips to the Game Over screen based on the cause of death.\\Removed 1 existing upgrade.Added 1 new upgrade.\\Reworked how additional Shockwaves are generated.Some Shockwave upgrades now convert into additional attacks during boss fights.","occurred_at":null,"published_at":"2026-10-12T04:00:16Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067939926","verified_at":"2026-10-20T23:10:53Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142610-1845383656388777","game_id":"steam-5142610","kind":"update","title":"Echo Doodle Demo Update - October 3, 2026","summary":"Update NotesBalanceAdjusted ranged enemy attack damage from 80 → 10.Adjusted ranged enemy attack interval from 2s → 0.75s.Adjusted ranged projectile travel time from 0.7s → 0.5s.UIThe low-health warning flash is now disabled while the choice popup is open when HP is below 50%.Adjusted the position of damage numbers to improve readability.AbilitiesLanding Spark's Micro Pull and Bilateral Compression effects no longer affect bosses.","occurred_at":null,"published_at":"2026-10-03T10:15:41Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656388777","verified_at":"2026-10-20T23:10:53Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5142610-1845383656383252","game_id":"steam-5142610","kind":"update","title":"Echo Doodle Demo Update - 2026.10.02","summary":"Update NotesEvent StagesFixed an issue where Pencil enemies could move together with other enemies during the Chase Event.Added a target indicator to make the target easier to identify during the Chase Event.ChoicesRegular choices can now be refreshed up to 3 times.Press R while highlighting the choice you want to replace to refresh it.StagesImproved the terrain generation logic for regular stages.BossesDefeating a boss now increases maximum HP by 10.","occurred_at":null,"published_at":"2026-10-01T17:37:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656383252","verified_at":"2026-10-20T23:10:53Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5142610":{"last_attempt_at":"2026-10-25T23:01:33Z","status":"ok","all_sources_checked_at":"2026-10-25T23:01:32Z","error_codes":[]}},"news_last_attempt_at":{"steam-5142610":"2026-10-25T23:01:33Z"},"notices":[],"news_sources":{"5142610":{"last_attempt_at":"2026-10-25T23:01:32Z","last_success_at":"2026-10-25T23:01:32Z","status":"ok","error_codes":[]},"5277130":{"last_attempt_at":"2026-10-25T23:01:33Z","last_success_at":"2026-10-25T23:01:33Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5142610","app_id":5142610,"app_scope":"base","observed_at":"2026-10-26T06:15:35Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"ec8f4c7f5f971da908fafc12d185bb6ae5e888289cdadafc2913fa60db032a7e","response_sha256":null,"source_fields":{"basic_info":{"short_description":"노트 한 장의 페이지를 배경으로 펼쳐지는 빠른 전개의 손그림 2D 액션 로그라이트 게임입니다. 낙서로 그려진 적들과 싸우며 점점 더 위험해지는 단계를 돌파하고, 매번 새로운 능력과 강화를 선택하세요. 대시, 공중 전투, 충격파 등 다양한 능력을 조합해 자신만의 빌드를 완성하고, 스테이지를 거듭할수록 강해지는 적들과 강력한 보스에 맞서 어디까지 살아남을 수 있는지 도전하세요.","publishers":[{"name":"T