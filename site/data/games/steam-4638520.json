"value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4766150","error_code":null}],"events":[{"id":"steam-steam-4638520-1846651706683738","game_id":"steam-4638520","kind":"announcement","title":"Demo updated to v1.3.1","summary":"Greetings curators!I’m excited to share a small update ahead of Steam Next Fest which improves support for Steam Deck. There are quite a few smaller changes to improve desktop and web builds as well.Enjoy!v1.3.1 changesIntegrated desktop builds with Steam.Added a toggle for full screen mode.Added dynamic delay parameters to holographic instruments.Set input preference silently on the splash screen.Defaulted the interface scale to its maximum.Faded out main volume on application close.Killed hapt","occurred_at":null,"published_at":"2026-10-17T03:35:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706683738","verified_at":"2026-10-20T15:35:02Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4638520-1846018067927734","game_id":"steam-4638520","kind":"announcement","title":"Reach for the stars in THE OMEGA REACH demo","summary":"Greetings curators!I'm thrilled to share the demo of THE OMEGA REACH for Steam Next Fest. Reach for the stars, gather their instruments, and curate the best collection in the universe!THE OMEGA REACH was originally created for Games for Blind Gamers 5. It offered a unique point-and-click experience that was made accessible through its tactile controls, expressive audio and haptics, and support for screen readers. Now, after six months of post-jam updates, its demo has arrived to Steam with more ","occurred_at":null,"published_at":"2026-10-07T22:55:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067927734","verified_at":"2026-10-20T15:35:02Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4638520-1834602721186672","game_id":"steam-4638520","kind":"announcement","title":"Introducing THE OMEGA REACH","summary":"Greetings curators!I'm excited to share THE OMEGA REACH with you for the Access-Ability Summer Showcase 2026!I initially created this project as a co-host for the Games For Blind Gamers 5 jam. The jam release culminated nearly 200 hours of development to introduce you to The Omega Conservatory and its core game loop of exploring the universe, finding your place in it, and killing time with music. Whether you played with just a keyboard, just a mouse, or a gamepad—with audio, visuals, or haptics ","occurred_at":null,"published_at":"2026-06-04T06:38:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1834602721186672","verified_at":"2026-10-20T15:35:02Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4638520":{"last_attempt_at":"2026-10-26T13:15:53Z","status":"ok","all_sources_checked_at":"2026-10-26T13:15:52Z","error_codes":[]}},"news_last_attempt_at":{"steam-4638520":"2026-10-26T13:15:53Z"},"notices":[],"news_sources":{"4638520":{"last_attempt_at":"2026-10-26T13:15:52Z","last_success_at":"2026-10-26T13:15:52Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T13:15:52Z"},"4766150":{"last_attempt_at":"2026-10-26T13:15:53Z","last_success_at":"2026-10-26T13:15:53Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T13:15:53Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4638520","app_id":4638520,"app_scope":"base","observed_at":"2026-10-26T06:14:45Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"64e6d83d1