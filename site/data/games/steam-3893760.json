scovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3893760-1845383656394577","game_id":"steam-3893760","kind":"announcement","title":"1,000 Wishlists! Thank You, and Next Up: a Fully Featured Demo","summary":"🎉 We just passed 1,000 wishlists!🎉 We're still a little stunned. When we first put Anvira: Forge Defense on Steam, we hoped a few people would like the idea of a tower defense roguelite about building absurd golems. Now more than 1,000 of you have added it to your wishlist. Thank you To everyone who wishlisted, played the demo, left feedback, shared a clip or told a friend: thank you. As a small team, we can't overstate how much this matters. Every wishlist helps the game show up for more player","occurred_at":null,"published_at":"2026-10-05T20:33:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656394577","verified_at":"2026-10-20T12:13:42Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3893760-1842846814452165","game_id":"steam-3893760","kind":"announcement","title":"New Demo","summary":"We are very excited for you to play the new version of Anvira: Forge Defense Demo.The demo includes:The first chapter of the game (10 levels).10 unique towers with 15 customization options.8 powerful abilities.9 challenging foes.30 achievements.Let us know what crazy builds you make in the comments!Don't forget to wishlist and follow. It helps us a lot!","occurred_at":null,"published_at":"2026-09-07T04:49:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814452165","verified_at":"2026-10-20T12:13:42Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3893760-1826992588596976","game_id":"steam-3893760","kind":"announcement","title":"Demo Available NOW!!!","summary":"Anvira: Forge Defense Demo is NOW LIVE on Steam!After years of hard work, you can finally jump in and play the first slice of Anvira: Forge Defense — for free!In this demo you'll get to experience the first chapter of Anvira.We're dying to hear what you think — feedback, bugs, vibes, everything. Your input shapes the full game ♥Play the demo here:Wishlist if you haven't yet → it really helps ❤️Thank you so much for the support — let's make this journey together!","occurred_at":null,"published_at":"2026-03-13T22:43:29Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1826992588596976","verified_at":"2026-10-20T12:13:42Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3893760":{"last_attempt_at":"2026-10-26T11:02:01Z","status":"ok","all_sources_checked_at":"2026-10-26T11:02:01Z","error_codes":[]}},"news_last_attempt_at":{"steam-3893760":"2026-10-26T11:02:01Z"},"notices":[],"news_sources":{"3893760":{"last_attempt_at":"2026-10-26T11:02:01Z","last_success_at":"2026-10-26T11:02:01Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T11:02:01Z"},"4462660":{"last_attempt_at":"2026-10-26T11:02:01Z","last_success_at":"2026-10-26T11:02:01Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T11:02:01Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3893760","app_id":3893760,"app_scope":"base","observed_at":"2026-10-26T06:14:24Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"fc7aa71177cf2e1aaa754df44a4a0ce68d2c7610513b894a09c734ea3f9a1032","response_sha256":null,"source_fields":{"basic_info":{"short_description":"전장을 용암으로 뒤덮으세요. 하늘을 메테오로 가득 채우세요. 수리검을 난사하는 닌자 골렘 군단을 일으키세요. Anvira: Forge Defense는 말도 안 되는 골렘 빌드를 만들어 내고, 끝없이 몰려오는 고블린 웨이브가 그 앞에서 박살 나는