/v1/","context":{"app_id":3742720,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-3742720","metric":"demo_ccu","observed_at":"2026-10-26T07:56:38Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5207390","error_code":null}],"events":[{"id":"steam-steam-3742720-1846651706690209","game_id":"steam-3742720","kind":"announcement","title":"Sobakistan: The Land of Dogs — Demo OUT NOW!","summary":"Explore a bizarre totalitarian state ruled by dogs, where you can be arrested for absolutely anything.NEW: Bureaucratic Card Battles!Fight back against absurd accusations using documents, recommendations, and your social rating. Your choices may even affect the game's endings.We've also released a brand-new trailer. It's strange. It's terrifying. It's very Sobakistan.We're participating in Steam Next Fest! Playing our demo right now is especially important to us. Your support can help more playe","occurred_at":null,"published_at":"2026-10-19T13:24:26Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706690209","verified_at":"2026-10-20T11:51:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3742720-1843481262702039","game_id":"steam-3742720","kind":"announcement","title":"Sobakistan: Final Playtest!","summary":"Comrades friends! After a whole year, we’re SUPER EXCITED to finally be back!We’ve made a brand-new demo, and we’re launching a big new playtest. Please join us and tell your friends!The game is now 90% complete, and we’re actively working on the final touches. We’ll announce the release date very soon, and we really hope we can get the game out this year.And yes — we’re coming back to Tokyo Game Show! Find us in the Indie Game Area, booth 09-C52.Let’s go, dogs!","occurred_at":null,"published_at":"2026-09-14T15:26:04Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262702039","verified_at":"2026-10-20T11:51:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3742720-1815034433007946","game_id":"steam-3742720","kind":"announcement","title":"🐾 The playtest for “Sobakistan: The Land of Dogs” is now live! 🎮","summary":"In the next few days, everyone will be able to join automatically — even if you didn’t sign up in advance.Please share your feedback through the in-game form and our Discord (links inside the game). Your input helps us make the experience better 🧡Thank you for joining us — and be careful out there. This is a harsh land that does not forgive mistakes 🐶🔥","occurred_at":null,"published_at":"2025-11-03T17:53:32Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1815034433007946","verified_at":"2026-10-20T11:51:51Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-3742720-1811772772214267","game_id":"steam-3742720","kind":"announcement","title":"Playtest Sign-ups Now Open + Tokyo Game Show","summary":"Comrades! The day has come. The Republic of Sobakistan invites citizens from all over the world to participate in the secret closed testing of our game's demo version. If you are interested, please press the appropriate button. The event will take place in October — stay alert and don’t miss it.Also, the official delegation of the Republic of Sobakistan will visit Tokyo to take part in Tokyo Game Show 2025.If you’re attending — come play the demo in person! Hall 11, Indie Area, Booth E-62. Long ","occurred_at":null,"published_at":"2025-09-24T15:28:18Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1811772772214267","verified_at":"2026-10-20T11:51:51Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-3742720":{"last_attempt_at":"2026-10-26T00:45:15Z","status":"ok","all_sources_checked_at":"2026-10-26T00:45:15Z","error_codes":[]}},"news_last_attempt_at":{"steam-3742720":"2026-10-26T00:45:15Z"},"notices":[],"news_sources":{"3742720":{"last_attempt_at":"2026-10-26T00:45:15Z","last_success_at":"2026-10-26T00:45:15Z","status":"ok","error_codes":[]},"5207390":{"last_attempt_at":"2026-10-26T00:45:15Z","last_success_at":"2026-10-26T00:45:15Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-3742720","app_id":3742720,"app_scope":"base","observed_at":"2026-10-26T06:14:21Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"d7972f84edf91182695a7b83c1fe51459d45be63443255b31eedc8357adbd7f7","response_sha256":null,"source_fields":{"basic_info":{"short_description":"소바키스탄 — 개들의 나라는, 언제 어떤 이유로 감옥에 갈지 알 수 없는 폐쇄된 전체주의 개 국가를 배경으로 한 어둡고 풍자적인 내러티브 몰입 게임입니다. 무자비한 국가 권력에 맞서 자신의 결백을 증명해야 하는 관료주의 카드 배틀.","publishers":[{"name":"Terletski Games","creator_clan_account_id":44977347}],"developers":[{"name":"Terletski Games","creator_clan_account_id":44977347}]},"release":{"is_coming_soon":true,"custom_release_date_message":"출시 예정","coming_soon_display":"text_comingsoon"},"trailers":{"highlights":[{"trailer_name":"Sobakistan: The Land of Dogs - Demo Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1792778022","trailer_category":1,"microtrailer":[{"filename":"3742720/1555550329/7afd7c81705e65b9dae1bfee5cc5374984ddb1e6/1792777690/microtrailer.webm","type":"video/webm"},{"filename":"3742720/1555550329/7afd7c81705e65b9dae1bfee5cc5374984ddb1e6/1792777690/microtra