13:35:17Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706690252","verified_at":"2026-10-20T21:25:47Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5070780-1846651706686495","game_id":"steam-5070780","kind":"announcement","title":"Whatever you stamp becomes true: the clerk's desk is open","summary":"The town hall opens at nine The free demo of TOWN HALL is on Steam, starting today, and the game is part of Steam Next Fest until 26 October. Most of the town has left, but the town hall still opens at nine. You are the clerk. The mayor is unreachable, the council hasn't met in two years, and the seal on your desk still works, which makes you, in every way that counts, the government. What the demo holds The clerk's desk: the people who come to the counter, the paper each of them needs made offi","occurred_at":null,"published_at":"2026-10-18T09:15:41Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706686495","verified_at":"2026-10-20T21:25:47Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5070780-1842212951311211","game_id":"steam-5070780","kind":"announcement","title":"Whatever you stamp becomes true","summary":"Hello — first word from us on this page. The town is half empty, but the town hall still opens at nine. You are the clerk. The mayor is unreachable, the other offices are dark, and the seal on your desk still works — which makes you, in every way that counts, the government. Whatever you stamp becomes true. Permits. Licenses. Certificates of birth, of death, of ownership. The paper in front of you is a claim; your stamp is the fact. Approve it and the town reshapes itself around your signature. ","occurred_at":null,"published_at":"2026-08-31T18:59:26Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842212951311211","verified_at":"2026-10-20T21:25:47Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5070780":{"last_attempt_at":"2026-10-26T07:59:07Z","status":"ok","all_sources_checked_at":"2026-10-26T07:59:07Z","error_codes":[]}},"news_last_attempt_at":{"steam-5070780":"2026-10-26T07:59:07Z"},"notices":[],"news_sources":{"5070780":{"last_attempt_at":"2026-10-26T07:59:07Z","last_success_at":"2026-10-26T07:59:07Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T07:59:07Z"},"5073000":{"last_attempt_at":"2026-10-26T07:59:07Z","last_success_at":"2026-10-26T07:59:07Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T07:59:07Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5070780","app_id":5070780,"app_scope":"base","observed_at":"2026-10-26T06:15:23Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"8f572bd147be217a75555fddeea16381f60b994d3b927fcee9e4926802e5b08b","response_sha256":null,"source_fields":{"basic_info":{"short_description":"마을은 절반이 비었지만 시청은 여전히 아홉 시에 문을 엽니다. 당신은 담당 공무원이고, 당신의 도장이 승인한 것은 사실이 됩니다 — 허가, 면허, 이름, 죽음. 당신의 책상에 닿는 사람은 모두 이유를 들고 오며, 대개는 돈도 들고 옵니다. 지하실에는 마을이 왜 비었는지 설명하는 파일이 있습니다.","publishers":[{"name":"3Cats Studio","creator_clan_account_id":46217660}],"developers":[{"name":"3Cats Studio","creator_clan_account_id":46217660}]},"release":{"steam_release_date":1803801600,"is_coming_soon":true,"coming_soon_display":"date_month"},"trailers":{"highlights":[{"trailer_name":"Announcement Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1788633600","trailer_category":1,"microtrailer":[{"filename":"5070780/360366877/ea6e6460cc6098c79682ff5b215b49f40bd4da08/1788633368/microtrailer.webm","type":"video