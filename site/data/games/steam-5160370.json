ror_code":"no_reviews"},{"game_id":"steam-5160370","metric":"demo_ccu","observed_at":"2026-10-26T07:08:02Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5255250","error_code":null}],"events":[{"id":"steam-steam-5160370-1847286114033507","game_id":"steam-5160370","kind":"announcement","title":"Next Fest is live — here's how to read your first fight","summary":"Next Fest: Oct 19 – Oct 26 HOSHIKIRI is in Steam Next Fest until Oct 26 at 10 AM PT. The demo has been free since September 30, so if you already have it, you're ready to go. Your first fight, in thirty seconds Aries opens Act One. When she winds up, a danger zone lights up on the board, and a rule line at the top tells you how to block it. You have three answers: Parry — shape an L, a T or a cross inside the zone. It works on every zone. Block — do what the rule line says. Aries's sweeps are li","occurred_at":null,"published_at":"2026-10-22T16:58:35Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114033507","verified_at":"2026-10-22T18:49:08Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5160370-1846018067935782","game_id":"steam-5160370","kind":"announcement","title":"HOSHIKIRI Demo v0.2.0 — Controller Support, Build Review & Traditional Chinese","summary":"New Full controller support. Play the whole demo on a gamepad — board cursor, every menu, and button prompts that follow your controller (Xbox, PlayStation, Nintendo, Steam Deck). Vibration can be turned off in Settings. Rebind keys and buttons in Settings → Controls (keyboard and controller). Inspect mode (controller Y / △, keyboard I): point at anything on the battle screen to read its tooltip. Build Review: open it from the victory or defeat screen to see your deck, damage by color and by sou","occurred_at":null,"published_at":"2026-10-10T09:12:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067935782","verified_at":"2026-10-20T23:32:35Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5160370-1845383656392891","game_id":"steam-5160370","kind":"announcement","title":"House of Gemini — two blades, only one is real","summary":"This week's house: Gemini Gemini raises both hands. Where the earlier houses paint one danger zone on the board, she paints two, one across and one down, and they open and close on the same beat. The defense window does not get any wider for it. And only one of the two blades is real. Reading the telegraph Two blades, one real. The rule line says it outright: TWIN BLADES - ONE IS REAL: DODGE INSIDE IT. Answer the real one. A straight line along its axis blocks it: a three blocks, a four or five ","occurred_at":null,"published_at":"2026-10-05T08:54:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656392891","verified_at":"2026-10-20T23:32:35Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5160370-1845383656386019","game_id":"steam-5160370","kind":"announcement","title":"The free demo is live: Act One, four Zodiac bosses","summary":"The demo is out The free demo of HOSHIKIRI: Parry the Zodiac is live. You'll find the Download Demo button on the main store page. What's in the demo Act One, four houses: Aries, Taurus, Gemini and Cancer. Between fights: a tarot three-pick and your natal chart. Every run draws a different star map. Platform and languages: Windows. English, Simplified Chinese, Japanese and Korean in game. How the fight works Read the telegraph. The boss winds up and a danger zone lights on the match-3 board. Sha","occurred_at":null,"published_at":"2026-10-02T11:44:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656386019","verified_at":"2026-10-20T23:32:35Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5160370-1844751498229117","game_id":"steam-5160370","kind":"announcement","title":"Boss of the week: Taurus, and why a line can't block her hammer","summary":"Boss of the week: Taurus One Zodiac boss per week, shown in motion. Week two is Taurus, the second fight of act one in HOSHIKIRI, an action match-3 roguelike built around the parry. Her hammer paints an area. When she raises it, the red covers a 4x4 patch of the board. Against Aries you blocked with a straight three along her line. Here there is no line, so a straight three has nothing to block against. What holds is a 2x2 square inside the zone. Touch the zone and it is a block; get all four ce","occurred_at":null,"published_at":"2026-09-27T12:41:36Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498229117","verified_at":"2026-10-20T23:32:35Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5160370-1844115010503401","game_id":"steam-5160370","kind":"announcement","title":"Boss of the week: Aries, and the countdown UI is gone","summary":"Boss of the week: Aries Starting this week, one Zodiac boss per week. Aries goes first, because she is the first fight of act one and the easiest of the twelve to read. Her danger zone is a line. When she winds up, the red paints one row or one column across the board. A line is the friendliest shape in the game: a cross or an L fits entirely inside it, the whole shape counts, and the parry registers perfect. Break her posture that way and the overclock window opens — one action, no step spent. ","occurred_at":null,"published_at":"2026-09-22T07:20:24Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010503401","verified_at":"2026-10-20T23:32:35Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5160370-1843481262697848","game_id":"steam-5160370","kind":"announcement","title":"Every match is a sword stroke — welcome to HOSHIKIRI","summary":"Every match is a sword stroke. Welcome to the HOSHIKIRI community hub. This is the first dev post, so here is what the game is in one loop: the boss winds up, the danger zone lights up on the board, you shape an L or a cross inside it, and a perfect parry breaks her posture. Then you end it in one overclocked blow. What is coming next: A free demo (the first four Zodiac bosses) for Steam Next Fest, October 19-26. A trailer before the press preview on October 8. Weekly boss spotlights here and on","occurred_at":null,"published_at":"2026-09-12T17:24:01Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1843481262697848","verified_at":"2026-10-20T23:32:35Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5160370":{"last_attempt_at":"2026-10-26T09:06:21Z","status":"ok","all_sources_checked_at":"2026-10-26T09:06:21Z","error_codes":[]}},"news_last_attempt_at":{"steam-5160370":"2026-10-26T09:06:21Z"},"notices":[],"news_sources":{"5160370":{"last_attempt_at":"2026-10-26T09:06:21Z","last_success_at":"2026-10-26T09:06:21Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:06:21Z"},"5255250":{"last_attempt_at":"2026-10-26T09:06:21Z","last_success_at":"2026-10-26T09:06:21Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:06:21Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5160370","app_id":5160370,"app_scope":"base","observed_at":"2026-10-26T06:15:37Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"k