aihd.net/news/externalpost/steam_community_announcements/1834602721191677","verified_at":"2026-10-20T13:42:16Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4301810-1834602721185314","game_id":"steam-4301810","kind":"announcement","title":"The Order of Serenity Demo Now Available","summary":"The first playable demo of The Order of Serenity is now available on Steam.In this demo, you step into the role of an undercover journalist attempting to infiltrate a secretive cult known as The Order of Serenity.To survive and progress, you will need to follow orders, gain the trust of the group, complete unsettling daily tasks, and secretly investigate the disturbing truth behind the Order’s beliefs and rituals.This first demo gives you an early look at the atmosphere, story direction, and cor","occurred_at":null,"published_at":"2026-06-03T16:34:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1834602721185314","verified_at":"2026-10-20T13:42:16Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4301810":{"last_attempt_at":"2026-10-26T02:09:56Z","status":"ok","all_sources_checked_at":"2026-10-26T02:09:56Z","error_codes":[]}},"news_last_attempt_at":{"steam-4301810":"2026-10-26T02:09:56Z"},"notices":[],"news_sources":{"4301810":{"last_attempt_at":"2026-10-26T02:09:56Z","last_success_at":"2026-10-26T02:09:56Z","status":"ok","error_codes":[]},"4779320":{"last_attempt_at":"2026-10-26T02:09:56Z","last_success_at":"2026-10-26T02:09:56Z","status":"ok","error_codes":[]}}}
