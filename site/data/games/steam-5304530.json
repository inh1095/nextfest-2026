ror_code":"no_reviews"},{"game_id":"steam-5304530","metric":"demo_ccu","observed_at":"2026-10-26T07:12:00Z","value":6,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5313120","error_code":null}],"events":[{"id":"steam-steam-5304530-1847286114030977","game_id":"steam-5304530","kind":"update","title":"October 22 patch notes","summary":"AUTOMATE DEATH demo: update The demo now starts on Mac On some Macs the demo wouldn't open at all (\"The game couldn't start a process\"). macOS now accepts it, and it runs on Apple Silicon Macs as well as Intel ones. If Steam's services can't be loaded, the game now carries on without them instead of failing to start. Fixed: bullets disappearing after a Retry With Graphics set to High, rounds, tracers, flames, explosions and the colour grading could vanish after you pressed Retry, or started the ","occurred_at":null,"published_at":"2026-10-22T02:41:49Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114030977","verified_at":"2026-10-22T03:02:45Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5304530-1847286114028438","game_id":"steam-5304530","kind":"update","title":"October 21 patch notes","summary":"New scoringRuns are now scored out of 1,000,000 points:Clear: 400,000. Any clear outranks any loss.Protection: up to 200,000. You lose points as your base takes damage.Speed: up to 200,000 for clearing the field quickly after the last hostile arrives. It halves at 10 seconds.Assets: up to 200,000. Each asset deployed after the first costs 10,000, so fewer, stronger guns pay.Abilities: each use costs 100 points per second of its cooldown, but never touches the Clear points.A loss scores up to 300","occurred_at":null,"published_at":"2026-10-21T10:59:58Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114028438","verified_at":"2026-10-21T16:03:58Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5304530-1846018067940586","game_id":"steam-5304530","kind":"update","title":"October 12 patch notes","summary":"Patch Notes Map Editor OverhaulThe map editor has been rebuilt from the ground up. A new layoutA tidier screen with much more room for your map: one row of buttons along the top, your tools down the left, and map settings down the right.See your map exactly as it will look in battle, or press V for the blueprint view. DrawingPaint Road, Ground (where you can place guns), Water or Gates with keys 1–4.New ways to draw: square brush, round brush, line, rectangle, ellipse, fill, and a path pen for d","occurred_at":null,"published_at":"2026-10-12T10:52:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067940586","verified_at":"2026-10-21T00:38:09Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5304530-1846018067936227","game_id":"steam-5304530","kind":"update","title":"Demo update - 10 October minor patch notes","summary":"Weapon EffectsAdded ammunition-specific spent casings that eject, tumble, bounce, settle, and fade.Added muzzle smoke, hot-barrel wisps, rocket backblast, vehicle exhaust, and support-aircraft gun smoke.These are visual improvements only. Weapon damage, firing rates, and balance are unchanged.Bug ReportingAdded Report a bug to the Escape menu and Settings.Reports include useful game-state, hardware, settings, and performance diagnostics to help investigate problems.Menus & VersionsAdded date-bas","occurred_at":null,"published_at":"2026-10-10T13:02:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067936227","verified_at":"2026-10-21T00:38:09Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5304530-1846018067931530","game_id":"steam-5304530","kind":"announcement","title":"Rolling bug fixes being deployed","summary":"Hey everyone. Over the next 12 hours there will be many small, targeted updates aimed at addressing the various issues that have been identified and reported, examples including crashing, freezing, unintuitive UI experiences, and so on. These patches will be small (around 10mb each). I invite you to share you experiences in this thread or on Discord. Be brutally honest and clear. I want to make a great game, so your feedback is essential. The demo is the perfect cornerstone for yourselves and us","occurred_at":null,"published_at":"2026-10-08T22:01:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067931530","verified_at":"2026-10-21T00:38:09Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5304530":{"last_attempt_at":"2026-10-26T09:31:37Z","status":"ok","all_sources_checked_at":"2026-10-26T09:31:36Z","error_codes":[]}},"news_last_attempt_at":{"steam-5304530":"2026-10-26T09:31:37Z"},"notices":[],"news_sources":{"5304530":{"last_attempt_at":"2026-10-26T09:31:36Z","last_success_at":"2026-10-26T09:31:36Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:31:36Z"},"5313120":{"last_attempt_at":"2026-10-26T09:31:37Z","last_success_at":"2026-10-26T09:31:37Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:31:37Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5304530","app_id":5304530,"app_scope":"base","observed_at":"2026-10-26T06:15:42Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"b037090a182fe8fec22c8e95d4a