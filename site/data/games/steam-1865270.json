/v1/","context":{"app_id":1865270,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"},{"game_id":"steam-1865270","metric":"demo_ccu","observed_at":"2026-10-26T07:31:22Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=4877850","error_code":null}],"events":[{"id":"steam-steam-1865270-1846651706688496","game_id":"steam-1865270","kind":"update","title":"Pre-NextFest Update","summary":"Gameplay:Melvin has a new hip thrust attack. Watch out.UI:The pause menu is a lot nicer looking and easier to use now.Settings menu has been overhauled. It works in the pause menu now too!In game notifications look better than ever.Key rebinding is easier and more comprehensive now.Player HUD has been refreshed and spruced up visually.The Main Menu has been refurbished.Some menus have had their buttons hold requirements removed or lessened.","occurred_at":null,"published_at":"2026-10-19T01:42:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706688496","verified_at":"2026-10-20T10:01:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1865270-1846018067927787","game_id":"steam-1865270","kind":"update","title":"Demo Release Update","summary":"The Custom Hobo Demo has been officially released! We hope you enjoy it as much as we enjoyed writing these patch notes. Content Added new job-specific sprites for certain pieces, so you can flex your fit in an appropriate style.Added a \"Bumper block\" object to the editor. Try to recreate Pinball. (you think it's a joke, but it works).Added liquor, beer, and wine bottles to the editor, for your drinking pleasure. Take that, ESRB. Features You can now enable anonymous gameplay stats in the settin","occurred_at":null,"published_at":"2026-10-07T23:21:33Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067927787","verified_at":"2026-10-20T10:01:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1865270-1842846814449581","game_id":"steam-1865270","kind":"announcement","title":"Custom Hobo Demo Releases October 19th","summary":"We're thrilled to announce that Custom Hobo was invited to join this October's Steam Next Fest! Get ready to customize hobos, collect biomass, and fight The M.A.N. on October 19th! In the meantime, check out our discord! {STEAM_CLAN_IMAGE}/45939226/4171659f602848ad33e91ad9d8eb8c85b97db683.png","occurred_at":null,"published_at":"2026-09-05T18:39:54Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814449581","verified_at":"2026-10-20T10:01:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1865270-1842846814449535","game_id":"steam-1865270","kind":"update","title":"Summer Update v0.5.0","summary":"Content \"Super Smash 'Bos\" — a dedicated terminal in Hobo Command that lets you queue up for a PvP stock battle against your friends. It's only a matter of time before the Nintendo thugs come for our kneecaps. \"Hobo With A Shotgun\" — a new level where you relive Moldy Mac's second most traumatic life event. \"Hail to the Grub\" — a new level where you ferry a cute yet demanding world leader across the wasteland on a 20th century bicycle. \"Healing Drone\" — a new umbilicus-wielding actor that infuse","occurred_at":null,"published_at":"2026-09-05T18:15:24Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814449535","verified_at":"2026-10-20T10:01:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1865270-1836506165568984","game_id":"steam-1865270","kind":"update","title":"Custom Hobo Update v0.4.0","summary":"It's time for the spring Custom Hobo update! We've been hard at work preparing for the upcoming NextFest and are excited to share these patch notes with you. Gameplay:All hobos have learned how to wall jump.The global slow-motion button has been removed. While powerful, we found it confused new players and disrupted co-op gameplay. Keep an eye out for the aptly named 'Slow Mo Arm'Co-op players can now join and leave via the pre-mission preparation menu.The in-game inventory has been restricted t","occurred_at":null,"published_at":"2026-07-02T20:34:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1836506165568984","verified_at":"2026-10-20T10:01:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1865270-1832065502821889","game_id":"steam-1865270","kind":"update","title":"Custom Hobo Update v0.3.0","summary":"GameplayIn addition to easily playing your Steam Workshop levels in H.O.B.O. Command’s R&D Terminal, you can now easily Rate or Favorite levels after you complete them!Give our new boss, The Fleshcopter, a new and deadly attack. This thing is going to disassemble you big time.Reworked the way body parts “smash” into little bits - to get more bits flying around!Hobos should control and look better while walking up, down, and around sloped surfaces.Hobos now strike dynamic poses while jumping arou","occurred_at":null,"published_at":"2026-05-11T16:31:31Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1832065502821889","verified_at":"2026-10-20T10:01:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1865270-1831432155566241","game_id":"steam-1865270","kind":"announcement","title":"Version v0.2.0 is live!","summary":"GameplayCustom Hobo now supports the Steam Workshop! Have fun uploading your lovingly crafted levels from the Level Editor to the Custom Hobo Workshop, and enjoy downloading and playing levels that the devious minds of the Custom Hobo community have seen fit to unleash upon you.Steam Rich Presence is now supported. Your friends can now speculate about what it means when Steam says that you're \"Bartering for Body Parts\".Revamped the mission progression system. This one's for those completionists ","occurred_at":null,"published_at":"2026-04-29T20:37:47Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1831432155566241","verified_at":"2026-10-20T10:01:36Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-1865270-1822556746165965","game_id":"steam-1865270","kind":"announcement","title":"Custom Hobo live on the Steam Store!","summary":"We are thrilled to announce the Custom Hobo is on the Steam store. Wishlist it now!The game is nearly feature complete. We are spending most of our time polishing content, adding deeper progression, and integrating the Level Editor with the Steam Workshop.Feel free to reach out to the dev team on our discord if you wish to become an early Beta Tester!","occurred_at":null,"published_at":"2026-01-25T21:13:22Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1822556746165965","verified_at":"2026-10-20T10:01:36Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-1865270":{"last_attempt_at":"2026-10-25T23:59:26Z","status":"ok","all_sources_checked_at":"2026-10-25T23:59:26Z","error_codes":[]}},"news_last_attempt_at":{"steam-1865270":"2026-10-25T23:59:26Z"},"notices":[],"news_sources":{"1865270":{"last_attempt_at":"2026-10-25T23:59:26Z","last_success_at":"2