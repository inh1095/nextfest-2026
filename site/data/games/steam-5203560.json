ouncements/1846018067943345","verified_at":"2026-10-21T00:16:44Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5203560-1845383656394672","game_id":"steam-5203560","kind":"update","title":"Demo update 0.0.4","summary":"Runs better, Steam achievements and leaderboards, and a lot of fixes. Thank you to everyone who sent reports! Runs better The game uses about 40% less memory on low. The main hall has about a third fewer triangles. You can pick your graphics setting on launch. Loading is quicker and now has a progress bar. Fixed lag when flipping the journal and opening settings. Low and medium both run a lot faster now. New custom graphics settings let you fine tune your game. New All achievements are now on St","occurred_at":null,"published_at":"2026-10-05T21:26:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656394672","verified_at":"2026-10-21T00:16:44Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5203560-1845383656379434","game_id":"steam-5203560","kind":"update","title":"Demo update 0.0.3","summary":"Special thanks to everyone who sent a crash report! This update fixes the crashes you found. Issues resolved: Fixed a crash when marking a rock in the journal or picking up a key. Fixed a crash in the settings after going back to the title from a game. Fixed a rare crash when fitting a vase piece right after scratching it with the knife. Fixed a rare crash when the game first opens. Fixed memory leak caused by returning to main menu. Fixed the game sometimes freezing or crashing when closing. St","occurred_at":null,"published_at":"2026-10-01T01:29:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656379434","verified_at":"2026-10-21T00:16:44Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5203560":{"last_attempt_at":"2026-10-25T23:40:35Z","status":"ok","all_sources_checked_at":"2026-10-25T23:40:35Z","error_codes":[]}},"news_last_attempt_at":{"steam-5203560":"2026-10-25T23:40:35Z"},"notices":[],"news_sources":{"5203560":{"last_attempt_at":"2026-10-25T23:40:35Z","last_success_at":"2026-10-25T23:40:35Z","status":"ok","error_codes":[]},"5274650":{"last_attempt_at":"2026-10-25T23:40:35Z","last_success_at":"2026-10-25T23:40:35Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5203560","app_id":5203560,"app_scope":"base","observed_at":"2026-10-26T06:15:41Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"fc3ed017a75689a99fa8c81ee477c5b46679df28a5871efab13fea8fba0afb8f","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Your Grandma has willed you a collection of rocks deep in the woods, but when you arrive, you find that the rocks are strewn across the floor. Armed with your Grandma's journal, a determination to clean the collection, and the tools she left behind, you begin sorting through thousands of rocks.","publishers":[{"name":"Urbandrei","creator_clan_account_id":46285808}],"developers":[{"name":"Urbandrei","creator_clan_account_id":46285808}]},"release":{"steam_release_date":1794841200,"is_coming_soon":true,"coming_soon_display":"date_full"},"trailers":{"highlights":[{"trailer_name":"Rock and Found Announcement Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1790113862","trailer_category":1,"microtrailer":[{"filename":"5203560/2075606111/f45f707b6d49c97939afae4629630d7d75876926/1790112632/microtrailer.webm","type":"video/webm"},{"filename":"5203560/2075606111/f45f707b6d49c97939afae4629630d7d75876926/1790112632/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers