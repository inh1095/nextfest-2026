ror_code":"no_reviews"},{"game_id":"steam-5107200","metric":"demo_ccu","observed_at":"2026-10-26T06:24:00Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5132460","error_code":null}],"events":[{"id":"steam-steam-5107200-1847286114027275","game_id":"steam-5107200","kind":"announcement","title":"72 Seconds — Live Gameplay","summary":"Watch 72 Seconds in action! Command squads, research upgrades, build your forces, and fight off alien swarms in this sci-fi real-time strategy game.The demo is live for Steam Next Fest. Stop by, watch some gameplay, and check out the demo!","occurred_at":null,"published_at":"2026-10-21T01:59:35Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114027275","verified_at":"2026-10-21T10:00:19Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5107200-1846651706693711","game_id":"steam-5107200","kind":"announcement","title":"72 Seconds Is Part of Steam Next Fest — Play the Demo Now!","summary":"Hey everyone!72 Seconds is taking part in Steam Next Fest, and the demo is available to play now!I've been working on this sci-fi RTS for a long time, and I'm excited to finally get it in front of more players.What is 72 Seconds?72 Seconds is a real-time strategy game where you command a squad of cloned soldiers, build facilities, research upgrades, gather resources, and fight hostile alien creatures.You'll need to manage your forces, expand your base, and make tactical decisions to survive agai","occurred_at":null,"published_at":"2026-10-20T04:52:03Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706693711","verified_at":"2026-10-20T22:26:22Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5107200-1846651706683346","game_id":"steam-5107200","kind":"update","title":"72 Seconds Demo Improvements & Quality-of-Life Update","summary":"Hey everyone!I've been working on improving the demo based on feedback and fixing a bunch of issues that came up during testing. This update includes improvements to the UI, controls, Horde mode, combat, and overall gameplay.Here's what's changed.New FeaturesCustom KeybindingsYou can now customize keybindings in the settings, giving you more control over how you play.Fully Unlocked Tech Tree in the DemoThe tech tree is now fully unlocked in the demo, and all abilities are available to explore. I","occurred_at":null,"published_at":"2026-10-16T23:03:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706683346","verified_at":"2026-10-20T22:26:22Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5107200-1846018067943070","game_id":"steam-5107200","kind":"announcement","title":"Welcome to 72 Seconds! The Demo Is Out","summary":"Hello everyone!I'm the developer behind 72 Seconds, and I wanted to take a moment to introduce the game and welcome everyone who's found their way here.I've been working on this project for quite a while, and it's exciting to finally have a demo available for people to play. There's still a lot of work ahead, but I wanted to start sharing more about the game, what I'm working on, and where things are going from here.What is 72 Seconds?The year is 3452. Humanity's largest corporation, Axiom, has ","occurred_at":null,"published_at":"2026-10-13T06:38:45Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067943070","verified_at":"2026-10-20T22:26:22Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5107200":{"last_attempt_at":"2026-10-25T22:55:16Z","status":"ok","all_sources_checked_at":"20