ing. The right trackpad turns the board. You can also rebind any control in Settings if you want.","occurred_at":null,"published_at":"2026-10-03T09:54:54Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656388744","verified_at":"2026-10-20T17:04:03Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4780520":{"last_attempt_at":"2026-10-26T04:23:07Z","status":"ok","all_sources_checked_at":"2026-10-26T04:23:07Z","error_codes":[]}},"news_last_attempt_at":{"steam-4780520":"2026-10-26T04:23:07Z"},"notices":[],"news_sources":{"4780520":{"last_attempt_at":"2026-10-26T04:23:07Z","last_success_at":"2026-10-26T04:23:07Z","status":"ok","error_codes":[]},"5296770":{"last_attempt_at":"2026-10-26T04:23:07Z","last_success_at":"2026-10-26T04:23:07Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4780520","app_id":4780520,"app_scope":"base","observed_at":"2026-10-26T06:14:57Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"1ecb6446da5a73c115839f4a12623548110279e56753ec6e15303668cd84ae39","response_sha256":null,"source_fields":{"basic_info":{"short_description":"The 3D four-in-a-row game I played with my grandmother - now in a digital form. You can outsmart the Machine across five difficulties, solve 40 one-solution puzzles, or challenge a friend on the couch, over LAN or with Steam Remote Play Together.\r\n","publishers":[{"name":"Department of Ducks"}],"developers":[{"name":"Department of Ducks"}]},"release":{"steam_release_date":1793430000,"is_coming_soon":true,"coming_soon_display":"date_month"},"trailers":{"highlights":[{"trailer_name":"MaMills Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1792957714","trailer_category":