eam_community_announcements/1845383656390480","verified_at":"2026-10-20T23:32:01Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5155770-1844115010500206","game_id":"steam-5155770","kind":"announcement","title":"Demo Overhaul Version 0.2","summary":"Demo version 0.2 is out now! The biggest change is the new unit collection system: you can open packs, collect cards, and use them to build your army. Battles will now feed directly into that collection, giving you gold to open more packs. The pack opening system will provide a very rewarding feedback loop to collect, upgrade, and improve your armies fellow warriors.There’s more of a roguelike feel to progression, with losses giving you another chance to improve your army and retry the battle. Y","occurred_at":null,"published_at":"2026-09-21T03:02:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010500206","verified_at":"2026-10-20T23:32:01Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5155770":{"last_attempt_at":"2026-10-26T09:05:47Z","status":"ok","all_sources_checked_at":"2026-10-26T09:05:47Z","error_codes":[]}},"news_last_attempt_at":{"steam-5155770":"2026-10-26T09:05:47Z"},"notices":[],"news_sources":{"5155770":{"last_attempt_at":"2026-10-26T09:05:47Z","last_success_at":"2026-10-26T09:05:47Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:05:47Z"},"5156670":{"last_attempt_at":"2026-10-26T09:05:47Z","last_success_at":"2026-10-26T09:05:47Z","status":"ok","error_codes":[],"last_fulltext_checked_at":"2026-10-26T09:05:47Z"}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5155770","app_id":5155770,"app_scope":"base","observed_at":"2026-10-26T06:15:36Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},