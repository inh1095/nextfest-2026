ror_code":"no_reviews"}],"events":[{"id":"steam-steam-5181050-1846651706689264","game_id":"steam-5181050","kind":"announcement","title":"Head Miner Demo is now playable on Mac!","summary":"The free demo is now available on macOS, with native support for Intel and Apple Silicon Macs. Download the free demo, break rocks, collect resources and upgrade your miner. Already installed? Update through Steam to get the latest Mac build. Play the free demo Thanks for playing! Share your feedback in the Steam discussions and add Head Miner to your wishlist. Wishlist Head Miner","occurred_at":null,"published_at":"2026-10-19T08:36:11Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706689264","verified_at":"2026-10-20T23:55:04Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5181050-1846651706688377","game_id":"steam-5181050","kind":"announcement","title":"Head Miner is joining Steam Next Fest!","summary":"Head Miner is joining Steam Next Fest in October 2026! Try the demo, share your feedback and support us by adding the game to your wishlist. Recent improvements We have adjusted chests, rewards and overall progression balance. We have improved the feel of mining, combat and abilities. Enemies, visual effects, audio and the camera have received improvements. The skill tree, equipment screens, resource displays and tutorial are clearer. We have refined translations and fixed various bugs. The late","occurred_at":null,"published_at":"2026-10-19T00:27:22Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706688377","verified_at":"2026-10-20T23:55:04Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5181050-1846651706685884","game_id":"steam-5181050","kind":"update","title":"BIG UPDATE! We listened to you","summary":"Hello miners! Your feedback is helping shape Head Miner. We have updated the demo with your comments in mind, and we are continuing to improve it. Here is what changed in the latest Windows demo update: Gameplay & healing Second Wind now restores health gradually, with updated activation thresholds and cooldown. New healing effects make health recovery easier to see. Progression & interface Added a Quarry tab for selling resources; the Market remains available for purchases. Improved skill-tree ","occurred_at":null,"published_at":"2026-10-18T00:50:57Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706685884","verified_at":"2026-10-20T23:55:04Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5181050-1846651706679316","game_id":"steam-5181050","kind":"update","title":"Windows Demo Update: Refreshed Enemy Visuals","summary":"The Head Miner Windows demo has been updated! This update brings the latest enemy models and refreshed visuals to the demo, including the enemies emerging from the tunnels. Download the latest update through Steam and head back underground to see the changes. Thank you to everyone playing the demo and sharing feedback. Tell us about your experience or report any issues in the Steam discussions. To follow development and support the full game, add Head Miner to your wishlist.","occurred_at":null,"published_at":"2026-10-15T21:16:14Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706679316","verified_at":"2026-10-20T23:55:04Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5181050-1846018067937681","game_id":"steam-5181050","kind":"announcement","title":"Head Miner Demo is out now!","summary":"Head Miner Demo is out now! Your head is the hero. Bounce through the mine, swing spinning pickaxes at ore blocks, and build your operation with every run. In the demo Billiard-style mining with orbiting pickaxes Ore tiers that need the right pickaxe Combo system that rewards long hit streaks Cave enemies, chests and loot Skill tree to shape your build We read every comment. Tell us what to fix first in the Steam discussions.","occurred_at":null,"published_at":"2026-10-11T02:56:08Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067937681","verified_at":"2026-10-20T23:55:04Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5181050":{"last_attempt_at":"2026-10-25T23:38:04Z","status":"ok","all_sources_checked_at":"2026-10-25T23:38:03Z","error_codes":[]}},"news_last_attempt_at":{"steam-5181050":"2026-10-25T23:38:04Z"},"notices":[],"news_sources":{"5181050":{"last_attempt_at":"2026-10-25T23:38:03Z","last_success_at":"2026-10-25T23:38:03Z","status":"ok","error_codes":[]},"5371570":{"last_attempt_at":"2026-10-25T23:38:04Z","last_success_at":"2026-10-25T23:38:04Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-5181050","app_id":5181050,"app_scope":"base","observed_at":"2026-10-26T06:15:40Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"b650ac6f6c241d97c036e8866a817573a1f95c79234e74ed2b18f20a439418fd","response_sha256":null,"source_fields":{"basic_info":{"short_description":"Head Miner는 캐릭터가 회전하며 벽에 부딪혀 앞으로 나아가는 방치형 채굴 게임입니다. 바위를 부수고 귀중한 광석을 모아 캐릭터를 강화하세요. 회전하고, 부딪치고, 채굴하며 더 강해지세요!","publishers":[{"name":"Pixelifact","creator_clan_account_id":45745665}],"developers":[{"name":"Pixelifact","creator_clan_account_id":45745665}]},"release":{"steam_release_date":1797609900,"is_coming_soon":true,"coming_soon_display":"date_full"},"trailers":{"highlights