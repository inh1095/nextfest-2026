red_at":null,"published_at":"2026-10-11T08:19:07Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067937991","verified_at":"2026-10-20T17:26:40Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4818400-1844115010503565","game_id":"steam-4818400","kind":"announcement","title":"The Luminons Forest is updating to version 0.1.0 for October’s Steam Next Fest!","summary":"Hi everyone!It’s been over a month since I released the 0.0.1 alpha demo on Steam, and honestly, your feedback has helped me improve the game a lot.With the upcoming Steam Next Fest in mind, I’ll be releasing the new 0.1.0 demo sometime between October 1st and 5th, including the following improvements:1. Wild Luminons are coming to the forests!Wild Luminons will now appear throughout the forests, and you’ll be able to try to tame them using food and by completing a minigame.Breeding is no longer","occurred_at":null,"published_at":"2026-09-22T08:47:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010503565","verified_at":"2026-10-20T17:26:40Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4818400":{"last_attempt_at":"2026-10-26T04:26:34Z","status":"ok","all_sources_checked_at":"2026-10-26T04:26:34Z","error_codes":[]}},"news_last_attempt_at":{"steam-4818400":"2026-10-26T04:26:34Z"},"notices":[],"news_sources":{"4818400":{"last_attempt_at":"2026-10-26T04:26:34Z","last_success_at":"2026-10-26T04:26:34Z","status":"ok","error_codes":[]},"5008010":{"last_attempt_at":"2026-10-26T04:26:34Z","last_success_at":"2026-10-26T04:26:34Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4818400","app_id":4818400,"app_scope":"base","observed_at":"2026-10-26T06:14:59Z","source_url":"https://api.steampowered.com/