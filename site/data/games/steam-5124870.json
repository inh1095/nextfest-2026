ror_code":"no_reviews"},{"game_id":"steam-5124870","metric":"demo_ccu","observed_at":"2026-10-26T06:27:55Z","value":0,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5149110","error_code":null}],"events":[{"id":"steam-steam-5124870-1847286114029930","game_id":"steam-5124870","kind":"announcement","title":"🚀Confined Space: Module Madness Is Joining Steam Next Fest!","summary":"We’re excited to announce that Confined Space: Module Madness is participating in Steam Next Fest!Get ready for intense bullet-hell action where every module counts. Fight through waves of enemies, collect loot, trade your gear, and rebuild your loadout to survive the chaos.But there’s a twist: your weapons wear out! Every module has its own durability, and once it breaks, it’s gone for good. Adapt your strategy, make every upgrade count, and see how long you can survive in the endless battle.🔥 ","occurred_at":null,"published_at":"2026-10-21T18:20:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1847286114029930","verified_at":"2026-10-21T20:55:01Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5124870-1845383656387419","game_id":"steam-5124870","kind":"announcement","title":"The winners of the Highscore Challenge","summary":"The Highscore Challenge is over - and the winners are:ricuDäMonaPixel-21Congratulations! Each of you gets a Steam key for the full game at release and beta access right away. The three names were drawn at random from the top twenty, live on our Discord.Winners: please reach out within 14 days (by 16 October) - on Discord or at info@confined-space.de - and show us the Steam profile behind your name on the board.15 names made it onto the board in two weeks. Thank you to everyone who played. Challe","occurred_at":null,"published_at":"2026-10-02T18:59:41Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656387419","verified_at":"2026-10-20T22:48:42Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5124870-1845383656383196","game_id":"steam-5124870","kind":"announcement","title":"Last Day of the Challenge","summary":"Fifteen names are on the board, twenty go into the draw. That's five empty slots left 👀You still don't need a good score. You need a score. One run in Challenge mode puts you on the board, and your position up there doesn't change the odds 🎲🔑 Three prizes: a Steam key for the full game at release + beta access right away 🎲 Draw: tomorrow, Friday 2 October – live right here. Time follows, come watch!🚀 📜 https://confined-space.de/challenge/","occurred_at":null,"published_at":"2026-10-01T17:29:06Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1845383656383196","verified_at":"2026-10-20T22:48:42Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5124870-1844751498222851","game_id":"steam-5124870","kind":"announcement","title":"Halftime: seven slots still open","summary":"Halftime. Seven days gone, seven to go - the Highscore Challenge runs until 1 October, 23:59 CEST.Thirteen names are on the board. Twenty go into the draw, so seven slots are still empty - and five of the thirteen are ours: devs play, but we cannot win. That leaves eight of you splitting three prizes.You do not need a high score. You need a score. A single run in Challenge mode puts you on the board, and everyone on it is in the draw - your position up there does not change the odds.Still unbeat","occurred_at":null,"published_at":"2026-09-24T22:42:32Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498222851","verified_at":"2026-10-20T22:48:42Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5124870-1844115010498019","game_id":"steam-5124870","kind":"update","title":"Demo update: Retry button, wrecks, automatic highscores","summary":"The demo got an update. Three changes:Wrecks are no longer red. Easier to see at a glance what is still alive and what is just debris.Retry button. Died? One click, same kit, new run. No detour through the menu.Highscores are submitted automatically. Quit the game and your best score goes to the leaderboard. Nothing to click, nothing to forget.That last one matters right now: the Highscore Challenge runs until 1 October, 23:59 CEST (21:59 UTC). Every Challenge run counts, your best score stays o","occurred_at":null,"published_at":"2026-09-19T22:33:23Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010498019","verified_at":"2026-10-20T22:48:42Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5124870-1844115010493372","game_id":"steam-5124870","kind":"announcement","title":"The Highscore Challenge is live","summary":"The Highscore Challenge runs until 1 October, 23:59 CEST (21:59 UTC).38,727 points. That's the best anyone on the team has managed - outscore us. Play the demo in Challenge mode, every run goes to the leaderboard, your best score counts.Top 20 on 1 October go into the draw: three winners, each with a Steam key for the full game at release and beta access right away. Drawn live on Discord on 2 October.Full terms: confined-space.de/challenge","occurred_at":null,"published_at":"2026-09-17T22:20:44Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010493372","verified_at":"2026-10-20T22:48:42Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5124870-1844115010492375","game_id":"steam-5124870","kind":"announcement","title":"Module Madness Demo - Highscore Challenge","summary":"Two weeks. One leaderboard. Three Steam keys.From 18 September to 1 October, Challenge mode in the Confined Space: Module Madness demo becomes a competition. One ship, one kit, one run – and your score goes onto the leaderboard. Make the top 20 and you're in the draw. The DatesStarts: 18 September, 00:00 CEST (17 September, 22:00 UTC) Ends: 1 October, 23:59 CEST (21:59 UTC) Where: Steam demo, Challenge mode Note: runs from the itch.io version don't count The Prize3 × Steam key for the full game ","occurred_at":null,"published_at":"2026-09-17T15:04:14Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844115010492375","verified_at":"2026-10-20T22:48:42Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5124870-1842846814456500","game_id":"steam-5124870","kind":"announcement","title":"The demo is live","summary":"The Module Madness demo is out now.Grab a ship, stack modules until nothing on screen survives - and tell us what broke.Every ability and every bonus comes from the modules you pick up along the way. Over 25 modules across five rarity tiers, and more than 150,000 combinations of them. No two runs hand you the same set.Feedback goes straight into the next build. Leave a comment here or join us on Discord.","occurred_at":null,"published_at":"2026-09-08T18:38:27Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1842846814456500","verified_at":"2026-10-20T22:48:42Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-5124870":{"last_attempt_at":"2026-10-25T22:58:17Z","status":"ok","all_sources_checked_at":"2026-10-25T22:58:17Z","error_codes":[]}},"news_last_attempt_at":{"steam-5124870":"2026-10-25T22:58:17Z"},"notices":[],"news_sources