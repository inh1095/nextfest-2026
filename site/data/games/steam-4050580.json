/v1/","context":{"app_id":4050580,"app_scope":"base","country":"KR","language":"koreana","batch_size":100,"review_scope":"store_summary_filtered","percentage_precision":"source_rounded_integer","review_score_label":"사용자 평가 없음"},"error_code":"no_reviews"}],"events":[{"id":"steam-steam-4050580-1828894815557653","game_id":"steam-4050580","kind":"announcement","title":"Toxoplasma Demo Release Date!","summary":"Hey everyone!We're proud to say that the demo is ready to be released on April 9th, and that our trailer was featured on the IGN channel! Thank you all for your support and we hope you're as excited as we are for you to finally experience Toxoplasma!","occurred_at":null,"published_at":"2026-04-02T14:56:05Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1828894815557653","verified_at":"2026-10-20T12:36:34Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4050580-1821288646580010","game_id":"steam-4050580","kind":"announcement","title":"Sound Design Devlog","summary":"A big part of horror is the sound design, which is why I've spent a lot of time studying other games sounds and their intention, as well as making a comprehensive sound system in the game engine to cover all cases needed for Toxoplasma. Of course, I can't tell you the systems secrets as that would be a spoiler of what's to come. During my playthroughs of Alien Isolation and ROUTINE, space horror games with amazing sound design, I wrote down pages and pages of notes and breakdowns. Analysis on ho","occurred_at":null,"published_at":"2026-01-09T04:19:42Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1821288646580010","verified_at":"2026-10-20T12:36:34Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4050580-1815580768359587","game_id":"steam-4050580","kind":"announcement","title":"Environments: The Vents","summary":"Environments: The VentsAs you progress through the story of Toxoplasma, you will encounter situations where the only \"safe\" escape is through the vents. What will be a surprise, however, is that the layout of the vents will change every time you enter them. This means that your last safe trek through the vents is no guarantee that you will stay in one piece the next time you go through.","occurred_at":null,"published_at":"2025-11-09T13:46:16Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1815580768359587","verified_at":"2026-10-20T12:36:34Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4050580-1813041031372432","game_id":"steam-4050580","kind":"announcement","title":"Toxoplasma Announcement!","summary":"What happens when the weapon you're creating consumes you?We are very proud to announce Toxoplasma! Right out of the gate, I want to say that a demo is already in development, with a definite direction already planned out for the timeline and storyline of the game. I will also be posting monthly updates about some features and environments of the game, with the next one being The Vents. Stay tuned, and follow to keep up-to-date!","occurred_at":null,"published_at":"2025-10-14T13:22:34Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1813041031372432","verified_at":"2026-10-20T12:36:34Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4050580":{"last_attempt_at":"2026-10-26T01:03:49Z","status":"ok","all_sources_checked_at":"2026-10-26T01:03:49Z","error_codes":[]}},"news_last_attempt_at":{"steam-4050580":"2026-10-26T01:03:49Z"},"notices":[],"news_sources":{"4050580":{"last_attempt_at":"2026-10-26T01:03:49Z","last_success_at":"2026-10-26T01:03:49Z","status":"ok","error_codes":[]},"4456830":{"last_attempt_at":"2026-10-26T01:03:49Z","last_success_at":"2026-10-26T01:03:49Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4050580","app_id":4050580,"app_scope":"base","observed_at":"2026-10-26T06:14:27Z","source_url":"https://api.steampowered.com/IStoreBrowseService/GetItems/v1/","context":{"country":"KR","language":"koreana","batch_size":100},"status":"ok","error_code":null,"store_item_success":1,"raw_item_sha256":"a2252d612db82bf3f2c8e12f1ad042b47440f8c51baa8884ac6bc4b7db04e441","response_sha256":null,"source_fields":{"basic_info":{"short_description":"톡소플라즈마는 버려진 우주 정거장에 갇힌 외로운 연구원이 되어, 감염자들이 악마적 존재들을 환각으로 보게 만드는 생물무기를 개발하는 인칭 호러 게임입니다. 감염의 징후를 발견하여 그것이 당신을 죽이기 전에 생물무기를 완성하고, 당신을 이곳에 데려온 음모를 밝혀내세요.","publishers":[{"name":"SimmeringConcrete","creator_clan_account_id":45788346}],"developers":[{"name":"SimmeringConcrete","creator_clan_account_id":45788346}]},"release":{"steam_release_date":1798704000,"is_coming_soon":true,"coming_soon_display":"date_year"},"trailers":{"highlights":[{"trailer_name":"Demo Release Date Trailer","trailer_url_format":"steam/apps/${FILENAME}?t=1775150956","trailer_category":0,"microtrailer":[{"filename":"4050580/1211848968/fcfbe763ebfec765791ea2526e606bb17743da86/1775150743/microtrailer.webm","type":"video/webm"},{"filename":"4050580/1211848968/fcfbe763ebfec765791ea2526e606bb17743da86/1775150743/microtrailer.mp4","type":"video/mp4"}],"adaptive_trailers":[{"cdn_path":"4050580/1211848968/fcfbe763ebfec765791ea2526e606bb17743da86/1775150743/dash_av1.mpd","encoding":"dash_av1"},{"cdn_path":"4050580/1211848968/fcfbe763ebfec765791ea2526e606bb17743da86/1775150743/dash_h264.mpd","encoding":"dash_h264"},{"cdn_path":"4050580/1211848968/fcfbe763ebfec765791ea2526e606bb17743da86/1775150743/hls_264_master.m3u8","encoding":"hls_h264"}],"screenshot_medium":"257313506/255f27f48abc1b8106728980d986c7c1fac5671b/movie_600x337.jpg","screenshot_full":"257313506/255f27f48abc1b810672898