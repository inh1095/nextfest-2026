ional route to 'Control Room'Lot's ","occurred_at":null,"published_at":"2026-10-14T13:17:35Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706674263","verified_at":"2026-10-20T14:06:15Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-4421250-1844751498228727","game_id":"steam-4421250","kind":"announcement","title":"The Demo Is Here!","summary":"Over the last couple of months, we here at Benchboat Games have been hard at work getting ready for Steam Next Fest, and we’ve finally reached a major milestone:A public demo!That means you can now try Liminal Brutalis: Physical Agility for yourself.To everyone who’s been here from the start—and to all the curious newcomers—we want to extend our gratitude for checking out the demo. We hope you have an interesting experience exploring what we’ve created!And if you enjoy your time with the game, c","occurred_at":null,"published_at":"2026-09-27T08:22:43Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1844751498228727","verified_at":"2026-10-20T14:06:15Z","discovery_method":"official_steam_news","content_review":"source_only"}],"analyses":[],"news_status":{"steam-4421250":{"last_attempt_at":"2026-10-26T02:30:09Z","status":"ok","all_sources_checked_at":"2026-10-26T02:30:09Z","error_codes":[]}},"news_last_attempt_at":{"steam-4421250":"2026-10-26T02:30:09Z"},"notices":[],"news_sources":{"4421250":{"last_attempt_at":"2026-10-26T02:30:09Z","last_success_at":"2026-10-26T02:30:09Z","status":"ok","error_codes":[]},"4704100":{"last_attempt_at":"2026-10-26T02:30:09Z","last_success_at":"2026-10-26T02:30:09Z","status":"ok","error_codes":[]}},"context_snapshots":[{"schema_version":1,"game_id":"steam-4421250","app_id":4421250,"app_scope":"base","observed_at":"2026-10-26T06:14:35Z","source_url":"https://api.steampowered.com/IStoreBrowseService