ror_code":"no_reviews"},{"game_id":"steam-5251600","metric":"demo_ccu","observed_at":"2026-10-26T07:11:29Z","value":1,"status":"ok","source_url":"https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=5301970","error_code":null}],"events":[{"id":"steam-steam-5251600-1846651706689444","game_id":"steam-5251600","kind":"announcement","title":"We're Joining Steam Next Fest! Play the Free Fish on the Floor Demo","summary":"Hello from Works On My PC Studio! Fish on the Floor is joining Steam Next Fest: October 2026! The free demo is available to play now. Step into a fish market full of sea creatures scattered across the floor and find your own way to clean up the chaos. Try the free demo First-person, single-player gameplay on the fish market map Pick up sea creatures and toss them into the right tanks Use water jets, a movable cart, and channels to move creatures around Upgrade your keeper mastery, save your prog","occurred_at":null,"published_at":"2026-10-19T09:26:10Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706689444","verified_at":"2026-10-21T00:37:12Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5251600-1846651706673269","game_id":"steam-5251600","kind":"announcement","title":"6 new abilities! Make cleanup even more satisfying","summary":"Six new abilities are here! Upgrade them to make every cleanup more satisfying. Vacuum net Pull nearby creatures toward your net. {STEAM_CLAN_IMAGE}/46307377/d9e414601d462c7ac1803803e6d28f85d69e62c2.gif Chain scoop Pick up one creature and scoop up matching neighbours too! {STEAM_CLAN_IMAGE}/46307377/7f44d706d2b02e82e97b091c45c82b858f27c2c3.gif Sorting launcher Hold right click to launch creatures into matching tanks. {STEAM_CLAN_IMAGE}/46307377/71125e3c9528e5e5f47d4b5da017663794dad1dd.gif Cart ","occurred_at":null,"published_at":"2026-10-14T06:05:28Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846651706673269","verified_at":"2026-10-21T00:37:12Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5251600-1846018067940488","game_id":"steam-5251600","kind":"announcement","title":"Thank you for playing the demo! First bug fixes","summary":"Hello from the developer of Fish on the Floor! We released the demo yesterday, and more of you have stopped by to play than we expected. Thank you so much! Seeing you rescue the fish scattered across the floor and reading your feedback has been a huge encouragement. We have fixed the following issues found during play: Fish getting stuck inside buildings or tanks Fixed an issue where throwing or pushing fish could leave them inside scenery, unable to be picked up again. Fish passing through wall","occurred_at":null,"published_at":"2026-10-12T10:02:40Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1846018067940488","verified_at":"2026-10-21T00:37:12Z","discovery_method":"official_steam_news","content_review":"source_only"},{"id":"steam-steam-5251600-1846018067937863","game_id":"steam-5251600","kind":"announcement","title":"Free Demo Out Now — Welcome to the Fish Market!","summary":"{STEAM_CLAN_IMAGE}/46307377/48bc6bc848f3ffc7c9498f76dbd443c33150a3d8.jpg The free demo is out! Your first shift at the fish market starts now. ▶ Play the free demo Scoop, toss, and sort! {STEAM_CLAN_IMAGE}/46307377/9ef4fbb90e14f3efdef2334aeca6731023dedd46.jpg Load up and roll out. {STEAM_CLAN_IMAGE}/46307377/5a4075ab1c62a2aed75781bc72da34c3fe3cc732.jpg Lift it up. Tip them out! {STEAM_CLAN_IMAGE}/46307377/b2382b6afc75b0114239df7b0ef89e3a45649f23.jpg Blast a path with the water jet. {STEAM_CLAN_I","occurred_at":null,"published_at":"2026-10-11T06:04:37Z","time_precision":"minute","source_url":"https://steamstore-a.akamaihd.net/new